                <tr id="issuerow12513043" rel="12513043" data-issuekey="AVRO-854" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-854" href="https://issues.apache.org/jira/browse/AVRO-854">AVRO-854</a>
</td>
                                            <td class="summary"><p>
                python DataFileWriter and DataFileReader should implement __enter__ and __exit__
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Harsh J
    </td>
                                            <td class="reporter">            Jeremy Lewi
    </td>
                                            <td class="creator">            Jeremy Lewi
    </td>
                                            <td class="created"> 06/Jul/11 21:46 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Feb/12 00:46 </td>
                                            <td class="resolutiondate"> 23/Jan/12 23:43 </td>
                                            <td class="versions">                        1.5.1            </td>
                                            <td class="fixVersions">                        1.6.2            </td>
                                            <td class="components">                        python            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      I think The python classes <br/>
{noformat}<br/>
avio.datafile.DataFileWriter<br/>
avio.datafile.DataFileReader<br/>
{noformat}<br/>
should implement the methods<br/>
{noformat}<br/>
__enter__<br/>
__exit__<br/>
{noformat}<br/>
So that they can be used in with statements as context managers<br/>
<br/>
see http://docs.python.org/release/2.5.2/lib/typecontextmanager.html<br/>
<br/>

  </td>
