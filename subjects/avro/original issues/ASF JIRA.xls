                <tr id="issuerow12469378" rel="12469378" data-issuekey="AVRO-598" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-598" href="https://issues.apache.org/jira/browse/AVRO-598">AVRO-598</a>
</td>
                                            <td class="summary"><p>
                ArrayIndexOutOfBoundsException after reading past a class that is not found
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Jon Travis
    </td>
                                            <td class="creator">            Jon Travis
    </td>
                                            <td class="created"> 15/Jul/10 20:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Sep/10 21:08 </td>
                                            <td class="resolutiondate"> 25/Aug/10 17:52 </td>
                                            <td class="versions">                        1.3.3,                     1.4.0            </td>
                                            <td class="fixVersions">                        1.4.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
