                <tr id="issuerow12430840" rel="12430840" data-issuekey="AVRO-79" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-79" href="https://issues.apache.org/jira/browse/AVRO-79">AVRO-79</a>
</td>
                                            <td class="summary"><p>
                The spec does not say how to encode default values for &quot;fixed&quot;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Thiruvalluvan M. G.
    </td>
                                            <td class="reporter">            Thiruvalluvan M. G.
    </td>
                                            <td class="creator">            Thiruvalluvan M. G.
    </td>
                                            <td class="created"> 18/Jul/09 04:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Sep/09 22:31 </td>
                                            <td class="resolutiondate"> 20/Jul/09 21:04 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.1.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
