    <a class="issue-link" data-issue-key="AVRO-621" href="https://issues.apache.org/jira/browse/AVRO-621">AVRO-621</a>
</td>
                                            <td class="summary"><p>
                Python library allows for incorrect field names in schema validation
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
