                <tr id="issuerow12518361" rel="12518361" data-issuekey="AVRO-872" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-872" href="https://issues.apache.org/jira/browse/AVRO-872">AVRO-872</a>
</td>
                                            <td class="summary"><p>
                Allow interdependancies across IDL schema imports
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Bill Graham
    </td>
                                            <td class="creator">            Bill Graham
    </td>
                                            <td class="created"> 09/Aug/11 20:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Dec/11 19:06 </td>
                                            <td class="resolutiondate"> 12/Aug/11 20:48 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.5.3            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      This currently doesn&#39;t work because Player depends on Position, but it should:<br/>
<br/>
{noformat}<br/>
$ cat position.avsc <br/>
{&quot;type&quot;:&quot;enum&quot;, &quot;name&quot;: &quot;Position&quot;, &quot;namespace&quot;: &quot;avro.examples.baseball&quot;,<br/>
    &quot;symbols&quot;: [&quot;P&quot;, &quot;C&quot;, &quot;B1&quot;, &quot;B2&quot;, &quot;B3&quot;, &quot;SS&quot;, &quot;LF&quot;, &quot;CF&quot;, &quot;RF&quot;, &quot;DH&quot;]<br/>
}<br/>
<br/>
$ cat player.avsc <br/>
{&quot;type&quot;:&quot;record&quot;, &quot;name&quot;:&quot;Player&quot;, &quot;namespace&quot;: &quot;avro.examples.baseball&quot;,<br/>
  &quot;fields&quot;: [<br/>
   {&quot;name&quot;: &quot;number&quot;, &quot;type&quot;: &quot;int&quot;},<br/>
   {&quot;name&quot;: &quot;first_name&quot;, &quot;type&quot;: &quot;string&quot;},<br/>
   {&quot;name&quot;: &quot;last_name&quot;, &quot;type&quot;: &quot;string&quot;},<br/>
   {&quot;name&quot;: &quot;position&quot;, &quot;type&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: &quot;avro.examples.baseball.Position&quot;} }<br/>
  ]<br/>
}<br/>
<br/>
$ cat baseball.avdl <br/>
@namespace(&quot;avro.examples.baseball&quot;)<br/>
protocol Baseball {<br/>
   import schema &quot;position.avsc&quot;;<br/>
   import schema &quot;player.avsc&quot;;<br/>
}<br/>
<br/>
$ java -jar avro-tools-1.5.1.jar idl baseball.avdl baseball.avpr<br/>
{noformat}<br/>

  </td>
