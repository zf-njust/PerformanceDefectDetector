                <tr id="issuerow12455504" rel="12455504" data-issuekey="AVRO-404" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-404" href="https://issues.apache.org/jira/browse/AVRO-404">AVRO-404</a>
</td>
                                            <td class="summary"><p>
                Support &quot;mixin properties&quot; for specific codegen
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
