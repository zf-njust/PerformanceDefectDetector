</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-170" href="https://issues.apache.org/jira/browse/AVRO-170">AVRO-170</a>
</td>
                                            <td class="summary"><p>
                Inifinte Recurison in Schema.java
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Mr Fish
    </td>
                                            <td class="creator">            Mr Fish
    </td>
                                            <td class="created"> 24/Oct/09 00:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Mar/10 17:09 </td>
                                            <td class="resolutiondate"> 12/Nov/09 19:43 </td>
                                            <td class="versions">                        1.2.0            </td>
                                            <td class="fixVersions">                        1.3.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
