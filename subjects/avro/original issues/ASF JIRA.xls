                <tr id="issuerow12539121" rel="12539121" data-issuekey="AVRO-1000" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1000" href="https://issues.apache.org/jira/browse/AVRO-1000">AVRO-1000</a>
</td>
                                            <td class="summary"><p>
                GenericArray breaks List.equals specification [java]
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Sylvain Lebresne
    </td>
                                            <td class="creator">            Sylvain Lebresne
    </td>
                                            <td class="created"> 20/Jan/12 10:48 </td>
                                            <td class="lastViewed"> 06/Jul/17 07:44 </td>
                                            <td class="updated"> 15/Feb/12 00:46 </td>
                                            <td class="resolutiondate"> 23/Jan/12 23:32 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.6.2            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Java API
  </td>
                                            <td class="description">      GenericArray (or more precisely GenericData$Array) implements the java.util.List interface but breaks the equals specification (and the hashCode one if it&#39;s coherent though I haven&#39;t checked). More precisely, no List can be equal to a GenericArray unless it is a GenericArray itself. It makes using a &quot;List&quot; from an Avro Object fairly dangerous to use.
  </td>
