                <tr id="issuerow12515443" rel="12515443" data-issuekey="AVRO-865" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-865" href="https://issues.apache.org/jira/browse/AVRO-865">AVRO-865</a>
</td>
                                            <td class="summary"><p>
                Upgrade to Jansson 2.1
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Douglas Creager
    </td>
                                            <td class="reporter">            Douglas Creager
    </td>
                                            <td class="creator">            Douglas Creager
    </td>
                                            <td class="created"> 26/Jul/11 18:37 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Nov/11 18:36 </td>
                                            <td class="resolutiondate"> 25/Sep/11 20:51 </td>
                                            <td class="versions">                        1.5.2,                     1.6.0            </td>
                                            <td class="fixVersions">                        1.6.0            </td>
                                            <td class="components">                        c            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
