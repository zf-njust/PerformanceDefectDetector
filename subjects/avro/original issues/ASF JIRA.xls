                <tr id="issuerow12456810" rel="12456810" data-issuekey="AVRO-422" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-422" href="https://issues.apache.org/jira/browse/AVRO-422">AVRO-422</a>
</td>
                                            <td class="summary"><p>
                build c++ docs in correct location
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
