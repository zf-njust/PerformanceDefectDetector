                <tr id="issuerow12506992" rel="12506992" data-issuekey="AVRO-819" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-819" href="https://issues.apache.org/jira/browse/AVRO-819">AVRO-819</a>
</td>
                                            <td class="summary"><p>
                C library not propagating error codes when reading files
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Douglas Creager
    </td>
                                            <td class="reporter">            Douglas Creager
    </td>
                                            <td class="creator">            Douglas Creager
    </td>
