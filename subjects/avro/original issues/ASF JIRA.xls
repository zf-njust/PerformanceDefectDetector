                <tr id="issuerow12437940" rel="12437940" data-issuekey="AVRO-141" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-141" href="https://issues.apache.org/jira/browse/AVRO-141">AVRO-141</a>
</td>
                                            <td class="summary"><p>
                NullPointerException when serializing records that are null (affects ReflectData.AllowNull)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Isabel Drost-Fromm
    </td>
                                            <td class="reporter">            Isabel Drost-Fromm
    </td>
                                            <td class="creator">            Isabel Drost-Fromm
    </td>
                                            <td class="created"> 13/Oct/09 07:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Mar/10 17:10 </td>
                                            <td class="resolutiondate"> 14/Oct/09 18:54 </td>
                                            <td class="versions">                        1.2.0            </td>
                                            <td class="fixVersions">                        1.3.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
