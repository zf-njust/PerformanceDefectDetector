                <tr id="issuerow12472536" rel="12472536" data-issuekey="AVRO-629" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-629" href="https://issues.apache.org/jira/browse/AVRO-629">AVRO-629</a>
</td>
                                            <td class="summary"><p>
                avro_array_get is a misnomer
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
