    <a class="issue-link" data-issue-key="AVRO-651" href="https://issues.apache.org/jira/browse/AVRO-651">AVRO-651</a>
</td>
                                            <td class="summary"><p>
                Add SPNEGO support to Avro HTTP transport
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Carl Steinbach
    </td>
                                            <td class="creator">            Carl Steinbach
    </td>
                                            <td class="created"> 02/Sep/10 01:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/Sep/10 18:10 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
