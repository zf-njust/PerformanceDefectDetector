                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    empty, file, header, marker, sync</td>
                                            <td class="customfield_12310220">            <span title="26/May/11 08:21"><time class="livestamp allow-future" datetime="2011-05-26T08:21:30+0000">26/May/11 8:21 AM</time></span>
    </td>
