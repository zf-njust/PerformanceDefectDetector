$ cat /usr/local/lib/pkgconfig/avro-c.pc<br/>
Name: avro-c<br/>
Description: C library for parsing Avro data<br/>
Version: undef<br/>
URL: http://avro.apache.org/<br/>
Libs: -L/usr/local/lib -lavro<br/>
Cflags: -I/usr/local/include<br/>
{code}
