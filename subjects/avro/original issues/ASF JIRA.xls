</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-147" href="https://issues.apache.org/jira/browse/AVRO-147">AVRO-147</a>
</td>
                                            <td class="summary"><p>
                Using configure to set up Makefiles for C++
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Scott Banachowski
    </td>
                                            <td class="reporter">            Scott Banachowski
    </td>
