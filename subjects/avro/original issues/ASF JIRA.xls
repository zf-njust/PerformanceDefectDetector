                <tr id="issuerow12436258" rel="12436258" data-issuekey="AVRO-117" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-117" href="https://issues.apache.org/jira/browse/AVRO-117">AVRO-117</a>
</td>
                                            <td class="summary"><p>
                plug mem leak from flex parser for C++
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
