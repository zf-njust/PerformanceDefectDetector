                <tr id="issuerow12444550" rel="12444550" data-issuekey="AVRO-281" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-281" href="https://issues.apache.org/jira/browse/AVRO-281">AVRO-281</a>
</td>
                                            <td class="summary"><p>
                Symlink in build.xml does not work well with Cygwin
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Thiruvalluvan M. G.
    </td>
                                            <td class="reporter">            Thiruvalluvan M. G.
    </td>
                                            <td class="creator">            Thiruvalluvan M. G.
    </td>
                                            <td class="created"> 04/Jan/10 00:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Mar/10 17:09 </td>
                                            <td class="resolutiondate"> 10/Jan/10 14:41 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.3.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
