                                            <td class="summary"><p>
                Remove dependency on C99 stdbool.h header
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Douglas Creager
    </td>
