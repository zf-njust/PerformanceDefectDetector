    <a class="issue-link" data-issue-key="AVRO-349" href="https://issues.apache.org/jira/browse/AVRO-349">AVRO-349</a>
</td>
                                            <td class="summary"><p>
                Make C++ builds work post AVRO-163
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Scott Banachowski
    </td>
                                            <td class="reporter">            Scott Banachowski
    </td>
                                            <td class="creator">            Scott Banachowski
    </td>
