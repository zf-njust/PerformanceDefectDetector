                <tr id="issuerow12457930" rel="12457930" data-issuekey="AVRO-446" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-446" href="https://issues.apache.org/jira/browse/AVRO-446">AVRO-446</a>
</td>
                                            <td class="summary"><p>
                top-level build.sh should checksum &amp; sign all artifacts in dist/
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Doug Cutting
    </td>
