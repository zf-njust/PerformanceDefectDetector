                <tr id="issuerow12522348" rel="12522348" data-issuekey="AVRO-887" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-887" href="https://issues.apache.org/jira/browse/AVRO-887">AVRO-887</a>
</td>
                                            <td class="summary"><p>
                ReflectData.findField needs better error message
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Chris Wilkes
    </td>
                                            <td class="creator">            Chris Wilkes
    </td>
                                            <td class="created"> 08/Sep/11 23:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Nov/11 18:36 </td>
                                            <td class="resolutiondate"> 21/Sep/11 20:45 </td>
                                            <td class="versions">                        1.5.3            </td>
                                            <td class="fixVersions">                        1.6.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">900</td>
                                            <td class="timeestimate">900</td>
                                            <td class="timespent"></td>
                                            <td class="workratio">            0%
    </td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      In this method:<br/>
  Field findField(Class c, String name)<br/>
a loop is done over c, replacing it each time with c = c.getSuperClass() and exiting if null.  This means that at the end of the loop c will always be null.  The exception message is then always<br/>
  No field named XXX in null<br/>
<br/>
The fix is trivial:<br/>
<br/>
  private static Field findField(Class c, String name) {<br/>
     Class originalClass = c;<br/>
    do {<br/>
      try {<br/>
        Field f = c.getDeclaredField(name);<br/>
        f.setAccessible(true);<br/>
        return f;<br/>
      } catch (NoSuchFieldException e) {}<br/>
      c = c.getSuperclass();<br/>
    } while (c != null);<br/>
    throw new AvroRuntimeException(&quot;No field named &quot;+name+&quot; in: &quot;+originalClass);<br/>
  }<br/>

  </td>
