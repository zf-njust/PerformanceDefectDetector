</td>
                                            <td class="summary"><p>
                TestFileSpanStorage.testTonsOfSpans() fails on my slow VM
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            James Baldassari
    </td>
                                            <td class="reporter">            James Baldassari
    </td>
                                            <td class="creator">            James Baldassari
    </td>
                                            <td class="created"> 16/Jan/12 08:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Feb/12 00:46 </td>
                                            <td class="resolutiondate"> 17/Jan/12 15:32 </td>
                                            <td class="versions">                        1.6.0,                     1.6.1            </td>
                                            <td class="fixVersions">                        1.6.2,                     1.7.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
