                <tr id="issuerow12525704" rel="12525704" data-issuekey="AVRO-903" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-903" href="https://issues.apache.org/jira/browse/AVRO-903">AVRO-903</a>
</td>
                                            <td class="summary"><p>
                C++/Cmake build fails to find Boost libraries
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Nebojsa Sabovic
    </td>
                                            <td class="reporter">            Nebojsa Sabovic
    </td>
                                            <td class="creator">            Nebojsa Sabovic
    </td>
                                            <td class="created"> 04/Oct/11 17:39 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Nov/11 18:36 </td>
                                            <td class="resolutiondate"> 07/Oct/11 08:36 </td>
                                            <td class="versions">                        1.5.4            </td>
                                            <td class="fixVersions">                        1.6.0            </td>
                                            <td class="components">                        c++            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      CMake build is not using ${Boost_INCLUDE_DIRS} in the build, and only looking for the libraries in /usr/include. This breaks custom installs (in /usr/local) and MacPorts (in /opt) builds.
  </td>
                                            <td class="security"></td>
