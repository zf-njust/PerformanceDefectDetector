                <tr id="issuerow12502924" rel="12502924" data-issuekey="AVRO-792" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-792" href="https://issues.apache.org/jira/browse/AVRO-792">AVRO-792</a>
</td>
                                            <td class="summary"><p>
                map reduce job for avro 1.5 generates ArrayIndexOutOfBoundsException
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            ey-chih chow
    </td>
                                            <td class="creator">            ey-chih chow
    </td>
                                            <td class="created"> 30/Mar/11 21:53 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/15 21:33 </td>
                                            <td class="resolutiondate"> 30/Jun/11 19:28 </td>
                                            <td class="versions">                        1.5.0,                     1.5.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
