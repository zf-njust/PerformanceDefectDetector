                <tr id="issuerow12479419" rel="12479419" data-issuekey="AVRO-694" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-694" href="https://issues.apache.org/jira/browse/AVRO-694">AVRO-694</a>
</td>
                                            <td class="summary"><p>
                Python protocol parsing failing on maps with record value types defined within protocol
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jeff Hammerbacher
    </td>
                                            <td class="reporter">            Richard Ahrens
    </td>
                                            <td class="creator">            Richard Ahrens
    </td>
                                            <td class="created"> 08/Nov/10 21:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Mar/11 00:32 </td>
                                            <td class="resolutiondate"> 07/Jan/11 21:24 </td>
                                            <td class="versions">                        1.4.1            </td>
                                            <td class="fixVersions">                        1.5.0            </td>
                                            <td class="components">                        python            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
