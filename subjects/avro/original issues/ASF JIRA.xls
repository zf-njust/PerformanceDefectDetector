                <tr id="issuerow12428299" rel="12428299" data-issuekey="AVRO-56" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-56" href="https://issues.apache.org/jira/browse/AVRO-56">AVRO-56</a>
</td>
                                            <td class="summary"><p>
                use Jackson to generate Json
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Doug Cutting
    </td>
                                            <td class="creator">            Doug Cutting
    </td>
                                            <td class="created"> 18/Jun/09 22:12 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Jul/09 22:50 </td>
                                            <td class="resolutiondate"> 19/Jun/09 20:46 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.0.0            </td>
                                            <td class="components">                        java            </td>
