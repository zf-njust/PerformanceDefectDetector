                <tr id="issuerow12496567" rel="12496567" data-issuekey="AVRO-744" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-744" href="https://issues.apache.org/jira/browse/AVRO-744">AVRO-744</a>
</td>
                                            <td class="summary"><p>
                Helper macros for extracting and setting record field values
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Douglas Creager
    </td>
                                            <td class="reporter">            Douglas Creager
    </td>
                                            <td class="creator">            Douglas Creager
    </td>
                                            <td class="created"> 24/Jan/11 16:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Mar/11 00:32 </td>
                                            <td class="resolutiondate"> 15/Feb/11 15:40 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.5.0            </td>
                                            <td class="components">                        c            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      I&#39;ve created two helper macros that can be used to extract or set the value of a record field using fewer function calls.  So instead of<br/>
<br/>
{code}<br/>
int  rc;<br/>
avro_datum_t  field;<br/>
char  *value;<br/>
rc = avro_record_get(record, &quot;name&quot;, &amp;field);<br/>
rc = avro_string_get(field, &amp;value);<br/>
{code}<br/>
<br/>
you can do:<br/>
<br/>
{code}<br/>
int  rc;<br/>
char  *value;<br/>
avro_record_get_field_value(rc, record, string, &quot;name&quot;, &amp;value);<br/>
{code}
  </td>
