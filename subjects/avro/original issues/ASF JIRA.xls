    <a class="issue-link" data-issue-key="AVRO-484" href="https://issues.apache.org/jira/browse/AVRO-484">AVRO-484</a>
</td>
                                            <td class="summary"><p>
                avro C++ HTTP rpc support
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
