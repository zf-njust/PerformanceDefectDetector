                <tr id="issuerow12446381" rel="12446381" data-issuekey="AVRO-370" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-370" href="https://issues.apache.org/jira/browse/AVRO-370">AVRO-370</a>
</td>
                                            <td class="summary"><p>
                Add support for encoding/decoding fixed data
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Matt Massie
    </td>
                                            <td class="reporter">            Matt Massie
    </td>
                                            <td class="creator">            Matt Massie
    </td>
                                            <td class="created"> 22/Jan/10 22:30 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Mar/10 17:09 </td>
                                            <td class="resolutiondate"> 22/Jan/10 22:38 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.3.0            </td>
                                            <td class="components">                        c            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
