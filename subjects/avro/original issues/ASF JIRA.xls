    <a class="issue-link" data-issue-key="AVRO-855" href="https://issues.apache.org/jira/browse/AVRO-855">AVRO-855</a>
</td>
                                            <td class="summary"><p>
                Use boost:variants for union types in C++ code generation
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ramana Suvarapu
    </td>
                                            <td class="creator">            Ramana Suvarapu
    </td>
                                            <td class="created"> 06/Jul/11 22:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Feb/17 12:40 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.5.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        c++            </td>
                                            <td class="duedate">    &nbsp;
</td>
