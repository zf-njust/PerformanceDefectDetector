    <a class="issue-link" data-issue-key="AVRO-898" href="https://issues.apache.org/jira/browse/AVRO-898">AVRO-898</a>
</td>
                                            <td class="summary"><p>
                NettyServer doesn&#39;t support SSL
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
