                                            <td class="resolutiondate"> 20/Aug/10 15:23 </td>
                                            <td class="versions">                        1.4.0            </td>
                                            <td class="fixVersions">                        1.4.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
