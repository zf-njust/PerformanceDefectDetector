    <a class="issue-link" data-issue-key="AVRO-155" href="https://issues.apache.org/jira/browse/AVRO-155">AVRO-155</a>
</td>
                                            <td class="summary"><p>
                Make avro.io.DataFileReader iterable
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
