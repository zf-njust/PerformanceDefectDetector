                <tr id="issuerow12475828" rel="12475828" data-issuekey="AVRO-676" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-676" href="https://issues.apache.org/jira/browse/AVRO-676">AVRO-676</a>
</td>
                                            <td class="summary"><p>
                Avro IDL can&#39;t process includes from disparate src trees
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Arun C Murthy
    </td>
                                            <td class="creator">            Arun C Murthy
    </td>
                                            <td class="created"> 05/Oct/10 00:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Oct/10 19:02 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.4.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        AVRO-495                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      AVRO-495 introduced support from includes in IDL. However it turns out that a bug in the implementation, which assumes that the path for the included path is in the same src tree causes it to not support includes from different source trees.<br/>
<br/>
E.g.<br/>
<br/>
src/foo/main/avro/a.genavro<br/>
// something here<br/>
<br/>
...<br/>
<br/>
src/foobar/main/avro/b.genavro<br/>
<br/>
protocol foobar {<br/>
  import idl &quot;src/foo/main/avro/a.genavro&quot;;<br/>
  ...<br/>
}.
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
                                            <td class="aggregatetimeestimate"></td>
                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    </td>
