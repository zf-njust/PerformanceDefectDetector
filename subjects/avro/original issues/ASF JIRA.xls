                <tr id="issuerow12473844" rel="12473844" data-issuekey="AVRO-665" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-665" href="https://issues.apache.org/jira/browse/AVRO-665">AVRO-665</a>
</td>
                                            <td class="summary"><p>
                Support for redirects in the Python client
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">            R. Tyler Croy
    </td>
                                            <td class="reporter">            R. Tyler Croy
    </td>
                                            <td class="creator">            R. Tyler Croy
    </td>
                                            <td class="created"> 10/Sep/10 19:27 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Sep/10 23:20 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        python            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      It&#39;s important in my environment that the Python client properly support HTTP redirects for purposes of load balancing as well as routing RPC requests properly.<br/>
<br/>
<br/>
Attached is a patch that adds support for redirects by way of a new transceiver class &quot;HTTPRedirectingTransceiver&quot;
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
