    <a class="issue-link" data-issue-key="AVRO-128" href="https://issues.apache.org/jira/browse/AVRO-128">AVRO-128</a>
</td>
                                            <td class="summary"><p>
                support NULL in AVRO record
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
