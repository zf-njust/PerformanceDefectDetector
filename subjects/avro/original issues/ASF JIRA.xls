</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-729" href="https://issues.apache.org/jira/browse/AVRO-729">AVRO-729</a>
</td>
                                            <td class="summary"><p>
                JSON encoded Avro values
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
