    <a class="issue-link" data-issue-key="AVRO-618" href="https://issues.apache.org/jira/browse/AVRO-618">AVRO-618</a>
</td>
                                            <td class="summary"><p>
                Avro doesn&#39;t work with python 2.4
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
