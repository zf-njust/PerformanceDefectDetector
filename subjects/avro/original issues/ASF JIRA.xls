                <tr id="issuerow12509478" rel="12509478" data-issuekey="AVRO-837" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-837" href="https://issues.apache.org/jira/browse/AVRO-837">AVRO-837</a>
</td>
                                            <td class="summary"><p>
                New Avro value interface
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Douglas Creager
    </td>
                                            <td class="reporter">            Douglas Creager
    </td>
                                            <td class="creator">            Douglas Creager
    </td>
