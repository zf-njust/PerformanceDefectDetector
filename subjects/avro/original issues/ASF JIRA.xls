    </td>
                                            <td class="creator">            Wanli Yang
    </td>
                                            <td class="created"> 30/Apr/10 21:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Aug/10 19:01 </td>
                                            <td class="resolutiondate"> 05/May/10 05:46 </td>
                                            <td class="versions">                        1.4.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        ruby            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
