    <a class="issue-link" data-issue-key="AVRO-893" href="https://issues.apache.org/jira/browse/AVRO-893">AVRO-893</a>
</td>
                                            <td class="summary"><p>
                New value_t API does not write out spec compatible files - header, metadata and blocks are missing.
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Douglas Creager
    </td>
                                            <td class="reporter">            Lucas Martin-King
    </td>
