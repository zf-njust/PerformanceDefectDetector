                                            <td class="summary"><p>
                Simplify and consolidate all data structures into hash tables
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
