    <a class="issue-link" data-issue-key="AVRO-876" href="https://issues.apache.org/jira/browse/AVRO-876">AVRO-876</a>
</td>
                                            <td class="summary"><p>
                Update Snappy-Java dependency to version to 1.0.3.1
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Alejandro Abdelnur
    </td>
                                            <td class="creator">            Alejandro Abdelnur
    </td>
                                            <td class="created"> 15/Aug/11 18:46 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Oct/11 20:27 </td>
                                            <td class="resolutiondate"> 23/Aug/11 22:24 </td>
                                            <td class="versions">                        1.5.2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
