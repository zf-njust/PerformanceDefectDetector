</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-21" href="https://issues.apache.org/jira/browse/AVRO-21">AVRO-21</a>
</td>
                                            <td class="summary"><p>
                namespace should be defaulted from containing definition
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Doug Cutting
    </td>
                                            <td class="creator">            Doug Cutting
    </td>
                                            <td class="created"> 24/Apr/09 21:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Jul/09 22:50 </td>
                                            <td class="resolutiondate"> 13/May/09 17:56 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.0.0            </td>
                                            <td class="components">                        java            </td>
