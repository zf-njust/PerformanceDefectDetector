    <a class="issue-link" data-issue-key="AVRO-95" href="https://issues.apache.org/jira/browse/AVRO-95">AVRO-95</a>
</td>
                                            <td class="summary"><p>
                mixing multiple types in one data file using reflection is not supported
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
