                <tr id="issuerow12457843" rel="12457843" data-issuekey="AVRO-440" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-440" href="https://issues.apache.org/jira/browse/AVRO-440">AVRO-440</a>
</td>
                                            <td class="summary"><p>
                config.h output not correctly used
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Bruce Mitchener
    </td>
                                            <td class="reporter">            Bruce Mitchener
    </td>
                                            <td class="creator">            Bruce Mitchener
    </td>
                                            <td class="created"> 02/Mar/10 10:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Mar/10 23:19 </td>
                                            <td class="resolutiondate"> 05/Mar/10 19:54 </td>
                                            <td class="versions">                        1.3.0            </td>
                                            <td class="fixVersions">                        1.3.1            </td>
                                            <td class="components">                        c            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
