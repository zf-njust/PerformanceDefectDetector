                <tr id="issuerow12433102" rel="12433102" data-issuekey="AVRO-90" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-90" href="https://issues.apache.org/jira/browse/AVRO-90">AVRO-90</a>
</td>
                                            <td class="summary"><p>
                json encoding does not encode unions correctly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Doug Cutting
    </td>
                                            <td class="creator">            Doug Cutting
    </td>
                                            <td class="created"> 14/Aug/09 18:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Feb/17 04:48 </td>
                                            <td class="resolutiondate"> 18/Aug/09 19:43 </td>
                                            <td class="versions">                        1.1.0            </td>
                                            <td class="fixVersions">                        1.1.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The Json encoding implemented in Java does not encode unions as intended.  In particular:<br/>
  - branches are labeled with their Java type enum name (all caps) rather than their Json type name (lowercase)<br/>
  - branches for named types (records, enums, fixed) are labeled with the type rather than the name<br/>
  - nulls are labelled -- a null value for a union should be untagged
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
