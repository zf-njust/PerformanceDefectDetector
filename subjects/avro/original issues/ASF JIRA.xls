    <a class="issue-link" data-issue-key="AVRO-108" href="https://issues.apache.org/jira/browse/AVRO-108">AVRO-108</a>
</td>
                                            <td class="summary"><p>
                add binary comparator
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
