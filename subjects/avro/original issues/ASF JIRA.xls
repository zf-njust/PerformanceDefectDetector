                <tr id="issuerow12469224" rel="12469224" data-issuekey="AVRO-596" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-596" href="https://issues.apache.org/jira/browse/AVRO-596">AVRO-596</a>
</td>
                                            <td class="summary"><p>
                NettyServer under-initialized in constructor.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Patrick Linehan
    </td>
                                            <td class="reporter">            Patrick Linehan
    </td>
                                            <td class="creator">            Patrick Linehan
    </td>
