                                            <td class="environment"></td>
                                            <td class="description">      As described at http://bob.pythonmac.org/archives/2008/10/02/python-26-released-now-with-json/:<br/>
<br/>
# Use simplejson or Python 2.6 json, prefer simplejson.<br/>
try:<br/>
    import simplejson as json<br/>
except ImportError:<br/>
    import json<br/>

