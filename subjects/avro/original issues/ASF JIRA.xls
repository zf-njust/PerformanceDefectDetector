                <tr id="issuerow12456217" rel="12456217" data-issuekey="AVRO-415" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-415" href="https://issues.apache.org/jira/browse/AVRO-415">AVRO-415</a>
</td>
                                            <td class="summary"><p>
                Allow Ruby implementation to work with older versions of Ruby
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jeff Hodges
    </td>
                                            <td class="reporter">            Jeff Hammerbacher
    </td>
                                            <td class="creator">            Jeff Hammerbacher
    </td>
                                            <td class="created"> 13/Feb/10 06:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Mar/10 17:09 </td>
                                            <td class="resolutiondate"> 16/Feb/10 21:24 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.3.0            </td>
                                            <td class="components">                        ruby            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      On Mac OS X Leopard with Ruby 1.8.6, running &quot;rake test&quot; results in:<br/>
<br/>
{quote}<br/>
$ rake test<br/>
