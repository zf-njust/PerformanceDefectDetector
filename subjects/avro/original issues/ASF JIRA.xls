                <tr id="issuerow12472323" rel="12472323" data-issuekey="AVRO-624" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-624" href="https://issues.apache.org/jira/browse/AVRO-624">AVRO-624</a>
</td>
                                            <td class="summary"><p>
                Fail to build from fresh git checkout
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Patrick Ting
    </td>
                                            <td class="creator">            Patrick Ting
    </td>
                                            <td class="created"> 24/Aug/10 02:48 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Aug/10 02:48 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.4.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        build            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
