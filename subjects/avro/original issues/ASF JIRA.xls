                <tr id="issuerow12505826" rel="12505826" data-issuekey="AVRO-814" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-814" href="https://issues.apache.org/jira/browse/AVRO-814">AVRO-814</a>
</td>
                                            <td class="summary"><p>
                SpecificDatumReader.newRecord always looks up the classname
