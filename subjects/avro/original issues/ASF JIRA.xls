    <a class="issue-link" data-issue-key="AVRO-142" href="https://issues.apache.org/jira/browse/AVRO-142">AVRO-142</a>
</td>
                                            <td class="summary"><p>
                Removing unused fields, constructors, and imports
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
