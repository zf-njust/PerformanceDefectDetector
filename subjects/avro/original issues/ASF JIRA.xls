    <a class="issue-link" data-issue-key="AVRO-535" href="https://issues.apache.org/jira/browse/AVRO-535">AVRO-535</a>
</td>
                                            <td class="summary"><p>
                default does not work
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
