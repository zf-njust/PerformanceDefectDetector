                <tr id="issuerow12962231" rel="12962231" data-issuekey="AVRO-1835" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1835" href="https://issues.apache.org/jira/browse/AVRO-1835">AVRO-1835</a>
</td>
                                            <td class="summary"><p>
                Running tests using JDK 1.8 complains about MaxPermSize
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Niels Basjes
    </td>
                                            <td class="reporter">            Niels Basjes
    </td>
                                            <td class="creator">            Niels Basjes
    </td>
                                            <td class="created"> 25/Apr/16 12:49 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Apr/16 20:59 </td>
                                            <td class="resolutiondate"> 28/Apr/16 20:59 </td>
                                            <td class="versions">                        1.8.0            </td>
                                            <td class="fixVersions">                        1.8.1            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
