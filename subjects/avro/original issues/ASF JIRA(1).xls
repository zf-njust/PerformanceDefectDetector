</td>
                                            <td class="summary"><p>
                Increase precision digits of JSON encodeNumber(double)
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">            Thiruvalluvan M. G.
    </td>
                                            <td class="reporter">            Jirapat Jirasirikul
    </td>
