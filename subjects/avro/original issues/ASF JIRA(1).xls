                <tr id="issuerow12646272" rel="12646272" data-issuekey="AVRO-1318" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1318" href="https://issues.apache.org/jira/browse/AVRO-1318">AVRO-1318</a>
</td>
                                            <td class="summary"><p>
                Python schema should store fingerprints
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Patch Available
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">            Jeremy Kahn
    </td>
                                            <td class="reporter">            Jeremy Kahn
    </td>
                                            <td class="creator">            Jeremy Kahn
    </td>
                                            <td class="created"> 06/May/13 19:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Oct/15 20:42 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        python            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">5</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        AVRO-1323                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      Python schema objects need to produce a simple representation that demonstrates their field identity.   {avro.schema.Schema} objects need to provide a {fingerprint} member field to enable quick checking of schema matching (even when the schema has other, possibly changed decoration).<br/>
<br/>
