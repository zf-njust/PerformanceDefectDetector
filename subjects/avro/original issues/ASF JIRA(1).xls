    <a class="issue-link" data-issue-key="AVRO-1094" href="https://issues.apache.org/jira/browse/AVRO-1094">AVRO-1094</a>
</td>
                                            <td class="summary"><p>
                Impossible to use non-default velocity templates
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
