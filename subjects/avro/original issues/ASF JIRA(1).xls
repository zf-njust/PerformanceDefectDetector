                                            <td class="summary"><p>
                Java: Single-record encoding marker bytes check is incorrect
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Ryan Blue
    </td>
                                            <td class="reporter">            Ryan Blue
    </td>
                                            <td class="creator">            Ryan Blue
    </td>
                                            <td class="created"> 24/Jul/16 23:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Sep/16 00:27 </td>
                                            <td class="resolutiondate"> 04/Sep/16 00:27 </td>
