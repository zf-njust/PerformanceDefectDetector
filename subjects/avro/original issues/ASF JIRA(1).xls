</td>
                                            <td class="summary"><p>
                Make position field of org.apache.avro.Schema not transient.
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Robert Chu
    </td>
                                            <td class="reporter">            Robert Chu
    </td>
