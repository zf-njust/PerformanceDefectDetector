                                            <td class="summary"><p>
                Clean up perl API dependencies
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Patch Available
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">            John Karp
    </td>
                                            <td class="reporter">            John Karp
    </td>
