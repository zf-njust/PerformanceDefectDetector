    <a class="issue-link" data-issue-key="AVRO-1372" href="https://issues.apache.org/jira/browse/AVRO-1372">AVRO-1372</a>
</td>
                                            <td class="summary"><p>
            <span class="parentIssue">AVRO-1371</span>
                Avro file data encryption for Java 
    </p>
</td>
                                            <td class="issuetype"> Sub-task</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
