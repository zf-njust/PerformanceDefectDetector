    <a class="issue-link" data-issue-key="AVRO-1474" href="https://issues.apache.org/jira/browse/AVRO-1474">AVRO-1474</a>
</td>
                                            <td class="summary"><p>
                C++ resolving decoder doesn&#39;t work when reader schema has more fields than writer schema
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
