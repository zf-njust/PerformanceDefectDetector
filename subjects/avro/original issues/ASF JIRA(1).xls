                <tr id="issuerow12663626" rel="12663626" data-issuekey="AVRO-1361" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1361" href="https://issues.apache.org/jira/browse/AVRO-1361">AVRO-1361</a>
</td>
                                            <td class="summary"><p>
                The values of a map are not correct
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Tibor Benke
    </td>
                                            <td class="creator">            Tibor Benke
    </td>
                                            <td class="created"> 14/Aug/13 11:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Dec/13 13:15 </td>
                                            <td class="resolutiondate"> 18/Dec/13 13:15 </td>
                                            <td class="versions">                        1.7.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        c            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
