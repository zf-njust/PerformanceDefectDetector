    </td>
                                            <td class="created"> 07/Feb/14 06:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Jul/15 10:31 </td>
                                            <td class="resolutiondate"> 07/Jul/15 10:31 </td>
                                            <td class="versions">                        1.7.6            </td>
                                            <td class="fixVersions">                        1.7.8            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">8</td>
                                            <td class="thumbnail"></td>
