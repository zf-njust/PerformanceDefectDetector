</td>
                                            <td class="summary"><p>
                Exception on storing Null value through AvroStorage using PIG
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
