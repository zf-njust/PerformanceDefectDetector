                <tr id="issuerow12646323" rel="12646323" data-issuekey="AVRO-1323" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1323" href="https://issues.apache.org/jira/browse/AVRO-1323">AVRO-1323</a>
</td>
                                            <td class="summary"><p>
                Python request schemas should report fullname
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Patch Available
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">            Jeremy Kahn
    </td>
                                            <td class="reporter">            Jeremy Kahn
    </td>
                                            <td class="creator">            Jeremy Kahn
    </td>
