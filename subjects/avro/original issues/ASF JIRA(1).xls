                <tr id="issuerow12995012" rel="12995012" data-issuekey="AVRO-1895" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1895" href="https://issues.apache.org/jira/browse/AVRO-1895">AVRO-1895</a>
</td>
                                            <td class="summary"><p>
                DeepCopy does not work with logical types
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            Taras Bobrovytsky
    </td>
                                            <td class="creator">            Taras Bobrovytsky
    </td>
                                            <td class="created"> 04/Aug/16 19:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Sep/16 15:36 </td>
                                            <td class="resolutiondate"> 31/Aug/16 23:23 </td>
                                            <td class="versions">                        1.8.1            </td>
                                            <td class="fixVersions">                        1.9.0,                     1.8.2            </td>
                                            <td class="components">                        logical types            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">7</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      AvroSchema is taken from a compiled avsc file which contains a decimal field.<br/>
<br/>
{code}<br/>
AvroSchema.Builder builder = AvroSchema.newBuilder();<br/>
BigDecimal bd = new BigDecimal(new BigInteger(&quot;155&quot;), 3);<br/>
campaignBuilder.setDecimalField(bd);<br/>
AvroSchema source = builder.build();<br/>
<br/>
//This line causes an exception<br/>
AvroSchema.Builder builder1 = AvroSchema.newBuilder(source);<br/>
{code}<br/>
<br/>
Exception:<br/>
{code}<br/>
InvocationTargetException: java.math.BigDecimal cannot be cast to java.nio.ByteBuffer<br/>
{code}<br/>
<br/>
The same failure happens with GenericData as well:<br/>
{code}<br/>
GenericRecord copy = GenericData.get().deepCopy(AvroSchema.getClassSchema(), source);<br/>
{code}
  </td>
