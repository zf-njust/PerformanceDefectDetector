    <a class="issue-link" data-issue-key="AVRO-1147" href="https://issues.apache.org/jira/browse/AVRO-1147">AVRO-1147</a>
</td>
                                            <td class="summary"><p>
                Allow Stringable Map keys in addition to pure String keys (avro reflection)
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
