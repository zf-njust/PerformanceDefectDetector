        {&quot;name&quot; : &quot;sequence_id&quot;, &quot;type&quot; : [&quot;int&quot;, &quot;null&quot;]} ,<br/>
        {&quot;name&quot; : &quot;name&quot;, &quot;type&quot; : [&quot;string&quot;, &quot;null&quot;]},<br/>
        {&quot;name&quot; : &quot;state&quot;, &quot;type&quot; : [&quot;string&quot;, &quot;null&quot;]},<br/>
        {&quot;name&quot; : &quot;description&quot;, &quot;type&quot; : [&quot;string&quot;, &quot;null&quot;]},<br/>
