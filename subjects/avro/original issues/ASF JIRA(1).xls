                <tr id="issuerow12641884" rel="12641884" data-issuekey="AVRO-1295" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1295" href="https://issues.apache.org/jira/browse/AVRO-1295">AVRO-1295</a>
</td>
                                            <td class="summary"><p>
                null namespace within non-null is not print/parse consistent
