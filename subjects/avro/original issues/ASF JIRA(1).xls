    <a class="issue-link" data-issue-key="AVRO-1403" href="https://issues.apache.org/jira/browse/AVRO-1403">AVRO-1403</a>
</td>
                                            <td class="summary"><p>
                Different arrays should be considered as different types in enums
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Eric Vergnaud
    </td>
                                            <td class="creator">            Eric Vergnaud
    </td>
                                            <td class="created"> 14/Nov/13 08:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Nov/13 08:19 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.7.5            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        spec            </td>
