                <tr id="issuerow13031290" rel="13031290" data-issuekey="AVRO-1973" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1973" href="https://issues.apache.org/jira/browse/AVRO-1973">AVRO-1973</a>
</td>
                                            <td class="summary"><p>
                Upgrade netty to the latest 3.x release
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
