    <a class="issue-link" data-issue-key="AVRO-1146" href="https://issues.apache.org/jira/browse/AVRO-1146">AVRO-1146</a>
</td>
                                            <td class="summary"><p>
                Can&#39;t use ReflectData to get schema when the type has a BigDecimal or BigInteger field
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Alexandre Normand
    </td>
                                            <td class="reporter">            Alexandre Normand
    </td>
