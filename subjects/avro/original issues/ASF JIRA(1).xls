                <tr id="issuerow12689399" rel="12689399" data-issuekey="AVRO-1441" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1441" href="https://issues.apache.org/jira/browse/AVRO-1441">AVRO-1441</a>
</td>
                                            <td class="summary"><p>
                Avro Class Files Output Directory
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jesse Anderson
    </td>
                                            <td class="reporter">            Jesse Anderson
    </td>
                                            <td class="creator">            Jesse Anderson
    </td>
                                            <td class="created"> 16/Jan/14 23:30 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Jul/14 20:16 </td>
                                            <td class="resolutiondate"> 28/Jan/14 20:02 </td>
                                            <td class="versions">                        1.7.6            </td>
                                            <td class="fixVersions">                        1.7.7            </td>
                                            <td class="components">                        doc            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">5</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The current documentation shows that Avro class files can be generated to the src/ directory. They should be generated to the target/ directory. Having files go to the src/ directory means they are not cleaned during a mvn clean. Guess who has two thumbs and ran into this issue?
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
                                            <td class="aggregatetimeestimate"></td>
                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    </td>
                                            <td class="customfield_12310220">            <span title="17/Jan/14 01:21"><time class="livestamp allow-future" datetime="2014-01-17T01:21:37+0000">17/Jan/14 1:21 AM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
