    @Test<br/>
    public void testWrite_AnonymousEnum() throws IOException {<br/>
        byte[] serializedBytes =<br/>
                serializeWithReflectDatumWriter(new MyObject(AnonymousEnum.A), MyObject.class, AllowNull.get());<br/>
