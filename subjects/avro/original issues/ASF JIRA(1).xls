                                            <td class="summary"><p>
                Introduce annotation to specify default values
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Doug Cutting
    </td>
                                            <td class="reporter">            dennis lucero
    </td>
                                            <td class="creator">            dennis lucero
    </td>
                                            <td class="created"> 12/Nov/13 09:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Jan/14 21:58 </td>
                                            <td class="resolutiondate"> 11/Dec/13 21:17 </td>
                                            <td class="versions">                        1.7.5            </td>
                                            <td class="fixVersions">                        1.7.6            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
