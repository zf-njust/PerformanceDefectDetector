    </td>
                                            <td class="created"> 10/Dec/14 22:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Dec/14 18:40 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.7.7            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
