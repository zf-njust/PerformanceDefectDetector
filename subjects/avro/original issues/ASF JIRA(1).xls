                                            <td class="customfield_12310192">      exemple to redo the error :<br/>
require &#39;avro&#39;<br/>
schema_json = &lt;&lt;-JSON<br/>
{    <br/>
  &quot;type&quot;: &quot;record&quot;,<br/>
  &quot;name&quot;: &quot;Activities&quot;,<br/>
  &quot;fields&quot; : [<br/>
    {&quot;name&quot;: &quot;params&quot;, &quot;type&quot;: [&quot;string&quot;,&quot;null&quot;]}<br/>
]<br/>
}<br/>
JSON<br/>
<br/>
schema = Avro::Schema.parse(schema_json)<br/>
writer = Avro::IO::DatumWriter.new(schema)<br/>
fname = &quot;test.avr&quot;<br/>
<br/>
puts &quot;writing to #{fname}&quot;<br/>
file = File.open(fname, &#39;wb&#39;)<br/>
dw = Avro::DataFile::Writer.new(file, writer, schema)<br/>
<br/>
# don&#39;t work when reading !<br/>
dw &lt;&lt; {&quot;params&quot; =&gt; &quot;家&quot;}<br/>
# don&#39;t work too<br/>
#dw &lt;&lt; {&quot;params&quot; =&gt; &quot;（&quot;}<br/>
dw.close<br/>
<br/>
<br/>
puts &quot;reading&quot;<br/>
Avro::DataFile.open(fname, &#39;r&#39;) do |dr|<br/>
  dr.each {|a|<br/>
    puts a[&quot;params&quot;]<br/>
  }<br/>
end
