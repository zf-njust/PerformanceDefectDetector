                <tr id="issuerow12632378" rel="12632378" data-issuekey="AVRO-1253" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1253" href="https://issues.apache.org/jira/browse/AVRO-1253">AVRO-1253</a>
</td>
                                            <td class="summary"><p>
                Added support for Trenvi BZip2 Compression
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Theodore michael Malaska
    </td>
                                            <td class="reporter">            Theodore michael Malaska
    </td>
