    <a class="issue-link" data-issue-key="AVRO-1612" href="https://issues.apache.org/jira/browse/AVRO-1612">AVRO-1612</a>
</td>
                                            <td class="summary"><p>
                typo in documentation for &quot;fixed&quot; type
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
