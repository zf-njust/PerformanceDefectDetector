                                            <td class="description">      {code}{<br/>
  &quot;type&quot;: &quot;record&quot;,<br/>
  &quot;name&quot;: &quot;EventName&quot;,<br/>
  &quot;namespace&quot;: &quot;com.company.avro.schemas&quot;,<br/>
  &quot;fields&quot;: [<br/>
    {&quot;name&quot;: &quot;eventname_model&quot;,<br/>
