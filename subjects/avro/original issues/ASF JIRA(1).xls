    </td>
                                            <td class="creator">            Francesco Versaci
    </td>
                                            <td class="created"> 22/Dec/16 15:02 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Feb/17 15:25 </td>
                                            <td class="resolutiondate"> 07/Feb/17 15:25 </td>
                                            <td class="versions">                        1.8.1            </td>
                                            <td class="fixVersions">                        1.9.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
