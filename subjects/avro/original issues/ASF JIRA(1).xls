</td>
                                            <td class="summary"><p>
                Test multiple Ruby versions in CI
    </p>
</td>
                                            <td class="issuetype"> Test</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
