                <tr id="issuerow12706630" rel="12706630" data-issuekey="AVRO-1492" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1492" href="https://issues.apache.org/jira/browse/AVRO-1492">AVRO-1492</a>
</td>
                                            <td class="summary"><p>
                Upgrade snappy-java to 1.1.0 (or later)
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Gabriel Reid
    </td>
                                            <td class="creator">            Gabriel Reid
    </td>
                                            <td class="created"> 04/Apr/14 13:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Nov/14 10:41 </td>
                                            <td class="resolutiondate"> 18/Nov/14 10:41 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
