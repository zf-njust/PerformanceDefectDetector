                                            <td class="resolutiondate"> 13/Jun/13 18:50 </td>
                                            <td class="versions">                        1.7.2,                     1.7.3,                     1.7.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        c++            </td>
                                            <td class="duedate">    &nbsp;
</td>
