    <a class="issue-link" data-issue-key="AVRO-1747" href="https://issues.apache.org/jira/browse/AVRO-1747">AVRO-1747</a>
</td>
                                            <td class="summary"><p>
                JavaScript implementation
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
