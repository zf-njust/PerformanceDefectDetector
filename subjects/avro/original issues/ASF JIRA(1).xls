</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1378" href="https://issues.apache.org/jira/browse/AVRO-1378">AVRO-1378</a>
</td>
                                            <td class="summary"><p>
                Python: custom properties not retained on primitive schemas
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Douglas Kaminsky
    </td>
                                            <td class="creator">            Douglas Kaminsky
    </td>
                                            <td class="created"> 19/Sep/13 17:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Sep/14 19:07 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.7.5            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        python            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
