                <tr id="issuerow12710337" rel="12710337" data-issuekey="AVRO-1499" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1499" href="https://issues.apache.org/jira/browse/AVRO-1499">AVRO-1499</a>
</td>
                                            <td class="summary"><p>
                Ruby 2+ Writes Invalid avro files using the avro gem
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Martin Kleppmann
    </td>
                                            <td class="reporter">            Michael Ries
    </td>
                                            <td class="creator">            Michael Ries
    </td>
                                            <td class="created"> 24/Apr/14 15:39 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Jul/14 20:16 </td>
                                            <td class="resolutiondate"> 03/Jul/14 15:17 </td>
                                            <td class="versions">                        1.7.5            </td>
                                            <td class="fixVersions">                        1.7.7            </td>
                                            <td class="components">                        ruby            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">5</td>
                                            <td class="thumbnail"></td>
