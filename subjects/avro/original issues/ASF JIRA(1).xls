                                            <td class="resolutiondate"> 07/Jan/15 15:48 </td>
                                            <td class="versions">                        1.7.4            </td>
                                            <td class="fixVersions">                        1.7.8,                     1.8.0            </td>
                                            <td class="components">    &nbsp;
</td>
