    <a class="issue-link" data-issue-key="AVRO-1784" href="https://issues.apache.org/jira/browse/AVRO-1784">AVRO-1784</a>
</td>
                                            <td class="summary"><p>
                Should have a C++ json encoder that pretty prints.
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
