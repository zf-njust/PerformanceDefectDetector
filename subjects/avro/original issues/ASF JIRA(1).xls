                <tr id="issuerow13040694" rel="13040694" data-issuekey="AVRO-1997" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1997" href="https://issues.apache.org/jira/browse/AVRO-1997">AVRO-1997</a>
</td>
                                            <td class="summary"><p>
                Avro Field.defaultVal broken for Fixed fields.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Zoltan Farkas
    </td>
                                            <td class="reporter">            Zoltan Farkas
    </td>
                                            <td class="creator">            Zoltan Farkas
    </td>
                                            <td class="created"> 06/Feb/17 17:25 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Feb/17 20:42 </td>
                                            <td class="resolutiondate"> 28/Feb/17 14:52 </td>
                                            <td class="versions">                        1.8.1,                     1.8.2            </td>
                                            <td class="fixVersions">                        1.9.0,                     1.8.2            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        AVRO-1723                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      here is a unit test to reproduce the issue:<br/>
<br/>
{code}<br/>
package org.apache.avro;<br/>
<br/>
import java.nio.ByteBuffer;<br/>
import org.junit.Assert;<br/>
import org.junit.Test;<br/>
<br/>
public class TestFixed {<br/>
<br/>
<br/>
  @Test<br/>
  public void testFixedDefaultValueDrop() {<br/>
    Schema md5 = SchemaBuilder.builder().fixed(&quot;MD5&quot;).size(16);<br/>
    Schema frec = SchemaBuilder.builder().record(&quot;test&quot;)<br/>
            .fields().name(&quot;hash&quot;).type(md5).withDefault(ByteBuffer.wrap(new byte[16])).endRecord();<br/>
    Schema.Field field = frec.getField(&quot;hash&quot;);<br/>
    Assert.assertNotNull(field.defaultVal());<br/>
  }<br/>
<br/>
}<br/>
{code}
  </td>
