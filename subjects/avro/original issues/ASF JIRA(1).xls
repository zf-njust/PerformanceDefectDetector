                <tr id="issuerow12601481" rel="12601481" data-issuekey="AVRO-1135" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1135" href="https://issues.apache.org/jira/browse/AVRO-1135">AVRO-1135</a>
</td>
                                            <td class="summary"><p>
                Avro C++ fails to build on Mac
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Thiruvalluvan M. G.
    </td>
