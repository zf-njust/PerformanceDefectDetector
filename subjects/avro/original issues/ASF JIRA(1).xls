                <tr id="issuerow13030132" rel="13030132" data-issuekey="AVRO-1972" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1972" href="https://issues.apache.org/jira/browse/AVRO-1972">AVRO-1972</a>
</td>
                                            <td class="summary"><p>
                Typo in method name
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
