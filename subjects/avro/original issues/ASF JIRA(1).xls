                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Here is a test that fails:<br/>
<br/>
  @Test<br/>
  public void test() {<br/>
    final Player.Builder builder = Player.newBuilder()<br/>
        .setFirstName(&quot;FirstName&quot;);<br/>
    final Player.Builder other = Player.newBuilder(builder);<br/>
    Assert.assertEquals(&quot;FirstName&quot;, other.getFirstName());<br/>
  }<br/>
<br/>
The generated code looks like:<br/>
<br/>
  /** Creates a new Player RecordBuilder by copying an existing Builder */<br/>
  public static avro.examples.baseball.Player.Builder newBuilder(avro.examples.baseball.Player.Builder other) {<br/>
    return new avro.examples.baseball.Player.Builder(other);<br/>
  }<br/>
<br/>
  /** Creates a Builder by copying an existing Builder */<br/>
  private Builder(avro.examples.baseball.Player.Builder other) {<br/>
    super(other);  // calls SpecificRecordBuilderBase(SpecificRecordBuilderBase&lt;T&gt; other)<br/>
  }<br/>

  </td>
