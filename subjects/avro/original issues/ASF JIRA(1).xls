    <a class="issue-link" data-issue-key="AVRO-1067" href="https://issues.apache.org/jira/browse/AVRO-1067">AVRO-1067</a>
</td>
                                            <td class="summary"><p>
                Include OutputFormat for a specified Avro schema that works with Streaming
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
