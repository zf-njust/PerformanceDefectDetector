                <tr id="issuerow12937596" rel="12937596" data-issuekey="AVRO-1797" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1797" href="https://issues.apache.org/jira/browse/AVRO-1797">AVRO-1797</a>
</td>
                                            <td class="summary"><p>
                Schema parser should not ignore null character in default value for bytes
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Huaisi Xu
    </td>
                                            <td class="creator">            Huaisi Xu
    </td>
                                            <td class="created"> 08/Feb/16 18:28 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Feb/16 22:13 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.7.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        c            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
