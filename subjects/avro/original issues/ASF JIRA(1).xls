    </td>
                                            <td class="created"> 14/Oct/15 00:13 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Feb/16 14:55 </td>
                                            <td class="resolutiondate"> 10/Dec/15 03:47 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.8.0            </td>
                                            <td class="components">                        javascript            </td>
