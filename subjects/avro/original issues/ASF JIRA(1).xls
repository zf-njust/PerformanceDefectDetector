                <tr id="issuerow12601516" rel="12601516" data-issuekey="AVRO-1136" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1136" href="https://issues.apache.org/jira/browse/AVRO-1136">AVRO-1136</a>
</td>
                                            <td class="summary"><p>
                Pair.equals returns false positives
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jeremy Lewi
    </td>
                                            <td class="creator">            Jeremy Lewi
    </td>
                                            <td class="created"> 05/Aug/12 22:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Sep/12 21:22 </td>
                                            <td class="resolutiondate"> 06/Aug/12 19:26 </td>
                                            <td class="versions">                        1.6.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Here is a test that fails and indicates the bug. pair1.equals(pair2) should return false because the values aren&#39;t the same but it returns true causing the test to fail. This appears to be a bug in both 1.6.1 and 1.7.1.<br/>
<br/>
<br/>
package contrail.avro;<br/>
<br/>
import static org.junit.Assert.*;<br/>
<br/>
import org.apache.avro.mapred.Pair;<br/>
import org.junit.Test;<br/>
<br/>
public class TestAssertEquals {<br/>
<br/>
  @Test<br/>
  public void test() {<br/>
    Pair&lt;Integer, Integer&gt; pair1 = new Pair&lt;Integer, Integer&gt;(1, 2);<br/>
    Pair&lt;Integer, Integer&gt; pair2 = new Pair&lt;Integer, Integer&gt;(1, 1);<br/>
    assertFalse(pair1.equals(pair2));<br/>
  }<br/>
}<br/>

  </td>
