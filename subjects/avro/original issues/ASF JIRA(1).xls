                <tr id="issuerow12555839" rel="12555839" data-issuekey="AVRO-1091" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1091" href="https://issues.apache.org/jira/browse/AVRO-1091">AVRO-1091</a>
</td>
                                            <td class="summary"><p>
                Avro-C - Simple scripts to call cmake from windows and linux
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Vivek Nadkarni
    </td>
                                            <td class="creator">            Vivek Nadkarni
    </td>
                                            <td class="created"> 15/May/12 17:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jun/12 20:01 </td>
                                            <td class="resolutiondate"> 20/May/12 14:29 </td>
                                            <td class="versions">                        1.7.0            </td>
                                            <td class="fixVersions">                        1.7.0            </td>
                                            <td class="components">                        c            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">86400</td>
                                            <td class="timeestimate">86400</td>
                                            <td class="timespent"></td>
                                            <td class="workratio">            0%
    </td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Windows XP, Windows 7, Ubuntu Linux
  </td>
                                            <td class="description">      New users to Avro-C may not know the specific commandline options to cmake to compile the Avro library. I would like to add simple scripts document the cmake commands under windows and linux. These scripts treat the Avro-C directory as a standalone project and are independent of the Apache build system and directory tree. <br/>
<br/>

  </td>
                                            <td class="security"></td>
