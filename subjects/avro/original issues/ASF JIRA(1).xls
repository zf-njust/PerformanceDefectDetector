    <a class="issue-link" data-issue-key="AVRO-1259" href="https://issues.apache.org/jira/browse/AVRO-1259">AVRO-1259</a>
</td>
                                            <td class="summary"><p>
                improve Trevni encoding of sparse fields
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
