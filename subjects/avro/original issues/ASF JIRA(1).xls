                                            <td class="customfield_12310310">    7
</td>
                                            <td class="customfield_12312331"></td>
                                            <td class="customfield_12311121"></td>
                                            <td class="customfield_12312332"></td>
                                            <td class="customfield_12311122"></td>
                                            <td class="customfield_12312330"></td>
                                            <td class="customfield_12311120"></td>
