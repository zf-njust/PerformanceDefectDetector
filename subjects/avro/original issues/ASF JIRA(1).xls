                <tr id="issuerow12606670" rel="12606670" data-issuekey="AVRO-1149" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1149" href="https://issues.apache.org/jira/browse/AVRO-1149">AVRO-1149</a>
</td>
                                            <td class="summary"><p>
                Add all-args constructor to generated class definitions
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Gabriel Reid
    </td>
                                            <td class="reporter">            Gabriel Reid
    </td>
                                            <td class="creator">            Gabriel Reid
    </td>
