</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1591" href="https://issues.apache.org/jira/browse/AVRO-1591">AVRO-1591</a>
</td>
                                            <td class="summary"><p>
                Java - handle hashCode / equals / toString in SpecificRequestor
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Mark Spadoni
    </td>
                                            <td class="reporter">            Mark Spadoni
    </td>
                                            <td class="creator">            Mark Spadoni
    </td>
                                            <td class="created"> 02/Oct/14 20:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Feb/16 14:56 </td>
                                            <td class="resolutiondate"> 04/Oct/14 00:01 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.8.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
