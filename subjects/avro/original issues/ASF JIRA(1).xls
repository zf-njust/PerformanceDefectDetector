    <a class="issue-link" data-issue-key="AVRO-1164" href="https://issues.apache.org/jira/browse/AVRO-1164">AVRO-1164</a>
</td>
                                            <td class="summary"><p>
                Avro-C: Deallocate resources used in test_avro_schema.c
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Vivek Nadkarni
    </td>
                                            <td class="creator">            Vivek Nadkarni
    </td>
                                            <td class="created"> 14/Sep/12 17:12 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Sep/12 21:16 </td>
                                            <td class="resolutiondate"> 17/Sep/12 23:13 </td>
                                            <td class="versions">                        1.7.1            </td>
                                            <td class="fixVersions">                        1.7.2            </td>
                                            <td class="components">                        c            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">3600</td>
