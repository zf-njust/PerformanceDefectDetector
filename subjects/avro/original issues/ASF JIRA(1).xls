    <a class="issue-link" data-issue-key="AVRO-1623" href="https://issues.apache.org/jira/browse/AVRO-1623">AVRO-1623</a>
</td>
                                            <td class="summary"><p>
                GenericData#validate() of enum: IndexOutOfBoundsException
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jeffrey Mullins
    </td>
                                            <td class="reporter">            Jeffrey Mullins
    </td>
                                            <td class="creator">            Jeffrey Mullins
    </td>
                                            <td class="created"> 16/Dec/14 20:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Feb/16 14:55 </td>
                                            <td class="resolutiondate"> 17/Dec/14 23:22 </td>
                                            <td class="versions">                        1.7.7            </td>
                                            <td class="fixVersions">                        1.8.0            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
