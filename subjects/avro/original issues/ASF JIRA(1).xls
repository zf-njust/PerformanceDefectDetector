</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1007" href="https://issues.apache.org/jira/browse/AVRO-1007">AVRO-1007</a>
</td>
                                            <td class="summary"><p>
                Insufficient validation in generated specific record builder implementations
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            James Baldassari
    </td>
                                            <td class="reporter">            James Baldassari
    </td>
                                            <td class="creator">            James Baldassari
    </td>
                                            <td class="created"> 25/Jan/12 09:14 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Feb/12 00:46 </td>
                                            <td class="resolutiondate"> 09/Feb/12 00:16 </td>
                                            <td class="versions">                        1.6.1            </td>
                                            <td class="fixVersions">                        1.6.2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
