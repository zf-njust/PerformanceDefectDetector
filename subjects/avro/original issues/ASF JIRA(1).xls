                <tr id="issuerow12955526" rel="12955526" data-issuekey="AVRO-1820" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1820" href="https://issues.apache.org/jira/browse/AVRO-1820">AVRO-1820</a>
</td>
                                            <td class="summary"><p>
                Read annotations to request&#39;s fields
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Konstantin Usachev
    </td>
                                            <td class="reporter">            Konstantin Usachev
    </td>
                                            <td class="creator">            Konstantin Usachev
    </td>
                                            <td class="created"> 02/Apr/16 17:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 20/Apr/16 18:01 </td>
                                            <td class="resolutiondate"> 20/Apr/16 18:01 </td>
                                            <td class="versions">                        1.8.0            </td>
                                            <td class="fixVersions">                        1.8.1            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      IDL compiler supports annotations on field&#39;s type but doesn&#39;t support annotations on field itself.  I mean you can write something like<br/>
{code}<br/>
...<br/>
void method(int @annotation(&quot;value&quot;) param);<br/>
...<br/>
{code}<br/>
which translates to<br/>
{code}<br/>
...{<br/>
        &quot;name&quot; : &quot;param&quot;,<br/>
        &quot;type&quot; : &quot;int&quot;,<br/>
        &quot;annotation&quot; : &quot;value&quot;<br/>
      }...<br/>
{code}<br/>
<br/>
but we lose annotations at org.apache.avro.Protocol.parseMessage. Another related to this bug is AVRO-1819
  </td>
