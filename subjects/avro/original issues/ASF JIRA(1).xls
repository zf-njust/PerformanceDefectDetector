</td>
                                            <td class="summary"><p>
                Avro-C misses EOF on 4K boundary
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Martin Kleppmann
    </td>
