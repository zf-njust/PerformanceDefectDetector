    <a class="issue-link" data-issue-key="AVRO-1534" href="https://issues.apache.org/jira/browse/AVRO-1534">AVRO-1534</a>
</td>
                                            <td class="summary"><p>
                Generate shema from a Java object
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Implemented
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Moustafa Aboul Atta
    </td>
                                            <td class="creator">            Moustafa Aboul Atta
    </td>
                                            <td class="created"> 29/Jun/14 13:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Jul/14 07:46 </td>
                                            <td class="resolutiondate"> 08/Jul/14 07:46 </td>
