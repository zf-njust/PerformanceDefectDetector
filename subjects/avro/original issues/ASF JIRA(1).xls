                                            <td class="resolutiondate"> 20/May/12 14:14 </td>
                                            <td class="versions">                        1.7.0            </td>
                                            <td class="fixVersions">                        1.7.0            </td>
                                            <td class="components">                        c            </td>
                                            <td class="duedate">    &nbsp;
</td>
