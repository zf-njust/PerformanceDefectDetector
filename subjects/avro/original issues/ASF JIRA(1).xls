                <tr id="issuerow12607704" rel="12607704" data-issuekey="AVRO-1166" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1166" href="https://issues.apache.org/jira/browse/AVRO-1166">AVRO-1166</a>
</td>
                                            <td class="summary"><p>
                IDL return type of map&lt;record&gt; fails in schema processing
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            George Fletcher
    </td>
                                            <td class="reporter">            George Fletcher
    </td>
                                            <td class="creator">            George Fletcher
    </td>
                                            <td class="created"> 14/Sep/12 19:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Feb/13 18:43 </td>
                                            <td class="resolutiondate"> 17/Sep/12 20:17 </td>
                                            <td class="versions">                        1.7.1            </td>
                                            <td class="fixVersions">                        1.7.2            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        AVRO-1148                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      An IDL construct such as ...<br/>
{code:title=Foo.idl}<br/>
protocol MyService {<br/>
    record Bar {<br/>
        int     count;<br/>
        string  message;<br/>
    }<br/>
<br/>
    map&lt;Bar&gt; getBars();<br/>
}<br/>
{code}<br/>
<br/>
generates run-time errors because of this code in SpecificData.java<br/>
{code:title=SpecificData.java lines 189-196}<br/>
      } else if (Map.class.isAssignableFrom(raw)) {   // map<br/>
        java.lang.reflect.Type key = params[0];<br/>
        java.lang.reflect.Type value = params[1];<br/>
        if (!(type instanceof Class<br/>
              &amp;&amp; CharSequence.class.isAssignableFrom((Class)type)))<br/>
          throw new AvroTypeException(&quot;Map key class not CharSequence: &quot;+key);<br/>
        return Schema.createMap(createSchema(value, names));<br/>
      } else {<br/>
{code}<br/>
<br/>
the issue is that CharSequence.class.isAssignableFrom((Class)type)) should really be CharSequence.class.isAssignableFrom((Class)*key*))
  </td>
