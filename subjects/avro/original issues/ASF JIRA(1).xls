                <tr id="issuerow12613110" rel="12613110" data-issuekey="AVRO-1181" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1181" href="https://issues.apache.org/jira/browse/AVRO-1181">AVRO-1181</a>
</td>
                                            <td class="summary"><p>
                compileJsonSchemaFromString(std::string) declared in Compiler.hh but not defined
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Russel
    </td>
                                            <td class="reporter">            Daniel Russel
    </td>
                                            <td class="creator">            Daniel Russel
    </td>
