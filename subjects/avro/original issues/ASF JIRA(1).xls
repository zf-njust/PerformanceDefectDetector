</td>
                                            <td class="assignee">            Scott Carey
    </td>
                                            <td class="reporter">            Scott Carey
    </td>
                                            <td class="creator">            Scott Carey
    </td>
                                            <td class="created"> 23/Feb/12 22:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Mar/12 16:34 </td>
                                            <td class="resolutiondate"> 24/Feb/12 22:43 </td>
                                            <td class="versions">                        1.6.2            </td>
                                            <td class="fixVersions">                        1.6.3            </td>
                                            <td class="components">                        java            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
