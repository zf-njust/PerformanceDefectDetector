    <a class="issue-link" data-issue-key="AVRO-1134" href="https://issues.apache.org/jira/browse/AVRO-1134">AVRO-1134</a>
</td>
                                            <td class="summary"><p>
                Ruby datafile serialization fails with UTF-8 characters
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Paul Dlug
    </td>
                                            <td class="creator">            Paul Dlug
    </td>
                                            <td class="created"> 27/Jul/12 01:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Dec/12 18:00 </td>
                                            <td class="resolutiondate"> 28/Nov/12 22:34 </td>
                                            <td class="versions">                        1.7.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        ruby            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
