</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-1383" href="https://issues.apache.org/jira/browse/AVRO-1383">AVRO-1383</a>
</td>
                                            <td class="summary"><p>
                Unabe to build on Visual Studio 2003 when generated file is huge
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ramana Suvarapu
    </td>
                                            <td class="creator">            Ramana Suvarapu
    </td>
                                            <td class="created"> 08/Oct/13 15:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Oct/13 15:07 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.7.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        c++            </td>
