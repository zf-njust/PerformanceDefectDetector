                <tr id="issuerow13084488" rel="13084488" data-issuekey="AVRO-2046" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-2046" href="https://issues.apache.org/jira/browse/AVRO-2046">AVRO-2046</a>
</td>
                                            <td class="summary"><p>
                avro-python3: Very restricted set of data types which are allowed in AvroSchemaFromJSONData
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Manvendra Singh
    </td>
                                            <td class="creator">            Manvendra Singh
    </td>
                                            <td class="created"> 04/Jul/17 10:10 </td>
                                            <td class="lastViewed"> 06/Jul/17 07:36 </td>
                                            <td class="updated"> 04/Jul/17 12:13 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.8.2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        python            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      avro-python3 (1.8.2)
  </td>
                                            <td class="description">      Minimal reproducable example:<br/>
<br/>
<br/>
{code:none}<br/>
from collections import OrderedDict<br/>
import avro.schema<br/>
AvroSchemaFromJSONData = avro.schema.SchemaFromJSONData<br/>
<br/>
a = {<br/>
  &quot;fields&quot;: [<br/>
    {<br/>
      &quot;name&quot;: &quot;name&quot;,<br/>
      &quot;type&quot;: &quot;string&quot;<br/>
    },<br/>
    {<br/>
      &quot;name&quot;: &quot;favorite_number&quot;,<br/>
      &quot;type&quot;: [<br/>
        &quot;int&quot;,<br/>
        &quot;null&quot;<br/>
      ]<br/>
    },<br/>
