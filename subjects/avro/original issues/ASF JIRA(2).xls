    <a class="issue-link" data-issue-key="AVRO-2030" href="https://issues.apache.org/jira/browse/AVRO-2030">AVRO-2030</a>
</td>
                                            <td class="summary"><p>
                Fix broken URL to &quot;this book chapter&quot; about Rabin fingerprints in 1.8.1 spec
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    <em>Unresolved</em>
