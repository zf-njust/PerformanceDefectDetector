                <tr id="issuerow13056229" rel="13056229" data-issuekey="AVRO-2006" class="issuerow">
                                            <td class="project">    Avro
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="AVRO-2006" href="https://issues.apache.org/jira/browse/AVRO-2006">AVRO-2006</a>
</td>
                                            <td class="summary"><p>
                Java union index serialization/deserialization is incorrect
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Marian S
    </td>
                                            <td class="creator">            Marian S
    </td>
