    <a class="issue-link" data-issue-key="AVRO-2026" href="https://issues.apache.org/jira/browse/AVRO-2026">AVRO-2026</a>
</td>
                                            <td class="summary"><p>
                Incorporate valgrind memory testing for C
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Patch Available
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
