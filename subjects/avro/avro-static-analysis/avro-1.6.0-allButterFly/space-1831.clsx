<cluster>
<group name="root">
<item name="org.apache.avro.mapred.Pair.checkIsPairSchema(Schema)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.mapred.Pair.Pair(Schema)" />
<item name="org.apache.avro.mapred.Pair.getKeySchema(Schema)" />
<item name="org.apache.avro.mapred.Pair.getValueSchema(Schema)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.Schema.Field.schema()" />
<item name="org.apache.avro.Schema.getField(String)" />
</group>
<group name="Layer-3">
<item name="org.apache.avro.AvroRuntimeException.AvroRuntimeException(String)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.avro.Schema.getFullName()" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.Schema.getName()" />
</group>
</group>
</group>
</cluster>
