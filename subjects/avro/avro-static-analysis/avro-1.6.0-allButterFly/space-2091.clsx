<cluster>
<group name="root">
<item name="org.apache.avro.Schema.Parser.addTypes(Map)" />
<group name="upper">
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.avro.Schema.Names.add(Schema)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.Schema.Names.put(Name, Schema)" />
</group>
<group name="Layer-3">
<item name="org.apache.avro.Schema.Name.toString()" />
<item name="org.apache.avro.SchemaParseException.SchemaParseException(String)" />
</group>
<group name="Layer-4">
<item name="org.apache.avro.AvroRuntimeException.AvroRuntimeException(String)" />
</group>
</group>
</group>
</cluster>
