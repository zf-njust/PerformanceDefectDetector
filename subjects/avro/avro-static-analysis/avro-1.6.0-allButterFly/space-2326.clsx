<cluster>
<group name="root">
<item name="org.apache.avro.ipc.stats.Stopwatch.elapsedNanos()" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.ipc.stats.StatsPlugin.publish(RPCContext, Stopwatch)" />
<item name="org.apache.avro.ipc.stats.StatsServlet.renderActiveRpc(RPCContext, Stopwatch)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.ipc.stats.StatsServlet.formatMillis(float)" />
<item name="org.apache.avro.ipc.stats.StatsPlugin.nanosToMillis(long)" />
<item name="org.apache.avro.ipc.stats.StatsPlugin.createNewFloatHistogram()" />
<item name="org.apache.avro.Protocol.Message.getName()" />
<item name="org.apache.avro.ipc.RPCContext.getMessage()" />
</group>
<group name="Layer-3">
<item name="org.apache.avro.ipc.stats.FloatHistogram.FloatHistogram(Segmenter)" />
</group>
<group name="Layer-4">
<item name="org.apache.avro.ipc.stats.Histogram.Histogram(Segmenter)" />
</group>
<group name="Layer-5">
<item name="org.apache.avro.ipc.stats.Histogram.Segmenter.size()" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.avro.ipc.stats.Stopwatch.Ticks.ticks()" />
</group>
</group>
</group>
</cluster>
