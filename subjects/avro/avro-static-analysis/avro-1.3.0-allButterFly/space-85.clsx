<cluster>
<group name="root">
<item name="org.apache.avro.ipc.stats.Stopwatch.start()" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.ipc.stats.StatsPlugin.serverReceiveRequest(RPCContext)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.ipc.stats.Stopwatch.Stopwatch(Ticks)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.avro.ipc.stats.Stopwatch.Ticks.ticks()" />
</group>
</group>
</group>
</cluster>
