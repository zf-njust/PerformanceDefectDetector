<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.Schema.EnumSchema.computeHash()" />
<item name="org.apache.avro.Schema.RecordSchema.computeHash()" />
<item name="org.apache.avro.Schema.FixedSchema.computeHash()" />
</group>
</group>
<group name="lower">
