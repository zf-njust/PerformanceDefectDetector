<cluster>
<group name="root">
<item name="org.apache.avro.SchemaBuilder.FieldBuilder.FieldBuilder(FieldAssembler, NameContext, String)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.SchemaBuilder.FieldAssembler.name(String)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.avro.SchemaBuilder.NamedBuilder.NamedBuilder(NameContext, String)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.SchemaBuilder.checkRequired(Object, String)" />
</group>
</group>
</group>
</cluster>
