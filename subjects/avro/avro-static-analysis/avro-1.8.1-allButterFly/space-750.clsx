<cluster>
<group name="root">
<item name="org.apache.avro.SchemaValidatorBuilder.valid()" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.SchemaValidatorBuilder.validateLatest()" />
<item name="org.apache.avro.SchemaValidatorBuilder.validateAll()" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.ValidateAll.ValidateAll(SchemaValidationStrategy)" />
<item name="org.apache.avro.ValidateLatest.ValidateLatest(SchemaValidationStrategy)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.avro.AvroRuntimeException.AvroRuntimeException(String)" />
</group>
</group>
</group>
</cluster>
