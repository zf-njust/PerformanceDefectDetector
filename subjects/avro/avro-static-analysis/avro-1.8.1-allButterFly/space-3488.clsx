<cluster>
<group name="root">
<item name="org.apache.avro.SchemaBuilder.NameContext.get(String, String)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.SchemaBuilder.BaseTypeBuilder.type(String, String)" />
<item name="org.apache.avro.SchemaBuilder.FieldBuilder.type(String, String)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.SchemaBuilder.BaseTypeBuilder.type(Schema)" />
<item name="org.apache.avro.SchemaBuilder.FieldBuilder.type(Schema)" />
<item name="org.apache.avro.SchemaBuilder.NamedBuilder.names()" />
</group>
<group name="Layer-3">
<item name="org.apache.avro.SchemaBuilder.Completion.complete(Schema)" />
<item name="org.apache.avro.SchemaBuilder.GenericDefault.GenericDefault(FieldBuilder, Schema)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.avro.SchemaBuilder.NameContext.getFullname(String)" />
<item name="org.apache.avro.SchemaBuilder.NameContext.resolveName(String, String)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.SchemaParseException.SchemaParseException(String)" />
</group>
<group name="Layer-3">
<item name="org.apache.avro.AvroRuntimeException.AvroRuntimeException(String)" />
</group>
</group>
</group>
</cluster>
