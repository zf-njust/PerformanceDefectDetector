<cluster>
<group name="root">
<item name="org.apache.avro.mapred.AvroReducer.reduce(K, Iterable, AvroCollector, Reporter)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.mapred.HadoopReducerBase.reduce(AvroKey, Iterator, OutputCollector, Reporter)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.mapred.HadoopReducerBase.getCollector(OutputCollector)" />
<item name="org.apache.avro.mapred.AvroWrapper.datum()" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.avro.mapred.Pair.set(K, V)" />
<item name="org.apache.avro.mapred.AvroJob.getOutputSchema(Configuration)" />
<item name="org.apache.avro.mapred.AvroCollector.collect(T)" />
<item name="org.apache.avro.mapred.Pair.Pair(Schema)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.mapred.Pair.checkIsPairSchema(Schema)" />
</group>
<group name="Layer-3">
<item name="org.apache.avro.Schema.getFullName()" />
</group>
<group name="Layer-4">
<item name="org.apache.avro.Schema.getName()" />
</group>
</group>
</group>
</cluster>
