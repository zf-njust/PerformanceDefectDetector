<cluster>
<group name="root">
<item name="org.apache.avro.SchemaBuilder.EnumBuilder.EnumBuilder(Completion, NameContext, String)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.SchemaBuilder.EnumBuilder.create(Completion, NameContext, String)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.avro.SchemaBuilder.NamespacedBuilder.NamespacedBuilder(Completion, NameContext, String)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.SchemaBuilder.NamedBuilder.NamedBuilder(NameContext, String)" />
</group>
<group name="Layer-3">
<item name="org.apache.avro.SchemaBuilder.checkRequired(Object, String)" />
</group>
</group>
</group>
</cluster>
