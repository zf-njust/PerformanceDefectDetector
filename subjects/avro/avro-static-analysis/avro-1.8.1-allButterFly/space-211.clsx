<cluster>
<group name="root">
<item name="org.apache.avro.Schema.setLogicalType(LogicalType)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.avro.LogicalType.addToSchema(Schema)" />
</group>
<group name="Layer-2">
<item name="org.apache.avro.LogicalType.validate(Schema)" />
<item name="org.apache.avro.JsonProperties.addProp(String, String)" />
</group>
<group name="Layer-3">
<item name="org.apache.avro.JsonProperties.getProp(String)" />
</group>
<group name="Layer-4">
<item name="org.apache.avro.JsonProperties.getJsonProp(String)" />
</group>
</group>
<group name="lower">
</group>
</group>
</cluster>
