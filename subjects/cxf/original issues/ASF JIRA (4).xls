                <tr id="issuerow12615716" rel="12615716" data-issuekey="CXF-4628" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4628" href="https://issues.apache.org/jira/browse/CXF-4628">CXF-4628</a>
</td>
                                            <td class="summary"><p>
                Only use default AttributeStatementProvider in STS if no Claims were handled
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
