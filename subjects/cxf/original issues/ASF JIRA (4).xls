                                            <td class="summary"><p>
                Add OperationInfo based authorization interceptor
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
