                <tr id="issuerow12545374" rel="12545374" data-issuekey="CXF-4166" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4166" href="https://issues.apache.org/jira/browse/CXF-4166">CXF-4166</a>
</td>
                                            <td class="summary"><p>
                CXF does not always respect SecurityPolicy TokenInclusion for the AsymmetricBinding
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 06/Mar/12 17:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Apr/12 16:45 </td>
                                            <td class="resolutiondate"> 07/Mar/12 11:26 </td>
