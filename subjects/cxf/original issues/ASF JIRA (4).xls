</td>
                                            <td class="summary"><p>
                Changing Maven Name for CXF-Services from CXF Runtime to CXF Services
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Christoph Emmersberger
    </td>
