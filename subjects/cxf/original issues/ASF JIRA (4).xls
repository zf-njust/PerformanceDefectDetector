                <tr id="issuerow12633585" rel="12633585" data-issuekey="CXF-4847" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4847" href="https://issues.apache.org/jira/browse/CXF-4847">CXF-4847</a>
</td>
                                            <td class="summary"><p>
                Data types not correctly published in WSDL from Exception classes
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            mustafa
    </td>
                                            <td class="creator">            mustafa
    </td>
                                            <td class="created"> 22/Feb/13 10:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/May/13 02:30 </td>
                                            <td class="resolutiondate"> 05/Mar/13 07:53 </td>
                                            <td class="versions">                        2.4.10,                     2.5.6,                     2.6.3,                     2.7            </td>
                                            <td class="fixVersions">                        2.7.4,                     2.6.7,                     2.5.10,                     3.0.0-milestone1            </td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        CXF-4874                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      Fixes for CXF-4542 and CXF-4542 introduced this regression where an Exception class with a Collection was always represented as the Collection type instead of the Paramatized Type.<br/>
<br/>
Example: <br/>
<br/>
@WebFault<br/>
public class CustomException extends Exception {<br/>
    <br/>
    private ArrayList&lt;MyData&gt; names;<br/>
...<br/>
<br/>
&lt;xs:complexType name=&quot;CustomException&quot;&gt;<br/>
&lt;xs:sequence&gt;<br/>
&lt;xs:element name=&quot;names&quot; nillable=&quot;true&quot; type=&quot;tns:arrayList&quot;/&gt;<br/>
&lt;/xs:sequence&gt;<br/>
<br/>
But it should be<br/>
<br/>
&lt;xs:complexType name=&quot;CustomException&quot;&gt;<br/>
&lt;xs:sequence&gt;<br/>
&lt;xs:element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;names&quot; type=&quot;tns:myData&quot;/&gt;<br/>
&lt;/xs:sequence&gt;<br/>

  </td>
