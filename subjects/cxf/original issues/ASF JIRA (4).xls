                <tr id="issuerow12596383" rel="12596383" data-issuekey="CXF-4399" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4399" href="https://issues.apache.org/jira/browse/CXF-4399">CXF-4399</a>
</td>
                                            <td class="summary"><p>
                Adding the instance.id to the ObjectName
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Willem Jiang
    </td>
                                            <td class="creator">            Willem Jiang
    </td>
                                            <td class="created"> 29/Jun/12 11:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/12 17:44 </td>
                                            <td class="resolutiondate"> 04/Jul/12 07:52 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.5.5,                     2.6.2,                     2.7            </td>
                                            <td class="components">                        Management            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
