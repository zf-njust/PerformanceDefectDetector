    </td>
                                            <td class="creator">            Stanislav Svirid
    </td>
                                            <td class="created"> 07/Mar/13 06:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Mar/13 14:04 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.7.3            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Dynamic Languages,                     JavaScript Client            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
