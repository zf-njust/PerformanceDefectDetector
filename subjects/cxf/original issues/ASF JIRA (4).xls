                <tr id="issuerow12630892" rel="12630892" data-issuekey="CXF-4810" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4810" href="https://issues.apache.org/jira/browse/CXF-4810">CXF-4810</a>
</td>
                                            <td class="summary"><p>
                java.beans.IntrospectionException: java.lang.Exception not superclass of java.lang.Exception
