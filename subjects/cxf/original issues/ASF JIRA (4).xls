</td>
                                            <td class="summary"><p>
                javax.ws.rs.WebApplicationException when creating jaxrs:server under OSGi Blueprint
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Hendy Irawan
    </td>
                                            <td class="creator">            Hendy Irawan
    </td>
                                            <td class="created"> 16/Oct/12 09:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Mar/13 13:25 </td>
                                            <td class="resolutiondate"> 23/Nov/12 15:38 </td>
                                            <td class="versions">                        2.7            </td>
                                            <td class="fixVersions">                        2.7.1            </td>
                                            <td class="components">                        JAX-RS,                     OSGi            </td>
                                            <td class="duedate">    &nbsp;
</td>
