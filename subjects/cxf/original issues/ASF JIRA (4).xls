</td>
                                            <td class="summary"><p>
                [OAuth1.0] oob callback is not supported
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Evgeni Kisel
    </td>
                                            <td class="creator">            Evgeni Kisel
    </td>
                                            <td class="created"> 18/Jul/12 05:39 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/12 17:44 </td>
                                            <td class="resolutiondate"> 18/Jul/12 23:17 </td>
                                            <td class="versions">                        2.6.1            </td>
                                            <td class="fixVersions">                        2.6.2,                     2.7            </td>
                                            <td class="components">                        JAX-RS,                     JAX-RS Security            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
