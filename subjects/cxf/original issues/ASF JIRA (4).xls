                                            <td class="issuelinks">                                        CXF-4887,                                                SMX4-1280                        </td>
                                            <td class="environment">      Karaf<br/>
  Karaf version               2.3.0<br/>
  Karaf home                  /home/ceefour/git/bippo-commerce5/karaf<br/>
  Karaf base                  /home/ceefour/git/bippo-commerce5/karaf<br/>
