    </td>
                                            <td class="created"> 15/Oct/12 05:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Jul/13 19:28 </td>
                                            <td class="resolutiondate"> 15/Oct/12 08:33 </td>
                                            <td class="versions">                        2.6.2            </td>
                                            <td class="fixVersions">                        2.5.7,                     2.6.4,                     2.7.1            </td>
                                            <td class="components">                        Soap Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
