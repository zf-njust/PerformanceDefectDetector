                <tr id="issuerow12650706" rel="12650706" data-issuekey="CXF-5053" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5053" href="https://issues.apache.org/jira/browse/CXF-5053">CXF-5053</a>
</td>
                                            <td class="summary"><p>
                JAX-RS behavior differs from JAX-WS for MessageContext.get( Message.class.getName() ) 
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Minto van der Sluis
    </td>
                                            <td class="creator">            Minto van der Sluis
    </td>
                                            <td class="created"> 03/Jun/13 18:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Aug/13 15:49 </td>
                                            <td class="resolutiondate"> 04/Jun/13 11:04 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.5.11,                     2.6.9,                     2.7.6,                     3.0.0-milestone1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      In JAX-WS:<br/>
<br/>
  WebServiceContext webServiceContext; // injected with proper value.<br/>
  Message message = Message.class.cast( webServiceContext.getMessageContext().get( Message.class.getName() ) );<br/>
<br/>
results in a valid message object reference (not null)<br/>
<br/>
In JAX-RS however similar code:<br/>
<br/>
  MessageContext jaxrsContext; // injected with proper value.<br/>
  Message message = Message.class.cast( jaxrsContext.get( Message.class.getName() ) );<br/>
<br/>
results in an invalid message object (null);<br/>

  </td>
