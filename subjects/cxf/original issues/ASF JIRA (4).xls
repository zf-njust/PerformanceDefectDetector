                                            <td class="environment"></td>
                                            <td class="description">      Upgrading from 2.7.0. to 2.7.1 uncovers a stackoverflow in JAXBContextInitializer.addType when using a recursive type definition like<br/>
{code}<br/>
public static abstract class AddressEntity&lt;T extends AddressEntity&lt;T&gt;&gt; {<br/>
	public abstract Addressable&lt;T&gt; getEntity();<br/>
}<br/>
	<br/>
public interface Addressable&lt;T extends AddressEntity&lt;T&gt;&gt;{}<br/>
{code}<br/>
{code}<br/>
java.lang.StackOverflowError<br/>
	at java.lang.Class.getDeclaredConstructor(Class.java:2001)<br/>
	at org.apache.cxf.common.util.ReflectionUtil$2.run(ReflectionUtil.java:67)<br/>
