                <tr id="issuerow12637984" rel="12637984" data-issuekey="CXF-4907" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4907" href="https://issues.apache.org/jira/browse/CXF-4907">CXF-4907</a>
</td>
                                            <td class="summary"><p>
                cxf-codegen-plugin does not work inside Eclipse with wsdlArtifact option
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Reopened
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jerome Revillard
    </td>
                                            <td class="creator">            Jerome Revillard
    </td>
                                            <td class="created"> 20/Mar/13 14:13 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Mar/17 18:55 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.7.3            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Eclipse Juno
  </td>
                                            <td class="description">      This kind of configuration raise an error inside Eclipse:<br/>
<br/>
&lt;plugin&gt;<br/>
  &lt;groupId&gt;org.apache.cxf&lt;/groupId&gt;<br/>
  &lt;artifactId&gt;cxf-codegen-plugin&lt;/artifactId&gt;<br/>
  &lt;executions&gt;<br/>
    &lt;execution&gt;<br/>
      &lt;id&gt;generate-sources&lt;/id&gt;<br/>
      &lt;phase&gt;generate-sources&lt;/phase&gt;<br/>
      &lt;configuration&gt;<br/>
        &lt;wsdlOptions&gt;<br/>
          &lt;wsdlOption&gt;<br/>
            &lt;wsdlArtifact&gt;<br/>
              &lt;groupId&gt;XXXX&lt;/groupId&gt;<br/>
              &lt;artifactId&gt;YYYYY&lt;/artifactId&gt;<br/>
              &lt;version&gt;2.1.1-SNAPSHOT&lt;/version&gt;<br/>
            &lt;/wsdlArtifact&gt;<br/>
          &lt;/wsdlOption&gt;<br/>
        &lt;/wsdlOptions&gt;<br/>
      &lt;/configuration&gt;<br/>
      &lt;goals&gt;<br/>
        &lt;goal&gt;wsdl2java&lt;/goal&gt;<br/>
      &lt;/goals&gt;<br/>
    &lt;/execution&gt;<br/>
  &lt;/executions&gt;<br/>
&lt;/plugin&gt;<br/>
<br/>
<br/>
The error raised is:<br/>
No wsdl available for base URI file:/mypath/ (org.apache.cxf:cxf-codegen-plugin:2.7.3:wsdl2java:generate-sources:generate-sources)<br/>
<br/>
<br/>
Best,<br/>
Jerome
