                                            <td class="versions">                        2.6.2,                     2.7.5            </td>
                                            <td class="fixVersions">                        2.6.8,                     2.5.11,                     2.7.6            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
