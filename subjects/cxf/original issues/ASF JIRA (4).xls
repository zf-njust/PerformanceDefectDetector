                <tr id="issuerow12634692" rel="12634692" data-issuekey="CXF-4863" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4863" href="https://issues.apache.org/jira/browse/CXF-4863">CXF-4863</a>
</td>
                                            <td class="summary"><p>
                TerminateSequenceResponse must be returned in reponse to WS-RM 1.1 TerminateSequence
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Akitoshi Yoshida
    </td>
                                            <td class="reporter">            Akitoshi Yoshida
    </td>
                                            <td class="creator">            Akitoshi Yoshida
    </td>
                                            <td class="created"> 28/Feb/13 21:48 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Apr/13 15:15 </td>
                                            <td class="resolutiondate"> 26/Mar/13 13:45 </td>
                                            <td class="versions">                        2.7.3            </td>
                                            <td class="fixVersions">                        2.7.4,                     2.6.7,                     3.0.0-milestone1            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
