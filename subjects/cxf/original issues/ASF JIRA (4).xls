                <tr id="issuerow12635316" rel="12635316" data-issuekey="CXF-4874" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4874" href="https://issues.apache.org/jira/browse/CXF-4874">CXF-4874</a>
</td>
                                            <td class="summary"><p>
                Data types for Fields not correctly published in WSDL from Exception classes
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            mustafa
    </td>
                                            <td class="creator">            mustafa
    </td>
                                            <td class="created"> 05/Mar/13 10:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/May/17 19:42 </td>
                                            <td class="resolutiondate"> 11/Mar/13 08:09 </td>
                                            <td class="versions">                        2.4.10,                     2.5.6,                     2.6.3,                     2.7            </td>
                                            <td class="fixVersions">                        2.7.4,                     2.6.7,                     2.5.10,                     3.0.0-milestone1            </td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        CXF-5538,                                                CXF-4847                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      This fix relies on CXF-4847 and fixes the same issue described in this but for public Field Types.<br/>
<br/>
Example: <br/>
<br/>
@WebFault<br/>
public class CustomException extends Exception {<br/>
    <br/>
    public ArrayList&lt;MyData&gt; names;<br/>
...<br/>
<br/>
&lt;xs:complexType name=&quot;CustomException&quot;&gt;<br/>
&lt;xs:sequence&gt;<br/>
&lt;xs:element name=&quot;names&quot; nillable=&quot;true&quot; type=&quot;tns:arrayList&quot;/&gt;<br/>
&lt;/xs:sequence&gt;<br/>
<br/>
But it should be<br/>
<br/>
&lt;xs:complexType name=&quot;CustomException&quot;&gt;<br/>
&lt;xs:sequence&gt;<br/>
&lt;xs:element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;names&quot; type=&quot;tns:myData&quot;/&gt;<br/>
&lt;/xs:sequence&gt;<br/>

  </td>
