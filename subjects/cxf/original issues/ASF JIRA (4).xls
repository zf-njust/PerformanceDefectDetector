                                            <td class="resolutiondate"> 05/Jun/12 11:39 </td>
                                            <td class="versions">                        2.6,                     2.4.8,                     2.5.4            </td>
                                            <td class="fixVersions">                        2.4.9,                     2.5.5,                     2.6.2            </td>
                                            <td class="components">                        Core            </td>
