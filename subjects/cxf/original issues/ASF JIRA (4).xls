</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4922" href="https://issues.apache.org/jira/browse/CXF-4922">CXF-4922</a>
</td>
                                            <td class="summary"><p>
                NPE is thrown at EP creation when no service class is specified and the wsdl cannot be loaded
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Akitoshi Yoshida
    </td>
                                            <td class="reporter">            Akitoshi Yoshida
    </td>
                                            <td class="creator">            Akitoshi Yoshida
    </td>
                                            <td class="created"> 25/Mar/13 14:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Apr/13 15:15 </td>
                                            <td class="resolutiondate"> 26/Mar/13 10:11 </td>
                                            <td class="versions">                        2.7.3            </td>
                                            <td class="fixVersions">                        2.7.4,                     2.6.7,                     3.0.0-milestone1            </td>
