                <tr id="issuerow12646920" rel="12646920" data-issuekey="CXF-5009" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5009" href="https://issues.apache.org/jira/browse/CXF-5009">CXF-5009</a>
</td>
                                            <td class="summary"><p>
                Allow multiple subcodes in a SOAP 1.2 fault
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Akitoshi Yoshida
    </td>
                                            <td class="reporter">            Kyle Lape
    </td>
                                            <td class="creator">            Kyle Lape
    </td>
                                            <td class="created"> 10/May/13 00:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Aug/13 15:49 </td>
                                            <td class="resolutiondate"> 17/May/13 09:17 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.5.11,                     2.6.9,                     2.7.6,                     3.0.0-milestone1            </td>
                                            <td class="components">                        Soap Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        CXF-4790                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      Currently CXF only allows one subcode to be set via in a {{SoapFault}} object, but the SOAP 1.2 spec allows nested subcodes like so:<br/>
<br/>
{code:xml}<br/>
&lt;soap:Envelope xmlns:soap=&quot;http://www.w3.org/2003/05/soap-envelope&quot;&gt;<br/>
  &lt;soap:Body&gt;<br/>
    &lt;soap:Fault&gt;<br/>
      &lt;soap:Code&gt;<br/>
        &lt;soap:Value&gt;soap:Receiver&lt;/soap:Value&gt;<br/>
        &lt;soap:Subcode&gt;<br/>
          &lt;soap:Value xmlns:ns1=&quot;http://ws.gss.redhat.com/&quot;&gt;ns1:Error&lt;/soap:Value&gt;<br/>
          &lt;soap:Subcode&gt;<br/>
            &lt;soap:Value xmlns:ns1=&quot;http://ws.gss.redhat.com/&quot;&gt;ns1:Failure&lt;/soap:Value&gt;<br/>
          &lt;/soap:Subcode&gt;<br/>
        &lt;/soap:Subcode&gt;<br/>
      &lt;/soap:Code&gt;<br/>
      &lt;soap:Reason&gt;<br/>
        &lt;soap:Text xml:lang=&quot;en&quot;&gt;Error by Failure&lt;/soap:Text&gt;<br/>
      &lt;/soap:Reason&gt;<br/>
    &lt;/soap:Fault&gt;<br/>
  &lt;/soap:Body&gt;<br/>
&lt;/soap:Envelope&gt;<br/>
{code}
  </td>
