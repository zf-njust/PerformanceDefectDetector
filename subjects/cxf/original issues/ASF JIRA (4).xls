    </td>
                                            <td class="created"> 29/Jan/13 11:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Apr/13 15:15 </td>
                                            <td class="resolutiondate"> 08/Feb/13 13:17 </td>
                                            <td class="versions">                        2.4.8            </td>
                                            <td class="fixVersions">                        2.7.4,                     2.6.7,                     2.5.10,                     3.0.0-milestone1            </td>
                                            <td class="components">                        WS-* Components            </td>
