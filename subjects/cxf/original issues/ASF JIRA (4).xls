    <a class="issue-link" data-issue-key="CXF-4881" href="https://issues.apache.org/jira/browse/CXF-4881">CXF-4881</a>
</td>
                                            <td class="summary"><p>
                Wrong set custom trace function in cxf-utils.js
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
