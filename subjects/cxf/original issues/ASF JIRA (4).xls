                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Jun/12 13:31 </td>
                                            <td class="resolutiondate"> 26/Apr/12 21:09 </td>
                                            <td class="versions">                        2.4.7,                     2.5.3,                     2.6            </td>
                                            <td class="fixVersions">                        2.3.11,                     2.4.8,                     2.5.4,                     2.6.1            </td>
                                            <td class="components">                        JavaScript Client            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
