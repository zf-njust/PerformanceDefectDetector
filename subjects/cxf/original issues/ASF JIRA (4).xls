    </td>
                                            <td class="creator">            Sergey Beryozkin
    </td>
                                            <td class="created"> 08/Apr/13 09:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Aug/13 15:50 </td>
                                            <td class="resolutiondate"> 16/Apr/13 13:02 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.7.5,                     3.0.0-milestone1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
