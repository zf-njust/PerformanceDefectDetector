    <a class="issue-link" data-issue-key="CXF-5067" href="https://issues.apache.org/jira/browse/CXF-5067">CXF-5067</a>
</td>
                                            <td class="summary"><p>
                CXF JAX-RS reports &#39;localhost&#39; to remote clients after an initial local access
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
