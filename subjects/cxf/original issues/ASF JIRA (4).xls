    <a class="issue-link" data-issue-key="CXF-4109" href="https://issues.apache.org/jira/browse/CXF-4109">CXF-4109</a>
</td>
                                            <td class="summary"><p>
                UriInfo getHost caches first request&#39;s host and always returns that on subsequent calls
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Dan Hintz
    </td>
                                            <td class="creator">            Dan Hintz
    </td>
                                            <td class="created"> 14/Feb/12 15:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Apr/15 16:25 </td>
                                            <td class="resolutiondate"> 14/Feb/12 17:13 </td>
                                            <td class="versions">                        2.5.2            </td>
                                            <td class="fixVersions">                        2.4.7,                     2.5.3,                     2.6            </td>
                                            <td class="components">    &nbsp;
</td>
