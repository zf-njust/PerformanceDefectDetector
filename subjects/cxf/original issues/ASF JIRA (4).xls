    <a class="issue-link" data-issue-key="CXF-4080" href="https://issues.apache.org/jira/browse/CXF-4080">CXF-4080</a>
</td>
                                            <td class="summary"><p>
                http conduit: documentation references basicAuthSupplier but should be authSupplier
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Achim Nierbeck
    </td>
                                            <td class="creator">            Achim Nierbeck
    </td>
                                            <td class="created"> 01/Feb/12 09:02 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Apr/12 16:50 </td>
                                            <td class="resolutiondate"> 03/Feb/12 10:06 </td>
                                            <td class="versions">                        2.4.1,                     2.5.1            </td>
                                            <td class="fixVersions">                        2.6            </td>
