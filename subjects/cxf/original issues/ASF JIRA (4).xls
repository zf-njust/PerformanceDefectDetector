                <tr id="issuerow12616436" rel="12616436" data-issuekey="CXF-4639" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4639" href="https://issues.apache.org/jira/browse/CXF-4639">CXF-4639</a>
</td>
                                            <td class="summary"><p>
                Add ability to send an existing SAML Token via the JAX-RS SAML code
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 16/Nov/12 16:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/12 14:38 </td>
                                            <td class="resolutiondate"> 16/Nov/12 17:07 </td>
                                            <td class="versions">                        2.7            </td>
                                            <td class="fixVersions">                        2.7.1            </td>
                                            <td class="components">                        JAX-RS Security            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
