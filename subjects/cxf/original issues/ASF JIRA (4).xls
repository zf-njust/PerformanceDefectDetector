                <tr id="issuerow12610079" rel="12610079" data-issuekey="CXF-4540" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4540" href="https://issues.apache.org/jira/browse/CXF-4540">CXF-4540</a>
</td>
                                            <td class="summary"><p>
                Colon character in the password is not hanled properly in AbstractHTTPDestination class
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Boris Ivanov
    </td>
                                            <td class="creator">            Boris Ivanov
    </td>
                                            <td class="created"> 03/Oct/12 14:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Nov/12 17:14 </td>
                                            <td class="resolutiondate"> 03/Oct/12 15:45 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.4.10,                     2.5.6,                     2.6.3            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
