    <a class="issue-link" data-issue-key="CXF-4449" href="https://issues.apache.org/jira/browse/CXF-4449">CXF-4449</a>
</td>
                                            <td class="summary"><p>
                XMLBinding generates different messages if code first or wsdl first
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
