                <tr id="issuerow12544568" rel="12544568" data-issuekey="CXF-4147" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4147" href="https://issues.apache.org/jira/browse/CXF-4147">CXF-4147</a>
</td>
                                            <td class="summary"><p>
                Wrong wsdl generated from impl class annotated with @SOAPBinding(parameterStyle = ParameterStyle.BARE)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            Jim Ma
    </td>
                                            <td class="creator">            Jim Ma
    </td>
                                            <td class="created"> 29/Feb/12 06:58 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Apr/12 16:45 </td>
                                            <td class="resolutiondate"> 29/Feb/12 10:23 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.4.7,                     2.5.3,                     2.6            </td>
