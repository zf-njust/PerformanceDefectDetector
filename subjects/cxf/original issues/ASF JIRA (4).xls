                                            <td class="resolutiondate"> 27/Jul/12 16:16 </td>
                                            <td class="versions">                        2.6.1            </td>
                                            <td class="fixVersions">                        2.5.5,                     2.6.2,                     2.7            </td>
                                            <td class="components">                        Core,                     JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
