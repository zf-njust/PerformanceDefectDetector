Content-Transfer-Encoding: binary<br/>
Content-ID: &lt;Attachment_id1&gt;<br/>
Content-Disposition: attachment; filename=filename1.doc<br/>
<br/>
{CONTENT1}<br/>
--uuid:{UUID}<br/>
Content-Type: application/vnd.ms-excel<br/>
Content-Transfer-Encoding: binary<br/>
Content-ID: &lt;Attachment_id2&gt;<br/>
Content-Disposition: attachment; filename=filename2.xls<br/>
<br/>
