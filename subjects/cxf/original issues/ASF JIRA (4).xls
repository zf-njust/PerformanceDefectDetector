</td>
                                            <td class="summary"><p>
                Introduce Nullable annotations to override the default handling of empty payloads by JAXB providers
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Sergey Beryozkin
    </td>
                                            <td class="creator">            Sergey Beryozkin
    </td>
                                            <td class="created"> 30/Mar/12 12:45 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Apr/12 16:45 </td>
                                            <td class="resolutiondate"> 30/Mar/12 16:28 </td>
                                            <td class="versions">                        2.3.10,                     2.4.7,                     2.5.3,                     2.6            </td>
                                            <td class="fixVersions">                        2.3.10,                     2.4.7,                     2.5.3,                     2.6            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
