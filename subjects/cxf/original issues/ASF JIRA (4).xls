</td>
                                            <td class="summary"><p>
                XmlAdapter Not Being Used
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Andy Chang
    </td>
                                            <td class="creator">            Andy Chang
    </td>
                                            <td class="created"> 02/Oct/12 17:15 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Nov/12 17:14 </td>
                                            <td class="resolutiondate"> 02/Oct/12 20:10 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.5.6,                     2.6.3,                     2.7            </td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
