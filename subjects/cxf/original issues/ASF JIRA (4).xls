                <tr id="issuerow12618141" rel="12618141" data-issuekey="CXF-4664" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4664" href="https://issues.apache.org/jira/browse/CXF-4664">CXF-4664</a>
</td>
                                            <td class="summary"><p>
                Support primary and secondary Claims in the STS
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 29/Nov/12 11:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/12 14:38 </td>
                                            <td class="resolutiondate"> 29/Nov/12 12:29 </td>
                                            <td class="versions">                        2.7            </td>
                                            <td class="fixVersions">                        2.7.1            </td>
                                            <td class="components">                        Services            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
