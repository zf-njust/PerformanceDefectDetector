</td>
                                            <td class="summary"><p>
                Want WS-SecurityPolicy assertion builder for RequireEmbeddedTokenReference
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Incomplete
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Chris Owens
    </td>
                                            <td class="creator">            Chris Owens
    </td>
                                            <td class="created"> 21/Sep/12 19:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Apr/13 15:19 </td>
                                            <td class="resolutiondate"> 25/Feb/13 22:53 </td>
                                            <td class="versions">                        2.6.2            </td>
                                            <td class="fixVersions">                        NeedMoreInfo            </td>
                                            <td class="components">                        WS-* Components            </td>
