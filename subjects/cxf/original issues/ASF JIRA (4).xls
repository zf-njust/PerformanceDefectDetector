    <a class="issue-link" data-issue-key="CXF-4624" href="https://issues.apache.org/jira/browse/CXF-4624">CXF-4624</a>
</td>
                                            <td class="summary"><p>
                XMLGregorianCalendarImpl Unmarshalling error
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Sylvain P
    </td>
                                            <td class="creator">            Sylvain P
    </td>
                                            <td class="created"> 08/Nov/12 12:48 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Apr/13 15:19 </td>
