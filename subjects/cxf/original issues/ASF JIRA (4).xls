    </td>
                                            <td class="created"> 20/Dec/12 16:32 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Feb/13 17:27 </td>
                                            <td class="resolutiondate"> 21/Dec/12 15:54 </td>
                                            <td class="versions">                        2.6.1,                     2.7.1            </td>
                                            <td class="fixVersions">                        2.5.8,                     2.6.5,                     2.7.2            </td>
