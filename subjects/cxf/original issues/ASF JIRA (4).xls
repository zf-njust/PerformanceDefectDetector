    </td>
                                            <td class="created"> 25/Feb/12 21:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Jul/15 14:58 </td>
                                            <td class="resolutiondate"> 04/Jul/13 01:57 </td>
                                            <td class="versions">                        2.5.2            </td>
                                            <td class="fixVersions">                        3.0.0-milestone1            </td>
