    <a class="issue-link" data-issue-key="CXF-4711" href="https://issues.apache.org/jira/browse/CXF-4711">CXF-4711</a>
</td>
                                            <td class="summary"><p>
                JAXBContextInitializer addType stopped handling recursive types (StackOverflow) 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Thijs Elferink
    </td>
                                            <td class="creator">            Thijs Elferink
    </td>
                                            <td class="created"> 19/Dec/12 10:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Jan/15 12:53 </td>
                                            <td class="resolutiondate"> 07/Feb/13 16:18 </td>
