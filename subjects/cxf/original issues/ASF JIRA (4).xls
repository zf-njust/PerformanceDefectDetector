    <a class="issue-link" data-issue-key="CXF-4216" href="https://issues.apache.org/jira/browse/CXF-4216">CXF-4216</a>
</td>
                                            <td class="summary"><p>
                use wsdl2java to genarate source, if the simpleType node(statusCode) have subnode like &lt;xs:enumeration value=&quot;0002&quot; /&gt; then can not genarate the StatusCode class
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            qiushengw
    </td>
                                            <td class="creator">            qiushengw
    </td>
                                            <td class="created"> 30/Mar/12 09:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Apr/12 05:14 </td>
                                            <td class="resolutiondate"> 31/Mar/12 00:56 </td>
                                            <td class="versions">                        2.5.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
