                                            <td class="updated"> 19/Dec/12 14:40 </td>
                                            <td class="resolutiondate"> 12/Oct/12 20:05 </td>
                                            <td class="versions">                        2.6.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
