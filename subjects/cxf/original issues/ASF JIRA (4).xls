                <tr id="issuerow12632151" rel="12632151" data-issuekey="CXF-4824" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4824" href="https://issues.apache.org/jira/browse/CXF-4824">CXF-4824</a>
</td>
                                            <td class="summary"><p>
                java.lang.NoSuchMethodError after the upgrade of CXF version to 2.4.9 from 2.1.6
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Arjun Bharadwaj H S
    </td>
                                            <td class="creator">            Arjun Bharadwaj H S
    </td>
                                            <td class="created"> 13/Feb/13 05:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Feb/13 12:15 </td>
                                            <td class="resolutiondate"> 13/Feb/13 12:03 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
