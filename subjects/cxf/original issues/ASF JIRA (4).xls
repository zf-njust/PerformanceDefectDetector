                                            <td class="summary"><p>
                WS Discovery service doesn&#39;t discover onvif devices
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
