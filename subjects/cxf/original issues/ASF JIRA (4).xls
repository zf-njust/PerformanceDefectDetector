                <tr id="issuerow12543557" rel="12543557" data-issuekey="CXF-4126" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4126" href="https://issues.apache.org/jira/browse/CXF-4126">CXF-4126</a>
</td>
                                            <td class="summary"><p>
                Can override built-in action  on WSS4JOutInterceptor but seems impossible to add a new custom action on WSS4JOutInterceptor 
    </p>
</td>
                                            <td class="issuetype"> Test</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            isdor sobze
    </td>
                                            <td class="creator">            isdor sobze
    </td>
