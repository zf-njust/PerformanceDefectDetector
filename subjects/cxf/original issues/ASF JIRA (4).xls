    <a class="issue-link" data-issue-key="CXF-4124" href="https://issues.apache.org/jira/browse/CXF-4124">CXF-4124</a>
</td>
                                            <td class="summary"><p>
                DynamicClientFactory has issues with schemas embedding in file based WSDL&#39;s
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
                                            <td class="created"> 21/Feb/12 19:46 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Apr/12 16:45 </td>
                                            <td class="resolutiondate"> 21/Feb/12 20:43 </td>
                                            <td class="versions">                        2.5.2            </td>
                                            <td class="fixVersions">                        2.4.7,                     2.5.3            </td>
                                            <td class="components">    &nbsp;
</td>
