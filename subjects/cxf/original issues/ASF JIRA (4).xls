    <a class="issue-link" data-issue-key="CXF-4612" href="https://issues.apache.org/jira/browse/CXF-4612">CXF-4612</a>
</td>
                                            <td class="summary"><p>
                SAML assertion element is not imported into SecurityHeader document
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
