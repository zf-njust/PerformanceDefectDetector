    <a class="issue-link" data-issue-key="CXF-4665" href="https://issues.apache.org/jira/browse/CXF-4665">CXF-4665</a>
</td>
                                            <td class="summary"><p>
                cxf-utils.js missing from release zip file
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Glen Mazza
    </td>
                                            <td class="reporter">            Erhard Trudrung
    </td>
                                            <td class="creator">            Erhard Trudrung
    </td>
                                            <td class="created"> 29/Nov/12 16:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/12 14:41 </td>
                                            <td class="resolutiondate"> 30/Nov/12 18:55 </td>
                                            <td class="versions">                        2.5.6,                     2.6.3,                     2.7            </td>
                                            <td class="fixVersions">                        2.5.7,                     2.6.4,                     2.7.1            </td>
                                            <td class="components">                        Dynamic Languages            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
