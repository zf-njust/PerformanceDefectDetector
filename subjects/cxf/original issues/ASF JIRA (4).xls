</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4556" href="https://issues.apache.org/jira/browse/CXF-4556">CXF-4556</a>
</td>
                                            <td class="summary"><p>
                JAX-RS SAML TLS HolderOfKey check does not work
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 11/Oct/12 15:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/12 14:38 </td>
