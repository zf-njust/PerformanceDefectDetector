                <tr id="issuerow12596253" rel="12596253" data-issuekey="CXF-4398" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4398" href="https://issues.apache.org/jira/browse/CXF-4398">CXF-4398</a>
</td>
                                            <td class="summary"><p>
                Handling of 303 redirections 
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            fred b
    </td>
                                            <td class="creator">            fred b
    </td>
                                            <td class="created"> 28/Jun/12 12:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/12 17:44 </td>
                                            <td class="resolutiondate"> 28/Jun/12 21:41 </td>
                                            <td class="versions">                        2.5            </td>
                                            <td class="fixVersions">                        2.4.9,                     2.5.5,                     2.6.2,                     2.7            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
