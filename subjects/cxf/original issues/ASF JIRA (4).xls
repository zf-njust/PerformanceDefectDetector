                <tr id="issuerow12544637" rel="12544637" data-issuekey="CXF-4148" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4148" href="https://issues.apache.org/jira/browse/CXF-4148">CXF-4148</a>
</td>
                                            <td class="summary"><p>
                JMS: Support conduitSelector prefix in combination with using the message ID as correlation ID for asynchronous communication
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jens Granseuer
    </td>
                                            <td class="creator">            Jens Granseuer
    </td>
                                            <td class="created"> 29/Feb/12 15:58 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 20/Apr/17 13:27 </td>
                                            <td class="resolutiondate"> 20/Apr/17 13:27 </td>
                                            <td class="versions">                        2.5.2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JMS,                     Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
