</td>
                                            <td class="customfield_12310220">            <span title="08/Feb/12 16:46"><time class="livestamp allow-future" datetime="2012-02-08T16:46:10+0000">08/Feb/12 4:46 PM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
                                            <td class="customfield_12312520"></td>
                                            <td class="customfield_12312323"></td>
                                            <td class="customfield_12312521">    3 years, 35 weeks, 5 days ago

                        </td>
                                            <td class="customfield_12312320"></td>
                                            <td class="customfield_12310420">      226989
  </td>
                                            <td class="customfield_12312321"></td>
                                            <td class="customfield_12312120">
</td>
                                            <td class="customfield_12312121"><span class="sla-agent-restricted">Restricted to agents</span>
</td>
                                            <td class="customfield_12312328"></td>
                                            <td class="customfield_12312329"></td>
