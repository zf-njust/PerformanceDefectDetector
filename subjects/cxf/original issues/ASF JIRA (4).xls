</td>
                                            <td class="summary"><p>
                Support &#39;qs&#39; media type parameters
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
