    <a class="issue-link" data-issue-key="CXF-4509" href="https://issues.apache.org/jira/browse/CXF-4509">CXF-4509</a>
</td>
                                            <td class="summary"><p>
                Support for NetWeaver AS&#39;s HTTPs connections
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Kirill Kadyrko
    </td>
                                            <td class="creator">            Kirill Kadyrko
    </td>
                                            <td class="created"> 19/Sep/12 15:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:37 </td>
                                            <td class="resolutiondate"> 28/Mar/17 17:25 </td>
                                            <td class="versions">                        2.6.1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
