                <tr id="issuerow12634872" rel="12634872" data-issuekey="CXF-4868" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4868" href="https://issues.apache.org/jira/browse/CXF-4868">CXF-4868</a>
</td>
                                            <td class="summary"><p>
                cxf-xjc plugin generate List&lt;T&gt; for wrapped lists
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Matt Pavlovich
    </td>
                                            <td class="creator">            Matt Pavlovich
    </td>
                                            <td class="created"> 01/Mar/13 18:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Aug/13 15:56 </td>
                                            <td class="resolutiondate"> 09/Apr/13 15:22 </td>
                                            <td class="versions">                        2.7.3            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
