                <tr id="issuerow12623528" rel="12623528" data-issuekey="CXF-4694" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4694" href="https://issues.apache.org/jira/browse/CXF-4694">CXF-4694</a>
</td>
                                            <td class="summary"><p>
                WS-RM is not returning a correct soap fault message to the client
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Akitoshi Yoshida
    </td>
                                            <td class="reporter">            Akitoshi Yoshida
    </td>
                                            <td class="creator">            Akitoshi Yoshida
    </td>
                                            <td class="created"> 12/Dec/12 11:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Feb/13 17:27 </td>
                                            <td class="resolutiondate"> 12/Dec/12 18:16 </td>
                                            <td class="versions">                        2.7.1            </td>
                                            <td class="fixVersions">                        2.5.8,                     2.6.5,                     2.7.2            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
