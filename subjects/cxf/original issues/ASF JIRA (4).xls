    <a class="issue-link" data-issue-key="CXF-4487" href="https://issues.apache.org/jira/browse/CXF-4487">CXF-4487</a>
</td>
                                            <td class="summary"><p>
                cxf-codegen-plugin: Error resolving component warnings for imported types
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Gert Driesen
    </td>
                                            <td class="creator">            Gert Driesen
    </td>
                                            <td class="created"> 24/Aug/12 19:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Nov/12 17:14 </td>
                                            <td class="resolutiondate"> 28/Aug/12 20:22 </td>
                                            <td class="versions">                        2.6.2            </td>
                                            <td class="fixVersions">                        2.6.3            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
