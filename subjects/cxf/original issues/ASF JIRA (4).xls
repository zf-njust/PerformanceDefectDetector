    xsi:schemaLocation=&quot;http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd<br/>
                        http://cxf.apache.org/jaxws http://cxf.apache.org/schemas/jaxws.xsd<br/>
                        http://cxf.apache.org/ws/addressing http://cxf.apache.org/schemas/ws-addr-conf.xsd&quot;&gt;<br/>
<br/>
    &lt;import resource=&quot;classpath:META-INF/cxf/cxf.xml&quot; /&gt;<br/>
    &lt;import resource=&quot;classpath:META-INF/cxf/cxf-extension-*.xml&quot; /&gt;<br/>
    &lt;import resource=&quot;classpath:META-INF/cxf/cxf-servlet.xml&quot; /&gt;<br/>
<br/>
    &lt;!-- Spring manage ServiceBean --&gt;<br/>
    &lt;bean id=&quot;RESAdapterService&quot; class=&quot;net.worldticket.edi.protocol.ota.RESAdapterService&quot; /&gt;<br/>
<br/>
    &lt;!--<br/>
    Log4j is set to be used in META-INF\cxf\org.apache.cxf.Logger<br/>
    Make sure that log4j INFO level is set for the following interceptors or<br/>
    for the package org.apache.cxf to make them work.<br/>
    --&gt;<br/>
    &lt;bean id=&quot;logInInterceptor&quot; class=&quot;org.apache.cxf.interceptor.LoggingInInterceptor&quot;/&gt;<br/>
    &lt;bean id=&quot;logOutInterceptor&quot; class=&quot;org.apache.cxf.interceptor.LoggingOutInterceptor&quot;/&gt;<br/>
<br/>
    &lt;!--<br/>
         WSS4JInInterceptor for decrypting and validating the signature of the SOAP request.<br/>
    --&gt;<br/>
    &lt;bean<br/>
        id=&quot;TimestampSignEncrypt_Request&quot;<br/>
        class=&quot;org.apache.cxf.ws.security.wss4j.WSS4JInInterceptor&quot;&gt;<br/>
        &lt;constructor-arg&gt;<br/>
            &lt;map&gt;<br/>
                &lt;entry key=&quot;action&quot; value=&quot;Signature Encrypt Timestamp&quot;/&gt;<br/>
                &lt;entry key=&quot;signaturePropFile&quot; value=&quot;interop.properties&quot;/&gt;<br/>
                &lt;entry key=&quot;decryptionPropFile&quot; value=&quot;interop.properties&quot;/&gt;<br/>
                &lt;entry key=&quot;passwordCallbackClass&quot; value=&quot;net.worldticket.myIdTravel.PasswordCallback&quot;/&gt;<br/>
            &lt;/map&gt;<br/>
        &lt;/constructor-arg&gt;<br/>
    &lt;/bean&gt;<br/>
<br/>
    &lt;!--<br/>
         WSS4JOutInterceptor for encoding and signing the SOAP response.<br/>
    --&gt;<br/>
    &lt;bean<br/>
        id=&quot;TimestampSignEncrypt_Response&quot;<br/>
        class=&quot;org.apache.cxf.ws.security.wss4j.WSS4JOutInterceptor&quot;&gt;<br/>
        &lt;constructor-arg&gt;<br/>
            &lt;map&gt;<br/>
                &lt;entry key=&quot;action&quot; value=&quot;Signature Encrypt Timestamp&quot;/&gt;<br/>
                &lt;entry key=&quot;user&quot; value=&quot;useReqSigCert&quot;/&gt;<br/>
                &lt;entry key=&quot;signatureUser&quot; value=&quot;bob&quot;/&gt;<br/>
                &lt;entry key=&quot;signaturePropFile&quot; value=&quot;interop.properties&quot;/&gt;<br/>
                &lt;entry key=&quot;encryptionPropFile&quot; value=&quot;interop.properties&quot;/&gt;<br/>
                &lt;entry key=&quot;passwordCallbackClass&quot; value=&quot;net.worldticket.myIdTravel.PasswordCallback&quot;/&gt;<br/>
                &lt;entry key=&quot;signatureParts&quot; value=&quot;{Element}{http://schemas.xmlsoap.org/soap/envelope/}Body;{Element}{http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd}Timestamp&quot;/&gt;<br/>
                &lt;entry key=&quot;encryptionParts&quot; value=&quot;{Content}{http://schemas.xmlsoap.org/soap/envelope/}Body&quot;/&gt;<br/>
                &lt;entry key=&quot;encryptionSymAlgorithm&quot; value=&quot;http://www.w3.org/2001/04/xmlenc#tripledes-cbc&quot;/&gt;<br/>
                &lt;entry key=&quot;encryptionKeyTransportAlgorithm&quot; value=&quot;http://www.w3.org/2001/04/xmlenc#rsa-1_5&quot;/&gt;<br/>
                &lt;entry key=&quot;encryptionKeyIdentifier&quot; value=&quot;Thumbprint&quot;/&gt;<br/>
                &lt;entry key=&quot;signatureKeyIdentifier&quot; value=&quot;Thumbprint&quot;/&gt;<br/>
            &lt;/map&gt;<br/>
        &lt;/constructor-arg&gt;<br/>
    &lt;/bean&gt;<br/>
<br/>
    &lt;!-- JAX-WS Service Endpoint --&gt;<br/>
    &lt;jaxws:endpoint id=&quot;resadapter&quot; implementor=&quot;#RESAdapterService&quot; address=&quot;/resadapter&quot;&gt;<br/>
        &lt;jaxws:outInterceptors&gt;<br/>
             &lt;ref bean=&quot;logOutInterceptor&quot;/&gt;<br/>
             &lt;ref bean=&quot;TimestampSignEncrypt_Response&quot;/&gt;<br/>
         &lt;/jaxws:outInterceptors&gt;<br/>
         &lt;jaxws:inInterceptors&gt;<br/>
             &lt;ref bean=&quot;logInInterceptor&quot;/&gt;<br/>
             &lt;ref bean=&quot;TimestampSignEncrypt_Request&quot;/&gt;<br/>
         &lt;/jaxws:inInterceptors&gt;<br/>
        &lt;jaxws:features&gt;<br/>
            &lt;wsa:addressing allowDuplicates=&quot;false&quot;/&gt;<br/>
        &lt;/jaxws:features&gt;<br/>
    &lt;/jaxws:endpoint&gt;<br/>
