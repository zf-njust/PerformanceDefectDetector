    <a class="issue-link" data-issue-key="CXF-4280" href="https://issues.apache.org/jira/browse/CXF-4280">CXF-4280</a>
</td>
                                            <td class="summary"><p>
                case insensitive MetadataMap keyset
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Romain Manni-Bucau
    </td>
                                            <td class="creator">            Romain Manni-Bucau
    </td>
                                            <td class="created"> 01/May/12 21:53 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Jun/12 13:31 </td>
                                            <td class="resolutiondate"> 03/May/12 22:19 </td>
                                            <td class="versions">                        2.5.3            </td>
                                            <td class="fixVersions">                        2.3.11,                     2.4.8,                     2.5.4,                     2.6.1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
