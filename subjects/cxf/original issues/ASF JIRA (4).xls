                <tr id="issuerow12614820" rel="12614820" data-issuekey="CXF-4614" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4614" href="https://issues.apache.org/jira/browse/CXF-4614">CXF-4614</a>
</td>
                                            <td class="summary"><p>
                Error using role, tokenService and ValidationService when initialize client AccessTokenValidation.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Guillaume BARTHE
    </td>
                                            <td class="creator">            Guillaume BARTHE
    </td>
                                            <td class="created"> 05/Nov/12 16:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/12 14:38 </td>
                                            <td class="resolutiondate"> 05/Nov/12 21:06 </td>
                                            <td class="versions">                        2.7            </td>
                                            <td class="fixVersions">                        2.6.4,                     2.7.1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
