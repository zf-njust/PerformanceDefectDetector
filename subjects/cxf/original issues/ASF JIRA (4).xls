</td>
                                            <td class="summary"><p>
                Downgrade the log level from INFO to FINE in the methods buildServiceFromWSDL and buildServiceFromClass in the org.apache.cxf.service.factory.ReflectionServiceFactoryBean
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Alan Yang
    </td>
                                            <td class="creator">            Alan Yang
    </td>
                                            <td class="created"> 14/Mar/13 10:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Apr/13 15:19 </td>
                                            <td class="resolutiondate"> 15/Mar/13 03:52 </td>
                                            <td class="versions">    &nbsp;
</td>
