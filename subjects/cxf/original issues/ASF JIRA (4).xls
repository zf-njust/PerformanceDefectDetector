                <tr id="issuerow12628082" rel="12628082" data-issuekey="CXF-4763" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4763" href="https://issues.apache.org/jira/browse/CXF-4763">CXF-4763</a>
</td>
                                            <td class="summary"><p>
                Http conduit configuration overriding.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Siarhei Krukau
    </td>
                                            <td class="creator">            Siarhei Krukau
    </td>
                                            <td class="created"> 17/Jan/13 18:49 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Jan/13 17:58 </td>
                                            <td class="resolutiondate"> 25/Jan/13 17:15 </td>
                                            <td class="versions">                        2.7.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Bus,                     JAX-WS Runtime,                     Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
