                <tr id="issuerow12602072" rel="12602072" data-issuekey="CXF-4457" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4457" href="https://issues.apache.org/jira/browse/CXF-4457">CXF-4457</a>
</td>
                                            <td class="summary"><p>
                Extend WS-SecureConversation to support SAML Assertions for authentication
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Glen Mazza
    </td>
                                            <td class="creator">            Glen Mazza
    </td>
                                            <td class="created"> 07/Aug/12 18:39 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Aug/13 15:49 </td>
                                            <td class="resolutiondate"> 26/Jun/13 10:10 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.7.6            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">2</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
