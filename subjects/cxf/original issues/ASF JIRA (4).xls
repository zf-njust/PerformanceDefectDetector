    <a class="issue-link" data-issue-key="CXF-4673" href="https://issues.apache.org/jira/browse/CXF-4673">CXF-4673</a>
</td>
                                            <td class="summary"><p>
                [OAuth2] Add requestedScope as a parameter to getPreauthorizedToken
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Steven Tippetts
    </td>
