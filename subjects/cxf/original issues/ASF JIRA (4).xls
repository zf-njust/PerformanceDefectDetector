    <a class="issue-link" data-issue-key="CXF-4539" href="https://issues.apache.org/jira/browse/CXF-4539">CXF-4539</a>
</td>
                                            <td class="summary"><p>
                WS-Security inbound performance regression
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 03/Oct/12 09:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Nov/12 17:14 </td>
                                            <td class="resolutiondate"> 03/Oct/12 09:51 </td>
                                            <td class="versions">                        2.4.9,                     2.5.5,                     2.6.2            </td>
                                            <td class="fixVersions">                        2.4.10,                     2.5.6,                     2.6.3            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
