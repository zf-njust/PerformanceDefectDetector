                <tr id="issuerow12615229" rel="12615229" data-issuekey="CXF-4621" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4621" href="https://issues.apache.org/jira/browse/CXF-4621">CXF-4621</a>
</td>
                                            <td class="summary"><p>
                CXF breaks Javax.mail 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Stefano Bertini
    </td>
                                            <td class="creator">            Stefano Bertini
    </td>
                                            <td class="created"> 07/Nov/12 21:08 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/12 14:40 </td>
                                            <td class="resolutiondate"> 05/Dec/12 16:01 </td>
                                            <td class="versions">                        2.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
