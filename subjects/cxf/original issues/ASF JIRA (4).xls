                                            <td class="versions">                        2.6.1            </td>
                                            <td class="fixVersions">                        2.6.1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
