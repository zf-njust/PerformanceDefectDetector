                                            <td class="resolutiondate"> 27/Feb/13 17:29 </td>
                                            <td class="versions">                        2.7.3            </td>
                                            <td class="fixVersions">                        2.7.4,                     2.6.7,                     2.5.10            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
