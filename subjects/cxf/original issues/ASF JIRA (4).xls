                                            <td class="environment"></td>
                                            <td class="description">      This is useful for processing generic responses, example,<br/>
{code:java}<br/>
GenericType&lt;List&lt;Book&gt;&gt; genericResponseType = new GenericType&lt;List&lt;Book&gt;&gt;() {};<br/>
<br/>
List&lt;Book&gt; books = webClient.get(genericResponseType);<br/>
// or<br/>
<br/>
List&lt;Book&gt; books = webClient.post(someObject, genericResponseType);<br/>
<br/>
{code}
