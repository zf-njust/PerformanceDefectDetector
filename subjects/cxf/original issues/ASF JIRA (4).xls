</td>
                                            <td class="summary"><p>
                Improve &quot;No namespace on &quot;{0}&quot; element&quot; error message.
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
