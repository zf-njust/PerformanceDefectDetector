                <tr id="issuerow12633587" rel="12633587" data-issuekey="CXF-4848" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4848" href="https://issues.apache.org/jira/browse/CXF-4848">CXF-4848</a>
</td>
                                            <td class="summary"><p>
                WebClient does not process GenericEntity correctly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Sergey Beryozkin
    </td>
                                            <td class="creator">            Sergey Beryozkin
    </td>
                                            <td class="created"> 22/Feb/13 10:30 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Apr/13 15:15 </td>
                                            <td class="resolutiondate"> 22/Feb/13 21:37 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.7.4,                     2.6.7,                     2.5.10,                     3.0.0-milestone1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      GenericEntity is JAX-RS 1.0 class which can be used to write explicit collection or other generic class instances, example:<br/>
<br/>
{code:java} <br/>
GenericEntity&lt;List&lt;Book&gt;&gt; genericEntity = <br/>
            new GenericEntity&lt;List&lt;Book&gt;&gt;(books) {<br/>
            };<br/>
{code}<br/>
or<br/>
{code:java}<br/>
<br/>
class Representation&lt;T&gt; {<br/>
 private T data;<br/>
 public Representation(T data) {<br/>
     this.data = data;<br/>
 }<br/>
}<br/>
<br/>
Representation&lt;Book&gt; rep = new Representation&lt;Book&gt;(new Book());<br/>
<br/>
GenericEntity&lt;Representation&lt;Book&gt;&gt; genericEntity2 = <br/>
   new GenericEntity&lt;Representation&lt;Book&gt;&gt;(rep, Book.class);<br/>
<br/>
{code}<br/>
<br/>
This is supported on the server, when writing responses, but not with WebClient
  </td>
