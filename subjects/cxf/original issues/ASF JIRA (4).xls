    <a class="issue-link" data-issue-key="CXF-4135" href="https://issues.apache.org/jira/browse/CXF-4135">CXF-4135</a>
</td>
                                            <td class="summary"><p>
                Allow xsd shema file as a jaxb binding file to pass into JAXB schmeCompiler
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
