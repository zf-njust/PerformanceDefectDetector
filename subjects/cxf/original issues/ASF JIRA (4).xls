                                            <td class="customfield_12310060">    Advanced
</td>
                                            <td class="customfield_12310220"></td>
                                            <td class="customfield_12312322"></td>
                                            <td class="customfield_12312520"></td>
                                            <td class="customfield_12312323"></td>
                                            <td class="customfield_12312521">    4 years, 40 weeks, 3 days ago

                        </td>
                                            <td class="customfield_12312320"></td>
                                            <td class="customfield_12310420">      250017
