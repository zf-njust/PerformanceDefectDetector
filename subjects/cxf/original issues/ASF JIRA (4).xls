                <tr id="issuerow12640766" rel="12640766" data-issuekey="CXF-4945" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4945" href="https://issues.apache.org/jira/browse/CXF-4945">CXF-4945</a>
</td>
                                            <td class="summary"><p>
                NoClassDefFoundError error when using ClientProxyImpl 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Johann Vanackere
    </td>
                                            <td class="creator">            Johann Vanackere
    </td>
                                            <td class="created"> 04/Apr/13 13:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Jul/13 08:32 </td>
                                            <td class="resolutiondate"> 04/Apr/13 13:50 </td>
                                            <td class="versions">                        2.7.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The ClientProxyImpl class in JAXRS frontend still uses javax.ws.rs.client.ClientException. But it seems that ClientException has been removed from javax.ws.rs-api 2.0-rc2. So when I run my JAXRS client I get the following stack :<br/>
<br/>
{noformat}<br/>
Caused by: java.lang.NoClassDefFoundError: javax/ws/rs/client/ClientException<br/>
	at org.apache.cxf.jaxrs.client.JAXRSClientFactoryBean.createWithValues(JAXRSClientFactoryBean.java:288) ~[cxf-rt-frontend-jaxrs-2.7.4.jar:2.7.4]<br/>
	at org.apache.cxf.jaxrs.client.JAXRSClientFactoryBean.create(JAXRSClientFactoryBean.java:251) ~[cxf-rt-frontend-jaxrs-2.7.4.jar:2.7.4]<br/>
	at sun.reflect.NativeMethodAccessorImpl.invoke0(Native Method) ~[na:1.6.0_41]<br/>
	at sun.reflect.NativeMethodAccessorImpl.invoke(NativeMethodAccessorImpl.java:39) ~[na:1.6.0_41]<br/>
	at sun.reflect.DelegatingMethodAccessorImpl.invoke(DelegatingMethodAccessorImpl.java:25) ~[na:1.6.0_41]<br/>
	at java.lang.reflect.Method.invoke(Method.java:597) ~[na:1.6.0_41]<br/>
	at org.springframework.beans.factory.support.SimpleInstantiationStrategy.instantiate(SimpleInstantiationStrategy.java:160) ~[spring-beans-3.1.3.RELEASE.jar:3.1.3.RELEASE]<br/>
	... 41 common frames omitted<br/>
Caused by: java.lang.ClassNotFoundException: javax.ws.rs.client.ClientException<br/>
	at java.net.URLClassLoader$1.run(URLClassLoader.java:202) ~[na:1.6.0_41]<br/>
	at java.security.AccessController.doPrivileged(Native Method) ~[na:1.6.0_41]<br/>
	at java.net.URLClassLoader.findClass(URLClassLoader.java:190) ~[na:1.6.0_41]<br/>
	at java.lang.ClassLoader.loadClass(ClassLoader.java:306) ~[na:1.6.0_41]<br/>
	at sun.misc.Launcher$AppClassLoader.loadClass(Launcher.java:301) ~[na:1.6.0_41]<br/>
	at java.lang.ClassLoader.loadClass(ClassLoader.java:247) ~[na:1.6.0_41]<br/>
	... 48 common frames omitted<br/>
{noformat}<br/>
<br/>
Did I miss something ?
