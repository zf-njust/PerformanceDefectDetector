    <a class="issue-link" data-issue-key="CXF-5071" href="https://issues.apache.org/jira/browse/CXF-5071">CXF-5071</a>
</td>
                                            <td class="summary"><p>
                Async Http transport: Injecting an sslSocketFactory in the tlsClientParameters has no effect 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
