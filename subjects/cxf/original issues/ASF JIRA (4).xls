    <a class="issue-link" data-issue-key="CXF-4249" href="https://issues.apache.org/jira/browse/CXF-4249">CXF-4249</a>
</td>
                                            <td class="summary"><p>
                Add to RMTxStore configuration options for schema name and datasource
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
