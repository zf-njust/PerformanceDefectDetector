    <a class="issue-link" data-issue-key="CXF-4688" href="https://issues.apache.org/jira/browse/CXF-4688">CXF-4688</a>
</td>
                                            <td class="summary"><p>
                Missing close() call on xmlStreamReader
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
