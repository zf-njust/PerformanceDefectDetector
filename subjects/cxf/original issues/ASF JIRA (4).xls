                <tr id="issuerow12626576" rel="12626576" data-issuekey="CXF-4736" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4736" href="https://issues.apache.org/jira/browse/CXF-4736">CXF-4736</a>
</td>
                                            <td class="summary"><p>
                Bundles cannot be deployed in non Aries Blueprint Container
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
