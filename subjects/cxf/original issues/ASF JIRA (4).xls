    <a class="issue-link" data-issue-key="CXF-4140" href="https://issues.apache.org/jira/browse/CXF-4140">CXF-4140</a>
</td>
                                            <td class="summary"><p>
                WS-BrokeredNotification Compliance PublisherReference
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Alex O&#39;Ree
    </td>
                                            <td class="creator">            Alex O&#39;Ree
    </td>
                                            <td class="created"> 26/Feb/12 02:43 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Apr/12 16:45 </td>
                                            <td class="resolutiondate"> 09/Mar/12 18:36 </td>
                                            <td class="versions">                        2.5.2            </td>
                                            <td class="fixVersions">                        2.5.3            </td>
