    </td>
                                            <td class="creator">            Gary Gregory
    </td>
                                            <td class="created"> 20/Aug/12 18:39 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Nov/12 17:14 </td>
                                            <td class="resolutiondate"> 22/Aug/12 08:06 </td>
                                            <td class="versions">                        2.6.1            </td>
                                            <td class="fixVersions">                        2.4.10,                     2.5.6,                     2.6.3,                     2.7            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
