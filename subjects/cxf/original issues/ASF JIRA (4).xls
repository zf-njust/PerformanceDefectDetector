</td>
                                            <td class="summary"><p>
                Remove DynamicImport from jaxb databinding
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Christian Schneider
    </td>
                                            <td class="creator">            Christian Schneider
    </td>
                                            <td class="created"> 10/Feb/12 08:31 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Apr/12 16:45 </td>
                                            <td class="resolutiondate"> 10/Apr/12 20:30 </td>
                                            <td class="versions">                        2.5.2            </td>
                                            <td class="fixVersions">                        2.6            </td>
