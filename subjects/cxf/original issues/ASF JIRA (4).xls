                <tr id="issuerow12609076" rel="12609076" data-issuekey="CXF-4521" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4521" href="https://issues.apache.org/jira/browse/CXF-4521">CXF-4521</a>
</td>
                                            <td class="summary"><p>
                Optimization for other stax implementations
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
