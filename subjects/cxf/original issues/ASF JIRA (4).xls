    <a class="issue-link" data-issue-key="CXF-4982" href="https://issues.apache.org/jira/browse/CXF-4982">CXF-4982</a>
</td>
                                            <td class="summary"><p>
                Codegen maven plugin fails forked execution on Windows XP environment
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Jeroen Benckhuijsen
    </td>
                                            <td class="creator">            Jeroen Benckhuijsen
    </td>
                                            <td class="created"> 24/Apr/13 08:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Aug/13 15:50 </td>
                                            <td class="resolutiondate"> 03/May/13 07:39 </td>
                                            <td class="versions">                        2.6.7            </td>
                                            <td class="fixVersions">                        2.6.8,                     2.7.5,                     2.5.11,                     3.0.0-milestone1            </td>
