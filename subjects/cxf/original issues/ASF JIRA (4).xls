                <tr id="issuerow12541952" rel="12541952" data-issuekey="CXF-4095" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4095" href="https://issues.apache.org/jira/browse/CXF-4095">CXF-4095</a>
</td>
                                            <td class="summary"><p>
                schemaLocation attribute for swaRef namespace &quot;http://ws-i.org/profiles/basic/1.1/xsd&quot;  is wrongly removed 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            Jim Ma
    </td>
                                            <td class="creator">            Jim Ma
    </td>
                                            <td class="created"> 09/Feb/12 10:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Apr/12 16:45 </td>
                                            <td class="resolutiondate"> 09/Feb/12 10:38 </td>
                                            <td class="versions">                        2.4.6,                     2.5.2            </td>
                                            <td class="fixVersions">                        2.4.7,                     2.5.3,                     2.6            </td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      The schemaLocation for swaRef namespace is wrongly removed in the wsdl generated from class:<br/>
<br/>
@WebService<br/>
public interface AddNumbers {<br/>
    @WebMethod<br/>
    int addNumbers(@WebParam<br/>
                   @XmlAttachmentRef<br/>
                   DataHandler body);<br/>
}<br/>
<br/>
This schema is expected:<br/>
<br/>
&lt;xs:schema version=&quot;1.0&quot; targetNamespace=&quot;http://attachment.apache.org/&quot; xmlns:tns=&quot;http://attachment.apache.org/&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:swaRef=&quot;http://ws-i.org/profiles/basic/1.1/xsd&quot;&gt;<br/>
<br/>
  &lt;xs:import namespace=&quot;http://ws-i.org/profiles/basic/1.1/xsd&quot; schemaLocation=&quot;http://ws-i.org/profiles/basic/1.1/swaref.xsd&quot;/&gt;<br/>
  &lt;xs:element name=&quot;addNumbers&quot; type=&quot;tns:addNumbers&quot;/&gt;<br/>
<br/>
  &lt;xs:element name=&quot;addNumbersResponse&quot; type=&quot;tns:addNumbersResponse&quot;/&gt;<br/>
<br/>
  &lt;xs:complexType name=&quot;addNumbers&quot;&gt;<br/>
    &lt;xs:sequence&gt;<br/>
      &lt;xs:element name=&quot;arg0&quot; type=&quot;swaRef:swaRef&quot; minOccurs=&quot;0&quot;/&gt;<br/>
    &lt;/xs:sequence&gt;<br/>
  &lt;/xs:complexType&gt;<br/>
<br/>
  &lt;xs:complexType name=&quot;addNumbersResponse&quot;&gt;<br/>
    &lt;xs:sequence&gt;<br/>
      &lt;xs:element name=&quot;return&quot; type=&quot;xs:int&quot;/&gt;<br/>
    &lt;/xs:sequence&gt;<br/>
  &lt;/xs:complexType&gt;<br/>
&lt;/xs:schema&gt;
  </td>
                                            <td class="description"></td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
