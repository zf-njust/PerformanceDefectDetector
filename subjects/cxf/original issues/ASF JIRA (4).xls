                <tr id="issuerow12652045" rel="12652045" data-issuekey="CXF-5075" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5075" href="https://issues.apache.org/jira/browse/CXF-5075">CXF-5075</a>
</td>
                                            <td class="summary"><p>
                Support for chain trust validation
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andrei Shakirin
    </td>
                                            <td class="reporter">            Achim Finke
    </td>
                                            <td class="creator">            Achim Finke
    </td>
                                            <td class="created"> 10/Jun/13 15:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Nov/13 17:39 </td>
                                            <td class="resolutiondate"> 17/Jun/13 08:14 </td>
                                            <td class="versions">                        3.0.0-milestone1            </td>
                                            <td class="fixVersions">                        3.0.0-milestone1            </td>
                                            <td class="components">                        Services            </td>
