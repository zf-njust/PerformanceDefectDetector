</td>
                                            <td class="summary"><p>
                i am getting timout error while creating webservice client using jaxWsProxyFactoryBean using spring
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Incomplete
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            jai
    </td>
                                            <td class="creator">            jai
    </td>
                                            <td class="created"> 08/Aug/12 15:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Apr/13 15:19 </td>
                                            <td class="resolutiondate"> 07/Mar/13 17:28 </td>
                                            <td class="versions">                        2.6.1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">86400</td>
                                            <td class="timeestimate">86400</td>
                                            <td class="timespent"></td>
