                <tr id="issuerow12624844" rel="12624844" data-issuekey="CXF-4716" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4716" href="https://issues.apache.org/jira/browse/CXF-4716">CXF-4716</a>
</td>
                                            <td class="summary"><p>
                WS-security policies enforcement with CXF server, bad policy selected
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
