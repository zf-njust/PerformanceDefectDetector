</td>
                                            <td class="summary"><p>
                EncryptedSupportingTokens used with EncryptBeforeSigning does not encrypt Username token
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Syed Abdul Wadood
    </td>
                                            <td class="creator">            Syed Abdul Wadood
    </td>
                                            <td class="created"> 29/May/13 15:49 </td>
                                            <td class="lastViewed"> &nbsp; </td>
