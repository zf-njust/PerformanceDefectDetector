                &lt;executions&gt;<br/>
                    &lt;execution&gt;<br/>
                        &lt;id&gt;generate-sources&lt;/id&gt;<br/>
                        &lt;configuration&gt;<br/>
                            &lt;fork&gt;once&lt;/fork&gt;<br/>
                            &lt;sourceRoot&gt;target/generated-sources/cxf&lt;/sourceRoot&gt;<br/>
