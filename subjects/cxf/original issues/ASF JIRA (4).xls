                <tr id="issuerow12545368" rel="12545368" data-issuekey="CXF-4165" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4165" href="https://issues.apache.org/jira/browse/CXF-4165">CXF-4165</a>
</td>
                                            <td class="summary"><p>
                Allow encrypted password storage in signaturePropFile
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Vandan Juvekar
    </td>
                                            <td class="creator">            Vandan Juvekar
    </td>
                                            <td class="created"> 06/Mar/12 16:53 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Mar/17 06:55 </td>
                                            <td class="resolutiondate"> 28/Mar/17 06:55 </td>
