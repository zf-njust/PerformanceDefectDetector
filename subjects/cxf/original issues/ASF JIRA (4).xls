                                    &lt;extraargs&gt;<br/>
                                        &lt;extraarg&gt;-xjc-Xts&lt;/extraarg&gt;<br/>
                                    &lt;/extraargs&gt;<br/>
                                &lt;/wsdlOption&gt;<br/>
                            &lt;/wsdlOptions&gt;<br/>
                        &lt;/configuration&gt;<br/>
                        &lt;goals&gt;<br/>
