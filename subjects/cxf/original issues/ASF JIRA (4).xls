    <a class="issue-link" data-issue-key="CXF-4935" href="https://issues.apache.org/jira/browse/CXF-4935">CXF-4935</a>
</td>
                                            <td class="summary"><p>
                (PATCH) Expose FastInfoset serializer tuning properties
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
