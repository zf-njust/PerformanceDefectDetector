                <tr id="issuerow12467862" rel="12467862" data-issuekey="CXF-2860" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2860" href="https://issues.apache.org/jira/browse/CXF-2860">CXF-2860</a>
</td>
                                            <td class="summary"><p>
                Handle the soap fault inbound message in server side
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            Jim Ma
    </td>
                                            <td class="creator">            Jim Ma
    </td>
                                            <td class="created"> 25/Jun/10 06:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 14:45 </td>
                                            <td class="resolutiondate"> 28/Jun/10 06:18 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.2.10,                     2.3            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      When using WSA, the service is configured a FaultTo endpoint which is not the same as the From endpoint ,  and it is another endpoint in CXF.  This requires CXF Interceptors do not treat this as a soapFault message and route it in the normal soap request process.
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
