    </td>
                                            <td class="creator">            Roman Kalukiewicz
    </td>
                                            <td class="created"> 26/Mar/09 15:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Apr/09 21:17 </td>
                                            <td class="resolutiondate"> 26/Mar/09 19:59 </td>
                                            <td class="versions">                        2.2            </td>
                                            <td class="fixVersions">                        2.2.1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
