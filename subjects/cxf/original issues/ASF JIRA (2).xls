                <tr id="issuerow12439284" rel="12439284" data-issuekey="CXF-2506" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2506" href="https://issues.apache.org/jira/browse/CXF-2506">CXF-2506</a>
</td>
                                            <td class="summary"><p>
                LoggingInInterceptor called twice if message is larger than 64 kb (when CachedOutStream writes to tempfile)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Laxmi Deepika Vadapalli
    </td>
                                            <td class="creator">            Laxmi Deepika Vadapalli
    </td>
                                            <td class="created"> 28/Oct/09 14:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Mar/11 21:43 </td>
                                            <td class="resolutiondate"> 11/Nov/09 20:36 </td>
                                            <td class="versions">                        2.1.5            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
