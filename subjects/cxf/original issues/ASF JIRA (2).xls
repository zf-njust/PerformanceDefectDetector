</td>
                                            <td class="summary"><p>
                Documentation: Provide complete set of application servers that Apache CXF runs on.
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Robert Liguori
    </td>
