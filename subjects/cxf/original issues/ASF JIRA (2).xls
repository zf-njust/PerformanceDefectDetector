			urn:uuid:b879526c-68c1-4713-8912-6ee23264715f&lt;/MessageID&gt;<br/>
		&lt;To xmlns=&quot;http://www.w3.org/2005/08/addressing&quot;&gt;<br/>
			https://host/ServiceModelSamples/service.svc/SSLA&lt;/To&gt;<br/>
