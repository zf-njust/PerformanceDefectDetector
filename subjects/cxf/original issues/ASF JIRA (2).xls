                &lt;ns2:SUBMITDATE&gt;&lt;/ns2:SUBMITDATE&gt;<br/>
                &lt;ns2:PAGE_SIZE&gt;&lt;/ns2:PAGE_SIZE&gt;<br/>
                &lt;ns2:CURRENT_PAGE&gt;&lt;/ns2:CURRENT_PAGE&gt;<br/>
                &lt;ns2:TOTAL_RECORD&gt;&lt;/ns2:TOTAL_RECORD&gt;<br/>
                &lt;ns2:PROVINCE_CODE&gt;&lt;/ns2:PROVINCE_CODE&gt;<br/>
                &lt;ns2:ENVIRONMENT_NAME&gt;&lt;/ns2:ENVIRONMENT_NAME&gt;<br/>
            &lt;/ns1:MsgHeader&gt;<br/>
            &lt;ns1:DOC_TYPE&gt;&lt;/ns1:DOC_TYPE&gt;<br/>
            &lt;ns1:VENDOR_NUMBER&gt;&lt;/ns1:VENDOR_NUMBER&gt;<br/>
            &lt;ns1:VENDOR_NAME&gt;&lt;/ns1:VENDOR_NAME&gt;<br/>
            &lt;ns1:INVOICE_NUM&gt;&lt;/ns1:INVOICE_NUM&gt;<br/>
            &lt;ns1:INVOICE_AMOUNT&gt;&lt;/ns1:INVOICE_AMOUNT&gt;<br/>
            &lt;ns1:DOCUMENT_NUM&gt;&lt;/ns1:DOCUMENT_NUM&gt;<br/>
            &lt;ns1:CONTRACT_NUM&gt;&lt;/ns1:CONTRACT_NUM&gt;<br/>
            &lt;ns1:PROJECT_NUM&gt;&lt;/ns1:PROJECT_NUM&gt;<br/>
            &lt;ns1:LAST_UPDATE_DATE_FROM&gt;2008-11-19T17:01:32+08:00&lt;/ns1:LAST_UPDATE_DATE_FROM&gt;<br/>
            &lt;ns1:LAST_UPDATE_DATE_TO&gt;2008-11-19T17:01:32+08:00&lt;/ns1:LAST_UPDATE_DATE_TO&gt;<br/>
        &lt;/ns1:SB_FI_EAS_PageInquiryClaimDocInfoSrvRequest&gt;<br/>
    &lt;/soap:Body&gt;<br/>
&lt;/soap:Envelope&gt;<br/>
<br/>
org.apache.cxf.interceptor.Fault: Unmarshalling Error:  <br/>
	at org.apache.cxf.jaxb.JAXBEncoderDecoder.unmarshall(JAXBEncoderDecoder.java:773)<br/>
