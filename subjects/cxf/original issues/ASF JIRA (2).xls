    </td>
                                            <td class="creator">            Grégoire A.
    </td>
                                            <td class="created"> 10/Nov/09 18:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Nov/09 17:27 </td>
                                            <td class="resolutiondate"> 12/Nov/09 10:54 </td>
                                            <td class="versions">                        2.2.3            </td>
                                            <td class="fixVersions">                        2.2.4            </td>
                                            <td class="components">                        OtherDatabindings,                     Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
