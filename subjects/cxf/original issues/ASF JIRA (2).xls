                <tr id="issuerow12428524" rel="12428524" data-issuekey="CXF-2309" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2309" href="https://issues.apache.org/jira/browse/CXF-2309">CXF-2309</a>
</td>
                                            <td class="summary"><p>
                client gets extra &lt;return&gt; tags with org.w3c.dom.Document result
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Benson Margulies
    </td>
                                            <td class="reporter">            Yuriy Halytskyy
    </td>
                                            <td class="creator">            Yuriy Halytskyy
    </td>
                                            <td class="created"> 22/Jun/09 01:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Aug/09 20:07 </td>
                                            <td class="resolutiondate"> 16/Jul/09 18:10 </td>
                                            <td class="versions">                        2.2.2            </td>
                                            <td class="fixVersions">                        2.2.3            </td>
                                            <td class="components">                        Aegis Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
