                                            <td class="summary"><p>
                Facilitate multi-branch development in Eclipse
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
