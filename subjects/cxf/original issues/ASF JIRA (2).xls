                <tr id="issuerow12468426" rel="12468426" data-issuekey="CXF-2868" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2868" href="https://issues.apache.org/jira/browse/CXF-2868">CXF-2868</a>
</td>
                                            <td class="summary"><p>
                JAXB unmarshal error when the field  of  partTypeClass  is javax.xml.datatype.XMLGregorianCalendar
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            Jim Ma
    </td>
                                            <td class="creator">            Jim Ma
    </td>
                                            <td class="created"> 02/Jul/10 11:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 14:52 </td>
                                            <td class="resolutiondate"> 12/Jul/10 09:40 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.2.10            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
