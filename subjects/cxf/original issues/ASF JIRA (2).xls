</td>
                                            <td class="summary"><p>
                JAXWS2.2: Compute wsam:action value for SEI method annotated with empty @FaultAction(className=AddNumbersException.class, value=&quot;&quot;))
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            Jim Ma
    </td>
                                            <td class="creator">            Jim Ma
    </td>
                                            <td class="created"> 28/May/10 06:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 15:08 </td>
                                            <td class="resolutiondate"> 28/May/10 08:07 </td>
