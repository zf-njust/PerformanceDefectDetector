                <tr id="issuerow12470318" rel="12470318" data-issuekey="CXF-2916" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2916" href="https://issues.apache.org/jira/browse/CXF-2916">CXF-2916</a>
</td>
                                            <td class="summary"><p>
                unmarshalling the JSON of a subclass fails when a field value is null
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Chaitanya Choleti
    </td>
                                            <td class="creator">            Chaitanya Choleti
    </td>
                                            <td class="created"> 28/Jul/10 06:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Apr/11 12:44 </td>
                                            <td class="resolutiondate"> 08/Apr/11 12:56 </td>
                                            <td class="versions">                        2.2.9            </td>
                                            <td class="fixVersions">                        2.4,                     2.3.4            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">86400</td>
                                            <td class="timeestimate">86400</td>
                                            <td class="timespent"></td>
                                            <td class="workratio">            0%
    </td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Windows XP,  JDK 1.6.0_14
  </td>
                                            <td class="description">      Unmarshalling the JSON :<br/>
<br/>
{&quot;@xsi.type&quot; : &quot;subClassTest&quot;, &quot;id&quot; : &quot;10000000&quot;, &quot;name&quot; : null }<br/>
<br/>
should give an instance of SubClassTest.class and the value of the field name(which is a String) should be null, but with the current implementation the value of the field name is String &quot;null&quot; .<br/>
<br/>
This happens only in the case of unmarshalling JSON to a subclass.
  </td>
