</td>
                                            <td class="summary"><p>
                JAX-RS ClientProxy does not properly test consume types when setting request headers
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Leonard Lu
    </td>
                                            <td class="creator">            Leonard Lu
    </td>
                                            <td class="created"> 28/Aug/09 22:58 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Oct/09 20:45 </td>
                                            <td class="resolutiondate"> 29/Aug/09 18:35 </td>
                                            <td class="versions">                        2.2.3            </td>
                                            <td class="fixVersions">                        2.2.4,                     2.3            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
