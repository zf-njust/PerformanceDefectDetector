</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Codegen should respect VariableNamingConventions: http://pmd.sourceforge.net/rules/naming.html#VariableNamingConventions<br/>
<br/>
Example violations:<br/>
<br/>
Variables that are final and static should be in all caps.<br/>
<br/>
    private final static QName _InvalidParameterException_QNAME = new QName(&quot;java:de.osc.ewetel.scopusonline.common.exceptions&quot;, &quot;InvalidParameterException&quot;);<br/>
<br/>
    public final static QName MyPort = new QName(&quot;http://www.mydomain.de&quot;, &quot;MyPort&quot;);<br/>
<br/>
<br/>
Variables that are not final should not contain underscores (except for underscores in standard prefix/suffix).<br/>
<br/>
    @XmlElement(name = &quot;Boolean&quot;)<br/>
    protected boolean _boolean;
  </td>
