                <tr id="issuerow12422136" rel="12422136" data-issuekey="CXF-2159" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2159" href="https://issues.apache.org/jira/browse/CXF-2159">CXF-2159</a>
</td>
                                            <td class="summary"><p>
                Custom Schema Validator that allows for application faults to be thrown when a schema validation error occurs
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            John Pfeifer IV
    </td>
                                            <td class="creator">            John Pfeifer IV
    </td>
                                            <td class="created"> 06/Apr/09 16:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Oct/11 17:12 </td>
                                            <td class="resolutiondate"> 09/Sep/11 18:41 </td>
                                            <td class="versions">                        2.2            </td>
