</td>
                                            <td class="summary"><p>
                sets null instead of empty List/Set/SortedSet when value isn&#39;t in query string
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Brad Cupit
    </td>
                                            <td class="creator">            Brad Cupit
    </td>
