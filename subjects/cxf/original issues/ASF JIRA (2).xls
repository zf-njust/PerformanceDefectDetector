    <a class="issue-link" data-issue-key="CXF-2266" href="https://issues.apache.org/jira/browse/CXF-2266">CXF-2266</a>
</td>
                                            <td class="summary"><p>
                Problem with one-way operation - CXF cannot send fault message due to IOException 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Przemek Gadomski
    </td>
                                            <td class="creator">            Przemek Gadomski
    </td>
                                            <td class="created"> 08/Jun/09 09:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Jul/09 20:35 </td>
                                            <td class="resolutiondate"> 08/Jun/09 14:41 </td>
                                            <td class="versions">                        2.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Transports            </td>
