</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2459" href="https://issues.apache.org/jira/browse/CXF-2459">CXF-2459</a>
</td>
                                            <td class="summary"><p>
                Allow setting SecurityContext from JMS Message for Tibco JMS
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Christian Schneider
    </td>
                                            <td class="creator">            Christian Schneider
    </td>
                                            <td class="created"> 05/Oct/09 21:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jan/10 17:17 </td>
                                            <td class="resolutiondate"> 10/Jan/10 11:04 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.2.6            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
