    <a class="issue-link" data-issue-key="CXF-2287" href="https://issues.apache.org/jira/browse/CXF-2287">CXF-2287</a>
</td>
                                            <td class="summary"><p>
                codegen should respect VariableNamingConventions
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Dennis Kieselhorst
    </td>
                                            <td class="creator">            Dennis Kieselhorst
    </td>
                                            <td class="created"> 15/Jun/09 09:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Jul/09 20:35 </td>
                                            <td class="resolutiondate"> 30/Jun/09 17:42 </td>
                                            <td class="versions">                        2.2.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
