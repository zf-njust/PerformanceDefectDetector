                <tr id="issuerow12423889" rel="12423889" data-issuekey="CXF-2191" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2191" href="https://issues.apache.org/jira/browse/CXF-2191">CXF-2191</a>
</td>
                                            <td class="summary"><p>
                cxf-codegen plugin does not accept files with (upper-case) .WSDL extension
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            nicolas de loof
    </td>
                                            <td class="creator">            nicolas de loof
    </td>
                                            <td class="created"> 27/Apr/09 14:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Aug/09 20:06 </td>
                                            <td class="resolutiondate"> 10/Jul/09 16:03 </td>
                                            <td class="versions">                        2.2.1            </td>
                                            <td class="fixVersions">                        2.1.6,                     2.2.3            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
