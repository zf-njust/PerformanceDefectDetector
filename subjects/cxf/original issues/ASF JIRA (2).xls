                <tr id="issuerow12436505" rel="12436505" data-issuekey="CXF-2446" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2446" href="https://issues.apache.org/jira/browse/CXF-2446">CXF-2446</a>
</td>
                                            <td class="summary"><p>
                generate java.util.List collections for XMLElementWrappers
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            warren crossing
    </td>
                                            <td class="creator">            warren crossing
    </td>
                                            <td class="created"> 24/Sep/09 11:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:35 </td>
                                            <td class="resolutiondate"> 26/Oct/09 20:00 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      when generating code with the xew plugin you have to turn off <br/>
   &lt;jaxws:enableWrapperStyle&gt;false&lt;/jaxws:enableWrapperStyle&gt;<br/>
<br/>
otherwise the cxf proxy will fail at runtime with a class cast exception.<br/>
<br/>
could some extension be added to generate XMLElementWrappers with one and only one collection as java.util.List?<br/>
<br/>
&lt;plugin&gt;<br/>
                &lt;groupId&gt;org.apache.cxf&lt;/groupId&gt;<br/>
                &lt;artifactId&gt;cxf-codegen-plugin&lt;/artifactId&gt;<br/>
                &lt;version&gt;${cxfVersion}&lt;/version&gt;<br/>
                &lt;executions&gt;<br/>
                    &lt;execution&gt;<br/>
                        &lt;id&gt;cxf-shipment&lt;/id&gt;<br/>
                        &lt;phase&gt;generate-sources&lt;/phase&gt;<br/>
                        &lt;goals&gt;<br/>
                            &lt;goal&gt;wsdl2java&lt;/goal&gt;<br/>
                        &lt;/goals&gt;<br/>
                        &lt;configuration&gt;<br/>
                            &lt;sourceRoot&gt;${project.build.directory}/generated-sources/main&lt;/sourceRoot&gt;<br/>
                            &lt;wsdlOptions&gt;<br/>
                                &lt;wsdlOption&gt;<br/>
                                    &lt;wsdl&gt;${basedir}/src/main/resources/ShipmentService.wsdl&lt;/wsdl&gt;<br/>
                                    &lt;bindingFiles&gt;<br/>
                                        &lt;bindingFile&gt;${basedir}/src/main/resources/bindings-global.xml&lt;/bindingFile&gt;<br/>
                                    &lt;/bindingFiles&gt;<br/>
                                    &lt;extraargs&gt;<br/>
                                        &lt;arg&gt;-xjc-Xxew&lt;/arg&gt;<br/>
                                    &lt;/extraargs&gt;<br/>
                                &lt;/wsdlOption&gt;<br/>
                            &lt;/wsdlOptions&gt;<br/>
                        &lt;/configuration&gt;<br/>
                    &lt;/execution&gt;<br/>
                &lt;/executions&gt;<br/>
                &lt;configuration&gt;<br/>
                    &lt;defaultOptions&gt;<br/>
                        &lt;autoNameResolution&gt;true&lt;/autoNameResolution&gt;<br/>
                    &lt;/defaultOptions&gt;<br/>
                    &lt;verbose&gt;true&lt;/verbose&gt;<br/>
                &lt;/configuration&gt;<br/>
                &lt;dependencies&gt;<br/>
                    &lt;dependency&gt;<br/>
                        &lt;groupId&gt;dk.conspicio&lt;/groupId&gt;<br/>
                        &lt;artifactId&gt;xew&lt;/artifactId&gt;<br/>
                        &lt;version&gt;1.0.0&lt;/version&gt;<br/>
                        &lt;scope&gt;runtime&lt;/scope&gt;<br/>
                    &lt;/dependency&gt;<br/>
                &lt;/dependencies&gt;<br/>
            &lt;/plugin&gt;<br/>

  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
