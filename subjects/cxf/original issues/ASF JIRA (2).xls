    <a class="issue-link" data-issue-key="CXF-2560" href="https://issues.apache.org/jira/browse/CXF-2560">CXF-2560</a>
</td>
                                            <td class="summary"><p>
                WebClient doesns&#39;t read response body if status code means some error
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Roman Kalukiewicz
    </td>
                                            <td class="creator">            Roman Kalukiewicz
    </td>
