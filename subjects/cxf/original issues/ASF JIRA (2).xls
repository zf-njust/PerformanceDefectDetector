</td>
                                            <td class="summary"><p>
                Aegis roots cannot be generics
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Benson Margulies
    </td>
                                            <td class="reporter">            Benson Margulies
    </td>
                                            <td class="creator">            Benson Margulies
    </td>
                                            <td class="created"> 31/Aug/09 14:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 14:44 </td>
                                            <td class="resolutiondate"> 08/Sep/09 17:45 </td>
                                            <td class="versions">                        2.2.3            </td>
                                            <td class="fixVersions">                        2.3            </td>
                                            <td class="components">                        Aegis Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
