    <a class="issue-link" data-issue-key="CXF-2660" href="https://issues.apache.org/jira/browse/CXF-2660">CXF-2660</a>
</td>
                                            <td class="summary"><p>
                Cannot load WSDL from HTTPS URL if HTTPConduit configuration has AutoRedirect set to true
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            David Valeri
    </td>
