                <tr id="issuerow12423134" rel="12423134" data-issuekey="CXF-2178" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2178" href="https://issues.apache.org/jira/browse/CXF-2178">CXF-2178</a>
</td>
                                            <td class="summary"><p>
                HTTP headers (and thus cookies) are not settable from client request context
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
                                            <td class="created"> 17/Apr/09 15:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Apr/09 21:17 </td>
                                            <td class="resolutiondate"> 17/Apr/09 19:36 </td>
                                            <td class="versions">                        2.2            </td>
                                            <td class="fixVersions">                        2.2.1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
