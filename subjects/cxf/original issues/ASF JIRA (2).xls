                                            <td class="aggregatetimeestimate"></td>
                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    </td>
                                            <td class="customfield_12310060"></td>
                                            <td class="customfield_12310220">            <span title="16/Jun/10 11:37"><time class="livestamp allow-future" datetime="2010-06-16T11:37:33+0000">16/Jun/10 11:37 AM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
                                            <td class="customfield_12312520"></td>
                                            <td class="customfield_12312323"></td>
                                            <td class="customfield_12312521">    7 years, 6 weeks, 6 days ago

                        </td>
