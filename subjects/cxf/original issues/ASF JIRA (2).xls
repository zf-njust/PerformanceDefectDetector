                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Jun/09 21:34 </td>
                                            <td class="resolutiondate"> 15/May/09 05:29 </td>
                                            <td class="versions">                        2.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
