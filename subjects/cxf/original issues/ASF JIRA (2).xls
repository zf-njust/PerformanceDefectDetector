</td>
                                            <td class="summary"><p>
                Invalid method is used to get the value of the xml:lang attribute in the SOAP1.2 Text Element
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            s.ohtsuka
    </td>
                                            <td class="creator">            s.ohtsuka
    </td>
                                            <td class="created"> 08/Mar/10 17:08 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Mar/10 02:59 </td>
                                            <td class="resolutiondate"> 09/Mar/10 02:14 </td>
                                            <td class="versions">                        2.2.6            </td>
                                            <td class="fixVersions">                        2.2.7            </td>
                                            <td class="components">                        Soap Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
