    <a class="issue-link" data-issue-key="CXF-2268" href="https://issues.apache.org/jira/browse/CXF-2268">CXF-2268</a>
</td>
                                            <td class="summary"><p>
                Collapse Atom Feed and Entry providers and support Atom reflectively
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Sergey Beryozkin
    </td>
