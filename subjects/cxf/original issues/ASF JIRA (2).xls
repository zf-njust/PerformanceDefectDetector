    <a class="issue-link" data-issue-key="CXF-2845" href="https://issues.apache.org/jira/browse/CXF-2845">CXF-2845</a>
</td>
                                            <td class="summary"><p>
                JAXWS2.2: Implement new added HTTP SPI APIs
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Alessio Soldano
    </td>
                                            <td class="reporter">            Jim Ma
    </td>
                                            <td class="creator">            Jim Ma
    </td>
                                            <td class="created"> 11/Jun/10 09:57 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 14:45 </td>
                                            <td class="resolutiondate"> 30/Aug/10 16:10 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.3            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
