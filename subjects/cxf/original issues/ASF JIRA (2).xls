    <a class="issue-link" data-issue-key="CXF-2553" href="https://issues.apache.org/jira/browse/CXF-2553">CXF-2553</a>
</td>
                                            <td class="summary"><p>
                WS-Security UsernameToken sample using WS-SecurityPolicy
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Oliver Wulff
    </td>
                                            <td class="creator">            Oliver Wulff
    </td>
                                            <td class="created"> 20/Nov/09 16:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Feb/10 19:02 </td>
                                            <td class="resolutiondate"> 04/Dec/09 19:35 </td>
                                            <td class="versions">                        2.2            </td>
                                            <td class="fixVersions">                        2.2.6            </td>
                                            <td class="components">    &nbsp;
</td>
