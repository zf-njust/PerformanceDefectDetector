                <tr id="issuerow12469368" rel="12469368" data-issuekey="CXF-2898" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2898" href="https://issues.apache.org/jira/browse/CXF-2898">CXF-2898</a>
</td>
                                            <td class="summary"><p>
                Support jetty version 7
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Benson Margulies
    </td>
                                            <td class="reporter">            Benson Margulies
    </td>
                                            <td class="creator">            Benson Margulies
    </td>
                                            <td class="created"> 15/Jul/10 18:27 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 14:45 </td>
                                            <td class="resolutiondate"> 11/Aug/10 11:33 </td>
                                            <td class="versions">                        2.2.9            </td>
                                            <td class="fixVersions">                        2.3            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      It would be convenient to be able to use jetty 7. I think that this requires a new transport, since the dependency structure is changed, so I don&#39;t see an easy way to make a single transport module do both.<br/>

  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
                                            <td class="aggregatetimeestimate"></td>
