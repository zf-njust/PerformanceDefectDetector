</td>
                                            <td class="summary"><p>
                Server accepts an unsigned message when the policy requires a signed message.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Mary Thompson
    </td>
                                            <td class="creator">            Mary Thompson
    </td>
                                            <td class="created"> 29/May/09 06:32 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:34 </td>
                                            <td class="resolutiondate"> 13/Nov/09 16:49 </td>
                                            <td class="versions">                        2.2.1            </td>
                                            <td class="fixVersions">                        2.2.5            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
