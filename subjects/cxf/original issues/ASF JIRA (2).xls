cxf-extension-soap.xml<br/>
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------<br/>
&lt;beans xmlns=&quot;http://www.springframework.org/schema/beans&quot;<br/>
       xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;<br/>
       xmlns:foo=&quot;http://cxf.apache.org/configuration/foo&quot;<br/>
       xsi:schemaLocation=&quot;<br/>
http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd&quot;&gt;<br/>
    <br/>
    &lt;bean id=&quot;org.apache.cxf.binding.soap.SoapBindingFactory&quot;<br/>
	  class=&quot;org.apache.cxf.binding.soap.SoapBindingFactory&quot; lazy-init=&quot;true&quot;&gt;<br/>
        &lt;property name=&quot;activationNamespaces&quot;&gt;<br/>
            &lt;set&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/soap/&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/wsdl/soap/&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/wsdl/soap12/&lt;/value&gt;<br/>
                &lt;value&gt;http://www.w3.org/2003/05/soap/bindings/HTTP/&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/wsdl/soap/http&lt;/value&gt;<br/>
            &lt;/set&gt;<br/>
        &lt;/property&gt;<br/>
        &lt;property name=&quot;bus&quot; ref=&quot;cxf&quot;/&gt;<br/>
    &lt;/bean&gt;<br/>
    <br/>
    &lt;bean class=&quot;org.apache.cxf.binding.soap.SoapTransportFactory&quot;<br/>
	  id=&quot;org.apache.cxf.binding.soap.SoapTransportFactory&quot;<br/>
	  lazy-init=&quot;true&quot;&gt;<br/>
        &lt;property name=&quot;transportIds&quot;&gt;<br/>
            &lt;list&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/soap/&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/wsdl/soap/&lt;/value&gt;<br/>
	        &lt;value&gt;http://schemas.xmlsoap.org/wsdl/soap12/&lt;/value&gt;<br/>
            &lt;/list&gt;<br/>
        &lt;/property&gt;<br/>
        &lt;property name=&quot;bus&quot; ref=&quot;cxf&quot;/&gt;<br/>
    &lt;/bean&gt;<br/>
        <br/>
	&lt;bean id=&quot;org.apache.cxf.binding.soap.customEditorConfigurer&quot;<br/>
		class=&quot;org.springframework.beans.factory.config.CustomEditorConfigurer&quot;&gt;<br/>
		&lt;property name=&quot;propertyEditorRegistrars&quot;&gt;<br/>
			&lt;list&gt;<br/>
				&lt;bean class=&quot;org.apache.cxf.binding.soap.spring.SoapVersionRegistrar&quot;/&gt;<br/>
			&lt;/list&gt;<br/>
		&lt;/property&gt;<br/>
	&lt;/bean&gt;<br/>
