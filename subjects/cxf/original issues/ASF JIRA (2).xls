                                            <td class="resolutiondate"> 22/Oct/10 01:05 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
