                                            <td class="resolutiondate"> 26/Feb/09 21:14 </td>
                                            <td class="versions">                        2.0.10            </td>
                                            <td class="fixVersions">                        2.0.11            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
