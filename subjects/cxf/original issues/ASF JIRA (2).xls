            xmlns:tns=&quot;http://bf.fractal.objectweb.org&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot;&gt;<br/>
            &lt;xsd:complexType name=&quot;HelloWorldException&quot;&gt;<br/>
                &lt;xsd:sequence /&gt;<br/>
            &lt;/xsd:complexType&gt;<br/>
        &lt;/xsd:schema&gt;<br/>
        &lt;xsd:schema attributeFormDefault=&quot;qualified&quot;<br/>
            elementFormDefault=&quot;qualified&quot; targetNamespace=&quot;http://bf.fractal.objectweb.org/&quot;<br/>
            xmlns:ns0=&quot;http://bf.fractal.objectweb.org&quot; xmlns:tns=&quot;http://bf.fractal.objectweb.org/&quot;<br/>
            xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot;&gt;<br/>
            &lt;xsd:complexType name=&quot;anyType2anyTypeMap&quot;&gt;<br/>
                &lt;xsd:sequence&gt;<br/>
                    &lt;xsd:element maxOccurs=&quot;unbounded&quot;<br/>
                        minOccurs=&quot;0&quot; name=&quot;entry&quot;&gt;<br/>
                        &lt;xsd:complexType&gt;<br/>
                            &lt;xsd:sequence&gt;<br/>
                                &lt;xsd:element minOccurs=&quot;0&quot;<br/>
                                    name=&quot;key&quot; type=&quot;xsd:anyType&quot; /&gt;<br/>
                                &lt;xsd:element minOccurs=&quot;0&quot;<br/>
