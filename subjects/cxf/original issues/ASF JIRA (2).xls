                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    </td>
                                            <td class="customfield_12310060"></td>
                                            <td class="customfield_12310220">            <span title="14/Sep/11 02:25"><time class="livestamp allow-future" datetime="2011-09-14T02:25:17+0000">14/Sep/11 2:25 AM</time></span>
