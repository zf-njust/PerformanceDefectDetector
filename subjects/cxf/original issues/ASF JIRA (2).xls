    <a class="issue-link" data-issue-key="CXF-2067" href="https://issues.apache.org/jira/browse/CXF-2067">CXF-2067</a>
</td>
                                            <td class="summary"><p>
                Can&#39;t send message attachments via the WebServiceContext in 2.0.x
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 25/Feb/09 15:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
