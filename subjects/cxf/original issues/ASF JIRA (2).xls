    <a class="issue-link" data-issue-key="CXF-2072" href="https://issues.apache.org/jira/browse/CXF-2072">CXF-2072</a>
</td>
                                            <td class="summary"><p>
                Persistant HTTPS connections appear to be disabled.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
