    <a class="issue-link" data-issue-key="CXF-2085" href="https://issues.apache.org/jira/browse/CXF-2085">CXF-2085</a>
</td>
                                            <td class="summary"><p>
                Applications classloader should be set during method invocations.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Chaitanya Choleti
    </td>
                                            <td class="creator">            Chaitanya Choleti
    </td>
                                            <td class="created"> 04/Mar/09 14:43 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Apr/09 21:17 </td>
                                            <td class="resolutiondate"> 10/Mar/09 21:54 </td>
                                            <td class="versions">                        2.2            </td>
                                            <td class="fixVersions">                        2.2            </td>
                                            <td class="components">    &nbsp;
</td>
