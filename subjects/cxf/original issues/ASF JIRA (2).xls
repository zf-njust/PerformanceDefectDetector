        HTTPClientPolicy httpClientPolicy = new HTTPClientPolicy();<br/>
        httpClientPolicy.setConnectionTimeout(36000);<br/>
        httpClientPolicy.setAllowChunking(false);<br/>
        http.setClient(httpClientPolicy);<br/>
<br/>
