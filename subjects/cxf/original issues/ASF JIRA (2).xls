                                            <td class="description">      When setting proxy server as VM parameters http.proxyHost, http.proxyPort,<br/>
proxySet, http.nonProxyHosts. HttpConduit doesn&#39;t read those properties and set proxy server.<br/>
<br/>
I have to manually set these after creating the client.<br/>
<br/>
if(&quot;true&quot;.equalsIgnoreCase(System.getProperty(&quot;proxySet&quot;))){<br/>
            Client client = ClientProxy.getClient(service);<br/>
            HTTPConduit http = (HTTPConduit) client.getConduit();<br/>
<br/>
            HTTPClientPolicy httpClientPolicy = http.getClient();<br/>
            httpClientPolicy.setProxyServer(System.getProperty(&quot;http.proxyHost&quot;));<br/>
            httpClientPolicy.setProxyServerPort(Integer.parseInt(System.getProperty(&quot;http.proxyPort&quot;)));<br/>
        }
  </td>
