                <tr id="issuerow12438069" rel="12438069" data-issuekey="CXF-2471" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2471" href="https://issues.apache.org/jira/browse/CXF-2471">CXF-2471</a>
</td>
                                            <td class="summary"><p>
                The HttpServletResponse statuses is lost after is set in a service implementation (where the response is injected through @Context).
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Vincenzo Vitale
    </td>
                                            <td class="creator">            Vincenzo Vitale
    </td>
                                            <td class="created"> 14/Oct/09 10:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Feb/10 19:02 </td>
                                            <td class="resolutiondate"> 08/Jan/10 16:38 </td>
                                            <td class="versions">                        2.2.4,                     2.2.5            </td>
                                            <td class="fixVersions">                        2.2.6            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
