<br/>
The Users class is just a collection workaround as suggested in CXF&#39;s documentation:<br/>
<br/>
@XmlRootElement(name = &quot;users&quot;)<br/>
public class Users <br/>
implements Serializable<br/>
{<br/>
	public Users() { setUser(new ArrayList&lt;User&gt;()); } // upon JAXB unmarshalling of an empty collection, the setUser is NOT called and the collection would be null instead of empty<br/>
	public Users(Collection&lt;User&gt; c) { setUser(c); }<br/>
	<br/>
	private Collection&lt;User&gt; iCollection;<br/>
	public Collection&lt;User&gt; getUser() { return iCollection; }<br/>
	public void setUser(Collection&lt;User&gt; c) { iCollection = c; }<br/>
    <br/>
	public List&lt;User&gt; asList() { return new ArrayList&lt;User&gt;(iCollection); }<br/>
}
