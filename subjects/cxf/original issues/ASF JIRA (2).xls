                            &lt;/xsd:sequence&gt;<br/>
                        &lt;/xsd:complexType&gt;<br/>
                    &lt;/xsd:element&gt;<br/>
                &lt;/xsd:sequence&gt;<br/>
            &lt;/xsd:complexType&gt;<br/>
            &lt;xsd:element name=&quot;print&quot; type=&quot;tns:print&quot; /&gt;<br/>
            &lt;xsd:complexType name=&quot;print&quot;&gt;<br/>
                &lt;xsd:sequence /&gt;<br/>
            &lt;/xsd:complexType&gt;<br/>
            &lt;xsd:element name=&quot;printResponse&quot; type=&quot;tns:printResponse&quot; /&gt;<br/>
