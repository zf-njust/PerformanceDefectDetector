    <a class="issue-link" data-issue-key="CXF-2744" href="https://issues.apache.org/jira/browse/CXF-2744">CXF-2744</a>
</td>
                                            <td class="summary"><p>
                Schema redefine element does not have its schemaLocation rewritten
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Brian P. Bailey
    </td>
                                            <td class="creator">            Brian P. Bailey
    </td>
                                            <td class="created"> 30/Mar/10 18:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
