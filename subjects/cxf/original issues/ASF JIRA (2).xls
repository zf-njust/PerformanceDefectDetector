    <a class="issue-link" data-issue-key="CXF-2533" href="https://issues.apache.org/jira/browse/CXF-2533">CXF-2533</a>
</td>
                                            <td class="summary"><p>
                Content disposition values don&#39;t have their quotes stripped
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Benson Margulies
    </td>
                                            <td class="creator">            Benson Margulies
    </td>
                                            <td class="created"> 13/Nov/09 02:32 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:34 </td>
                                            <td class="resolutiondate"> 13/Nov/09 09:28 </td>
                                            <td class="versions">                        2.2.4            </td>
                                            <td class="fixVersions">                        2.2.5,                     2.3            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
