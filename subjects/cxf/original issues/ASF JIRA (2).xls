                <tr id="issuerow12434168" rel="12434168" data-issuekey="CXF-2405" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2405" href="https://issues.apache.org/jira/browse/CXF-2405">CXF-2405</a>
</td>
                                            <td class="summary"><p>
                CXF Client: Outbound SOAP request - Missing &lt;soap:Body&gt;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Vikas Narang
    </td>
                                            <td class="creator">            Vikas Narang
    </td>
                                            <td class="created"> 27/Aug/09 14:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Sep/09 20:59 </td>
                                            <td class="resolutiondate"> 11/Sep/09 18:03 </td>
                                            <td class="versions">                        2.2.2,                     2.2.3            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
