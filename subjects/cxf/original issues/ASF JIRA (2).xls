Payload: &lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;&gt;&lt;soapenv:Body&gt;&lt;getFirstNameReturn xmlns=&quot;http://net.ibs.WSGetName&quot;&gt;Vikas&lt;/getFirstNameReturn&gt;&lt;/soapenv:Body&gt;&lt;/soapenv:Envelope&gt;<br/>
