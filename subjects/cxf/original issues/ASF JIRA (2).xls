                <tr id="issuerow12477111" rel="12477111" data-issuekey="CXF-3061" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3061" href="https://issues.apache.org/jira/browse/CXF-3061">CXF-3061</a>
</td>
                                            <td class="summary"><p>
                Resolving a DTD from Schema fails when Endpoint definition uses wsdlLocation
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Marco Zapletal
    </td>
                                            <td class="creator">            Marco Zapletal
    </td>
                                            <td class="created"> 12/Oct/10 08:27 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Dec/10 22:48 </td>
                                            <td class="resolutiondate"> 29/Nov/10 22:19 </td>
                                            <td class="versions">                        2.3,                     2.2.11            </td>
                                            <td class="fixVersions">                        2.2.12,                     2.3.1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
