                <tr id="issuerow12431073" rel="12431073" data-issuekey="CXF-2349" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2349" href="https://issues.apache.org/jira/browse/CXF-2349">CXF-2349</a>
</td>
                                            <td class="summary"><p>
                Space in namespace localName causes org.w3c.dom.DOMException: INVALID_CHARACTER_ERR
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Zack
    </td>
                                            <td class="creator">            Zack
    </td>
                                            <td class="created"> 21/Jul/09 21:08 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Aug/09 20:07 </td>
                                            <td class="resolutiondate"> 22/Jul/09 01:25 </td>
                                            <td class="versions">                        2.2.2            </td>
                                            <td class="fixVersions">                        2.0.12,                     2.1.6,                     2.2.3            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
