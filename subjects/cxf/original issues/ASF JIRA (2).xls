</td>
                                            <td class="summary"><p>
                Object argument is passed as null
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Ravi Sukheja
    </td>
                                            <td class="creator">            Ravi Sukheja
    </td>
                                            <td class="created"> 07/Jan/10 15:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
