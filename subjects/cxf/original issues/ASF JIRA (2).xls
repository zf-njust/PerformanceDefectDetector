                <tr id="issuerow12439733" rel="12439733" data-issuekey="CXF-2517" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2517" href="https://issues.apache.org/jira/browse/CXF-2517">CXF-2517</a>
</td>
                                            <td class="summary"><p>
                Exception shouldn&#39;t be considered as JBI ERROR,should use JBI FAULT instead
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Freeman Fang
    </td>
                                            <td class="creator">            Freeman Fang
    </td>
                                            <td class="created"> 03/Nov/09 08:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:34 </td>
                                            <td class="resolutiondate"> 05/Nov/09 02:18 </td>
