                <tr id="issuerow12427343" rel="12427343" data-issuekey="CXF-2267" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2267" href="https://issues.apache.org/jira/browse/CXF-2267">CXF-2267</a>
</td>
                                            <td class="summary"><p>
                How to parse the input request and ensure that it is as per the XSD ?
    </p>
</td>
                                            <td class="issuetype"> Test</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            amit rathi
    </td>
                                            <td class="creator">            amit rathi
    </td>
                                            <td class="created"> 08/Jun/09 10:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Jul/09 17:59 </td>
                                            <td class="resolutiondate"> 09/Jun/09 00:27 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
