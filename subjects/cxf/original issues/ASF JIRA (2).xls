    <a class="issue-link" data-issue-key="CXF-2141" href="https://issues.apache.org/jira/browse/CXF-2141">CXF-2141</a>
</td>
                                            <td class="summary"><p>
                Expose faults count in ResponseTimeCounter in addition to existing invocations count
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
