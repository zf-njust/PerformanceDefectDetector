</td>
                                            <td class="summary"><p>
                Aegis ObjectType throws NullPointerException when reading value for an xs:any without xsi:type information
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Benson Margulies
    </td>
                                            <td class="reporter">            Fried Hoeben
    </td>
                                            <td class="creator">            Fried Hoeben
    </td>
                                            <td class="created"> 31/Aug/09 15:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Oct/09 20:45 </td>
                                            <td class="resolutiondate"> 08/Sep/09 18:43 </td>
                                            <td class="versions">                        2.2.3            </td>
                                            <td class="fixVersions">                        2.2.4            </td>
                                            <td class="components">                        Aegis Databinding            </td>
