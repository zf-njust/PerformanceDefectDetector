</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2710" href="https://issues.apache.org/jira/browse/CXF-2710">CXF-2710</a>
</td>
                                            <td class="summary"><p>
                DynamicClientFactory compilation wrong classpath Jboss5
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Prasad Deshpande
    </td>
                                            <td class="creator">            Prasad Deshpande
    </td>
                                            <td class="created"> 12/Mar/10 13:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Nov/11 02:11 </td>
                                            <td class="resolutiondate"> 26/Oct/11 16:30 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.4.3            </td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
