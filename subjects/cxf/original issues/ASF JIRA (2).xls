</td>
                                            <td class="summary"><p>
                LogUtils does not recognize SLF4J due to invallid Class.forName()  
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Bas Passon
    </td>
                                            <td class="creator">            Bas Passon
    </td>
                                            <td class="created"> 04/Feb/10 10:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Mar/10 02:59 </td>
                                            <td class="resolutiondate"> 04/Feb/10 16:20 </td>
                                            <td class="versions">                        2.2.6            </td>
                                            <td class="fixVersions">                        2.2.7            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
