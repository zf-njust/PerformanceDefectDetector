		xacc	TransducedAccessor$CompositeTransducedAccessorImpl&lt;BeanT,ValueT&gt;  (id=247)	<br/>
			acc	AdaptedAccessor&lt;BeanT,InMemValueT,OnWireValueT&gt;  (id=240)	<br/>
				adapter	Class&lt;T&gt; (javax.xml.bind.annotation.adapters.NormalizedStringAdapter) (id=253)	<br/>
