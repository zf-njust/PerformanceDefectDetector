    <a class="issue-link" data-issue-key="CXF-2535" href="https://issues.apache.org/jira/browse/CXF-2535">CXF-2535</a>
</td>
                                            <td class="summary"><p>
                OverlayW3CDOMStreamWriter is not allowing multiple elements of the same name to be written out
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
                                            <td class="created"> 13/Nov/09 22:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:34 </td>
                                            <td class="resolutiondate"> 13/Nov/09 22:21 </td>
                                            <td class="versions">                        2.2.4            </td>
                                            <td class="fixVersions">                        2.2.5            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
