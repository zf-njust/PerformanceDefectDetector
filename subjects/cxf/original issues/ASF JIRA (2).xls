                <tr id="issuerow12471564" rel="12471564" data-issuekey="CXF-2942" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2942" href="https://issues.apache.org/jira/browse/CXF-2942">CXF-2942</a>
</td>
                                            <td class="summary"><p>
                ServletTransportFactory bean in cxf-servlet.xml file use incorrect collection type.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Harpreet Singh
    </td>
                                            <td class="creator">            Harpreet Singh
    </td>
                                            <td class="created"> 13/Aug/10 15:53 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 14:45 </td>
                                            <td class="resolutiondate"> 07/Sep/10 18:40 </td>
                                            <td class="versions">                        2.2.8            </td>
                                            <td class="fixVersions">                        2.2.11            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      ServletTransportFactory bean defined in cxf-servlet.xml file use Set instead of List.<br/>
<br/>
 &lt;bean class=&quot;org.apache.cxf.transport.servlet.ServletTransportFactory&quot;  id=&quot;org.apache.cxf.transport.servlet.ServletTransportFactory&quot;&gt;<br/>
        &lt;property name=&quot;bus&quot; ref=&quot;cxf&quot;/&gt;<br/>
        &lt;property name=&quot;transportIds&quot;&gt;<br/>
            &lt;set&gt;<br/>
                &lt;value&gt;http://cxf.apache.org/bindings/xformat&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/soap/http&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/wsdl/http/&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/wsdl/soap/http&lt;/value&gt;<br/>
 	            &lt;value&gt;http://www.w3.org/2003/05/soap/bindings/HTTP/&lt;/value&gt;<br/>
                &lt;value&gt;http://cxf.apache.org/transports/http/configuration&lt;/value&gt;                <br/>
            &lt;/set&gt;<br/>
        &lt;/property&gt;<br/>
<br/>
must be<br/>
<br/>
 &lt;bean class=&quot;org.apache.cxf.transport.servlet.ServletTransportFactory&quot;<br/>
	  id=&quot;org.apache.cxf.transport.servlet.ServletTransportFactory&quot;&gt;<br/>
        &lt;property name=&quot;bus&quot; ref=&quot;cxf&quot;/&gt;<br/>
        &lt;property name=&quot;transportIds&quot;&gt;<br/>
            &lt;list&gt;<br/>
                &lt;value&gt;http://cxf.apache.org/bindings/xformat&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/soap/http&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/wsdl/http/&lt;/value&gt;<br/>
                &lt;value&gt;http://schemas.xmlsoap.org/wsdl/soap/http&lt;/value&gt;<br/>
 	            &lt;value&gt;http://www.w3.org/2003/05/soap/bindings/HTTP/&lt;/value&gt;<br/>
                &lt;value&gt;http://cxf.apache.org/transports/http/configuration&lt;/value&gt;                <br/>
            &lt;/list&gt;<br/>
        &lt;/property&gt;
  </td>
