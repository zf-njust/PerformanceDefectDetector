                <tr id="issuerow12428385" rel="12428385" data-issuekey="CXF-2307" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2307" href="https://issues.apache.org/jira/browse/CXF-2307">CXF-2307</a>
</td>
                                            <td class="summary"><p>
                PhaseInterceptorChain should log errors above INFO
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Kevin Conaway
    </td>
                                            <td class="creator">            Kevin Conaway
    </td>
                                            <td class="created"> 19/Jun/09 17:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Aug/09 20:07 </td>
                                            <td class="resolutiondate"> 07/Jul/09 19:45 </td>
                                            <td class="versions">                        2.2.2            </td>
                                            <td class="fixVersions">                        2.1.6,                     2.2.3            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Currently, if there is an uncaught exception either in an Interceptor or the application, the PhaseInterceptorChain logs this exception at the INFO level.<br/>
<br/>
It would be more useful to log events at the WARNING or SEVERE level.
  </td>
