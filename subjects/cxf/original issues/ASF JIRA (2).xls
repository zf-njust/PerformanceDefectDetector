   Count = 1,<br/>
   Clause[0] = LocalIdKeyIdentifierClause(LocalId = &#39;urn:uuid:67422cf9-69c5-4e15-802d-4c6d39cdc57d&#39;, Owner = &#39;System.ServiceModel.Security.Tokens.SecurityContextSecurityToken&#39;)<br/>
   )<br/>
&#39;, available tokens &#39;SecurityTokenResolver<br/>
