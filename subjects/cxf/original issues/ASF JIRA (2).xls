package com.acme.server;<br/>
<br/>
import javax.jws.WebService;<br/>
<br/>
import com.acme.test.TestPortType;<br/>
<br/>
/**<br/>
 *<br/>
 */<br/>
@WebService(targetNamespace = &quot;http://acme.com/test/&quot;,<br/>
	    portName=&quot;testXMLPort&quot;,<br/>
	    serviceName=&quot;test&quot;,<br/>
	    endpointInterface=&quot;com.acme.test.TestPortType&quot;)<br/>
<br/>
public class TestPortTypeXMLImpl implements TestPortType {<br/>
<br/>
	/*<br/>
	 * (non-Javadoc)<br/>
	 * <br/>
