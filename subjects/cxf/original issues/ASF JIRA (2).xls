                <tr id="issuerow12440516" rel="12440516" data-issuekey="CXF-2532" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2532" href="https://issues.apache.org/jira/browse/CXF-2532">CXF-2532</a>
</td>
                                            <td class="summary"><p>
                On demand retrieval of JAX-WS MessageContext properties
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Alessio Soldano
    </td>
                                            <td class="reporter">            Alessio Soldano
    </td>
