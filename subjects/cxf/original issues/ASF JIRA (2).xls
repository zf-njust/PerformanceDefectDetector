    <a class="issue-link" data-issue-key="CXF-2708" href="https://issues.apache.org/jira/browse/CXF-2708">CXF-2708</a>
</td>
                                            <td class="summary"><p>
                endpoint validation fails if WSDL referenced schemas exist on classpath outside the jar the endpoint exists
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
