</td>
                                            <td class="summary"><p>
                WS-Trust seems to require a TransportBinding policy
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Brandon Richins
    </td>
                                            <td class="creator">            Brandon Richins
    </td>
                                            <td class="created"> 12/Jul/10 21:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 14:45 </td>
