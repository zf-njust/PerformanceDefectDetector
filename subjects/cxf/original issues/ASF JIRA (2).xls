                <tr id="issuerow12464603" rel="12464603" data-issuekey="CXF-2811" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2811" href="https://issues.apache.org/jira/browse/CXF-2811">CXF-2811</a>
</td>
                                            <td class="summary"><p>
                org.apache.cxf.interceptor.Fault: UNMARSHAL_ERROR ((XMLBeans data binding with the CXF version 2.2.7/2.2.8
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Sundar Ramamurthy
    </td>
                                            <td class="creator">            Sundar Ramamurthy
    </td>
                                            <td class="created"> 16/May/10 02:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Apr/11 12:47 </td>
                                            <td class="resolutiondate"> 14/Mar/11 21:54 </td>
                                            <td class="versions">                        2.2.7,                     2.2.8            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        OtherDatabindings            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
