                    &lt;/list&gt;<br/>
                &lt;/property&gt;<br/>
                &lt;property name=&quot;servletMappings&quot;&gt;<br/>
                    &lt;list&gt;<br/>
                        &lt;bean class=&quot;org.mortbay.jetty.servlet.ServletMapping&quot;&gt;<br/>
                            &lt;property name=&quot;servletName&quot; value=&quot;servlet-holder&quot; /&gt;<br/>
                            &lt;property name=&quot;pathSpec&quot; value=&quot;/*&quot; /&gt;<br/>
