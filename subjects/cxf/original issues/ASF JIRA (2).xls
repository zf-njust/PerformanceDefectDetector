    <a class="issue-link" data-issue-key="CXF-2748" href="https://issues.apache.org/jira/browse/CXF-2748">CXF-2748</a>
</td>
                                            <td class="summary"><p>
                Unmarshalling error when using fastinfoset
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Reinis Vicups
    </td>
                                            <td class="creator">            Reinis Vicups
    </td>
                                            <td class="created"> 31/Mar/10 16:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Apr/10 10:29 </td>
                                            <td class="resolutiondate"> 08/Apr/10 01:32 </td>
                                            <td class="versions">                        2.2.7            </td>
                                            <td class="fixVersions">                        2.2.8            </td>
                                            <td class="components">    &nbsp;
