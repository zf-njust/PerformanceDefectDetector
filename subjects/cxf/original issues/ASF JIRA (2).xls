    <a class="issue-link" data-issue-key="CXF-3025" href="https://issues.apache.org/jira/browse/CXF-3025">CXF-3025</a>
</td>
                                            <td class="summary"><p>
                What are the sample projects for CXF? A web page describing each at a high level would be nice.
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Robert Liguori
    </td>
                                            <td class="creator">            Robert Liguori
    </td>
                                            <td class="created"> 04/Oct/10 15:27 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Oct/10 00:22 </td>
