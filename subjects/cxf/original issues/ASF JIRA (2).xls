    <a class="issue-link" data-issue-key="CXF-2701" href="https://issues.apache.org/jira/browse/CXF-2701">CXF-2701</a>
</td>
                                            <td class="summary"><p>
                Make slf4j-jdk14 optional dependency in http-jetty
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Roman Kalukiewicz
    </td>
                                            <td class="creator">            Roman Kalukiewicz
    </td>
                                            <td class="created"> 09/Mar/10 10:02 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Jan/11 18:18 </td>
                                            <td class="resolutiondate"> 08/Jan/11 02:25 </td>
                                            <td class="versions">                        2.2.5,                     2.3            </td>
                                            <td class="fixVersions">                        2.3            </td>
                                            <td class="components">    &nbsp;
</td>
