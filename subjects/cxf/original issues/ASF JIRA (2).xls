    <a class="issue-link" data-issue-key="CXF-2418" href="https://issues.apache.org/jira/browse/CXF-2418">CXF-2418</a>
</td>
                                            <td class="summary"><p>
                SchemaCollection throws StackOverflowError when schema contains circular reference
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Fried Hoeben
    </td>
                                            <td class="creator">            Fried Hoeben
    </td>
                                            <td class="created"> 02/Sep/09 12:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Oct/09 20:45 </td>
                                            <td class="resolutiondate"> 04/Sep/09 01:26 </td>
                                            <td class="versions">                        2.2.3            </td>
                                            <td class="fixVersions">                        2.2.4            </td>
                                            <td class="components">                        Aegis Databinding            </td>
