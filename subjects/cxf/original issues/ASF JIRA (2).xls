Payload: &lt;soap:Envelope xmlns:soap=&quot;http://schemas.xmlsoap.org/soap/ <br/>
envelope/&quot;&gt; &lt;soap:Body&gt; &lt;ns2:greetMe xmlns:ns2=&quot;http://cxf/&quot;&gt; &lt;arg0&gt;测试 &lt;/ <br/>
arg0&gt; &lt;/ns2:greetMe&gt; &lt;/soap:Body&gt; &lt;/soap:Envelope&gt; <br/>
<br/>
<br/>
