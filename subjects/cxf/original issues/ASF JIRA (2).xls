                <tr id="issuerow12415826" rel="12415826" data-issuekey="CXF-2076" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2076" href="https://issues.apache.org/jira/browse/CXF-2076">CXF-2076</a>
</td>
                                            <td class="summary"><p>
                InstantiationException trying to create wrapper object when using xmlbeans databinding
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Dave Stanley
    </td>
                                            <td class="creator">            Dave Stanley
    </td>
                                            <td class="created"> 27/Feb/09 22:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Oct/09 19:37 </td>
                                            <td class="resolutiondate"> 05/Oct/09 16:49 </td>
                                            <td class="versions">                        2.1.4            </td>
                                            <td class="fixVersions">                        2.1.6,                     2.2.3            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
