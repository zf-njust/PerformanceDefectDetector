			soap:mustUnderstand=&quot;true&quot;&gt;<br/>
			&lt;wsu:Timestamp<br/>
				xmlns:wsu=&quot;http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd&quot;<br/>
				wsu:Id=&quot;Timestamp-937741416&quot;&gt;<br/>
				&lt;wsu:Created&gt;2009-04-06T10:00:48.903Z<br/>
				&lt;/wsu:Created&gt;<br/>
				&lt;wsu:Expires&gt;2009-04-06T10:05:48.903Z<br/>
				&lt;/wsu:Expires&gt;<br/>
			&lt;/wsu:Timestamp&gt;<br/>
			&lt;c:SecurityContextToken xmlns:c=&quot;http://schemas.xmlsoap.org/ws/2005/02/sc&quot;<br/>
				xmlns:u=&quot;http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd&quot;<br/>
				u:Id=&quot;uuid-e19e1759-7ef7-452b-9055-17ed4b15114c-3&quot;&gt;<br/>
				&lt;c:Identifier&gt;urn:uuid:cc05aea2-c53b-417e-9527-5d81102d6b20<br/>
				&lt;/c:Identifier&gt;<br/>
			&lt;/c:SecurityContextToken&gt;<br/>
			&lt;ds:Signature xmlns:ds=&quot;http://www.w3.org/2000/09/xmldsig#&quot;<br/>
				Id=&quot;Signature-1670444352&quot;&gt;<br/>
				&lt;ds:SignedInfo&gt;<br/>
