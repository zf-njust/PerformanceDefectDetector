                <tr id="issuerow12464950" rel="12464950" data-issuekey="CXF-2817" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2817" href="https://issues.apache.org/jira/browse/CXF-2817">CXF-2817</a>
</td>
                                            <td class="summary"><p>
                The NON_UNIQUE_BODY message misspells signature signaure
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Glen Mazza
    </td>
                                            <td class="reporter">            Brandon Richins
    </td>
                                            <td class="creator">            Brandon Richins
    </td>
                                            <td class="created"> 19/May/10 21:15 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/May/10 17:59 </td>
                                            <td class="resolutiondate"> 20/May/10 04:31 </td>
                                            <td class="versions">                        2.2.8            </td>
                                            <td class="fixVersions">                        2.2.9            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
