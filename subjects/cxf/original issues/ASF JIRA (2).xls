                <tr id="issuerow12475748" rel="12475748" data-issuekey="CXF-3022" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3022" href="https://issues.apache.org/jira/browse/CXF-3022">CXF-3022</a>
</td>
                                            <td class="summary"><p>
                Integrating Spring 3 + GenericDAO (Don&#39;t repeat the DAO!) + CXF JAX-RS (JAXB Databinding) with a Generic Service Interface 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Ivan Vitoria
    </td>
                                            <td class="creator">            Ivan Vitoria
    </td>
                                            <td class="created"> 04/Oct/10 11:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Dec/10 22:48 </td>
                                            <td class="resolutiondate"> 19/Nov/10 16:06 </td>
                                            <td class="versions">                        2.2.10            </td>
                                            <td class="fixVersions">                        2.2.12,                     2.3.1,                     2.4            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">604800</td>
                                            <td class="timeestimate">604800</td>
                                            <td class="timespent"></td>
                                            <td class="workratio">            0%
    </td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Spring 3.03, CXF 2.2.10, Apache Tomcat 6.0.26...
  </td>
                                            <td class="description">      Hello everyone,<br/>
<br/>
I&#39;m trying to use a generic interface implementation as a JAX-RS service in order to accomplish basic rest operations for all model data (in the same way that the pattern [GenericDAO|http://www.ibm.com/developerworks/java/library/j-genericdao.html].<br/>
<br/>
The interface:<br/>
<br/>
{code:title=IRestService.java|borderStyle=solid}<br/>
public interface IRestService&lt;T, PK extends Long&gt;<br/>
{<br/>
    T getById(PK id);<br/>
<br/>
    PK add(T instance);<br/>
}<br/>
{code} <br/>
<br/>
The generic service implementation:<br/>
<br/>
{code:title=GenericRestServiceImpl.java|borderStyle=solid}<br/>
public class GenericRestServiceImpl&lt;T, PK extends Long&gt; implements IRestService&lt;T, PK&gt;<br/>
{<br/>
    private IGenericDAO&lt;T, PK&gt; iDAO;<br/>
<br/>
    public void setiDAO(IGenericDAO&lt;T, PK&gt; iDAO)<br/>
    {<br/>
        this.iDAO = iDAO;<br/>
    }<br/>
<br/>
    public T getById(PK id)<br/>
    {<br/>
        return iDAO.read(id);<br/>
    }<br/>
<br/>
    public PK add(T instance)<br/>
    {<br/>
        return iDAO.create(instance);<br/>
    }<br/>
{code}<br/>
<br/>
The simple POJO I want to send and receive:<br/>
<br/>
{code:title=MobilityUser.java|borderStyle=solid}<br/>
@XmlRootElement(name=&quot;MobilityUser&quot;)<br/>
public class MobilityUser implements Serializable<br/>
{<br/>
    private Long id;<br/>
    private String login;<br/>
    private String nif;<br/>
<br/>
    public MobilityUser()<br/>
    {<br/>
