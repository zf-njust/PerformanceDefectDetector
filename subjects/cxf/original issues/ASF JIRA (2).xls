                <tr id="issuerow12414664" rel="12414664" data-issuekey="CXF-2039" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2039" href="https://issues.apache.org/jira/browse/CXF-2039">CXF-2039</a>
</td>
                                            <td class="summary"><p>
                -Dorg.apache.cxf.spring.validation.mode=VALIDATION_NONE has no effect
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Laurent Perez
    </td>
                                            <td class="creator">            Laurent Perez
    </td>
