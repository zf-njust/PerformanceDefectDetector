</td>
                                            <td class="summary"><p>
                FastInfoset Thread blocked
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
