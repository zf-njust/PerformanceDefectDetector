      &lt;app:testAppendRequest&gt;<br/>
         &lt;typ:string1&gt;string1&lt;/typ:string1&gt;<br/>
         &lt;typ:string2&gt;string2&lt;/typ:string2&gt;<br/>
      &lt;/app:testAppendRequest&gt;<br/>
   &lt;/soapenv:Body&gt;<br/>
&lt;/soapenv:Envelope&gt;<br/>
