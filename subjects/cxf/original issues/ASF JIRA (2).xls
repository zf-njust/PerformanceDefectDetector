        &lt;property name=&quot;contextPath&quot; value=&quot;/servlet&quot; /&gt;<br/>
        &lt;property name=&quot;handler&quot;&gt;<br/>
            &lt;bean class=&quot;org.mortbay.jetty.servlet.ServletHandler&quot;&gt;<br/>
                &lt;property name=&quot;servlets&quot;&gt;<br/>
                    &lt;list&gt;<br/>
                        &lt;bean class=&quot;org.mortbay.jetty.servlet.ServletHolder&quot;&gt;<br/>
                            &lt;property name=&quot;name&quot; value=&quot;servlet-holder&quot; /&gt;<br/>
