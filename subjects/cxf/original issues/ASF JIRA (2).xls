                <tr id="issuerow12462768" rel="12462768" data-issuekey="CXF-2781" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2781" href="https://issues.apache.org/jira/browse/CXF-2781">CXF-2781</a>
</td>
                                            <td class="summary"><p>
                Charset encoding other than UTF-8 (as ISO-8859-1) not working
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Olivier Rousseil
    </td>
                                            <td class="creator">            Olivier Rousseil
    </td>
                                            <td class="created"> 22/Apr/10 13:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/May/10 18:06 </td>
                                            <td class="resolutiondate"> 28/Apr/10 21:03 </td>
                                            <td class="versions">                        2.2.7            </td>
                                            <td class="fixVersions">                        2.2.8,                     2.3            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
