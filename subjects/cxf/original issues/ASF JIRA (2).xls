                                            <td class="summary"><p>
                Null message part type class org.apache.cxf.xmlbeans.DataWriterImpl 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
