</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            carles rico
    </td>
                                            <td class="creator">            carles rico
    </td>
                                            <td class="created"> 23/Feb/10 11:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 14:57 </td>
                                            <td class="resolutiondate"> 04/May/10 21:02 </td>
                                            <td class="versions">                        2.1.5            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Core            </td>
