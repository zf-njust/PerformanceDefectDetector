    <a class="issue-link" data-issue-key="CXF-7214" href="https://issues.apache.org/jira/browse/CXF-7214">CXF-7214</a>
</td>
                                            <td class="summary"><p>
                Login  Register  Changing reply-to causes NPE in MessageSenderInterceptor.java
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
