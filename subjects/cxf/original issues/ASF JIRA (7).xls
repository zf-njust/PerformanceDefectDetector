        &lt;xs:schema xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;urn:com:bbva:jee:arq:spring:core:servicing:utils&quot; xmlns:tns=&quot;urn:com:bbva:qzqp:claim:facade:v01&quot; attributeFormDefault=&quot;unqualified&quot; elementFormDefault=&quot;unqualified&quot; targetNamespace=&quot;urn:com:bbva:qzqp:claim:facade:v01&quot;&gt;<br/>
            &lt;xs:import namespace=&quot;urn:com:bbva:jee:arq:spring:core:servicing:utils&quot;/&gt;<br/>
