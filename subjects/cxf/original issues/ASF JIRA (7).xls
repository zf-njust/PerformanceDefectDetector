                <tr id="issuerow13033707" rel="13033707" data-issuekey="CXF-7210" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-7210" href="https://issues.apache.org/jira/browse/CXF-7210">CXF-7210</a>
</td>
                                            <td class="summary"><p>
                StringIndexOutOfBoundsException during construction of failover request
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
