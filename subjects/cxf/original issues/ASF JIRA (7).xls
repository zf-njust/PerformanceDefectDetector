                                            <td class="summary"><p>
                Double checked locking in PolicyEngineImpl.java
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
