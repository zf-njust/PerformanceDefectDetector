                <tr id="issuerow13049595" rel="13049595" data-issuekey="CXF-7272" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-7272" href="https://issues.apache.org/jira/browse/CXF-7272">CXF-7272</a>
</td>
                                            <td class="summary"><p>
                @SchemaValidation inoperant
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Nicolas Duminil
    </td>
                                            <td class="creator">            Nicolas Duminil
    </td>
                                            <td class="created"> 09/Mar/17 13:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:37 </td>
                                            <td class="resolutiondate"> 28/Mar/17 11:34 </td>
                                            <td class="versions">                        2.7.14            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
