</td>
                                            <td class="summary"><p>
                No way to configure TLS for the JettyHTTPServerEngineFactory in code
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 24/Mar/17 16:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:04 </td>
                                            <td class="resolutiondate"> 24/Mar/17 18:45 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.1.11,                     3.2.0            </td>
