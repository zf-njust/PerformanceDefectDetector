    <a class="issue-link" data-issue-key="CXF-7374" href="https://issues.apache.org/jira/browse/CXF-7374">CXF-7374</a>
</td>
                                            <td class="summary"><p>
                Concurrent calls to refreshAccessToken() fails with SQL constraint violation
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Viacheslav Gagara
    </td>
                                            <td class="creator">            Viacheslav Gagara
    </td>
                                            <td class="created"> 18/May/17 13:49 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/May/17 16:05 </td>
                                            <td class="resolutiondate"> 19/May/17 20:47 </td>
                                            <td class="versions">                        3.2.0            </td>
                                            <td class="fixVersions">                        3.1.12,                     3.2.0            </td>
                                            <td class="components">                        JAX-RS Security            </td>
