</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Sebastian Hoß
    </td>
                                            <td class="creator">            Sebastian Hoß
    </td>
                                            <td class="created"> 11/Jan/17 12:38 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Feb/17 15:08 </td>
                                            <td class="resolutiondate"> 12/Jan/17 05:58 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.1.10,                     3.2.0            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
