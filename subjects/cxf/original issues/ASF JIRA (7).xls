                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/May/17 12:52 </td>
                                            <td class="resolutiondate"> 26/May/17 10:08 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
