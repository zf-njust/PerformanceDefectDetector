    <a class="issue-link" data-issue-key="CXF-7378" href="https://issues.apache.org/jira/browse/CXF-7378">CXF-7378</a>
</td>
                                            <td class="summary"><p>
                For the HttpConduit set the http response message along side the RESPONSE_CODE
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
