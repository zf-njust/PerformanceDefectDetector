                <tr id="issuerow13014706" rel="13014706" data-issuekey="CXF-7108" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-7108" href="https://issues.apache.org/jira/browse/CXF-7108">CXF-7108</a>
</td>
                                            <td class="summary"><p>
                NOTICE file in Distribution is too broad
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            John D. Ament
    </td>
                                            <td class="creator">            John D. Ament
    </td>
                                            <td class="created"> 24/Oct/16 12:37 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:37 </td>
                                            <td class="resolutiondate"> 23/Mar/17 14:03 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Build system            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
