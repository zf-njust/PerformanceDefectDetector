</td>
                                            <td class="reporter">            Vishal Saxena
    </td>
                                            <td class="creator">            Vishal Saxena
    </td>
                                            <td class="created"> 27/Jun/17 09:24 </td>
                                            <td class="lastViewed"> 25/Jul/17 13:06 </td>
                                            <td class="updated"> 10/Jul/17 08:33 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        3.0.4,                     3.1.11            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
