                                            <td class="resolutiondate"> 26/Jan/17 17:50 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.1.10,                     3.2.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
