                                            <td class="updated"> 12/Jun/17 14:39 </td>
                                            <td class="resolutiondate"> 08/Jun/17 17:43 </td>
                                            <td class="versions">                        3.1.7,                     3.1.10            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        WS-* Components            </td>
