</td>
                                            <td class="customfield_12312328"></td>
                                            <td class="customfield_12312329"></td>
                                            <td class="customfield_12312923"></td>
                                            <td class="customfield_12312326"></td>
                                            <td class="customfield_12312920"></td>
                                            <td class="customfield_12312327"></td>
                                            <td class="customfield_12312921"></td>
