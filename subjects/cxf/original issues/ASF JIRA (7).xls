    <a class="issue-link" data-issue-key="CXF-7204" href="https://issues.apache.org/jira/browse/CXF-7204">CXF-7204</a>
</td>
                                            <td class="summary"><p>
                CXF 3.1.9 does not support Spring 3.2, enforces Spring 4.1
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Concombre Masqué
    </td>
                                            <td class="creator">            Concombre Masqué
    </td>
                                            <td class="created"> 03/Jan/17 22:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Feb/17 15:08 </td>
                                            <td class="resolutiondate"> 25/Jan/17 16:36 </td>
                                            <td class="versions">                        3.1.9            </td>
                                            <td class="fixVersions">                        3.1.10            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
