                <tr id="issuerow13031602" rel="13031602" data-issuekey="CXF-7202" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-7202" href="https://issues.apache.org/jira/browse/CXF-7202">CXF-7202</a>
</td>
                                            <td class="summary"><p>
                the incorrect spring-beans-4.3.xsd/spring-util-4.3.xsd/spring-context-4.3.xsd cause master build extremely slow and sometimes even hang
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Freeman Fang
    </td>
                                            <td class="creator">            Freeman Fang
    </td>
                                            <td class="created"> 03/Jan/17 08:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Jan/17 09:08 </td>
                                            <td class="resolutiondate"> 03/Jan/17 09:08 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.2.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      because so far we use the spring 4.2.x and so the related spring jars only have spring 4.2 version xsd as local xsd file. But we refer spring 4.3 xsd everywhere which cause try to download 4.3 xsd files remotely, this takes build very long time and sometimes even cause build hang if the internet connection going wrong
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
                                            <td class="aggregatetimeestimate"></td>
                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    </td>
                                            <td class="customfield_12310060">    Unknown
