</td>
                                            <td class="customfield_12310220">            <span title="01/Dec/16 16:04"><time class="livestamp allow-future" datetime="2016-12-01T16:04:49+0000">01/Dec/16 4:04 PM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
                                            <td class="customfield_12312520"></td>
                                            <td class="customfield_12312323"></td>
                                            <td class="customfield_12312521">    33 weeks, 3 days ago

                    <style>
