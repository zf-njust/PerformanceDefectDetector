                <tr id="issuerow13016531" rel="13016531" data-issuekey="CXF-7115" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-7115" href="https://issues.apache.org/jira/browse/CXF-7115">CXF-7115</a>
</td>
                                            <td class="summary"><p>
                Issuer in TokenIntrospection should be quoted in JSON
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Svein Otto Solem
    </td>
                                            <td class="creator">            Svein Otto Solem
    </td>
                                            <td class="created"> 31/Oct/16 08:31 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Mar/17 17:25 </td>
                                            <td class="resolutiondate"> 31/Oct/16 16:58 </td>
                                            <td class="versions">                        3.1.8            </td>
                                            <td class="fixVersions">                        3.1.9,                     3.2.0            </td>
                                            <td class="components">                        JAX-RS Security            </td>
                                            <td class="duedate">    &nbsp;
</td>
