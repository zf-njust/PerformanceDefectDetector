                &lt;xs:sequence&gt;<br/>
                    &lt;xs:element minOccurs=&quot;0&quot; name=&quot;claimId&quot; type=&quot;xs:string&quot;/&gt;<br/>
                    &lt;xs:element minOccurs=&quot;0&quot; name=&quot;claimName&quot; type=&quot;xs:string&quot;/&gt;<br/>
                    &lt;xs:element minOccurs=&quot;0&quot; name=&quot;claimUpDate&quot; type=&quot;xs:dateTime&quot;/&gt;<br/>
                    &lt;xs:element minOccurs=&quot;0&quot; name=&quot;claimType&quot; type=&quot;xs:string&quot;/&gt;<br/>
                    &lt;xs:element minOccurs=&quot;0&quot; name=&quot;estimatedCost&quot; type=&quot;ns1:money&quot;/&gt;<br/>
                    &lt;xs:element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;claimers&quot; nillable=&quot;true&quot; type=&quot;tns:claimer&quot;/&gt;<br/>
                    &lt;xs:element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;issues&quot; nillable=&quot;true&quot; type=&quot;tns:issue&quot;/&gt;<br/>
                    &lt;xs:element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;links&quot; nillable=&quot;true&quot; type=&quot;ns1:link&quot;/&gt;<br/>
                &lt;/xs:sequence&gt;<br/>
