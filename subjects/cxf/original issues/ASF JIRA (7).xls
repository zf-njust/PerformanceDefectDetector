                <tr id="issuerow13037617" rel="13037617" data-issuekey="CXF-7230" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-7230" href="https://issues.apache.org/jira/browse/CXF-7230">CXF-7230</a>
</td>
                                            <td class="summary"><p>
                Unable to disable access to default wadl genearated by cxf
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
