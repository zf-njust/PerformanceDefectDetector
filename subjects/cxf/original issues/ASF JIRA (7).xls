    <a class="issue-link" data-issue-key="CXF-7112" href="https://issues.apache.org/jira/browse/CXF-7112">CXF-7112</a>
</td>
                                            <td class="summary"><p>
                AsyncHTTPConduit ignore the ReceiveTimeout when use Async JAXWS api
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Freeman Fang
    </td>
                                            <td class="creator">            Freeman Fang
    </td>
                                            <td class="created"> 28/Oct/16 03:38 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Mar/17 17:24 </td>
                                            <td class="resolutiondate"> 28/Oct/16 04:15 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.1.9,                     3.2.0            </td>
