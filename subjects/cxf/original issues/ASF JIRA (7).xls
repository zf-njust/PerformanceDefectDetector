                        &lt;osgi:bean class=&quot;org.apache.cxf.feature.LoggingFeature&quot; /&gt;<br/>
                        &lt;policies xmlns=&quot;http://cxf.apache.org/policy&quot; /&gt;<br/>
                &lt;/cxf:features&gt;<br/>
        &lt;/cxf:cxfEndpoint&gt;<br/>
        &lt;cxf:cxfEndpoint serviceName=&quot;tns:DelayService&quot; endpointName=&quot;tns:DelayServicePort&quot; wsdlURL=&quot;classpath:/DelayService.wsdl&quot; id=&quot;DelayService_DelayServiceBackend&quot; address=&quot;http://localhost:8080/DelayBackendService&quot; xmlns:tns=&quot;http://www.talend.org/service/&quot;&gt;<br/>
                &lt;cxf:properties&gt;<br/>
                        &lt;osgi:entry key=&quot;dataFormat&quot; value=&quot;PAYLOAD&quot; /&gt;<br/>
                &lt;/cxf:properties&gt;<br/>
