                <tr id="issuerow12368474" rel="12368474" data-issuekey="CXF-624" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-624" href="https://issues.apache.org/jira/browse/CXF-624">CXF-624</a>
</td>
                                            <td class="summary"><p>
                cxf-rt-transports-http pom.xml has compile dependencies on jetty and servlet-api
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Chris Moesel
    </td>
                                            <td class="creator">            Chris Moesel
    </td>
                                            <td class="created"> 02/May/07 16:32 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 02:03 </td>
                                            <td class="resolutiondate"> 02/May/07 16:52 </td>
                                            <td class="versions">                        2.0            </td>
                                            <td class="fixVersions">                        2.0            </td>
                                            <td class="components">                        Build system            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
