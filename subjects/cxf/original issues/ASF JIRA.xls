    <a class="issue-link" data-issue-key="CXF-556" href="https://issues.apache.org/jira/browse/CXF-556">CXF-556</a>
</td>
                                            <td class="summary"><p>
                WSDL location in binding file must be an exact string match to wsdl2java arg 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jonathan Anstey
    </td>
                                            <td class="creator">            Jonathan Anstey
    </td>
