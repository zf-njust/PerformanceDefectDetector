                                            <td class="environment"></td>
                                            <td class="description">      Use java2wsdl to generate wsdl for following class , schema elment &quot;person&quot; in wrong targetNamespace.<br/>
<br/>
------------Class Person---------------------------<br/>
<br/>
package common.test;<br/>
<br/>
public class Person {<br/>
<br/>
    String name;<br/>
<br/>
    public void setName(String name) {<br/>
        this.name = name;<br/>
    }<br/>
<br/>
    public String getName() {<br/>
        return name;<br/>
    }<br/>
<br/>
}<br/>
<br/>
-------Class Greeter--------<br/>
package demo.test;<br/>
<br/>
import javax.jws.WebMethod;<br/>
import javax.jws.WebParam;<br/>
import javax.jws.WebService;<br/>
import javax.xml.ws.RequestWrapper;<br/>
import javax.xml.ws.ResponseWrapper;<br/>
<br/>
import common.test.Person;<br/>
@WebService(name = &quot;Greeter&quot;, targetNamespace = &quot;http://test.demo/&quot;)<br/>
public interface Greeter {<br/>
<br/>
    @WebMethod(operationName = &quot;sayHi&quot;, exclude = false)<br/>
    @ResponseWrapper(className = &quot;demo.test.SayHiResponse&quot;, <br/>
                     localName = &quot;sayHiResponse&quot;, targetNamespace = &quot;http://test.demo/&quot;)<br/>
    @RequestWrapper(className = &quot;demo.test.SayHi&quot;, <br/>
                    localName = &quot;sayHi&quot;, targetNamespace = &quot;http://test.demo/&quot;)<br/>
    void sayHi(@WebParam(targetNamespace = &quot;http://test.common&quot;, name = &quot;person&quot;)<br/>
               Person person);<br/>
<br/>
}<br/>
<br/>
<br/>
