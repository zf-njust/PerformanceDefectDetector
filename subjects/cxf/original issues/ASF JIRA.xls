                <tr id="issuerow12364811" rel="12364811" data-issuekey="CXF-459" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-459" href="https://issues.apache.org/jira/browse/CXF-459">CXF-459</a>
</td>
                                            <td class="summary"><p>
                Non-Daemon Timer thread created at RMManager
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Bharath Ganesh
    </td>
                                            <td class="creator">            Bharath Ganesh
    </td>
                                            <td class="created"> 13/Mar/07 12:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 18:03 </td>
                                            <td class="resolutiondate"> 15/Mar/07 12:24 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0-RC            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      A Timer is created at org.apache.cxf.ws.rm.RMManager using the default Timer constructor. This causes the associate timer thread to run as a non-daemon thread.  <br/>
Since this timer is never cancelled, the thread to be there forever, stopping the VM from exiting. (Matters a lot at the JAX-WS client side)
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
