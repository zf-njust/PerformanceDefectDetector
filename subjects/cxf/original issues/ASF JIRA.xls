                <tr id="issuerow12370600" rel="12370600" data-issuekey="CXF-696" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-696" href="https://issues.apache.org/jira/browse/CXF-696">CXF-696</a>
</td>
                                            <td class="summary"><p>
                Spring integration can fail when external Java archives are incorporated.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Paul Hanke
    </td>
                                            <td class="creator">            Paul Hanke
    </td>
                                            <td class="created"> 31/May/07 14:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
