                <tr id="issuerow12367599" rel="12367599" data-issuekey="CXF-558" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-558" href="https://issues.apache.org/jira/browse/CXF-558">CXF-558</a>
</td>
                                            <td class="summary"><p>
                JAX-WS Context not injected for RESTful service implementations
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jervis Liu
    </td>
                                            <td class="reporter">            Dave Stanley
    </td>
                                            <td class="creator">            Dave Stanley
    </td>
                                            <td class="created"> 19/Apr/07 20:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Jun/07 08:08 </td>
                                            <td class="resolutiondate"> 14/Jun/07 08:08 </td>
                                            <td class="versions">                        2.0-RC            </td>
                                            <td class="fixVersions">                        2.0            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Not env specific
  </td>
                                            <td class="description">      The context is not injected for RESTful services. You can see this by modifying the the JUnit testcase below: <br/>
<br/>
&lt;cxf&gt;/trunk/rt/bindings/http/src/test/java/org/apache/cxf/binding/http/bare/CustomerService.java<br/>
<br/>
Added the @Resource annotation as shown below ..<br/>
<br/>
import javax.annotation.Resource;<br/>
...<br/>
<br/>
import javax.xml.ws.WebServiceContext;<br/>
<br/>
...<br/>
<br/>
// END SNIPPET: service<br/>
@WebService(targetNamespace = &quot;http://cxf.apache.org/jra&quot;)<br/>
public class CustomerService {<br/>
    long currentId = 1;<br/>
    Map&lt;Long, Customer&gt; customers = new HashMap&lt;Long, Customer&gt;();<br/>
<br/>
    @Resource<br/>
    private WebServiceContext context;<br/>
 <br/>
    @Post<br/>
    @HttpResource(location = &quot;/customers&quot;)<br/>
    @WebMethod<br/>
    public void addCustomer(@WebParam(name = &quot;customer&quot;) Customer c) {<br/>
        long id = ++currentId;<br/>
        c.setId(id);<br/>
        customers.put(id, c);<br/>
        <br/>
        // Context is null .. <br/>
        MessageContext mc = context.getMessageContext();<br/>
   }      <br/>
<br/>

  </td>
