<br/>
SimpleServiceDocLit.wsdl :<br/>
<br/>
&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;<br/>
&lt;definitions name=&quot;SimpleService&quot; targetNamespace=&quot;http://www.iona.com/bus/tests&quot;<br/>
    xmlns=&quot;http://schemas.xmlsoap.org/wsdl/&quot;<br/>
    xmlns:soap=&quot;http://schemas.xmlsoap.org/wsdl/soap/&quot;<br/>
    xmlns:tns=&quot;http://www.iona.com/bus/tests&quot;<br/>
    xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot;<br/>
    xmlns:corba=&quot;http://schemas.iona.com/bindings/corba&quot;<br/>
    xmlns:xsd1=&quot;http://www.iona.com/bus/tests/types&quot;&gt;<br/>
    <br/>
<br/>
    &lt;types&gt;<br/>
        &lt;schema targetNamespace=&quot;http://www.iona.com/bus/tests/types&quot;<br/>
            xmlns=&quot;http://www.w3.org/2001/XMLSchema&quot;<br/>
            xmlns:wsdl=&quot;http://schemas.xmlsoap.org/wsdl/&quot;&gt;<br/>
            &lt;import namespace=&quot;http://www.iona.com/bus/tests/types&quot; schemaLocation=&quot;inner.xsd&quot;/&gt;<br/>
<br/>
            &lt;!-- dot type --&gt;<br/>
            &lt;simpleType name=&quot;TypeTest.Beer&quot;&gt;<br/>
                &lt;restriction base=&quot;string&quot;&gt;<br/>
                    &lt;enumeration value=&quot;Wheat&quot;/&gt;<br/>
                    &lt;enumeration value=&quot;Lambic&quot;/&gt;<br/>
                    &lt;enumeration value=&quot;Bitter&quot;/&gt;<br/>
                    &lt;enumeration value=&quot;Stout&quot;/&gt;<br/>
                    &lt;enumeration value=&quot;Porter&quot;/&gt;<br/>
                &lt;/restriction&gt;<br/>
            &lt;/simpleType&gt;<br/>
            <br/>
            &lt;!-- pingMe types --&gt;<br/>
            &lt;element name=&quot;pingMe&quot;&gt;<br/>
                &lt;complexType /&gt;<br/>
            &lt;/element&gt;<br/>
            &lt;element name=&quot;pingMeResponse&quot;&gt;<br/>
                &lt;complexType /&gt;<br/>
            &lt;/element&gt;<br/>
<br/>
            &lt;!-- sayHi types --&gt;<br/>
            &lt;element name=&quot;sayHi&quot;&gt;<br/>
                &lt;complexType /&gt;<br/>
            &lt;/element&gt;<br/>
            &lt;element name=&quot;sayHiResponse&quot;&gt;<br/>
                &lt;complexType&gt;<br/>
                    &lt;sequence&gt;<br/>
                        &lt;element name=&quot;responseType&quot; type=&quot;xsd:string&quot; /&gt;<br/>
                    &lt;/sequence&gt;<br/>
                &lt;/complexType&gt;<br/>
            &lt;/element&gt;<br/>
<br/>
            &lt;!-- sayHello types --&gt;<br/>
            &lt;element name=&quot;responseType&quot; type=&quot;xsd:string&quot;/&gt;<br/>
<br/>
            &lt;!-- greetMe types --&gt;<br/>
            &lt;element name=&quot;greetMe&quot;&gt;<br/>
                &lt;complexType&gt;<br/>
                    &lt;sequence&gt;<br/>
                        &lt;element name=&quot;requestType&quot; type=&quot;xsd:string&quot; /&gt;<br/>
                    &lt;/sequence&gt;<br/>
                &lt;/complexType&gt;<br/>
            &lt;/element&gt;<br/>
            &lt;element name=&quot;greetMeResponse&quot;&gt;<br/>
                &lt;complexType&gt;<br/>
                    &lt;sequence&gt;<br/>
                        &lt;element name=&quot;responseType&quot; type=&quot;xsd:string&quot; /&gt;<br/>
                    &lt;/sequence&gt;<br/>
                &lt;/complexType&gt;<br/>
            &lt;/element&gt;<br/>
<br/>
            &lt;!-- exchangeDetails types --&gt;<br/>
            &lt;element name=&quot;exchangeDetailsElem&quot; type=&quot;xsd1:Details&quot;/&gt;<br/>
            &lt;complexType name=&quot;Details&quot;&gt;<br/>
                &lt;sequence&gt;<br/>
                    &lt;element name=&quot;age&quot; type=&quot;xsd:int&quot;/&gt;<br/>
                    &lt;element name=&quot;address&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                    &lt;element name=&quot;name&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                    &lt;element name=&quot;inner&quot; type=&quot;xsd1:Inner&quot;/&gt;<br/>
                    &lt;element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;value&quot; type=&quot;xsd:int&quot;/&gt;<br/>
                &lt;/sequence&gt;<br/>
            &lt;/complexType&gt;<br/>
<br/>
            &lt;element name=&quot;stringElem&quot; type=&quot;xsd:string&quot;/&gt;<br/>
            &lt;complexType name=&quot;CompoundArray&quot;&gt;<br/>
                &lt;sequence&gt;<br/>
                    &lt;element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;array1&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                    &lt;element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;array2&quot; type=&quot;xsd1:Details&quot;/&gt;<br/>
                    &lt;element name=&quot;address&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                    &lt;element name=&quot;date&quot; type=&quot;xsd:dateTime&quot;/&gt;<br/>
                    &lt;element name=&quot;dec&quot; type=&quot;xsd:decimal&quot;/&gt;<br/>
                &lt;/sequence&gt;<br/>
            &lt;/complexType&gt;<br/>
<br/>
            &lt;element name=&quot;echo&quot;&gt;<br/>
                &lt;complexType&gt;<br/>
                    &lt;sequence&gt;<br/>
                        &lt;element name=&quot;x&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                        &lt;element name=&quot;y&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                    &lt;/sequence&gt;<br/>
                &lt;/complexType&gt;<br/>
            &lt;/element&gt;<br/>
<br/>
            &lt;element name=&quot;echoResponse&quot;&gt;<br/>
                &lt;complexType&gt;<br/>
                    &lt;sequence&gt;<br/>
                        &lt;element name=&quot;return&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                        &lt;element name=&quot;y&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                        &lt;element name=&quot;z&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                    &lt;/sequence&gt;<br/>
                &lt;/complexType&gt;<br/>
            &lt;/element&gt;<br/>
<br/>
            &lt;element name=&quot;Compound&quot; type=&quot;xsd1:CompoundArray&quot;/&gt;<br/>
<br/>
            &lt;element name=&quot;GetCustomer&quot;&gt;<br/>
                &lt;complexType&gt;<br/>
                    &lt;sequence&gt;<br/>
                        &lt;element name=&quot;MSISDN&quot; type=&quot;string&quot;/&gt;<br/>
                        &lt;element maxOccurs=&quot;1&quot; minOccurs=&quot;0&quot; name=&quot;agentUserName&quot;<br/>
                            type=&quot;string&quot;/&gt;<br/>
                        &lt;element maxOccurs=&quot;1&quot; minOccurs=&quot;0&quot; name=&quot;ChannelID&quot;<br/>
                            type=&quot;string&quot;/&gt;<br/>
                        &lt;element name=&quot;testEnum&quot; type=&quot;xsd1:TestEnum&quot;/&gt;<br/>
                        &lt;element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;1&quot; name=&quot;CustomerArrayIn&quot; <br/>
                            type=&quot;xsd1:Customer&quot;/&gt;<br/>
                        &lt;element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;1&quot; name=&quot;CustomerArrayInOut&quot; <br/>
                            type=&quot;xsd1:Customer&quot;/&gt;<br/>
                    &lt;/sequence&gt;<br/>
                &lt;/complexType&gt;<br/>
            &lt;/element&gt;<br/>
<br/>
            &lt;element name=&quot;GetCustomerResponse&quot;&gt;<br/>
                &lt;complexType&gt;<br/>
                    &lt;sequence&gt;<br/>
                        &lt;element maxOccurs=&quot;1&quot; minOccurs=&quot;1&quot; name=&quot;GetCustomerResult&quot;<br/>
                            type=&quot;xsd1:Customer&quot;/&gt;<br/>
                        &lt;element maxOccurs=&quot;1&quot; minOccurs=&quot;1&quot; name=&quot;OutStatusCode&quot; type=&quot;int&quot;/&gt;<br/>
                        &lt;element maxOccurs=&quot;1&quot; minOccurs=&quot;1&quot; name=&quot;OutSalutation&quot; type=&quot;xsd1:Customer&quot;/&gt;<br/>
                        &lt;element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;1&quot; name=&quot;CustomerArrayInOut&quot; <br/>
                            type=&quot;xsd1:Customer&quot;/&gt;<br/>
                        &lt;element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;1&quot; name=&quot;CustomerArrayOut&quot; <br/>
                            type=&quot;xsd1:Customer&quot;/&gt;<br/>
                    &lt;/sequence&gt;<br/>
                &lt;/complexType&gt;<br/>
            &lt;/element&gt;<br/>
<br/>
            &lt;xsd:simpleType name=&quot;TestEnum&quot;&gt;<br/>
                &lt;xsd:restriction base=&quot;xsd:string&quot;&gt;<br/>
                    &lt;xsd:enumeration value=&quot;Low&quot;/&gt;<br/>
                    &lt;xsd:enumeration value=&quot;Medium&quot;/&gt;<br/>
                    &lt;xsd:enumeration value=&quot;High&quot;/&gt;<br/>
                &lt;/xsd:restriction&gt;<br/>
            &lt;/xsd:simpleType&gt;<br/>
<br/>
            &lt;complexType name=&quot;Customer&quot;&gt;<br/>
                &lt;sequence&gt;<br/>
                    &lt;element maxOccurs=&quot;1&quot; minOccurs=&quot;1&quot; name=&quot;StatusCode&quot; type=&quot;int&quot;/&gt;<br/>
                    &lt;element maxOccurs=&quot;1&quot; minOccurs=&quot;0&quot; name=&quot;UserID&quot; type=&quot;string&quot;/&gt;<br/>
                    &lt;element maxOccurs=&quot;1&quot; minOccurs=&quot;0&quot; name=&quot;Salutation&quot; type=&quot;string&quot;/&gt;<br/>
                    &lt;element maxOccurs=&quot;1&quot; minOccurs=&quot;0&quot; name=&quot;FirstName&quot; type=&quot;string&quot;/&gt;<br/>
                &lt;/sequence&gt;<br/>
            &lt;/complexType&gt;<br/>
 <br/>
            &lt;element name=&quot;TypeTest.enum_inout&quot;&gt;<br/>
                &lt;complexType&gt;<br/>
                    &lt;sequence&gt;<br/>
                        &lt;element name=&quot;val&quot; type=&quot;xsd1:TypeTest.Beer&quot;/&gt;<br/>
                    &lt;/sequence&gt;<br/>
                &lt;/complexType&gt;<br/>
            &lt;/element&gt;<br/>
            &lt;element name=&quot;TypeTest.enum_inoutResult&quot;&gt;<br/>
                &lt;complexType&gt;<br/>
                    &lt;sequence&gt;<br/>
                        &lt;element name=&quot;val&quot; type=&quot;xsd1:TypeTest.Beer&quot;/&gt;<br/>
                    &lt;/sequence&gt;<br/>
                &lt;/complexType&gt;<br/>
            &lt;/element&gt;<br/>
<br/>
            <br/>
        &lt;/schema&gt;<br/>
    &lt;/types&gt;<br/>
<br/>
    &lt;!-- pingMe messages --&gt;<br/>
    &lt;message name=&quot;pingMeRequest&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:pingMe&quot; name=&quot;in&quot; /&gt;<br/>
    &lt;/message&gt;<br/>
    &lt;message name=&quot;pingMeResponse&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:pingMeResponse&quot; name=&quot;out&quot; /&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;!-- sayHi messages --&gt;<br/>
    &lt;message name=&quot;sayHiRequest&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:sayHi&quot; name=&quot;in&quot; /&gt;<br/>
    &lt;/message&gt;<br/>
    &lt;message name=&quot;sayHiResponse&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:sayHiResponse&quot; name=&quot;out&quot; /&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;!-- sayHello messages --&gt;<br/>
    &lt;message name=&quot;sayHelloRequest&quot;/&gt;<br/>
    &lt;message name=&quot;sayHelloResponse&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:responseType&quot; name=&quot;theResponse&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;!-- greetMe messages --&gt;<br/>
    &lt;message name=&quot;greetMeRequest&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:greetMe&quot; name=&quot;in&quot; /&gt;<br/>
    &lt;/message&gt;<br/>
    &lt;message name=&quot;greetMeResponse&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:greetMeResponse&quot; name=&quot;out&quot; /&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;!-- exchangeDetails messages --&gt;<br/>
    &lt;message name=&quot;exchangeDetailsRequest&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:exchangeDetailsElem&quot; name=&quot;detailsIn&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
    &lt;message name=&quot;exchangeDetailsResponse&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:exchangeDetailsElem&quot; name=&quot;return&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;say_goodbye&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:Compound&quot; name=&quot;goodbye&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;say_goodbyeResponse&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:Compound&quot; name=&quot;return&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;send_greeting&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:stringElem&quot; name=&quot;greeting&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;send_greetingResponse&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:stringElem&quot; name=&quot;return&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;echoChar&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:echo&quot; name=&quot;parameters&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;echoCharResponse&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:echoResponse&quot; name=&quot;parameters&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;failureOccured&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:stringElem&quot; name=&quot;exceptionType&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;errorOccured&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:stringElem&quot; name=&quot;exceptionType&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;GetCustomerSoapIn&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:GetCustomer&quot; name=&quot;parameters&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;GetCustomerSoapOut&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:GetCustomerResponse&quot; name=&quot;parameters&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;message name=&quot;TypeTest.enum_inout&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:TypeTest.enum_inout&quot; name=&quot;parameters&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
    &lt;message name=&quot;TypeTest.enum_inoutResponse&quot;&gt;<br/>
        &lt;part element=&quot;xsd1:TypeTest.enum_inoutResult&quot; name=&quot;parameters&quot;/&gt;<br/>
    &lt;/message&gt;<br/>
<br/>
    &lt;portType name=&quot;SimpleServicePortType&quot;&gt;<br/>
        &lt;operation name=&quot;pingMe&quot;&gt;<br/>
            &lt;input message=&quot;tns:pingMeRequest&quot; name=&quot;pingMeRequest&quot; /&gt;<br/>
            &lt;output message=&quot;tns:pingMeResponse&quot;  name=&quot;pingMeResponse&quot; /&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;sayHi&quot;&gt;<br/>
            &lt;input message=&quot;tns:sayHiRequest&quot; name=&quot;sayHiRequest&quot; /&gt;<br/>
            &lt;output message=&quot;tns:sayHiResponse&quot; name=&quot;sayHiResponse&quot; /&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;sayHello&quot;&gt;<br/>
            &lt;input message=&quot;tns:sayHelloRequest&quot; name=&quot;sayHelloRequest&quot;/&gt;<br/>
            &lt;output message=&quot;tns:sayHelloResponse&quot; name=&quot;sayHelloResponse&quot;/&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;greetMe&quot;&gt;<br/>
            &lt;input message=&quot;tns:greetMeRequest&quot; name=&quot;greetMeRequest&quot; /&gt;<br/>
            &lt;output message=&quot;tns:greetMeResponse&quot; name=&quot;greetMeResponse&quot; /&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;exchangeDetails&quot;&gt;<br/>
             &lt;input message=&quot;tns:exchangeDetailsRequest&quot; name=&quot;exchangeDetailsRequest&quot;/&gt;<br/>
             &lt;output message=&quot;tns:exchangeDetailsResponse&quot; name=&quot;exchangeDetailsResponse&quot;/&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;say_goodbye&quot;&gt;<br/>
            &lt;input message=&quot;tns:say_goodbye&quot; name=&quot;say_goodbye&quot;/&gt;<br/>
            &lt;output message=&quot;tns:say_goodbyeResponse&quot; name=&quot;say_goodbyeResponse&quot;/&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;send_greeting&quot;&gt;<br/>
            &lt;input message=&quot;tns:send_greeting&quot; name=&quot;send_greeting&quot;/&gt;<br/>
            &lt;output message=&quot;tns:send_greetingResponse&quot; name=&quot;send_greetingResponse&quot;/&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;echoChar&quot;&gt;<br/>
            &lt;input message=&quot;tns:echoChar&quot;/&gt;<br/>
            &lt;output message=&quot;tns:echoCharResponse&quot;/&gt;<br/>
            &lt;fault  name=&quot;failure&quot; message=&quot;tns:failureOccured&quot;/&gt;<br/>
            &lt;fault  name=&quot;error&quot; message=&quot;tns:errorOccured&quot;/&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;GetCustomer&quot;&gt;<br/>
            &lt;input message=&quot;tns:GetCustomerSoapIn&quot; name=&quot;GetCustomer&quot;/&gt;<br/>
            &lt;output message=&quot;tns:GetCustomerSoapOut&quot; name=&quot;GetCustomerResponse&quot;/&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
    &lt;/portType&gt;<br/>
<br/>
    &lt;portType name=&quot;simple.simpleServicePortType&quot;&gt;<br/>
        &lt;operation name=&quot;pingMe&quot;&gt;<br/>
            &lt;input message=&quot;tns:pingMeRequest&quot; name=&quot;pingMeRequest&quot; /&gt;<br/>
            &lt;output message=&quot;tns:pingMeResponse&quot;  name=&quot;pingMeResponse&quot; /&gt;<br/>
        &lt;/operation&gt;<br/>
        <br/>
        &lt;operation name=&quot;enum_inout&quot;&gt;<br/>
            &lt;input message=&quot;tns:TypeTest.enum_inout&quot; name=&quot;enum_inout&quot;/&gt;<br/>
            &lt;output message=&quot;tns:TypeTest.enum_inoutResponse&quot; name=&quot;enum_inoutResponse&quot;/&gt;<br/>
        &lt;/operation&gt;<br/>
    &lt;/portType&gt;<br/>
<br/>
    &lt;binding name=&quot;SimpleServiceBinding&quot; type=&quot;tns:SimpleServicePortType&quot;&gt;<br/>
        &lt;soap:binding style=&quot;document&quot; transport=&quot;http://schemas.xmlsoap.org/soap/http&quot;/&gt;<br/>
<br/>
        &lt;operation name=&quot;pingMe&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;&quot; style=&quot;document&quot;/&gt;<br/>
            &lt;input name=&quot;pingMeRequest&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output name=&quot;pingMeResponse&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;sayHi&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;&quot; style=&quot;document&quot;/&gt;<br/>
            &lt;input name=&quot;sayHiRequest&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output name=&quot;sayHiResponse&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;sayHello&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;&quot; style=&quot;document&quot;/&gt;<br/>
            &lt;input name=&quot;sayHelloRequest&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output name=&quot;sayHelloResponse&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;greetMe&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;&quot; style=&quot;document&quot;/&gt;<br/>
            &lt;input name=&quot;greetMeRequest&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output name=&quot;greetMeResponse&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;exchangeDetails&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;http://www.iona.com/bus/tests&quot; style=&quot;document&quot;/&gt;<br/>
            &lt;input name=&quot;exchangeDetailsRequest&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output name=&quot;exchangeDetailsResponse&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;say_goodbye&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;http://www.iona.com/bus/tests&quot; style=&quot;document&quot;/&gt;<br/>
            &lt;input name=&quot;say_goodbye&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output name=&quot;say_goodbyeResponse&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;send_greeting&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;http://www.iona.com/bus/tests&quot; style=&quot;document&quot;/&gt;<br/>
            &lt;input name=&quot;send_greeting&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output name=&quot;send_greetingResponse&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;echoChar&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;http://soapinterop.org/&quot; style=&quot;document&quot;/&gt;<br/>
            &lt;input&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
        &lt;operation name=&quot;GetCustomer&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;http://www.mi-pay.com/WebServices/GetCustomer&quot;<br/>
                style=&quot;document&quot;/&gt;<br/>
            &lt;input name=&quot;GetCustomer&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output name=&quot;GetCustomerResponse&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
        &lt;/binding&gt;<br/>
        <br/>
    &lt;binding name=&quot;simple.simpleServiceBinding&quot; type=&quot;tns:simple.simpleServicePortType&quot;&gt;<br/>
        &lt;soap:binding style=&quot;document&quot; transport=&quot;http://schemas.xmlsoap.org/soap/http&quot;/&gt;<br/>
<br/>
        &lt;operation name=&quot;pingMe&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;&quot; style=&quot;document&quot;/&gt;<br/>
            &lt;input name=&quot;pingMeRequest&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/input&gt;<br/>
            &lt;output name=&quot;pingMeResponse&quot;&gt;<br/>
                &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
            &lt;/output&gt;<br/>
        &lt;/operation&gt;<br/>
        <br/>
        &lt;operation name=&quot;enum_inout&quot;&gt;<br/>
            &lt;corba:operation name=&quot;enum_inout&quot;&gt;<br/>
                &lt;corba:param idltype=&quot;corbatm:TypeTest.Beer&quot; mode=&quot;inout&quot; name=&quot;val&quot;/&gt;<br/>
            &lt;/corba:operation&gt;<br/>
            &lt;input name=&quot;enum_inout&quot;/&gt;<br/>
            &lt;output name=&quot;enum_inoutResponse&quot;/&gt;<br/>
        &lt;/operation&gt;<br/>
<br/>
    &lt;/binding&gt;<br/>
<br/>
    &lt;service name=&quot;SimpleServiceService&quot;&gt;<br/>
        &lt;port binding=&quot;tns:SimpleServiceBinding&quot; name=&quot;SimplePort&quot;&gt;<br/>
            &lt;soap:address location=&quot;http://localhost:9900/SimpleService/SimplePort&quot;/&gt;<br/>
        &lt;/port&gt;<br/>
    &lt;/service&gt;<br/>
    <br/>
    &lt;service name=&quot;simple.simpleServiceService&quot;&gt;<br/>
        &lt;port binding=&quot;tns:simple.simpleServiceBinding&quot; name=&quot;SimplePort&quot;&gt;<br/>
            &lt;soap:address location=&quot;http://localhost:9999/SimpleService/SimplePort&quot;/&gt;<br/>
