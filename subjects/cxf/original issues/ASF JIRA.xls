                <tr id="issuerow12374380" rel="12374380" data-issuekey="CXF-824" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-824" href="https://issues.apache.org/jira/browse/CXF-824">CXF-824</a>
</td>
                                            <td class="summary"><p>
                SOAPAction can&#39;t be used to select an operation
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
