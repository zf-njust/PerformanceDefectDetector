                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Jan/08 00:16 </td>
                                            <td class="resolutiondate"> 18/Jun/07 18:58 </td>
                                            <td class="versions">                        2.0-M1            </td>
                                            <td class="fixVersions">                        2.0            </td>
                                            <td class="components">                        Soap Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
