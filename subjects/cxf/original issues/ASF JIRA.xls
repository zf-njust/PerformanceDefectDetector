    <a class="issue-link" data-issue-key="CXF-501" href="https://issues.apache.org/jira/browse/CXF-501">CXF-501</a>
</td>
                                            <td class="summary"><p>
                Rebase configuration of AutomaticWorkQueue thresholds on new config mechanism
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
