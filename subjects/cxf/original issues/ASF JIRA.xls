</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-510" href="https://issues.apache.org/jira/browse/CXF-510">CXF-510</a>
</td>
                                            <td class="summary"><p>
                SpringBusFactory only use DEFAULT_BUS_ID to create bus from context
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Willem Jiang
    </td>
                                            <td class="creator">            Willem Jiang
    </td>
                                            <td class="created"> 03/Apr/07 07:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 02:02 </td>
                                            <td class="resolutiondate"> 25/Jul/07 05:49 </td>
                                            <td class="versions">                        2.0-RC            </td>
                                            <td class="fixVersions">                        2.0.1            </td>
                                            <td class="components">                        Bus            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
