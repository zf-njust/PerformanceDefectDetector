    <a class="issue-link" data-issue-key="CXF-784" href="https://issues.apache.org/jira/browse/CXF-784">CXF-784</a>
</td>
                                            <td class="summary"><p>
                Interceptor not setting the fault chain for HTTP Binding
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Dan Diephouse
    </td>
                                            <td class="reporter">            Derek Shaw
    </td>
                                            <td class="creator">            Derek Shaw
    </td>
                                            <td class="created"> 12/Jul/07 15:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Dec/07 21:23 </td>
                                            <td class="resolutiondate"> 14/Jul/07 17:49 </td>
                                            <td class="versions">                        2.0,                     2.0.1,                     2.0.2,                     2.0.3,                     2.1            </td>
                                            <td class="fixVersions">                        2.0.1            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
