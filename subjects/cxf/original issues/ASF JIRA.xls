</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-590" href="https://issues.apache.org/jira/browse/CXF-590">CXF-590</a>
</td>
                                            <td class="summary"><p>
                JaxWsImplementorImpl.getServiceName() does not return the proper service name
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Dan Diephouse
    </td>
                                            <td class="reporter">            Jeff Genender
    </td>
                                            <td class="creator">            Jeff Genender
    </td>
                                            <td class="created"> 23/Apr/07 11:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Apr/07 15:29 </td>
                                            <td class="resolutiondate"> 23/Apr/07 15:29 </td>
                                            <td class="versions">                        2.0-M1            </td>
                                            <td class="fixVersions">                        2.0-RC            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
