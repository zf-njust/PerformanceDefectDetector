</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      <br/>
Methods like:<br/>
    String multiHeaderInOut(<br/>
                        @WebParam(mode = WebParam.Mode.OUT, header = true)<br/>
                        Holder&lt;String&gt; a,<br/>
                        @WebParam(mode = WebParam.Mode.INOUT)<br/>
                        Holder&lt;String&gt; b,<br/>
                        @WebParam(mode = WebParam.Mode.OUT)<br/>
                        Holder&lt;String&gt; c,<br/>
                        @WebParam(mode = WebParam.Mode.INOUT, header = true)<br/>
                        Holder&lt;String&gt; d,<br/>
                        @WebParam(mode = WebParam.Mode.INOUT)<br/>
                        Holder&lt;String&gt; e,<br/>
                        @WebParam(mode = WebParam.Mode.OUT, header = true)<br/>
                        Holder&lt;String&gt; f,<br/>
                        @WebParam(mode = WebParam.Mode.OUT)<br/>
                        Holder&lt;String&gt; g);<br/>
<br/>
result in incorrect SOAP messages being written and ArrayIndex issues and wrong number of param issues on the server.
  </td>
