    <a class="issue-link" data-issue-key="CXF-344" href="https://issues.apache.org/jira/browse/CXF-344">CXF-344</a>
</td>
                                            <td class="summary"><p>
                No system test for servlet transport
    </p>
</td>
                                            <td class="issuetype"> Test</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Eoghan Glynn
    </td>
                                            <td class="creator">            Eoghan Glynn
    </td>
