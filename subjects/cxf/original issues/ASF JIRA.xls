                                            <td class="assignee">            Sean O&#39;Callaghan
    </td>
                                            <td class="reporter">            Sean O&#39;Callaghan
    </td>
                                            <td class="creator">            Sean O&#39;Callaghan
    </td>
                                            <td class="created"> 09/Jan/07 12:14 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 18:04 </td>
                                            <td class="resolutiondate"> 31/Jan/07 14:37 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0-RC            </td>
