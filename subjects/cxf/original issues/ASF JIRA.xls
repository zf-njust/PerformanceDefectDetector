    <a class="issue-link" data-issue-key="CXF-355" href="https://issues.apache.org/jira/browse/CXF-355">CXF-355</a>
</td>
                                            <td class="summary"><p>
                WrapperClassInInterceptor throws NPE when handling an oneway operator
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
