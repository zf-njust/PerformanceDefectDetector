                                            <td class="summary"><p>
                Problem with Aegis databinding
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Guillaume Alleon
    </td>
                                            <td class="creator">            Guillaume Alleon
    </td>
                                            <td class="created"> 12/May/07 17:13 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Jun/07 19:07 </td>
                                            <td class="resolutiondate"> 13/Jun/07 19:07 </td>
                                            <td class="versions">                        2.0-RC            </td>
                                            <td class="fixVersions">                        2.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
