<br/>
@WebServiceProvider<br/>
@ServiceMode(value=Service.Mode.PAYLOAD)<br/>
public class SwissDecService implements Provider&lt;Source&gt; {<br/>
		<br/>
	public Source invoke(Source request) {<br/>
		try {<br/>
			System.out.println(request.toString());<br/>
		} catch (Exception e) {<br/>
			e.printStackTrace();<br/>
		}<br/>
		return null;<br/>
	}<br/>
<br/>
<br/>
