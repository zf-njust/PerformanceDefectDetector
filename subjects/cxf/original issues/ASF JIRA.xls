</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-340" href="https://issues.apache.org/jira/browse/CXF-340">CXF-340</a>
</td>
                                            <td class="summary"><p>
                Support adding extra classes to JAXB context
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Dan Diephouse
    </td>
                                            <td class="creator">            Dan Diephouse
    </td>
                                            <td class="created"> 29/Dec/06 18:46 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Oct/07 16:46 </td>
                                            <td class="resolutiondate"> 11/Jun/07 08:45 </td>
                                            <td class="versions">                        2.0-M1            </td>
                                            <td class="fixVersions">                        2.0.2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Users may have their own JAXB classes which need to be included in the context. We should provide a simple mechanism to add extra classes to the context. (This worked pretty well in XFire).<br/>
<br/>
HashMap props = new HashMap();<br/>
props.put(&quot;jaxb.additionalContextClasses&quot;, new Class[] { Foo.class, Bar.class });<br/>
<br/>
serverFactory.setProperties(props);<br/>
serverFactory.create();<br/>
<br/>

  </td>
