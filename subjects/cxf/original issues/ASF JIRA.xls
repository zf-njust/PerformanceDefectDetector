                <tr id="issuerow12361904" rel="12361904" data-issuekey="CXF-406" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-406" href="https://issues.apache.org/jira/browse/CXF-406">CXF-406</a>
</td>
                                            <td class="summary"><p>
                AnnotationHandlerChainBuilder.buildHandlerChainFromClass() considers only one handler chain
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Jarek Gawor
    </td>
                                            <td class="creator">            Jarek Gawor
    </td>
                                            <td class="created"> 03/Feb/07 06:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 02:05 </td>
                                            <td class="resolutiondate"> 09/Apr/07 14:51 </td>
                                            <td class="versions">                        2.0-RC            </td>
                                            <td class="fixVersions">                        2.0-RC            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
