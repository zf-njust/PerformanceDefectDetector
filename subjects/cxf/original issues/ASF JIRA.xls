                                            <td class="summary"><p>
                create service from class can&#39;t set operationInfo isOneWay rightly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
