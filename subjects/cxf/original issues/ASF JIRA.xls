    <a class="issue-link" data-issue-key="CXF-910" href="https://issues.apache.org/jira/browse/CXF-910">CXF-910</a>
</td>
                                            <td class="summary"><p>
                maven codegen plugin needs to allow passing arguments for java2wsdl goal
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
