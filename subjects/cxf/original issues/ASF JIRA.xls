                <tr id="issuerow12376972" rel="12376972" data-issuekey="CXF-949" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-949" href="https://issues.apache.org/jira/browse/CXF-949">CXF-949</a>
</td>
                                            <td class="summary"><p>
                wsdl2java generated client can not be compiled
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Willem Jiang
    </td>
                                            <td class="creator">            Willem Jiang
    </td>
                                            <td class="created"> 28/Aug/07 06:14 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Feb/08 21:36 </td>
                                            <td class="resolutiondate"> 19/Feb/08 21:44 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0.3            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The client code is generated by wsdl2java using the jaxws_async sample&#39;s wsdl.<br/>
Here are part of the client code<br/>
<br/>
       System.out.println(&quot;Invoking greetMeSometime...&quot;);<br/>
        java.lang.String _greetMeSometime_requestType = &quot;&quot;;<br/>
        java.lang.String _greetMeSometime__return = port.greetMeSometime(_greetMeSometime_requestType);<br/>
        System.out.println(&quot;greetMeSometime.result=&quot; + _greetMeSometime__return);<br/>
<br/>
<br/>
        System.out.println(&quot;Invoking greetMeSometimeAsync...&quot;);<br/>
        java.lang.String _greetMeSometimeAsync_requestType = &quot;&quot;;<br/>
        Future&lt;?&gt; _greetMeSometimeAsync__return = port.greetMeSometimeAsync(_greetMeSometimeAsync_requestType, _greetMeSometimeAsync_asyncHandler);<br/>
<br/>
<br/>
        System.out.println(&quot;Invoking greetMeSometimeAsync...&quot;);<br/>
        java.lang.String _greetMeSometimeAsync_requestType = &quot;&quot;;<br/>
        Response&lt;org.apache.hello_world_async_soap_http.types.GreetMeSometimeResponse&gt; _greetMeSometimeAsync__return = port.greetMeSometimeAsync(_greetMeSometimeAsync_requestType);<br/>
<br/>
The variable  _greetMeSometimeAsync_requestType is defined twice.<br/>
<br/>
<br/>

  </td>
