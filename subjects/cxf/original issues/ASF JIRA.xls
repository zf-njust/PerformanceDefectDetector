    [junit]     at org.apache.cxf.transport.http.HTTPConduit.close(HTTPConduit.java:574)<br/>
    [junit]     at org.apache.cxf.interceptor.MessageSenderInterceptor$MessageSenderEndingInterceptor.handleMessage(MessageSenderInterceptor.java:62)<br/>
