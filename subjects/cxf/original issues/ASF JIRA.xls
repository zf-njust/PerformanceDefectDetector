                <tr id="issuerow12356286" rel="12356286" data-issuekey="CXF-259" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-259" href="https://issues.apache.org/jira/browse/CXF-259">CXF-259</a>
</td>
                                            <td class="summary"><p>
                JSR 250: Support for @PreDestroy
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Andrea Smyth
    </td>
                                            <td class="creator">            Andrea Smyth
    </td>
                                            <td class="created"> 21/Nov/06 17:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 18:03 </td>
                                            <td class="resolutiondate"> 28/Feb/07 16:52 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0-RC            </td>
                                            <td class="components">                        Bus            </td>
                                            <td class="duedate">    &nbsp;
</td>
