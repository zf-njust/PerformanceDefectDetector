    <a class="issue-link" data-issue-key="CXF-119" href="https://issues.apache.org/jira/browse/CXF-119">CXF-119</a>
</td>
                                            <td class="summary"><p>
                Empty request elements causes NPE
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            Dan Diephouse
    </td>
                                            <td class="creator">            Dan Diephouse
    </td>
                                            <td class="created"> 26/Sep/06 14:14 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 02:05 </td>
                                            <td class="resolutiondate"> 17/Nov/06 05:07 </td>
                                            <td class="versions">                        2.0-RC            </td>
                                            <td class="fixVersions">                        2.0-RC            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
