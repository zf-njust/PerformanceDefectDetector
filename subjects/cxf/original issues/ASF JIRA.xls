    <a class="issue-link" data-issue-key="CXF-73" href="https://issues.apache.org/jira/browse/CXF-73">CXF-73</a>
</td>
                                            <td class="summary"><p>
            <span class="parentIssue">CXF-44</span>
                a configuration to configure interceptor chain
    </p>
</td>
                                            <td class="issuetype"> Sub-task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jervis Liu
    </td>
                                            <td class="creator">            Jervis Liu
    </td>
                                            <td class="created"> 12/Sep/06 08:12 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 18:00 </td>
                                            <td class="resolutiondate"> 26/Sep/06 15:35 </td>
                                            <td class="versions">                        2.0-M1            </td>
                                            <td class="fixVersions">                        2.0-M1            </td>
                                            <td class="components">                        Configuration            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
