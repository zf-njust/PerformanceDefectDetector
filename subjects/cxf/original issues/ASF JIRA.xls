    <a class="issue-link" data-issue-key="CXF-872" href="https://issues.apache.org/jira/browse/CXF-872">CXF-872</a>
</td>
                                            <td class="summary"><p>
                WS-Policy: Upgrade to www.w3.org/ns/ws-policy namespace
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
