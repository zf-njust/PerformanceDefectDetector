</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Linux debian + jdk1.5.0_11
  </td>
                                            <td class="description">      Got this incorrect wsdl <br/>
<br/>
&lt;wsdl:definitions name=&quot;serviceClass&quot; targetNamespace=&quot;http://test.acme.com&quot;&gt;<br/>
&lt;wsdl:portType name=&quot;serviceClassPortType&quot;&gt;<br/>
