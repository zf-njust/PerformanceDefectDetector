                                            <td class="summary"><p>
                Support for comments and exclusion list in idltowsdl
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ramanathan Krishnamurthy
    </td>
                                            <td class="creator">            Ramanathan Krishnamurthy
    </td>
                                            <td class="created"> 27/Jun/06 03:56 </td>
                                            <td class="lastViewed"> 25/Jul/17 13:07 </td>
                                            <td class="updated"> 26/Oct/11 17:12 </td>
                                            <td class="resolutiondate"> 09/Sep/11 18:07 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        CORBA Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
