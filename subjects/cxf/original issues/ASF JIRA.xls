    <a class="issue-link" data-issue-key="CXF-956" href="https://issues.apache.org/jira/browse/CXF-956">CXF-956</a>
</td>
                                            <td class="summary"><p>
                Wsdl2java not creating service interface method signatures right for wrapped document literal
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ben Brown
    </td>
                                            <td class="creator">            Ben Brown
    </td>
                                            <td class="created"> 30/Aug/07 06:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Feb/08 21:43 </td>
                                            <td class="resolutiondate"> 19/Feb/08 21:46 </td>
                                            <td class="versions">                        2.0.1            </td>
