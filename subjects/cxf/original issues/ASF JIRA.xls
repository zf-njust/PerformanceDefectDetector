                <tr id="issuerow12366000" rel="12366000" data-issuekey="CXF-497" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-497" href="https://issues.apache.org/jira/browse/CXF-497">CXF-497</a>
</td>
                                            <td class="summary"><p>
                if schema include &quot;any&quot; type, runtime will  fail
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Freeman Fang
    </td>
                                            <td class="creator">            Freeman Fang
    </td>
                                            <td class="created"> 28/Mar/07 09:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 18:06 </td>
                                            <td class="resolutiondate"> 18/Apr/07 01:39 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0-RC            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      if schema include &quot;any&quot; type, like<br/>
            &lt;element name=&quot;sayHi&quot;&gt;<br/>
                &lt;xs:complexType name=&quot;Reference&quot;&gt;<br/>
                    &lt;xs:sequence&gt;<br/>
                        &lt;xs:element name=&quot;port&quot; minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;<br/>
                            &lt;xs:complexType&gt;<br/>
                                &lt;xs:sequence&gt;<br/>
                                    &lt;xs:any namespace=&quot;##other&quot; processContents=&quot;lax&quot; minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;/&gt;<br/>
                                &lt;/xs:sequence&gt;<br/>
                            &lt;/xs:complexType&gt;<br/>
                        &lt;/xs:element&gt;<br/>
                    &lt;/xs:sequence&gt;<br/>
<br/>
                &lt;/xs:complexType&gt;<br/>
            &lt;/element&gt;<br/>
then runtime will fail when client side do mashall
  </td>
