    <a class="issue-link" data-issue-key="CXF-842" href="https://issues.apache.org/jira/browse/CXF-842">CXF-842</a>
</td>
                                            <td class="summary"><p>
                Code first, RPC/Lit with lots of inouts/outs/headers doesn&#39;t work
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
