    <a class="issue-link" data-issue-key="CXF-163" href="https://issues.apache.org/jira/browse/CXF-163">CXF-163</a>
</td>
                                            <td class="summary"><p>
                WSDL2Java fails to include endpointInterface WebService attribute for server Impl
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Seumas Soltysik
    </td>
                                            <td class="creator">            Seumas Soltysik
    </td>
                                            <td class="created"> 20/Oct/06 20:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Oct/06 08:31 </td>
                                            <td class="resolutiondate"> 25/Oct/06 08:31 </td>
                                            <td class="versions">                        2.0-M1            </td>
                                            <td class="fixVersions">                        2.0-M1            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
