    <a class="issue-link" data-issue-key="CXF-825" href="https://issues.apache.org/jira/browse/CXF-825">CXF-825</a>
</td>
                                            <td class="summary"><p>
                WSS4JOutInterceptor does not work without &quot;user&quot; Property
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Ulhas Bhole
    </td>
                                            <td class="reporter">            Matthias Germann
    </td>
                                            <td class="creator">            Matthias Germann
    </td>
                                            <td class="created"> 24/Jul/07 09:58 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Feb/08 21:36 </td>
                                            <td class="resolutiondate"> 19/Feb/08 21:10 </td>
                                            <td class="versions">                        2.0            </td>
                                            <td class="fixVersions">                        2.0.2            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
