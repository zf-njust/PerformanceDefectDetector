    <a class="issue-link" data-issue-key="CXF-631" href="https://issues.apache.org/jira/browse/CXF-631">CXF-631</a>
</td>
                                            <td class="summary"><p>
                Regression in simple front end WSDL auto-generation
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            maomaode
    </td>
                                            <td class="reporter">            Oisin Hurley
    </td>
                                            <td class="creator">            Oisin Hurley
    </td>
                                            <td class="created"> 03/May/07 13:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/07 02:03 </td>
                                            <td class="resolutiondate"> 01/Jun/07 08:12 </td>
                                            <td class="versions">                        2.0-RC            </td>
                                            <td class="fixVersions">                        2.0            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
