                <tr id="issuerow12352791" rel="12352791" data-issuekey="CXF-149" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-149" href="https://issues.apache.org/jira/browse/CXF-149">CXF-149</a>
</td>
                                            <td class="summary"><p>
                Use individual spec jars from apache/geronimo rather than single jboss dependencies in jca module
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            David Jencks
    </td>
                                            <td class="creator">            David Jencks
    </td>
                                            <td class="created"> 09/Oct/06 19:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
