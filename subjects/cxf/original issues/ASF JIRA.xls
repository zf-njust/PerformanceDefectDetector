                <tr id="issuerow12360296" rel="12360296" data-issuekey="CXF-362" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-362" href="https://issues.apache.org/jira/browse/CXF-362">CXF-362</a>
</td>
                                            <td class="summary"><p>
                wsdltojava generated code has inconsistent style
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            Peter Jones
    </td>
                                            <td class="creator">            Peter Jones
    </td>
                                            <td class="created"> 11/Jan/07 17:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Jul/07 08:05 </td>
                                            <td class="resolutiondate"> 30/Jul/07 08:05 </td>
                                            <td class="versions">                        2.0-RC            </td>
                                            <td class="fixVersions">                        2.0.1            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
