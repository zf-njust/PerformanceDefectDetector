                <tr id="issuerow12377338" rel="12377338" data-issuekey="CXF-963" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-963" href="https://issues.apache.org/jira/browse/CXF-963">CXF-963</a>
</td>
                                            <td class="summary"><p>
                Incorrect &quot;required&quot; property being added to XMLElement annotation.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Glen Mazza
    </td>
                                            <td class="creator">            Glen Mazza
    </td>
                                            <td class="created"> 03/Sep/07 01:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Sep/07 18:14 </td>
                                            <td class="resolutiondate"> 04/Sep/07 18:14 </td>
                                            <td class="versions">                        2.0.1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
