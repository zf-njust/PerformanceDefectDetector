    <a class="issue-link" data-issue-key="CXF-898" href="https://issues.apache.org/jira/browse/CXF-898">CXF-898</a>
</td>
                                            <td class="summary"><p>
                Invalid links in Service Listing at root of CXF servlet if the context path does not end in &#39;/&#39;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Andrew Phillips
    </td>
                                            <td class="creator">            Andrew Phillips
    </td>
                                            <td class="created"> 08/Aug/07 07:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/07 18:36 </td>
                                            <td class="resolutiondate"> 12/Aug/07 14:40 </td>
                                            <td class="versions">                        2.0            </td>
                                            <td class="fixVersions">                        2.0.2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
