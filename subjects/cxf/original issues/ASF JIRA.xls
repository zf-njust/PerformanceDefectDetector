    <a class="issue-link" data-issue-key="CXF-128" href="https://issues.apache.org/jira/browse/CXF-128">CXF-128</a>
</td>
                                            <td class="summary"><p>
                ReflectionServiceFactoryBean.isValidMethod() rejecting all the valid methods
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Jim Ma
    </td>
                                            <td class="creator">            Jim Ma
    </td>
