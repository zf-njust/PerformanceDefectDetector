                <tr id="issuerow12376114" rel="12376114" data-issuekey="CXF-911" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-911" href="https://issues.apache.org/jira/browse/CXF-911">CXF-911</a>
</td>
                                            <td class="summary"><p>
                java2wsdl goal of the codegen plugin does not throw an exception to stop the maven build on error
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            maomaode
    </td>
                                            <td class="reporter">            Jason Rosenberg
    </td>
                                            <td class="creator">            Jason Rosenberg
    </td>
                                            <td class="created"> 16/Aug/07 03:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Oct/07 16:46 </td>
                                            <td class="resolutiondate"> 20/Aug/07 02:58 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        2.0.2            </td>
                                            <td class="components">                        Build system            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
