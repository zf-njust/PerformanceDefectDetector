    <a class="issue-link" data-issue-key="CXF-117" href="https://issues.apache.org/jira/browse/CXF-117">CXF-117</a>
</td>
                                            <td class="summary"><p>
                Validator tool schema validation doesn&#39;t work when wsdl imports schema.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
