                                            <td class="summary"><p>
                endpoint address rewriting for user supplied wsdl
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
