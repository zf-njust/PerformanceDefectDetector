    <a class="issue-link" data-issue-key="CXF-633" href="https://issues.apache.org/jira/browse/CXF-633">CXF-633</a>
</td>
                                            <td class="summary"><p>
                SOAP 1.2 action header is sent incorrectly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
