                <tr id="issuerow12358801" rel="12358801" data-issuekey="CXF-318" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-318" href="https://issues.apache.org/jira/browse/CXF-318">CXF-318</a>
</td>
                                            <td class="summary"><p>
                Support for using Apache Qpid as a CXF transport.
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Suresh Kodichath
    </td>
                                            <td class="creator">            Suresh Kodichath
    </td>
                                            <td class="created"> 15/Dec/06 19:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:35 </td>
                                            <td class="resolutiondate"> 16/Oct/09 19:23 </td>
                                            <td class="versions">                        2.0-RC            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">2</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
