                                            <td class="summary"><p>
                Java first with external XSD does not resolve name spaces properly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Kaj Kandler
    </td>
                                            <td class="creator">            Kaj Kandler
    </td>
