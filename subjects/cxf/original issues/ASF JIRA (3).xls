                <tr id="issuerow12518573" rel="12518573" data-issuekey="CXF-3733" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3733" href="https://issues.apache.org/jira/browse/CXF-3733">CXF-3733</a>
</td>
                                            <td class="summary"><p>
                Introduce rt/rs/security/xml module
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
