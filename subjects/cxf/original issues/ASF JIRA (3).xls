                <tr id="issuerow12493560" rel="12493560" data-issuekey="CXF-3203" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3203" href="https://issues.apache.org/jira/browse/CXF-3203">CXF-3203</a>
</td>
                                            <td class="summary"><p>
                Introduce CXF X509 token 
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Sergey Beryozkin
    </td>
                                            <td class="creator">            Sergey Beryozkin
    </td>
                                            <td class="created"> 17/Dec/10 22:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Mar/17 09:30 </td>
                                            <td class="resolutiondate"> 28/Mar/17 09:30 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
