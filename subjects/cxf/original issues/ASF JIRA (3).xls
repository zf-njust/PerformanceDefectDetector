                <tr id="issuerow12493768" rel="12493768" data-issuekey="CXF-3211" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3211" href="https://issues.apache.org/jira/browse/CXF-3211">CXF-3211</a>
</td>
                                            <td class="summary"><p>
                Infinite loop in FileUtils.getDefaultTempDir() when &quot;java.io.tmpdir&quot; directory is not writable
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Eric Citaire
    </td>
                                            <td class="creator">            Eric Citaire
    </td>
                                            <td class="created"> 21/Dec/10 16:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Jul/13 19:29 </td>
                                            <td class="resolutiondate"> 22/Dec/10 08:09 </td>
                                            <td class="versions">                        2.2.6            </td>
                                            <td class="fixVersions">                        2.3.2,                     2.4            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      FileUtils.getDefaultTempDir() can go into a infinite loop when the &quot;java.io.tmpdir&quot; system property is set to an non-writable directory.<br/>
<br/>
See issue #CXF-1924.<br/>
<br/>
May be something like this would prevent an infinite loop :<br/>
<br/>
{{s = System.getProperty(&quot;java.io.tmpdir&quot;);}}<br/>
{{File checkExists = new File(s);}}<br/>
{{if (!checkExists.exists() || !checkExists.isDirectory() || !checkExists.canWrite()) {}}<br/>
 {{throw new RuntimeException(&quot;The directory &quot;}}<br/>
   {{+ checkExists.getAbsolutePath()}}<br/>
   {{+ &quot; is not a writable directory&quot;);}}<br/>
{{}}}<br/>
{{File f = new File(s, &quot;cxf-tmp-&quot; + x);}}<br/>
{{for (int attempts=0; attempts&lt;10; attempts++) {}}<br/>
 {{x = (int)(Math.random() * 1000000);}}<br/>
 {{f = new File(s, &quot;cxf-tmp-&quot; + x);}}<br/>
 {{if (f.mkdir()) break;}}<br/>
{{}}}<br/>
<br/>

  </td>
