                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Mar/11 15:53 </td>
                                            <td class="resolutiondate"> 18/Feb/11 23:58 </td>
                                            <td class="versions">                        2.3            </td>
                                            <td class="fixVersions">                        2.3.3            </td>
                                            <td class="components">                        Bus            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
