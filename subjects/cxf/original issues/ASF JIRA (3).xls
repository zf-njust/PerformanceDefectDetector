                      &lt;xs:simpleType&gt;<br/>
                        &lt;xs:restriction base=&quot;xs:string&quot;&gt;<br/>
                          &lt;xs:annotation&gt;<br/>
                            &lt;xs:documentation xml:lang=&quot;en&quot;&gt;Format limitations: an..3&lt;/xs:documentation&gt;<br/>
                          &lt;/xs:annotation&gt;<br/>
