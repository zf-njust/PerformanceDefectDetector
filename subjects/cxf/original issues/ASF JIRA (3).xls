                <tr id="issuerow12505807" rel="12505807" data-issuekey="CXF-3480" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3480" href="https://issues.apache.org/jira/browse/CXF-3480">CXF-3480</a>
</td>
                                            <td class="summary"><p>
                URIMappingInterceptor and ArrayIndexOutOfBounds Error
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Ron Grimes
    </td>
                                            <td class="creator">            Ron Grimes
    </td>
                                            <td class="created"> 29/Apr/11 17:12 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Aug/11 14:43 </td>
                                            <td class="resolutiondate"> 03/May/11 05:55 </td>
                                            <td class="versions">                        2.4            </td>
                                            <td class="fixVersions">                        2.4.1,                     2.3.5            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Tomcat 6.0.32, CXF 2.4, JDK 1.6.0_23
  </td>
                                            <td class="description">      URIMappingInterceptor keeps throwing ArrayIndexOutOfBounds error. <br/>
<br/>
Method:          getQueries<br/>
Statement (318): queries.put(keyValue[0], uriDecode(keyValue[1]));<br/>
<br/>
Proposed Fix<br/>
Change from:<br/>
{code}<br/>
        if (!StringUtils.isEmpty(query)) {            <br/>
            List&lt;String&gt; parts = Arrays.asList(query.split(&quot;&amp;&quot;));<br/>
            for (String part : parts) {<br/>
                String[] keyValue = part.split(&quot;=&quot;);<br/>
                queries.put(keyValue[0], uriDecode(keyValue[1]));<br/>
            }<br/>
            return queries;<br/>
        }<br/>
{code}<br/>
<br/>
Change to:<br/>
{code}<br/>
        if (!StringUtils.isEmpty(query)) { <br/>
            List&lt;String&gt; parts = Arrays.asList(query.split(&quot;&amp;&quot;));<br/>
            for (String part : parts) {<br/>
               if (part.contains(&quot;=&quot;)) {<br/>
                   String[] keyValue = part.split(&quot;=&quot;);<br/>
                   queries.put(keyValue[0], uriDecode(keyValue[1]));<br/>
               }<br/>
            }<br/>
            return queries;<br/>
        }<br/>
{code}
