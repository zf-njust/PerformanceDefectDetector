</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3198" href="https://issues.apache.org/jira/browse/CXF-3198">CXF-3198</a>
</td>
                                            <td class="summary"><p>
                XMLBeansElementProvider doesn&#39;t support text/xml
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Rahul Somasunderam
    </td>
                                            <td class="creator">            Rahul Somasunderam
    </td>
                                            <td class="created"> 16/Dec/10 21:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Jan/11 18:14 </td>
                                            <td class="resolutiondate"> 27/Dec/10 18:21 </td>
                                            <td class="versions">                        2.2.10            </td>
                                            <td class="fixVersions">                        2.3.2,                     2.4            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
