    <a class="issue-link" data-issue-key="CXF-3837" href="https://issues.apache.org/jira/browse/CXF-3837">CXF-3837</a>
</td>
                                            <td class="summary"><p>
                Allow JAXB Context customization on client
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">            Daniel Kulp
