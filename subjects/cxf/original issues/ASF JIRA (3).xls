                <tr id="issuerow12501443" rel="12501443" data-issuekey="CXF-3402" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3402" href="https://issues.apache.org/jira/browse/CXF-3402">CXF-3402</a>
</td>
                                            <td class="summary"><p>
                http://util.java in WSDL 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Jara Cesnek
    </td>
                                            <td class="creator">            Jara Cesnek
    </td>
                                            <td class="created"> 15/Mar/11 09:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Apr/11 12:44 </td>
                                            <td class="resolutiondate"> 15/Mar/11 18:50 </td>
                                            <td class="versions">                        2.3.2            </td>
                                            <td class="fixVersions">                        2.4            </td>
                                            <td class="components">                        Aegis Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      For SEI:<br/>
{code}<br/>
@WebService<br/>
public interface IStringSl {<br/>
  void storeStrings(@WebParam(name = &quot;stringsToStore&quot;) List&lt;DTOtra_string&gt; stringToStore);<br/>
}<br/>
<br/>
@XmlType ( name = &quot;DtoString&quot;)<br/>
public class DTOtra_string {<br/>
 ....<br/>
}<br/>
{code}<br/>
<br/>
there is many http://util.java namespaces in WSDL.<br/>
<br/>
Maybe this is bug maybe not? I dont know.<br/>
But I expect same wsdl as List&lt;&gt; is replaces with array.<br/>
WSDL with array is more clean.<br/>
<br/>
*Fortunately XML on-the-wire is almost same in booth cases.*<br/>
And our customers can consume booth without reimporting changed WSDL. <br/>
<br/>
Xml with array.<br/>
{code}<br/>
&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:sl=&quot;http://sl.tra.modules.daisy.marbes.cz/&quot; xmlns:dto=&quot;http://dto.tra.modules.daisy.marbes.cz&quot;&gt;<br/>
   &lt;soapenv:Header/&gt;<br/>
   &lt;soapenv:Body&gt;<br/>
      &lt;sl:storeStrings&gt;<br/>
         &lt;stringsToStore&gt;<br/>
            &lt;dto:DtoString&gt;<br/>
               &lt;dto:Anglicky&gt;?&lt;/dto:Anglicky&gt;<br/>
               &lt;dto:AnglickyPrelozeno&gt;true&lt;/dto:AnglickyPrelozeno&gt;<br/>
            &lt;/dto:DtoString&gt;<br/>
         &lt;/stringsToStore&gt;<br/>
      &lt;/sl:storeStrings&gt;<br/>
   &lt;/soapenv:Body&gt;<br/>
&lt;/soapenv:Envelope&gt;<br/>
{code}<br/>
<br/>
Xml with List&lt;&gt;.<br/>
{code}<br/>
&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:sl=&quot;http://sl.tra.modules.daisy.marbes.cz/&quot; xmlns:util=&quot;http://util.java&quot; xmlns:dto=&quot;http://dto.tra.modules.daisy.marbes.cz&quot;&gt;<br/>
   &lt;soapenv:Header/&gt;<br/>
   &lt;soapenv:Body&gt;<br/>
      &lt;sl:storeStrings&gt;<br/>
         &lt;stringsToStore&gt;<br/>
            &lt;util:DtoString&gt;<br/>
               &lt;dto:Anglicky&gt;?&lt;/dto:Anglicky&gt;<br/>
               &lt;dto:AnglickyPrelozeno&gt;true&lt;/dto:AnglickyPrelozeno&gt;<br/>
            &lt;/util:DtoString&gt;<br/>
         &lt;/stringsToStore&gt;<br/>
      &lt;/sl:storeStrings&gt;<br/>
   &lt;/soapenv:Body&gt;<br/>
&lt;/soapenv:Envelope&gt;<br/>
{code}<br/>
<br/>
<br/>
<br/>

  </td>
