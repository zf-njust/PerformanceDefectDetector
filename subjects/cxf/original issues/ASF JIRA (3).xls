    </td>
                                            <td class="created"> 18/Nov/11 12:32 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/11 16:15 </td>
                                            <td class="resolutiondate"> 30/Nov/11 02:35 </td>
                                            <td class="versions">                        2.4.4            </td>
                                            <td class="fixVersions">                        2.3.8,                     2.4.5,                     2.5.1            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
