                <tr id="issuerow12527929" rel="12527929" data-issuekey="CXF-3868" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3868" href="https://issues.apache.org/jira/browse/CXF-3868">CXF-3868</a>
</td>
                                            <td class="summary"><p>
                CXF STS WSDL not updating both SOAP 1.2 and SOAP 1.1 addresses upon initial &quot;?wsdl&quot; view from browser.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Glen Mazza
    </td>
                                            <td class="creator">            Glen Mazza
    </td>
                                            <td class="created"> 20/Oct/11 14:13 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:06 </td>
                                            <td class="resolutiondate"> 18/Sep/13 16:47 </td>
                                            <td class="versions">                        2.5            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Services            </td>
                                            <td class="duedate">    &nbsp;
</td>
