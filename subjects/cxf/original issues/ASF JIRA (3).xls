                <tr id="issuerow12496827" rel="12496827" data-issuekey="CXF-3291" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3291" href="https://issues.apache.org/jira/browse/CXF-3291">CXF-3291</a>
</td>
                                            <td class="summary"><p>
                Unmarshalling null value for java.lang.Long generates an empty string exception
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Victor-Adrian Ichim
    </td>
                                            <td class="creator">            Victor-Adrian Ichim
    </td>
                                            <td class="created"> 26/Jan/11 15:13 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Feb/11 15:38 </td>
                                            <td class="resolutiondate"> 08/Feb/11 12:56 </td>
                                            <td class="versions">                        2.3.1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
