                <tr id="issuerow12513266" rel="12513266" data-issuekey="CXF-3648" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3648" href="https://issues.apache.org/jira/browse/CXF-3648">CXF-3648</a>
</td>
                                            <td class="summary"><p>
                Wrong scope for commons-pool
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
