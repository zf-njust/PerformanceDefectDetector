                <tr id="issuerow12520718" rel="12520718" data-issuekey="CXF-3778" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3778" href="https://issues.apache.org/jira/browse/CXF-3778">CXF-3778</a>
</td>
                                            <td class="summary"><p>
                cxf-wadl2java-plugin (maven) does not generate an implementing service-class, neither with &lt;impl&gt;true&lt;/impl&gt; nor with &lt;extraarg&gt;-impl&lt;/extraarg&gt;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Oliver Jelinski
    </td>
                                            <td class="creator">            Oliver Jelinski
    </td>
                                            <td class="created"> 30/Aug/11 10:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/11 21:38 </td>
                                            <td class="resolutiondate"> 22/Sep/11 16:53 </td>
                                            <td class="versions">                        2.4.1,                     2.4.2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Maven 3.0-SNAPSHOT<br/>
Oracle Java jdk1.6_24
  </td>
                                            <td class="description">      cxf-wadl2java-plugin (maven) does not generate an implementing service-class, neither with &lt;impl&gt;true&lt;/true&gt; nor with &lt;extraarg&gt;-impl&lt;/extraarg&gt;.<br/>
<br/>
For example with these declarations:<br/>
<br/>
...<br/>
  &lt;properties&gt;<br/>
    &lt;cxf.version&gt;2.4.2&lt;/cxf.version&gt;<br/>
  &lt;/properties&gt;<br/>
<br/>
  &lt;dependencies&gt;<br/>
    &lt;dependency&gt;<br/>
      &lt;groupId&gt;org.apache.cxf&lt;/groupId&gt;<br/>
      &lt;artifactId&gt;cxf-rt-frontend-jaxrs&lt;/artifactId&gt;<br/>
      &lt;version&gt;${cxf.version}&lt;/version&gt;<br/>
    &lt;/dependency&gt;<br/>
  &lt;/dependencies&gt;<br/>
...<br/>
            &lt;plugin&gt;<br/>
                &lt;groupId&gt;org.apache.cxf&lt;/groupId&gt;<br/>
                &lt;artifactId&gt;cxf-wadl2java-plugin&lt;/artifactId&gt;<br/>
                &lt;version&gt;${cxf.version}&lt;/version&gt;<br/>
                &lt;executions&gt;<br/>
                    &lt;execution&gt;<br/>
                        &lt;id&gt;generate-sources&lt;/id&gt;<br/>
                        &lt;phase&gt;generate-sources&lt;/phase&gt;<br/>
                        &lt;configuration&gt;<br/>
                            &lt;sourceRoot&gt;${basedir}/target/generated-sources/cxf-rs&lt;/sourceRoot&gt;<br/>
                            &lt;wadlOptions&gt;<br/>
                                &lt;wadlOption&gt;<br/>
                                    &lt;wadl&gt;${basedir}/src/main/resources/wadl/RestTestService.wadl&lt;/wadl&gt;<br/>
					                &lt;extraargs&gt;<br/>
					                    &lt;extraarg&gt;-impl&lt;/extraarg&gt;<br/>
					                    &lt;extraarg&gt;-interface&lt;/extraarg&gt;<br/>
					                    &lt;extraarg&gt;-verbose&lt;/extraarg&gt;<br/>
					                &lt;/extraargs&gt;<br/>
                                    <br/>
                                    &lt;packagename&gt;rest.test.service&lt;/packagename&gt;<br/>
                                    &lt;schemaPackagenames&gt;<br/>
                                       &lt;schemaPackagename&gt;http://example.com/rest-test=rest.test.types&lt;/schemaPackagename&gt;<br/>
                                    &lt;/schemaPackagenames&gt;<br/>
                                    <br/>
                                &lt;/wadlOption&gt;<br/>
                            &lt;/wadlOptions&gt;<br/>
                        &lt;/configuration&gt;<br/>
                        &lt;goals&gt;<br/>
                            &lt;goal&gt;wadl2java&lt;/goal&gt;<br/>
                        &lt;/goals&gt;<br/>
                    &lt;/execution&gt;<br/>
                &lt;/executions&gt;<br/>
            &lt;/plugin&gt;<br/>
...<br/>
<br/>
Build is sucessful, the interface is generated, as well as the xml-types, but the impl class isn&#39;t.
  </td>
