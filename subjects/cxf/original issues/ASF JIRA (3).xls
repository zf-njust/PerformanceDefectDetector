                <tr id="issuerow12506354" rel="12506354" data-issuekey="CXF-3494" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3494" href="https://issues.apache.org/jira/browse/CXF-3494">CXF-3494</a>
</td>
                                            <td class="summary"><p>
                Out Of Memory Exception
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            jacques hefer
    </td>
                                            <td class="creator">            jacques hefer
    </td>
                                            <td class="created"> 06/May/11 00:28 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Oct/11 17:12 </td>
                                            <td class="resolutiondate"> 30/Aug/11 18:07 </td>
                                            <td class="versions">                        2.3.4            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        WS-* Components            </td>
