    <a class="issue-link" data-issue-key="CXF-3694" href="https://issues.apache.org/jira/browse/CXF-3694">CXF-3694</a>
</td>
                                            <td class="summary"><p>
                Migrate to Jetty 7.4.5 from 7.4.4.
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
