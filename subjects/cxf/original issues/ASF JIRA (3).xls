                <tr id="issuerow12498201" rel="12498201" data-issuekey="CXF-3325" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3325" href="https://issues.apache.org/jira/browse/CXF-3325">CXF-3325</a>
</td>
                                            <td class="summary"><p>
                Logging interceptors should show the HTTP method
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
