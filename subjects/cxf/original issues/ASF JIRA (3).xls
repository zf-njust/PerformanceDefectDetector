    <a class="issue-link" data-issue-key="CXF-4064" href="https://issues.apache.org/jira/browse/CXF-4064">CXF-4064</a>
</td>
                                            <td class="summary"><p>
                Problem with JAX-RS annotated interface 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
