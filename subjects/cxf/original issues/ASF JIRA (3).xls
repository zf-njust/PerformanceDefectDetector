                <tr id="issuerow12519828" rel="12519828" data-issuekey="CXF-3758" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3758" href="https://issues.apache.org/jira/browse/CXF-3758">CXF-3758</a>
</td>
                                            <td class="summary"><p>
                when web container be redeployed WebServiceContextImpl&#39;s static atrribute ThreadLocal&lt;MessageContext&gt; may not be release successfully.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            bohr.qiu
    </td>
                                            <td class="creator">            bohr.qiu
    </td>
