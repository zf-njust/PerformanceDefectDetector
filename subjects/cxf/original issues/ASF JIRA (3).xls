                <tr id="issuerow12503915" rel="12503915" data-issuekey="CXF-3451" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3451" href="https://issues.apache.org/jira/browse/CXF-3451">CXF-3451</a>
</td>
                                            <td class="summary"><p>
                Can CXF support multiple response?
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            David Liu
    </td>
                                            <td class="creator">            David Liu
    </td>
                                            <td class="created"> 11/Apr/11 09:38 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Apr/11 05:45 </td>
                                            <td class="resolutiondate"> 12/Apr/11 02:13 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core,                     Service Model            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
