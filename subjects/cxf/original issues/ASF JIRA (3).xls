    <a class="issue-link" data-issue-key="CXF-3954" href="https://issues.apache.org/jira/browse/CXF-3954">CXF-3954</a>
</td>
                                            <td class="summary"><p>
                Could not obtain STS metadata. MEX call failed
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
