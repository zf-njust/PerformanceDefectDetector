</td>
                                            <td class="summary"><p>
                Avoid parsing the SOAP Body to DOM in WS-Security processing unless necessary
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 25/Feb/11 15:32 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Nov/11 20:58 </td>
                                            <td class="resolutiondate"> 12/Sep/11 09:28 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
