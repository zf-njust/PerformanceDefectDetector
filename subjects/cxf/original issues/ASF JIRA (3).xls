                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Jan/11 18:14 </td>
                                            <td class="resolutiondate"> 17/Jan/11 20:18 </td>
                                            <td class="versions">                        2.3.1            </td>
                                            <td class="fixVersions">                        2.3.2,                     2.4            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
