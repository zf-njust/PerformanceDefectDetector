                                            <td class="created"> 23/Nov/10 08:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Dec/10 22:49 </td>
                                            <td class="resolutiondate"> 24/Nov/10 06:44 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.2.12            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
