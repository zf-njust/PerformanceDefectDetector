    <a class="issue-link" data-issue-key="CXF-3867" href="https://issues.apache.org/jira/browse/CXF-3867">CXF-3867</a>
</td>
                                            <td class="summary"><p>
                Fix for CXF-1816 causes startup performance regression
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Joel Turkel
    </td>
                                            <td class="creator">            Joel Turkel
    </td>
