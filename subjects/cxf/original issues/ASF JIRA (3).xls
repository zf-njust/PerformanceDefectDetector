    <a class="issue-link" data-issue-key="CXF-3719" href="https://issues.apache.org/jira/browse/CXF-3719">CXF-3719</a>
</td>
                                            <td class="summary"><p>
                NullPointerException When using TransformOutInterceptor
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Later
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Christopher Marshall
    </td>
                                            <td class="creator">            Christopher Marshall
    </td>
                                            <td class="created"> 08/Aug/11 19:02 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/11 16:15 </td>
                                            <td class="resolutiondate"> 10/Aug/11 13:53 </td>
                                            <td class="versions">                        2.4.1            </td>
                                            <td class="fixVersions">                        2.5.1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
