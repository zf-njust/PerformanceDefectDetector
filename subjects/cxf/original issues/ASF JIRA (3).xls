    <a class="issue-link" data-issue-key="CXF-3860" href="https://issues.apache.org/jira/browse/CXF-3860">CXF-3860</a>
</td>
                                            <td class="summary"><p>
                CXF sample &quot;restful_dispatch&quot; Readme.txt need to be updated
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
