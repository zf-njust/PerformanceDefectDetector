{code:xml}<br/>
&lt;mappings xmlns=&quot;http://webservice.com&quot; &gt;<br/>
	&lt;mapping name=&quot;Employee&quot; &gt;<br/>
		&lt;property name=&quot;name&quot; mappedName=&quot;Name&quot; /&gt;<br/>
