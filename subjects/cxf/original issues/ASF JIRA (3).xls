    <a class="issue-link" data-issue-key="CXF-3729" href="https://issues.apache.org/jira/browse/CXF-3729">CXF-3729</a>
</td>
                                            <td class="summary"><p>
                TLSParameterJaxBUtils is unable to use keystores with empty file/url/resource.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
