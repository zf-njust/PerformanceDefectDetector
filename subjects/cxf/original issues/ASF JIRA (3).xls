                <tr id="issuerow12534070" rel="12534070" data-issuekey="CXF-3960" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3960" href="https://issues.apache.org/jira/browse/CXF-3960">CXF-3960</a>
</td>
                                            <td class="summary"><p>
                Patch for InitiatorSignatureToken Support in WS-Policy definition
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Vinay Penmatsa
    </td>
                                            <td class="creator">            Vinay Penmatsa
    </td>
                                            <td class="created"> 06/Dec/11 18:53 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/11 16:15 </td>
                                            <td class="resolutiondate"> 08/Dec/11 15:16 </td>
                                            <td class="versions">                        2.4.4            </td>
                                            <td class="fixVersions">                        2.4.5,                     2.5.1            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      CXF supported environments
  </td>
                                            <td class="description">      This patch adds support for InitiatorSignatureToken assertion. Support for IntiatorEncryptionToken and corresponding recipient tokens will be added subsequently.<br/>
Here&#39;s an example of supported policy definition:<br/>
{code:xml} <br/>
&lt;sp:AsymmetricBinding&gt;<br/>
  &lt;wsp:Policy&gt;<br/>
    &lt;sp:InitiatorSignatureToken&gt;<br/>
      &lt;wsp:Policy&gt;<br/>
	&lt;sp:X509Token sp:IncludeToken=&quot;http://docs.oasis-open.org/ws-sx/ws-securitypolicy/200702/IncludeToken/AlwaysToRecipient&quot;&gt;			<br/>
	  &lt;wsp:Policy&gt;<br/>
	    &lt;sp:RequireThumbprintReference/&gt;<br/>
	    &lt;sp:WssX509V3Token10/&gt;<br/>
	  &lt;/wsp:Policy&gt;	<br/>
	&lt;/sp:X509Token&gt;<br/>
	&lt;/wsp:Policy&gt;<br/>
    &lt;/sp:InitiatorSignatureToken&gt;<br/>
    &lt;sp:RecipientToken&gt;<br/>
      &lt;wsp:Policy&gt;<br/>
	&lt;sp:X509Token sp:IncludeToken=&quot;http://docs.oasis-open.org/ws-sx/ws-securitypolicy/200702/IncludeToken/Always&quot;&gt;	<br/>
	  &lt;wsp:Policy&gt;<br/>
	    &lt;sp:RequireThumbprintReference/&gt;<br/>
	    &lt;sp:WssX509V3Token10/&gt;<br/>
	  &lt;/wsp:Policy&gt;								<br/>
	&lt;/sp:X509Token&gt;<br/>
      &lt;/wsp:Policy&gt;<br/>
    &lt;/sp:RecipientToken&gt;<br/>
    &lt;sp:AlgorithmSuite&gt;<br/>
      &lt;wsp:Policy&gt;<br/>
	&lt;sp:TripleDesRsa15/&gt;			<br/>
	&lt;/wsp:Policy&gt;<br/>
    &lt;/sp:AlgorithmSuite&gt;<br/>
    &lt;sp:Layout&gt;<br/>
      &lt;wsp:Policy&gt;<br/>
	&lt;sp:Lax /&gt;<br/>
      &lt;/wsp:Policy&gt;<br/>
    &lt;/sp:Layout&gt;		<br/>
    &lt;sp:IncludeTimestamp/&gt;			<br/>
    &lt;sp:OnlySignEntireHeadersAndBody /&gt;						<br/>
  &lt;/wsp:Policy&gt;					<br/>
&lt;/sp:AsymmetricBinding&gt;<br/>
{code}<br/>

  </td>
