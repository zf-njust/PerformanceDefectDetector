    <a class="issue-link" data-issue-key="CXF-3780" href="https://issues.apache.org/jira/browse/CXF-3780">CXF-3780</a>
</td>
                                            <td class="summary"><p>
                DynamicClientFactory trying to resolve wsdl URL prior to calling into service factories
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
