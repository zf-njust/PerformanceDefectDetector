                <tr id="issuerow12477780" rel="12477780" data-issuekey="CXF-3074" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3074" href="https://issues.apache.org/jira/browse/CXF-3074">CXF-3074</a>
</td>
                                            <td class="summary"><p>
                Add a fork parameter in the cxf-java2ws-plugin
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
