</td>
                                            <td class="summary"><p>
                WADL Generator ignores @PathParams mapped on class fields
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Raphael Vullriede
    </td>
                                            <td class="creator">            Raphael Vullriede
    </td>
                                            <td class="created"> 04/Jul/11 10:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Aug/11 03:30 </td>
                                            <td class="resolutiondate"> 12/Jul/11 17:17 </td>
                                            <td class="versions">                        2.4.1            </td>
                                            <td class="fixVersions">                        2.4.2,                     2.5            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
