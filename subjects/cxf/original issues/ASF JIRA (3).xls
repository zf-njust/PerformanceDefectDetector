    <a class="issue-link" data-issue-key="CXF-3790" href="https://issues.apache.org/jira/browse/CXF-3790">CXF-3790</a>
</td>
                                            <td class="summary"><p>
                org.apache.cxf.jaxws.interceptors.WrapperClassInInterceptor.handleMessage(Message) contains cruft code
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Gary Gregory
    </td>
                                            <td class="creator">            Gary Gregory
    </td>
                                            <td class="created"> 02/Sep/11 14:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Oct/11 17:30 </td>
                                            <td class="resolutiondate"> 02/Sep/11 16:05 </td>
                                            <td class="versions">                        2.4.2            </td>
                                            <td class="fixVersions">                        2.3.7,                     2.4.3            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
