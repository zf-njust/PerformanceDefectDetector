org.apache.cxf.binding.soap.SoapFault: Exception from postMessages<br/>
<br/>
<br/>
<br/>
Here is the client Code.<br/>
<br/>
		try<br/>
		{<br/>
			JaxWsDynamicClientFactory dcf = JaxWsDynamicClientFactory.newInstance();<br/>
			Client client = dcf.createClient(&quot;http://localhost:8080/contactUs/contactus?wsdl&quot;, Thread.currentThread().getContextClassLoader());<br/>
			client.invoke(&quot;postMessage&quot;, &quot;test&quot;);<br/>
		}<br/>
		catch(Exception e){<br/>
			System.out.println(e);<br/>
		}<br/>
			<br/>

