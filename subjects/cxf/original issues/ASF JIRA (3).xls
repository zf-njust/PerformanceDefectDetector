    <a class="issue-link" data-issue-key="CXF-3296" href="https://issues.apache.org/jira/browse/CXF-3296">CXF-3296</a>
</td>
                                            <td class="summary"><p>
                wsdl2java tool should always use catalog to resovle the overwriten url firstly 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
