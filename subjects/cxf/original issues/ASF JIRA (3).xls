Caused by: java.lang.NullPointerException<br/>
        at org.apache.cxf.tools.corba.processors.idl.ConstVisitor.visit(ConstVisitor.java:97)<br/>
        at org.apache.cxf.tools.corba.processors.idl.DefinitionVisitor.visit(DefinitionVisitor.java:85)<br/>
        at org.apache.cxf.tools.corba.processors.idl.ModuleVisitor.visit(ModuleVisitor.java:53)<br/>
