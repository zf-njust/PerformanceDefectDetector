    <a class="issue-link" data-issue-key="CXF-3204" href="https://issues.apache.org/jira/browse/CXF-3204">CXF-3204</a>
</td>
                                            <td class="summary"><p>
                DynamicClientFactory.setupClasspath method cannot handle spaces in path
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Issam Bandak
    </td>
                                            <td class="creator">            Issam Bandak
    </td>
                                            <td class="created"> 19/Dec/10 03:32 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Apr/11 12:44 </td>
                                            <td class="resolutiondate"> 07/Apr/11 22:06 </td>
                                            <td class="versions">                        2.2.10,                     2.3,                     2.2.11,                     2.2.12,                     2.3.1,                     2.3.2,                     2.3.3            </td>
                                            <td class="fixVersions">                        2.3.4            </td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
