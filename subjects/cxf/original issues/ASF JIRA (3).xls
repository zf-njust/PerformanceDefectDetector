    <a class="issue-link" data-issue-key="CXF-3889" href="https://issues.apache.org/jira/browse/CXF-3889">CXF-3889</a>
</td>
                                            <td class="summary"><p>
                OOM when uploading files greater than 2GB
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Narayanan Arunachalam
    </td>
                                            <td class="creator">            Narayanan Arunachalam
    </td>
                                            <td class="created"> 28/Oct/11 19:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Nov/11 05:48 </td>
                                            <td class="resolutiondate"> 28/Oct/11 20:30 </td>
                                            <td class="versions">                        2.4.3            </td>
                                            <td class="fixVersions">                        2.5            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">86400</td>
