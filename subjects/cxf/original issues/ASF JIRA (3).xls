    <a class="issue-link" data-issue-key="CXF-3218" href="https://issues.apache.org/jira/browse/CXF-3218">CXF-3218</a>
</td>
                                            <td class="summary"><p>
                apparent regression introduced between 2.2.8 and 2.2.9:  http://docs.oasis-open.org/ws-sx/ws-trust/200512/RST/SCT not supported
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            John J. Franey
    </td>
                                            <td class="creator">            John J. Franey
    </td>
                                            <td class="created"> 24/Dec/10 18:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Jan/11 18:14 </td>
                                            <td class="resolutiondate"> 04/Jan/11 21:28 </td>
                                            <td class="versions">                        2.3.1            </td>
                                            <td class="fixVersions">                        2.3.2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
