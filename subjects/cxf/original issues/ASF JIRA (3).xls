                <tr id="issuerow12497145" rel="12497145" data-issuekey="CXF-3293" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3293" href="https://issues.apache.org/jira/browse/CXF-3293">CXF-3293</a>
</td>
                                            <td class="summary"><p>
                idl2wsdl tool fails if parameter refer an interface from other module in an included idl file
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
