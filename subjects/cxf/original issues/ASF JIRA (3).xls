                                            <td class="resolutiondate"> 21/Jan/11 20:07 </td>
                                            <td class="versions">                        2.3.1            </td>
                                            <td class="fixVersions">                        2.3.3            </td>
                                            <td class="components">    &nbsp;
</td>
