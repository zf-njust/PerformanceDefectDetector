    <a class="issue-link" data-issue-key="CXF-3572" href="https://issues.apache.org/jira/browse/CXF-3572">CXF-3572</a>
</td>
                                            <td class="summary"><p>
                Add a check of the message content list to avoid the OoM error from the HolderOutInterceptor
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
