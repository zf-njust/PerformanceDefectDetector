                <tr id="issuerow12518304" rel="12518304" data-issuekey="CXF-3723" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3723" href="https://issues.apache.org/jira/browse/CXF-3723">CXF-3723</a>
</td>
                                            <td class="summary"><p>
                clientCreated() of ClientLifeCycleListener can&#39;t be invoked on Spring created clients
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Xilai Dai
    </td>
                                            <td class="creator">            Xilai Dai
    </td>
                                            <td class="created"> 09/Aug/11 10:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Aug/11 03:30 </td>
                                            <td class="resolutiondate"> 10/Aug/11 15:20 </td>
                                            <td class="versions">                        2.5            </td>
                                            <td class="fixVersions">                        2.4.2            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
