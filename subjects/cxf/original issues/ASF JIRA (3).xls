                <tr id="issuerow12537338" rel="12537338" data-issuekey="CXF-4010" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-4010" href="https://issues.apache.org/jira/browse/CXF-4010">CXF-4010</a>
</td>
                                            <td class="summary"><p>
                Add ability to specific EncryptionProperties per STS instance
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 05/Jan/12 15:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Feb/12 21:50 </td>
                                            <td class="resolutiondate"> 05/Jan/12 15:15 </td>
                                            <td class="versions">                        2.5.1            </td>
                                            <td class="fixVersions">                        2.5.2            </td>
                                            <td class="components">                        Services            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      This task is to add the ability to specify an EncryptionProperties per STS instance. Currently it can only be configured per-service. If the request does not contain an &quot;AppliesTo&quot; field, then this will be skipped. This will allow the STS user to specify a different default encryption algorithm, for example.
  </td>
                                            <td class="security"></td>
