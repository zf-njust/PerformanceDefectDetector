    <a class="issue-link" data-issue-key="CXF-3077" href="https://issues.apache.org/jira/browse/CXF-3077">CXF-3077</a>
</td>
                                            <td class="summary"><p>
                java.lang.InstantiationException: org.apache.cxf.wstx_msv_validation.WoodstoxValidationImpl
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
