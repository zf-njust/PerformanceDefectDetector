&lt;xs:schema xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; targetNamespace=&quot;http://xml.amadeus.com/FMPTBR_08_2_1A&quot; xmlns=&quot;http://xml.amadeus.com/FMPTBR_08_2_1A&quot; elementFormDefault=&quot;qualified&quot;&gt;<br/>
  &lt;xs:element name=&quot;Fare_MasterPricerTravelBoardSearchReply&quot;&gt;<br/>
    &lt;xs:complexType&gt;<br/>
