                <tr id="issuerow12514724" rel="12514724" data-issuekey="CXF-3670" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3670" href="https://issues.apache.org/jira/browse/CXF-3670">CXF-3670</a>
</td>
                                            <td class="summary"><p>
                Regression CXF-3159: Jettison required for json processing with some classloader implementations
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Mike Youngstrom
    </td>
                                            <td class="creator">            Mike Youngstrom
    </td>
                                            <td class="created"> 19/Jul/11 23:57 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Aug/11 03:29 </td>
                                            <td class="resolutiondate"> 20/Jul/11 23:17 </td>
                                            <td class="versions">                        2.4.1            </td>
                                            <td class="fixVersions">                        2.4.2,                     2.5            </td>
                                            <td class="components">                        JAX-RS            </td>
