                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:38 </td>
                                            <td class="resolutiondate"> 30/Mar/17 19:53 </td>
                                            <td class="versions">                        2.4.3            </td>
                                            <td class="fixVersions">                        3.0            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
