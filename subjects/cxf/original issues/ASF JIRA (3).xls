    <a class="issue-link" data-issue-key="CXF-3252" href="https://issues.apache.org/jira/browse/CXF-3252">CXF-3252</a>
</td>
                                            <td class="summary"><p>
                org.apache.cxf.ws.addressing.ContextUtils.getAction should support namespace &quot;http://www.w3.org/2005/08/addressing&quot; 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Willem Jiang
    </td>
                                            <td class="creator">            Willem Jiang
    </td>
                                            <td class="created"> 17/Jan/11 08:49 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Jul/13 19:29 </td>
                                            <td class="resolutiondate"> 17/Jan/11 09:58 </td>
                                            <td class="versions">                        2.2.9,                     2.1.10,                     2.0.13,                     2.2.10,                     2.3,                     2.2.11,                     2.2.12,                     2.3.1            </td>
                                            <td class="fixVersions">                        2.3.2,                     2.4            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
