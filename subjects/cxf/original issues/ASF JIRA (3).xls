                <tr id="issuerow12500623" rel="12500623" data-issuekey="CXF-3382" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3382" href="https://issues.apache.org/jira/browse/CXF-3382">CXF-3382</a>
</td>
                                            <td class="summary"><p>
                Mess in WSDL (targetNamespace=&quot;http://util.java&quot;)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jara Cesnek
    </td>
                                            <td class="creator">            Jara Cesnek
    </td>
                                            <td class="created"> 07/Mar/11 13:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Apr/11 12:47 </td>
                                            <td class="resolutiondate"> 15/Mar/11 07:46 </td>
                                            <td class="versions">                        2.3.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Aegis Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      I realy dont expect &quot;http://util.java&quot; in wsdl :<br/>
<br/>
{code}<br/>
- &lt;xsd:schema attributeFormDefault=&quot;qualified&quot; elementFormDefault=&quot;qualified&quot; targetNamespace=&quot;http://util.java&quot; xmlns:ns0=&quot;http://dto.tra.modules.daisy.marbes.cz&quot; xmlns:tns=&quot;http://util.java&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot;&gt;<br/>
  &lt;xsd:import namespace=&quot;http://dto.tra.modules.daisy.marbes.cz&quot; /&gt; <br/>
- &lt;xsd:complexType name=&quot;stringsToStore&quot;&gt;<br/>
- &lt;xsd:sequence&gt;<br/>
  &lt;xsd:element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;DtoString&quot; nillable=&quot;true&quot; type=&quot;ns0:DtoString&quot; /&gt; <br/>
  &lt;/xsd:sequence&gt;<br/>
  &lt;/xsd:complexType&gt;<br/>
  &lt;/xsd:schema&gt;<br/>
<br/>
{code}<br/>
<br/>
Used collection type in interface is &quot;java.util.List&lt;&gt;&quot;.<br/>
<br/>
Quick fix is use array instead.
  </td>
