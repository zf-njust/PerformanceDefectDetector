                                            <td class="summary"><p>
                ManagedEndpoint.getTransportId return endpoint address
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
