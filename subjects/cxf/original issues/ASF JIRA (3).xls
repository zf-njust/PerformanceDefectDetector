    <a class="issue-link" data-issue-key="CXF-3709" href="https://issues.apache.org/jira/browse/CXF-3709">CXF-3709</a>
</td>
                                            <td class="summary"><p>
                Incorrect URL handling in org.apache.cxf.transport.servlet.BaseUrlHelper method getBaseURL
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Konstantin V. Salikhov
    </td>
                                            <td class="creator">            Konstantin V. Salikhov
    </td>
                                            <td class="created"> 04/Aug/11 13:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Aug/11 03:30 </td>
                                            <td class="resolutiondate"> 05/Aug/11 09:39 </td>
                                            <td class="versions">                        2.4.1            </td>
                                            <td class="fixVersions">                        2.4.2,                     2.5            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
