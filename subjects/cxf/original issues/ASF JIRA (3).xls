                <tr id="issuerow12494306" rel="12494306" data-issuekey="CXF-3224" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3224" href="https://issues.apache.org/jira/browse/CXF-3224">CXF-3224</a>
</td>
                                            <td class="summary"><p>
                WS-Trust: remove current wst:KeyType and wst:KeySize defaults
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Willem Salembier
    </td>
                                            <td class="creator">            Willem Salembier
    </td>
                                            <td class="created"> 30/Dec/10 14:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Apr/11 12:42 </td>
                                            <td class="resolutiondate"> 22/Mar/11 13:26 </td>
                                            <td class="versions">                        2.3.1            </td>
                                            <td class="fixVersions">                        2.4,                     2.3.4            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Currently the RST always contains a wst:KeyType and wst:KeySize field. The WS-Trust 1.3 specification says these tags are optional.<br/>
<br/>
We like CXF to render the following simple RST to ask for a SAML v1.1 token.<br/>
<br/>
 &lt;wst:RequestSecurityToken Context=&quot;abc&quot; xmlns:ns1=&quot;http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd&quot; xmlns:auth=&quot;http://schemas.xmlsoap.org/ws/2006/12/authorization&quot; xmlns:wst=&quot;http://docs.oasis-open.org/ws-sx/ws-trust/200512&quot;&gt;<br/>
         &lt;wst:TokenType&gt;http://docs.oasis-open.org/wss/oasis-wss-saml-token-profile-1.1#SAMLV1.1&lt;/wst:TokenType&gt;<br/>
         &lt;wst:RequestType&gt;http://docs.oasis-open.org/ws-sx/ws-trust/200512/Issue&lt;/wst:RequestType&gt;<br/>
         &lt;wst:Claims Dialect=&quot;http://schemas.xmlsoap.org/ws/2006/12/authorization/authclaims&quot;&gt;<br/>
            &lt;auth:ClaimType Uri=&quot;urn:be:my_claim_attribute&quot;&gt;<br/>
               &lt;auth:Value&gt;1234&lt;/auth:Value&gt;<br/>
            &lt;/auth:ClaimType&gt;<br/>
         &lt;/wst:Claims&gt;<br/>
      &lt;/wst:RequestSecurityToken&gt;<br/>

  </td>
