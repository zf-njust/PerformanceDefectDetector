                                            <td class="resolutiondate"> 12/Dec/11 22:02 </td>
                                            <td class="versions">                        2.2,                     2.3,                     2.4            </td>
                                            <td class="fixVersions">                        2.3.8,                     2.4.5,                     2.5.1            </td>
