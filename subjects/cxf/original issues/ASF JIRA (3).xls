</td>
                                            <td class="summary"><p>
                Refactoring to decrease code &#39;duplications&#39; percentage to under 5 percent.
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Robert Liguori
    </td>
                                            <td class="creator">            Robert Liguori
    </td>
                                            <td class="created"> 30/Sep/11 23:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Oct/11 03:12 </td>
                                            <td class="resolutiondate"> 06/Oct/11 03:12 </td>
                                            <td class="versions">                        2.5            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
