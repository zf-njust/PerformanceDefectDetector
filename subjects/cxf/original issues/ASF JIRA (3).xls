    <a class="issue-link" data-issue-key="CXF-3471" href="https://issues.apache.org/jira/browse/CXF-3471">CXF-3471</a>
</td>
                                            <td class="summary"><p>
                JAX-RS attachment content its are malformed
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
