    <a class="issue-link" data-issue-key="CXF-3932" href="https://issues.apache.org/jira/browse/CXF-3932">CXF-3932</a>
</td>
                                            <td class="summary"><p>
                RSTR Lifetime element sets current time in Created element
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
