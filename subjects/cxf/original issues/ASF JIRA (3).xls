                <tr id="issuerow12497973" rel="12497973" data-issuekey="CXF-3318" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3318" href="https://issues.apache.org/jira/browse/CXF-3318">CXF-3318</a>
</td>
                                            <td class="summary"><p>
                The &quot;ws-security.ut.no-callbacks&quot; property needs to be renamed
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Sergey Beryozkin
    </td>
                                            <td class="creator">            Sergey Beryozkin
    </td>
                                            <td class="created"> 08/Feb/11 11:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Apr/11 12:42 </td>
                                            <td class="resolutiondate"> 08/Feb/11 11:45 </td>
                                            <td class="versions">                        2.4            </td>
                                            <td class="fixVersions">                        2.4            </td>
