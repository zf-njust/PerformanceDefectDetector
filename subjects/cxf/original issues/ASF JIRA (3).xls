                <tr id="issuerow12479080" rel="12479080" data-issuekey="CXF-3110" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3110" href="https://issues.apache.org/jira/browse/CXF-3110">CXF-3110</a>
</td>
                                            <td class="summary"><p>
                jaxrs: ParameterizedTypeImpl cannot be cast to java.lang.Class
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Stephane Chomat
    </td>
                                            <td class="creator">            Stephane Chomat
