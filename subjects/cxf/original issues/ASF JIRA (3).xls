</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3722" href="https://issues.apache.org/jira/browse/CXF-3722">CXF-3722</a>
</td>
                                            <td class="summary"><p>
                Generic interface and Implementation
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Deboschère Tony
    </td>
                                            <td class="creator">            Deboschère Tony
    </td>
                                            <td class="created"> 09/Aug/11 09:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Mar/14 02:06 </td>
                                            <td class="resolutiondate"> 10/Aug/11 15:22 </td>
                                            <td class="versions">                        2.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
