                <tr id="issuerow12501383" rel="12501383" data-issuekey="CXF-3401" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3401" href="https://issues.apache.org/jira/browse/CXF-3401">CXF-3401</a>
</td>
                                            <td class="summary"><p>
                soap.env.ns.map cannot be set on enpoint
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
                                            <td class="created"> 14/Mar/11 17:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Apr/11 12:42 </td>
                                            <td class="resolutiondate"> 14/Mar/11 18:30 </td>
                                            <td class="versions">                        2.3.3            </td>
                                            <td class="fixVersions">                        2.4,                     2.3.4            </td>
                                            <td class="components">                        Soap Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      <br/>
The soap.env.ns.map namespace map is only looked up on the message itself.  It&#39;s not  treated as a contextual property. Thus, it cannot be set on a jaxws:endpoint and have it properly picked up.
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
