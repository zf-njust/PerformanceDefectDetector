    <a class="issue-link" data-issue-key="CXF-3346" href="https://issues.apache.org/jira/browse/CXF-3346">CXF-3346</a>
</td>
                                            <td class="summary"><p>
                Wrong Error Message &#39;Content is not allowed in prolog&#39; On Empty Schema Includes
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Robert Lalyko
    </td>
                                            <td class="creator">            Robert Lalyko
    </td>
                                            <td class="created"> 18/Feb/11 09:25 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Apr/11 12:47 </td>
                                            <td class="resolutiondate"> 21/Feb/11 06:51 </td>
                                            <td class="versions">                        2.3            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Tooling            </td>
