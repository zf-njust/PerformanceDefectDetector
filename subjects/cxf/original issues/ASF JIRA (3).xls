                <tr id="issuerow12521178" rel="12521178" data-issuekey="CXF-3787" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3787" href="https://issues.apache.org/jira/browse/CXF-3787">CXF-3787</a>
</td>
                                            <td class="summary"><p>
                CXF does not set the correct host when viewing WSDLs that are published with JAXWS API
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Alessio Soldano
    </td>
                                            <td class="reporter">            Magesh Kumar Bojan
    </td>
                                            <td class="creator">            Magesh Kumar Bojan
    </td>
                                            <td class="created"> 02/Sep/11 12:31 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Oct/11 17:30 </td>
                                            <td class="resolutiondate"> 23/Sep/11 17:59 </td>
                                            <td class="versions">                        2.4.1            </td>
                                            <td class="fixVersions">                        2.4.3,                     2.5            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      JAXWS frontend using HTTP transport
  </td>
                                            <td class="description">      Using Endpoint.publish method when the WSDL is queried the soap:address returned is always the local address rather than the requester&#39;s address. For such endpoints the rewriteSoapAddress property is null, so the code modifies the soap:address (MessageUtils.isTrue(rewriteSoapAddress)), but the base URL is always pointing to the localAddress.<br/>
<br/>

  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
