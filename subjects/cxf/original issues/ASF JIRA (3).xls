                <tr id="issuerow12478009" rel="12478009" data-issuekey="CXF-3079" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3079" href="https://issues.apache.org/jira/browse/CXF-3079">CXF-3079</a>
</td>
                                            <td class="summary"><p>
                Javadoc refinements are necesarry as exposed by the CXF build process (mvn -e)
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Robert Liguori
    </td>
                                            <td class="creator">            Robert Liguori
    </td>
                                            <td class="created"> 21/Oct/10 16:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Jan/11 18:14 </td>
                                            <td class="resolutiondate"> 12/Jan/11 19:58 </td>
                                            <td class="versions">                        2.3            </td>
                                            <td class="fixVersions">                        2.3.2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
