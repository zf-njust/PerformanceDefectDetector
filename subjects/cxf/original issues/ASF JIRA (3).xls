    <a class="issue-link" data-issue-key="CXF-3957" href="https://issues.apache.org/jira/browse/CXF-3957">CXF-3957</a>
</td>
                                            <td class="summary"><p>
                Cannot convert to javax.xml.ws.handler 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
