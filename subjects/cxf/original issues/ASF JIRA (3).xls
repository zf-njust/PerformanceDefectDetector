                <tr id="issuerow12513772" rel="12513772" data-issuekey="CXF-3651" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3651" href="https://issues.apache.org/jira/browse/CXF-3651">CXF-3651</a>
</td>
                                            <td class="summary"><p>
                Type in Documentation: usePlatformMbeanServer must be usePlatformMBeanServer
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Oliver Jelinski
    </td>
                                            <td class="creator">            Oliver Jelinski
    </td>
