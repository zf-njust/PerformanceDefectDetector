    </td>
                                            <td class="created"> 18/Oct/11 11:49 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Nov/11 02:11 </td>
                                            <td class="resolutiondate"> 18/Oct/11 12:57 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.5,                     2.4.4,                     2.3.8            </td>
                                            <td class="components">                        Samples            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
