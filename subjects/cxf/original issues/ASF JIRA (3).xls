    <a class="issue-link" data-issue-key="CXF-3689" href="https://issues.apache.org/jira/browse/CXF-3689">CXF-3689</a>
</td>
                                            <td class="summary"><p>
                path_info should not be contextPath + req.getPathInfo()
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            bohr.qiu
    </td>
                                            <td class="creator">            bohr.qiu
    </td>
                                            <td class="created"> 26/Jul/11 15:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Aug/11 03:30 </td>
                                            <td class="resolutiondate"> 26/Jul/11 16:23 </td>
                                            <td class="versions">                        2.3.5            </td>
                                            <td class="fixVersions">                        2.3.6,                     2.4.2,                     2.5            </td>
                                            <td class="components">                        Transports            </td>
