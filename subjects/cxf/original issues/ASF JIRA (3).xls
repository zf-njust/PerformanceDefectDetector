                <tr id="issuerow12503895" rel="12503895" data-issuekey="CXF-3450" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3450" href="https://issues.apache.org/jira/browse/CXF-3450">CXF-3450</a>
</td>
                                            <td class="summary"><p>
                Unable to build service from class with JAXB bindings
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Daniel Kulp
