    <a class="issue-link" data-issue-key="CXF-3094" href="https://issues.apache.org/jira/browse/CXF-3094">CXF-3094</a>
</td>
                                            <td class="summary"><p>
                Create Maven website-like for Maven plugins
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
