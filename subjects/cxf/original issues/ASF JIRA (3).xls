                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Dec/11 08:34 </td>
                                            <td class="resolutiondate"> 06/Dec/11 08:33 </td>
                                            <td class="versions">                        2.5            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Services            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
