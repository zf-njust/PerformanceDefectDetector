    <a class="issue-link" data-issue-key="CXF-3418" href="https://issues.apache.org/jira/browse/CXF-3418">CXF-3418</a>
</td>
                                            <td class="summary"><p>
                Transactional JAX-RS Service (Spring 3 + Hibernate 3)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
