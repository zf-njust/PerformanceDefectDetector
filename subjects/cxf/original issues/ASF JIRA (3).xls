    <a class="issue-link" data-issue-key="CXF-4053" href="https://issues.apache.org/jira/browse/CXF-4053">CXF-4053</a>
</td>
                                            <td class="summary"><p>
                Runtime error while connecting to the Secure(https) WebService from Apache CXF Client 
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Incomplete
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Srinivas A
    </td>
                                            <td class="creator">            Srinivas A
    </td>
                                            <td class="created"> 23/Jan/12 17:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/12 17:46 </td>
                                            <td class="resolutiondate"> 25/May/12 17:49 </td>
                                            <td class="versions">                        2.4.4            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">604800</td>
                                            <td class="timeestimate">604800</td>
