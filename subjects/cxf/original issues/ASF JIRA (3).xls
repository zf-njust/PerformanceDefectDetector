                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/11 16:15 </td>
                                            <td class="resolutiondate"> 02/Dec/11 20:06 </td>
                                            <td class="versions">                        2.5            </td>
                                            <td class="fixVersions">                        2.5.1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
