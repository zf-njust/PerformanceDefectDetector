                <tr id="issuerow12493844" rel="12493844" data-issuekey="CXF-3214" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3214" href="https://issues.apache.org/jira/browse/CXF-3214">CXF-3214</a>
</td>
                                            <td class="summary"><p>
                CXFBusLifeCycleManager will call the preshutdown twice if when the BusApplicationContext is closed
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Willem Jiang
    </td>
                                            <td class="creator">            Willem Jiang
    </td>
                                            <td class="created"> 22/Dec/10 08:30 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Jul/13 19:29 </td>
                                            <td class="resolutiondate"> 22/Dec/10 13:53 </td>
                                            <td class="versions">                        2.1.10,                     2.0.13,                     2.2.10,                     2.3,                     2.2.11,                     2.2.12,                     2.3.1            </td>
                                            <td class="fixVersions">                        2.3.2,                     2.4            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      When I write the test of BusApplicationListenerTest I found the BusLifeCycleListener will be called twice when the application context is closed.<br/>
The code of CXFBusLifeCycleManager should be changed like this<br/>
{code}<br/>
--- rt/core/src/main/java/org/apache/cxf/buslifecycle/CXFBusLifeCycleManager.java	(revision 1051771)<br/>
+++ rt/core/src/main/java/org/apache/cxf/buslifecycle/CXFBusLifeCycleManager.java	(working copy)<br/>
@@ -78,9 +78,11 @@<br/>
     <br/>
     public void preShutdown() {<br/>
         // TODO inverse order of registration?<br/>
-        preShutdownCalled = true;<br/>
-        for (BusLifeCycleListener listener : listeners) {<br/>
-            listener.preShutdown();<br/>
+        if (!preShutdownCalled) { <br/>
+            preShutdownCalled = true;<br/>
+            for (BusLifeCycleListener listener : listeners) {<br/>
+                listener.preShutdown();<br/>
+            }<br/>
         }<br/>
     }<br/>
<br/>
{code}
  </td>
