    <a class="issue-link" data-issue-key="CXF-3534" href="https://issues.apache.org/jira/browse/CXF-3534">CXF-3534</a>
</td>
                                            <td class="summary"><p>
                RMTxStore unable to create tables in Oracle DB (SQL Error: ORA-00902: invalid datatype)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Akitoshi Yoshida
    </td>
                                            <td class="reporter">            Maciej Starzyk
    </td>
                                            <td class="creator">            Maciej Starzyk
    </td>
                                            <td class="created"> 18/May/11 11:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Aug/11 14:43 </td>
                                            <td class="resolutiondate"> 27/May/11 13:48 </td>
                                            <td class="versions">                        2.4            </td>
                                            <td class="fixVersions">                        2.4.1            </td>
                                            <td class="components">                        WS-* Components            </td>
