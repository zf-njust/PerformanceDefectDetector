    <a class="issue-link" data-issue-key="CXF-3484" href="https://issues.apache.org/jira/browse/CXF-3484">CXF-3484</a>
</td>
                                            <td class="summary"><p>
                Password set to null in UsernameTokenValidator
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Nicolas Poirot
    </td>
