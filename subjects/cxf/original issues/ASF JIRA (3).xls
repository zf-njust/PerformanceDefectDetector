                <tr id="issuerow12506374" rel="12506374" data-issuekey="CXF-3496" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3496" href="https://issues.apache.org/jira/browse/CXF-3496">CXF-3496</a>
</td>
                                            <td class="summary"><p>
                SpnegoAuthSupplier using Kerberos OID instead of Spnego
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Aris Tsaklidis
    </td>
                                            <td class="creator">            Aris Tsaklidis
    </td>
                                            <td class="created"> 06/May/11 06:58 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Aug/11 14:43 </td>
                                            <td class="resolutiondate"> 06/May/11 13:08 </td>
                                            <td class="versions">                        2.4            </td>
                                            <td class="fixVersions">                        2.4.1            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Updating from 2.3.4 to 2.4.0 added the SpnegoAuthSupplier which is called everytime you use &quot;Negotiate&quot; as AuthorizationType. SpnegoAuthSupplier uses Kerberos OID instead of Spnego. Spnego would be correct.<br/>
<br/>
http://cxf.547215.n5.nabble.com/CXF-2-4-Kerberos-SpnegoAuthSupplier-Message-content-from-Soap-Response-is-null-td4369582.html<br/>
<br/>
## correct code in SpnegoAuthSupplier.java<br/>
<br/>
 private byte[] getToken(AuthorizationPolicy proxyAuthPolicy, String spn) throws GSSException, <br/>
        LoginException {<br/>
        GSSManager manager = GSSManager.getInstance();<br/>
        GSSName serverName = manager.createName(spn, null);<br/>
<br/>
        // need to use SPNEGO_OID<br/>
        Oid oid = new Oid(SPNEGO_OID);<br/>
        <br/>
        GSSContext context = manager<br/>
                .createContext(serverName.canonicalize(oid), oid, null, GSSContext.DEFAULT_LIFETIME);<br/>
        // TODO Do we need mutual auth. Will the code we have really work with<br/>
        // mutual auth?<br/>
        context.requestMutualAuth(true);<br/>
        // TODO Credential delegation could be a security hole if it was not<br/>
        // intended. Both settings should be configurable<br/>
        context.requestCredDeleg(true);<br/>
<br/>
        return getToken(proxyAuthPolicy, context);<br/>
    }
  </td>
