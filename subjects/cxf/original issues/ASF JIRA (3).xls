                <tr id="issuerow12509779" rel="12509779" data-issuekey="CXF-3582" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3582" href="https://issues.apache.org/jira/browse/CXF-3582">CXF-3582</a>
</td>
                                            <td class="summary"><p>
                Reading attachments using the middle of large buffer results in corruption
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
