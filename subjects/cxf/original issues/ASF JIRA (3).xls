    <a class="issue-link" data-issue-key="CXF-4003" href="https://issues.apache.org/jira/browse/CXF-4003">CXF-4003</a>
</td>
                                            <td class="summary"><p>
                XmlSchemaPrimitiveUtils covers date/time types
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
