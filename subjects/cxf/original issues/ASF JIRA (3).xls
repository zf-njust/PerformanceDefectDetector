                <tr id="issuerow12480365" rel="12480365" data-issuekey="CXF-3135" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3135" href="https://issues.apache.org/jira/browse/CXF-3135">CXF-3135</a>
</td>
                                            <td class="summary"><p>
                WadlGenerator does not respect Consumes annotation for form requests
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Guy Dumais
    </td>
                                            <td class="creator">            Guy Dumais
    </td>
                                            <td class="created"> 18/Nov/10 19:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Jan/11 18:14 </td>
                                            <td class="resolutiondate"> 11/Jan/11 21:00 </td>
                                            <td class="versions">                        2.3            </td>
                                            <td class="fixVersions">                        2.3.2,                     2.4            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      any
  </td>
                                            <td class="description">      {{WadlGenerator}} invokes {{handleRepresentation}} with the wrong parameter when creating the {{&lt;request&gt;}} element.  The last parameter of {{handleRepresentation}} should be _true_ not _false_:<br/>
{code}<br/>
 if (ori.getMethodToInvoke().getParameterTypes().length != 0) {<br/>
            sb.append(&quot;&lt;request&gt;&quot;);<br/>
            if (isFormRequest(ori)) {<br/>
                handleRepresentation(sb, jaxbTypes, qnameResolver, clsMap, ori, null, false);<br/>
            } else {<br/>
                for (Parameter p : ori.getParameters()) {        <br/>
                    handleParameter(sb, jaxbTypes, qnameResolver, clsMap, ori, p);             <br/>
                }<br/>
            }<br/>
            sb.append(&quot;&lt;/request&gt;&quot;);<br/>
 }<br/>
{code}
  </td>
