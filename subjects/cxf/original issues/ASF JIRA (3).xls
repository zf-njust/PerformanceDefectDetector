                <tr id="issuerow12507548" rel="12507548" data-issuekey="CXF-3531" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3531" href="https://issues.apache.org/jira/browse/CXF-3531">CXF-3531</a>
</td>
                                            <td class="summary"><p>
                CXF doesn&#39;t always generate 415 when POSTing to a resource with an invalid media type
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Ka-Lok Fung
    </td>
                                            <td class="creator">            Ka-Lok Fung
    </td>
                                            <td class="created"> 18/May/11 01:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Aug/11 14:43 </td>
                                            <td class="resolutiondate"> 18/May/11 18:05 </td>
                                            <td class="versions">                        2.4,                     2.3.4            </td>
                                            <td class="fixVersions">                        2.4.1,                     2.3.5            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      JDK 1.6
  </td>
                                            <td class="description">      When you POST to a resource using an invalid Content-Type of &quot;foo&quot;, CXF doesn&#39;t return 415.<br/>
<br/>
Instead, CXF throws a 500 because an IllegalArgumentException is thrown instead of a WebApplicationException.<br/>

  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
