    <a class="issue-link" data-issue-key="CXF-3569" href="https://issues.apache.org/jira/browse/CXF-3569">CXF-3569</a>
</td>
                                            <td class="summary"><p>
                One service port and one soapAction
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">            Akitoshi Yoshida
    </td>
                                            <td class="reporter">            Tomasz Gieszczyk
    </td>
                                            <td class="creator">            Tomasz Gieszczyk
    </td>
                                            <td class="created"> 06/Jun/11 12:45 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Oct/11 17:12 </td>
