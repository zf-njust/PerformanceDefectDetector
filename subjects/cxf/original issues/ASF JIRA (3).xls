    <a class="issue-link" data-issue-key="CXF-3776" href="https://issues.apache.org/jira/browse/CXF-3776">CXF-3776</a>
</td>
                                            <td class="summary"><p>
                Duplicate policy getting added with java-first approach
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Rajesh Kumar
    </td>
                                            <td class="creator">            Rajesh Kumar
    </td>
                                            <td class="created"> 30/Aug/11 06:39 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Sep/11 13:28 </td>
                                            <td class="resolutiondate"> 31/Aug/11 18:09 </td>
                                            <td class="versions">                        2.4.2            </td>
                                            <td class="fixVersions">                        2.4.3            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">86400</td>
                                            <td class="timeestimate">86400</td>
