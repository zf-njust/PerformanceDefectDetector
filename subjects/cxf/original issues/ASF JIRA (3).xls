                <tr id="issuerow12478118" rel="12478118" data-issuekey="CXF-3088" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-3088" href="https://issues.apache.org/jira/browse/CXF-3088">CXF-3088</a>
</td>
                                            <td class="summary"><p>
                UriBuilderImpl#clone does not clone leadingSlash
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Alex Wenckus
    </td>
                                            <td class="creator">            Alex Wenckus
    </td>
                                            <td class="created"> 22/Oct/10 21:28 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Dec/10 22:49 </td>
                                            <td class="resolutiondate"> 26/Oct/10 16:06 </td>
                                            <td class="versions">                        2.3,                     2.2.11            </td>
                                            <td class="fixVersions">                        2.2.12,                     2.3.1,                     2.4            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      When cloning a UriBuilderImpl the URI which results from a clone can be different from the URI which would result from the original builder if the path contains a leading slash. The reason for this is that the leading slash is not cloned with the rest of the URI and thus is not retained in the new builder.<br/>
<br/>
{code}<br/>
        UriBuilder builder = new UriBuilderImpl(new URI(&quot;/this/is/my/path&quot;));<br/>
        assertEquals(builder.build(), builder.clone().build()); // assertion fails<br/>
{code}<br/>
unit.framework.AssertionFailedError: expected:&lt;/this/is/my/path&gt; but was:&lt;this/is/my/path&gt;
  </td>
