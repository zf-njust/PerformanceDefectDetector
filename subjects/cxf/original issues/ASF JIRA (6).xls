                <tr id="issuerow12997151" rel="12997151" data-issuekey="CXF-7012" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-7012" href="https://issues.apache.org/jira/browse/CXF-7012">CXF-7012</a>
</td>
                                            <td class="summary"><p>
                CXF memory issue dump
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            ismail CHAKOUR
    </td>
                                            <td class="creator">            ismail CHAKOUR
    </td>
                                            <td class="created"> 13/Aug/16 19:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:37 </td>
                                            <td class="resolutiondate"> 22/Mar/17 19:55 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
