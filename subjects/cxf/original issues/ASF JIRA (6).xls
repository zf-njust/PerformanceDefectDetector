                <tr id="issuerow12946190" rel="12946190" data-issuekey="CXF-6817" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6817" href="https://issues.apache.org/jira/browse/CXF-6817">CXF-6817</a>
</td>
                                            <td class="summary"><p>
                Provide an easy way to set authentication for JAXRS client
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Dennis Kieselhorst
    </td>
                                            <td class="creator">            Dennis Kieselhorst
    </td>
                                            <td class="created"> 02/Mar/16 16:15 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Mar/16 15:27 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        3.1.5            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      CXF should provide an easy way to configure the basic authentication for a JAXRS client programmatically, e.g.:<br/>
{code:java}<br/>
      Client client = ClientBuilder.newClient().register(new java.net.Authenticator() {<br/>
         @Override<br/>
         protected PasswordAuthentication getPasswordAuthentication() {<br/>
            return new PasswordAuthentication(&quot;myuser&quot;, &quot;mypassword&quot;.toCharArray());<br/>
         }<br/>
      });<br/>
{code}<br/>
<br/>
See also: http://stackoverflow.com/questions/25155017/client-side-authentication-with-jax-rs-and-cxf
  </td>
