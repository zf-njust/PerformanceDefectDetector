                                            <td class="resolutiondate"> 26/Oct/15 22:09 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.7.18,                     3.0.7,                     3.1.4            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
