                <tr id="issuerow12967355" rel="12967355" data-issuekey="CXF-6897" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6897" href="https://issues.apache.org/jira/browse/CXF-6897">CXF-6897</a>
</td>
                                            <td class="summary"><p>
                CXF enumeration validation
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Incomplete
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            El Fassi Hamza
    </td>
                                            <td class="creator">            El Fassi Hamza
    </td>
                                            <td class="created"> 11/May/16 09:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:37 </td>
                                            <td class="resolutiondate"> 22/Mar/17 19:58 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
