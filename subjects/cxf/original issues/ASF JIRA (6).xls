                <tr id="issuerow12781553" rel="12781553" data-issuekey="CXF-6293" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6293" href="https://issues.apache.org/jira/browse/CXF-6293">CXF-6293</a>
</td>
                                            <td class="summary"><p>
                Provide CXF + Spring Boot example without XML
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Andrew Cuga
    </td>
                                            <td class="creator">            Andrew Cuga
    </td>
                                            <td class="created"> 12/Mar/15 16:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:06 </td>
                                            <td class="resolutiondate"> 27/Apr/15 13:21 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Documentation            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
