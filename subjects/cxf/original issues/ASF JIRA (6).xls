                <tr id="issuerow12820762" rel="12820762" data-issuekey="CXF-6350" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6350" href="https://issues.apache.org/jira/browse/CXF-6350">CXF-6350</a>
</td>
                                            <td class="summary"><p>
                Can&#39;t turn on async transport by specifying endpoint address in JAX-WS client when using IPv6
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Alessio Soldano
    </td>
                                            <td class="creator">            Alessio Soldano
    </td>
                                            <td class="created"> 14/Apr/15 09:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Apr/15 09:15 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      I have a testcase that runs some code as follows:<br/>
{code:java}<br/>
Endpoint proxy = initPort();<br/>
BindingProvider provider = (BindingProvider)proxy;<br/>
Map&lt;String, Object&gt; requestContext = provider.getRequestContext();<br/>
requestContext.put(BindingProvider.ENDPOINT_ADDRESS_PROPERTY, &quot;hc://&quot; + baseURL);<br/>
proxy.echo(1000));<br/>
{code}<br/>
where baseURL is the endpoint URL (http://[::1]:8080/jaxws-cxf-asyncclient/).<br/>
