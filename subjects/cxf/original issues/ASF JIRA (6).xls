</td>
                                            <td class="summary"><p>
                NamespaceHandlerRegisterer should not use log level WARN
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Jens Borrmann
    </td>
                                            <td class="creator">            Jens Borrmann
    </td>
                                            <td class="created"> 02/Mar/15 11:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:38 </td>
                                            <td class="resolutiondate"> 22/Mar/17 19:45 </td>
                                            <td class="versions">                        3.0.4            </td>
                                            <td class="fixVersions">                        3.1.10            </td>
                                            <td class="components">                        Bus            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
