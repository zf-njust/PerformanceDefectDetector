    <a class="issue-link" data-issue-key="CXF-6491" href="https://issues.apache.org/jira/browse/CXF-6491">CXF-6491</a>
</td>
                                            <td class="summary"><p>
                wadl2java produces incorrect Consumes annotation for multiple representations on POST methods
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Pat Lynch
    </td>
                                            <td class="creator">            Pat Lynch
    </td>
                                            <td class="created"> 08/Jul/15 19:48 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:28 </td>
                                            <td class="resolutiondate"> 09/Jul/15 13:37 </td>
                                            <td class="versions">                        3.0.2,                     3.0.5,                     3.1.1            </td>
                                            <td class="fixVersions">                        3.0.6,                     3.1.2            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
