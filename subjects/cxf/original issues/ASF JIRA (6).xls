    <a class="issue-link" data-issue-key="CXF-6696" href="https://issues.apache.org/jira/browse/CXF-6696">CXF-6696</a>
</td>
                                            <td class="summary"><p>
                Java2WS - SEI - multiple classpaths
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Invalid
</td>
