                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:09 </td>
                                            <td class="resolutiondate"> 21/Nov/14 18:30 </td>
                                            <td class="versions">                        3.0.2            </td>
                                            <td class="fixVersions">                        3.0.3,                     3.1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
