                <tr id="issuerow12843190" rel="12843190" data-issuekey="CXF-6488" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6488" href="https://issues.apache.org/jira/browse/CXF-6488">CXF-6488</a>
</td>
                                            <td class="summary"><p>
                Binding style vs part type R2203 And R2204 problems in wsdl document
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Akitoshi Yoshida
    </td>
                                            <td class="reporter">            Yuri Kr
    </td>
                                            <td class="creator">            Yuri Kr
    </td>
                                            <td class="created"> 07/Jul/15 13:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:12 </td>
                                            <td class="resolutiondate"> 18/Aug/15 16:03 </td>
                                            <td class="versions">                        3.0.1            </td>
                                            <td class="fixVersions">                        3.1.3,                     2.7.18,                     3.0.7            </td>
                                            <td class="components">                        Tooling,                     WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      apache-cxf 3.0.1
  </td>
                                            <td class="description">      Why Apache-cxf wsdl validator returns error:<br/>
&quot;WSDLValidator Error : A document-literal binding in a DESCRIPTION MUST refer, in each of its soapbind:body element(s),only to wsdl:part element(s) that have been defined using the element attribute.&quot;<br/>
Validator takes messages&#39; parts from operations despite of style of usage (mime:content here) and returns error if soap binding style does not match part type/element. At the same time this document is marked as correct on http://www.ws-i.org web page. So i do not understand, is it an apache-cxf bug or ws-i web page does not follow their standards?<br/>
validating following document http://www.ws-i.org/profiles/attachmentsprofile-1.0.html#Referencing_Attachments_from_the_SOAP_Envelope (here it is correct):<br/>
{code:xml}<br/>
&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot; ?&gt; <br/>
&lt;wsdl:definitions xmlns:types=&quot;http://example.com/mimetypes&quot;<br/>
                  xmlns:ref=&quot;http://ws-i.org/profiles/basic/1.1/xsd&quot;<br/>
                  xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot;<br/>
                  xmlns:soapbind=&quot;http://schemas.xmlsoap.org/wsdl/soap/&quot;<br/>
                  xmlns:wsdl=&quot;http://schemas.xmlsoap.org/wsdl/&quot;<br/>
                  xmlns:mime=&quot;http://schemas.xmlsoap.org/wsdl/mime/&quot;<br/>
                  targetNamespace=&quot;http://example.com/mimewsdl&quot;<br/>
                  xmlns:tns=&quot;http://example.com/mimewsdl&quot;&gt;<br/>
<br/>
    &lt;wsdl:types&gt;<br/>
        &lt;xsd:schema targetNamespace=&quot;http://example.com/mimetypes&quot;<br/>
                xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot;&gt;<br/>
<br/>
            &lt;xsd:import namespace=&quot;http://ws-i.org/profiles/basic/1.1/xsd&quot; /&gt;<br/>
            &lt;xsd:element name=&quot;ClaimDetail&quot; type=&quot;types:ClaimDetailType&quot;/&gt;<br/>
            &lt;xsd:complexType name=&quot;ClaimDetailType&quot;&gt;<br/>
                &lt;xsd:sequence&gt;<br/>
                    &lt;xsd:element name=&quot;Name&quot; type=&quot;xsd:string&quot;/&gt;<br/>
                    &lt;xsd:element name=&quot;ClaimForm&quot; type=&quot;ref:swaRef&quot;/&gt;<br/>
                &lt;/xsd:sequence&gt;<br/>
            &lt;/xsd:complexType&gt;<br/>
            &lt;xsd:element name=&quot;ClaimRefNo&quot; type=&quot;xsd:string&quot;/&gt;<br/>
        &lt;/xsd:schema&gt;<br/>
    &lt;/wsdl:types&gt;<br/>
<br/>
    &lt;wsdl:message name=&quot;ClaimIn&quot;&gt;<br/>
        &lt;wsdl:part name=&quot;body&quot; element=&quot;types:ClaimDetail&quot;/&gt;<br/>
        &lt;wsdl:part name=&quot;ClaimPhoto&quot; type=&quot;xsd:base64Binary&quot;/&gt;<br/>
    &lt;/wsdl:message&gt;<br/>
<br/>
    &lt;wsdl:message name=&quot;ClaimOut&quot;&gt;<br/>
        &lt;wsdl:part name=&quot;out&quot; element=&quot;types:ClaimRefNo&quot;/&gt;<br/>
    &lt;/wsdl:message&gt;<br/>
<br/>
    &lt;wsdl:portType name=&quot;ClaimPortType&quot;&gt;<br/>
        &lt;wsdl:operation name=&quot;SendClaim&quot;&gt;<br/>
            &lt;wsdl:input message=&quot;tns:ClaimIn&quot;/&gt;<br/>
            &lt;wsdl:output message=&quot;tns:ClaimOut&quot;/&gt;<br/>
        &lt;/wsdl:operation&gt;<br/>
    &lt;/wsdl:portType&gt;<br/>
<br/>
    &lt;wsdl:binding name=&quot;ClaimBinding&quot; type=&quot;tns:ClaimPortType&quot;&gt;<br/>
        &lt;soapbind:binding style=&quot;document&quot; <br/>
                          transport=&quot;http://schemas.xmlsoap.org/soap/http&quot;/&gt;<br/>
        &lt;wsdl:operation name=&quot;SendClaim&quot;&gt;<br/>
            &lt;soapbind:operation soapAction=&quot;http://example.com/soapaction&quot;/&gt;<br/>
            &lt;wsdl:input&gt;<br/>
                &lt;mime:multipartRelated&gt;<br/>
                    &lt;mime:part&gt;<br/>
                        &lt;soapbind:body parts=&quot;body&quot; use=&quot;literal&quot;/&gt;<br/>
                    &lt;/mime:part&gt;<br/>
                    &lt;mime:part&gt;<br/>
                        &lt;mime:content part=&quot;ClaimPhoto&quot; type=&quot;image/jpeg&quot;/&gt;<br/>
                    &lt;/mime:part&gt;<br/>
                &lt;/mime:multipartRelated&gt;<br/>
            &lt;/wsdl:input&gt;<br/>
            &lt;wsdl:output&gt;<br/>
                &lt;soapbind:body use=&quot;literal&quot; /&gt;<br/>
            &lt;/wsdl:output&gt;<br/>
        &lt;/wsdl:operation&gt;<br/>
    &lt;/wsdl:binding&gt;<br/>
&lt;/wsdl:definitions&gt;<br/>
{code}<br/>

  </td>
