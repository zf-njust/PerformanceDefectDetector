                <tr id="issuerow12960045" rel="12960045" data-issuekey="CXF-6874" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6874" href="https://issues.apache.org/jira/browse/CXF-6874">CXF-6874</a>
</td>
                                            <td class="summary"><p>
                NPE During Code Generation By Maven Plug-In If Name Collision
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
