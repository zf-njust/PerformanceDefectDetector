                <tr id="issuerow12756460" rel="12756460" data-issuekey="CXF-6109" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6109" href="https://issues.apache.org/jira/browse/CXF-6109">CXF-6109</a>
</td>
                                            <td class="summary"><p>
                Incorrect TrustException constructor in AbstractSTSClient 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Frank Cornelis
    </td>
                                            <td class="creator">            Frank Cornelis
    </td>
                                            <td class="created"> 19/Nov/14 16:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:09 </td>
                                            <td class="resolutiondate"> 24/Nov/14 11:32 </td>
                                            <td class="versions">                        2.7.13            </td>
                                            <td class="fixVersions">                        3.0.3,                     2.7.14,                     3.1            </td>
                                            <td class="components">                        STS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The TrustException constructor is incorrectly called within AbstractSTSClient.<br/>
Next patch fixes this.<br/>
{code}<br/>
--- src/main/java/org/apache/cxf/ws/security/trust/AbstractSTSClient.java.orig	2014-11-19 17:49:37.964705313 +0100<br/>
+++ src/main/java/org/apache/cxf/ws/security/trust/AbstractSTSClient.java	2014-11-19 17:49:44.179393712 +0100<br/>
@@ -586,7 +586,7 @@<br/>
                     client = new ClientImpl(bus, endpoint);<br/>
                 }<br/>
             } catch (Exception ex) {<br/>
-                throw new TrustException(LOG, &quot;WS_MEX_ERROR&quot;, ex);<br/>
+                throw new TrustException(&quot;WS_MEX_ERROR&quot;, LOG, ex);<br/>
             }<br/>
         }<br/>
     }<br/>
{code} 
  </td>
