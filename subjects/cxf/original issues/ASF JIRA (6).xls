                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:24 </td>
                                            <td class="resolutiondate"> 20/Apr/15 11:40 </td>
                                            <td class="versions">                        3.0.1,                     3.0.3,                     2.7.15            </td>
                                            <td class="fixVersions">                        3.1,                     3.0.5            </td>
