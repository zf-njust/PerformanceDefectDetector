                <tr id="issuerow12823683" rel="12823683" data-issuekey="CXF-6370" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6370" href="https://issues.apache.org/jira/browse/CXF-6370">CXF-6370</a>
</td>
                                            <td class="summary"><p>
                wrong usages for System.arraycopy in org.apache.cxf.jaxrs.impl.AsyncResponseImpl
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
