                                            <td class="description">       SoapOutInterceptor moves nillable header element to soap body when its value is set to null[1].  For example, when the following header part value is set to null, this nillable element will appear in soap body. <br/>
&lt;code&gt;<br/>
public String echo(@WebParam(name = &quot;message&quot;) String message.<br/>
<br/>
    @WebParam(name = &quot;paramOut&quot;,mode = WebParam.Mode.INOUT, header = true) Holder&lt;String&gt; paramOut) {<br/>
        paramOut.value = null;<br/>
        return &quot;echo: &quot; + message;<br/>
    }<br/>
&lt;/code&gt;<br/>
&lt;soap:Body&gt;&lt;ns2:echoResponse xmlns:ns2=&quot;urn:echo&quot;&gt;&lt;result&gt;echo: test&lt;/result&gt;&lt;/ns2:echoResponse&gt;&lt;ns2:paramOut xmlns:ns2=&quot;urn:echo&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:nil=&quot;true&quot;/&gt;&lt;/soap:Body&gt;<br/>

