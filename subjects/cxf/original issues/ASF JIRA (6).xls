</td>
                                            <td class="summary"><p>
                JMSDestination and setExceptionListener fails with WebSphere 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Alexis Willemyns
    </td>
                                            <td class="creator">            Alexis Willemyns
    </td>
                                            <td class="created"> 02/Sep/15 10:31 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Apr/17 09:47 </td>
                                            <td class="resolutiondate"> 28/Apr/17 09:47 </td>
                                            <td class="versions">                        3.1.2            </td>
                                            <td class="fixVersions">                        3.2.0            </td>
                                            <td class="components">                        JMS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
