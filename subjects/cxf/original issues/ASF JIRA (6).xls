    </td>
                                            <td class="created"> 10/Dec/15 10:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:19 </td>
                                            <td class="resolutiondate"> 16/Dec/15 05:35 </td>
                                            <td class="versions">                        3.1.4            </td>
                                            <td class="fixVersions">                        3.1.5,                     3.2.0            </td>
                                            <td class="components">                        Core            </td>
