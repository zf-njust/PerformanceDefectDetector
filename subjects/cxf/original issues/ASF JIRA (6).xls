    <a class="issue-link" data-issue-key="CXF-6944" href="https://issues.apache.org/jira/browse/CXF-6944">CXF-6944</a>
</td>
                                            <td class="summary"><p>
                cacerts is loaded while different truststore is specified
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
