                                            <td class="description">      class MyForm {<br/>
  String name;<br/>
  Integer[] vals;<br/>
}<br/>
//----------------------------<br/>
@PUT<br/>
@Path(&quot;test&quot;)<br/>
@Consumes(MediaType.APPLICATION_FORM_URLENCODED)<br/>
void test(@FormParam(&quot;&quot;) MyForm frm);<br/>
//----------------------------<br/>
frm.name=&quot;blabla&quot;;<br/>
frm.vals=new Integer[]{1,2};<br/>
service.test(frm);<br/>
//----------------------------<br/>
expected POST entity body:<br/>
  name=blabla&amp;vals=1&amp;vals=2<br/>
but actual entity body:<br/>
  name=blabla&amp;vals=[Ljava.lang.Integer;@16554210<br/>
<br/>

