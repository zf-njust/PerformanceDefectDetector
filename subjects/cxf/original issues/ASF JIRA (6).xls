                <tr id="issuerow12958341" rel="12958341" data-issuekey="CXF-6865" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6865" href="https://issues.apache.org/jira/browse/CXF-6865">CXF-6865</a>
</td>
                                            <td class="summary"><p>
                Add cache for target resouce method matching
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Neal Hu
    </td>
                                            <td class="creator">            Neal Hu
    </td>
                                            <td class="created"> 13/Apr/16 02:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Dec/16 18:11 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        3.1.6,                     3.0.9            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
