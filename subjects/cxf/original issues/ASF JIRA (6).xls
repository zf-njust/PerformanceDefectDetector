    <a class="issue-link" data-issue-key="CXF-7017" href="https://issues.apache.org/jira/browse/CXF-7017">CXF-7017</a>
</td>
                                            <td class="summary"><p>
                @BeanParam not working in subresource
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Nicos Tegos
    </td>
                                            <td class="creator">            Nicos Tegos
    </td>
                                            <td class="created"> 19/Aug/16 19:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/16 18:45 </td>
                                            <td class="resolutiondate"> 25/Aug/16 16:11 </td>
                                            <td class="versions">                        3.1.6            </td>
                                            <td class="fixVersions">                        3.1.8,                     3.0.11,                     3.2.0            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
