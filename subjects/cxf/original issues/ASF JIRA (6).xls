                <tr id="issuerow12921573" rel="12921573" data-issuekey="CXF-6707" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6707" href="https://issues.apache.org/jira/browse/CXF-6707">CXF-6707</a>
</td>
                                            <td class="summary"><p>
                Supported JDK version needs to be updated in BUILDING.txt  (JDK 8 instead of JDK 1.7.0_25)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Sabiya Kazi
    </td>
                                            <td class="creator">            Sabiya Kazi
    </td>
                                            <td class="created"> 14/Dec/15 06:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Dec/15 10:33 </td>
                                            <td class="resolutiondate"> 14/Dec/15 10:33 </td>
                                            <td class="versions">                        3.2.0            </td>
                                            <td class="fixVersions">                        3.2.0            </td>
