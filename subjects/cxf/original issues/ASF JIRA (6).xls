                                            <td class="description">      When client side set accept encoding to &quot;*&quot; value and send request to following operation, client always get notAcceptable . <br/>
       @GET<br/>
	@Path(&quot;/test&quot;)<br/>
	public Response test(@Context Request req) {<br/>
		List&lt;Variant&gt; list = Variant.encodings(&quot;CP1250&quot;, &quot;UTF-8&quot;)<br/>
...  <br/>
		if (null == req.selectVariant(list))<br/>
			return Response.notAcceptable(list).build();<br/>
		return Response.ok(&quot;entity&quot;).build();<br/>
	}
