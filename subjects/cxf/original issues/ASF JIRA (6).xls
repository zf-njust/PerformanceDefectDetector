                <tr id="issuerow12767563" rel="12767563" data-issuekey="CXF-6195" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6195" href="https://issues.apache.org/jira/browse/CXF-6195">CXF-6195</a>
</td>
                                            <td class="summary"><p>
                JMS soap listeners are single-threaded in CXF 3.0.x
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            EasternWahoo
    </td>
                                            <td class="creator">            EasternWahoo
    </td>
                                            <td class="created"> 14/Jan/15 21:57 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Jan/15 13:41 </td>
                                            <td class="resolutiondate"> 27/Jan/15 13:41 </td>
                                            <td class="versions">                        3.0.3            </td>
                                            <td class="fixVersions">                        3.0.4,                     3.1            </td>
                                            <td class="components">                        JMS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
