    </td>
                                            <td class="created"> 10/Mar/15 18:43 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:41 </td>
                                            <td class="resolutiondate"> 11/Mar/15 13:05 </td>
                                            <td class="versions">                        3.0.4            </td>
                                            <td class="fixVersions">                        NeedMoreInfo            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
