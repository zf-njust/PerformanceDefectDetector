    </td>
                                            <td class="created"> 10/Apr/15 12:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:24 </td>
                                            <td class="resolutiondate"> 10/Apr/15 13:18 </td>
                                            <td class="versions">                        3.0.4,                     2.7.15            </td>
                                            <td class="fixVersions">                        3.1,                     2.7.16,                     3.0.5            </td>
                                            <td class="components">                        STS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
