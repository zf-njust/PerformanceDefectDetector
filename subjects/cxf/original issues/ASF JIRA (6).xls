</td>
                                            <td class="summary"><p>
                parameter state may contain spaces, it must be urlencoded in response.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Svein Otto Solem
    </td>
                                            <td class="creator">            Svein Otto Solem
    </td>
