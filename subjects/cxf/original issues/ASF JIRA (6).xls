                <tr id="issuerow12768387" rel="12768387" data-issuekey="CXF-6201" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6201" href="https://issues.apache.org/jira/browse/CXF-6201">CXF-6201</a>
</td>
                                            <td class="summary"><p>
                Issue parsing xs:choice with maxoccurs attribute when using cxf-codegen-plugin
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Lex Uijthof
    </td>
                                            <td class="creator">            Lex Uijthof
    </td>
                                            <td class="created"> 19/Jan/15 09:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Jan/15 09:40 </td>
                                            <td class="resolutiondate"> 19/Jan/15 09:40 </td>
                                            <td class="versions">                        2.7.14            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      windows 7 Professional, JDK 1.7.0_71, mvn 3.2.3 
  </td>
                                            <td class="description">      I&#39;m trying to create a client based on a WDSL and it&#39;s XSD&#39;s from an external party. <br/>
I don&#39;t want to modify the XSD&#39;s manually, because the schema&#39;s change once in a while.<br/>
<br/>
In the plugins excecution part of my Pom I have the following configuration:<br/>
&lt;configuration&gt;<br/>
  &lt;additionalJvmArgs&gt;-Dfile.encoding=UTF8&lt;/additionalJvmArgs&gt;<br/>
  &lt;defaultOptions&gt;<br/>
    &lt;bindingFiles&gt;<br/>
      &lt;bindingFile&gt;${basedir}/src/main/resources/bindings.xjb&lt;/bindingFile&gt;<br/>
    &lt;/bindingFiles&gt;<br/>
    &lt;extraargs&gt;<br/>
      &lt;extraarg&gt;-client&lt;/extraarg&gt;<br/>
      &lt;extraarg&gt;-verbose&lt;/extraarg&gt;<br/>
      &lt;extraarg&gt;-xjc-Xvalue-constructor&lt;/extraarg&gt;<br/>
      &lt;extraarg&gt;-xjc-Xfluent-api&lt;/extraarg&gt;<br/>
      &lt;extraarg&gt;-xjc-Xcollection-setter-injector&lt;/extraarg&gt;<br/>
      &lt;exreaarg&gt;-autoNameResolution&lt;/exreaarg&gt;<br/>
    &lt;/extraargs&gt;<br/>
  &lt;/defaultOptions&gt;<br/>
  &lt;sourceRoot&gt;/${basedir}/src-generated/main/java/&lt;/sourceRoot&gt;<br/>
  &lt;wsdlOptions&gt;<br/>
    &lt;wsdlOption&gt;<br/>
      &lt;wsdl&gt;/${basedir}/src/main/resources/bg0310/vraagAntwoord/bg0310_beantwoordVraag_vraagAntwoord.wsdl&lt;/wsdl&gt;<br/>
    &lt;/wsdlOption&gt;<br/>
  &lt;/wsdlOptions&gt;<br/>
&lt;/configuration&gt;<br/>
<br/>
My bindings.xjb:<br/>
&lt;jxb:bindings<br/>
  xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot;<br/>
  xmlns:jxb=&quot;http://java.sun.com/xml/ns/jaxb&quot;<br/>
  xmlns:xjc=&quot;http://java.sun.com/xml/ns/jaxb/xjc&quot; <br/>
  jxb:extensionBindingPrefixes=&quot;xjc&quot;<br/>
  version=&quot;2.1&quot;&gt;<br/>
<br/>
  &lt;jxb:globalBindings<br/>
    underscoreBinding=&quot;asCharInWord&quot;<br/>
    fixedAttributeAsConstantProperty=&quot;true&quot;<br/>
    choiceContentProperty=&quot;false&quot;&gt;<br/>
    &lt;jxb:javaType name=&quot;java.lang.Integer&quot; xmlType=&quot;xs:int&quot;/&gt;<br/>
    &lt;jxb:javaType name=&quot;java.lang.Integer&quot; xmlType=&quot;xs:positiveInteger&quot;/&gt;<br/>
  &lt;/jxb:globalBindings&gt;<br/>
&lt;/jxb:bindings&gt;<br/>
<br/>
The part of the XSD that is parsed incorrectly :<br/>
&lt;complexType name=&quot;NPSNINING-basis&quot;&gt;<br/>
  &lt;annotation&gt;<br/>
     &lt;documentation&gt;Gezamenlijk basistype voor Natuurlijk persoon, ingezetene en niet-ingezetene&lt;/documentation&gt;<br/>
  &lt;/annotation&gt;<br/>
  &lt;sequence&gt;<br/>
    &lt;choice minOccurs=&quot;0&quot; maxOccurs=&quot;2&quot;&gt;<br/>
      &lt;element name=&quot;inp.bsn&quot; type=&quot;BG:BSN-e&quot; nillable=&quot;true&quot; minOccurs=&quot;0&quot;/&gt;<br/>
      &lt;element name=&quot;authentiek&quot; type=&quot;BG:Authentiek&quot; default=&quot;N&quot; nillable=&quot;true&quot; minOccurs=&quot;0&quot;/&gt;<br/>
      &lt;element name=&quot;anp.identificatie&quot; type=&quot;BG:IdentificatieRPSBTL-e&quot; nillable=&quot;true&quot; minOccurs=&quot;0&quot;/&gt;<br/>
	&lt;/choice&gt;<br/>
  &lt;/sequence&gt;<br/>
  &lt;attribute ref=&quot;StUF:entiteittype&quot;/&gt;<br/>
  &lt;attributeGroup ref=&quot;StUF:entiteit&quot;/&gt;<br/>
&lt;/complexType&gt;<br/>
<br/>
When parsed the following Java class is generated:<br/>
<br/>
@XmlAccessorType(XmlAccessType.FIELD)<br/>
@XmlType(name = &quot;NPSNINING-basis&quot;, propOrder = {<br/>
    &quot;inpBsnOrAuthentiekOrAnpIdentificatie&quot;<br/>
})<br/>
public class NPSNININGBasis {<br/>
<br/>
    @XmlElements({<br/>
        @XmlElement(name = &quot;inp.bsn&quot;, type = BSNE.class, nillable = true),<br/>
        @XmlElement(name = &quot;authentiek&quot;, type = Authentiek.class, defaultValue = &quot;N&quot;, nillable = true),<br/>
        @XmlElement(name = &quot;anp.identificatie&quot;, type = IdentificatieRPSBTLE.class, nillable = true)<br/>
    })<br/>
    protected List&lt;Object&gt; inpBsnOrAuthentiekOrAnpIdentificatie;<br/>
	.<br/>
	<br/>
    public List&lt;Object&gt; getInpBsnOrAuthentiekOrAnpIdentificatie() {<br/>
        if (inpBsnOrAuthentiekOrAnpIdentificatie == null) {<br/>
            inpBsnOrAuthentiekOrAnpIdentificatie = new ArrayList&lt;Object&gt;();<br/>
        }<br/>
        return this.inpBsnOrAuthentiekOrAnpIdentificatie;<br/>
    }<br/>
	<br/>
    public void setInpBsnOrAuthentiekOrAnpIdentificatie(List&lt;Object&gt; inpBsnOrAuthentiekOrAnpIdentificatie) {<br/>
        this.inpBsnOrAuthentiekOrAnpIdentificatie = inpBsnOrAuthentiekOrAnpIdentificatie;<br/>
    }<br/>
<br/>
    public NPSNININGBasis withInpBsnOrAuthentiekOrAnpIdentificatie(Object... values) {<br/>
        if (values!= null) {<br/>
            for (Object value: values) {<br/>
                getInpBsnOrAuthentiekOrAnpIdentificatie().add(value);<br/>
            }<br/>
        }<br/>
        return this;<br/>
    }<br/>
<br/>
    public NPSNININGBasis withInpBsnOrAuthentiekOrAnpIdentificatie(Collection&lt;Object&gt; values) {<br/>
        if (values!= null) {<br/>
            getInpBsnOrAuthentiekOrAnpIdentificatie().addAll(values);<br/>
        }<br/>
        return this;<br/>
    }<br/>
}<br/>
	<br/>
The globalbinding param choiceContentProperty=&quot;false&quot; normally creates 3 different Jaxbelement type values for each element inside the choice and that is what i need, because i need to be able to set nill=&#39;true&#39; on eacht of these elements.<br/>
<br/>
When I just remove the maxOccurs=&quot;2&quot; in the choice element, the following code is generated:<br/>
@XmlAccessorType (XmlAccessType.FIELD)<br/>
@XmlType (<br/>
    name      = &quot;NPSNINING-basis&quot;,<br/>
    propOrder = {<br/>
        &quot;inpBsn&quot;, <br/>
		&quot;authentiek&quot;, <br/>
		&quot;anpIdentificatie&quot;<br/>
})<br/>
public class NPSNININGBasis {<br/>
<br/>
    @XmlElementRef (<br/>
        name      = &quot;inp.bsn&quot;,<br/>
        namespace = &quot;http://www.egem.nl/StUF/sector/bg/0310&quot;,<br/>
        type      = JAXBElement.class,<br/>
        required  = false<br/>
        )<br/>
    protected JAXBElement&lt;BSNE&gt;                                 inpBsn;<br/>
    @XmlElementRef (<br/>
        name      = &quot;authentiek&quot;,<br/>
        namespace = &quot;http://www.egem.nl/StUF/sector/bg/0310&quot;,<br/>
        type      = JAXBElement.class,<br/>
        required  = false<br/>
        )<br/>
    protected JAXBElement&lt;Authentiek&gt;                           authentiek;<br/>
    @XmlElementRef (<br/>
        name      = &quot;anp.identificatie&quot;,<br/>
        namespace = &quot;http://www.egem.nl/StUF/sector/bg/0310&quot;,<br/>
        type      = JAXBElement.class,<br/>
        required  = false<br/>
        )<br/>
		<br/>
    public JAXBElement&lt;BSNE&gt; getInpBsn () {<br/>
        return inpBsn;<br/>
        }<br/>
		<br/>
    public void setInpBsn (JAXBElement&lt;BSNE&gt; value) {<br/>
        this.inpBsn = value;<br/>
        }<br/>
		<br/>
    public JAXBElement&lt;Authentiek&gt; getAuthentiek () {<br/>
        return authentiek;<br/>
        }<br/>
		<br/>
    public void setAuthentiek (JAXBElement&lt;Authentiek&gt; value) {<br/>
        this.authentiek = value;<br/>
        }<br/>
		<br/>
    public JAXBElement&lt;IdentificatieRPSBTLE&gt; getAnpIdentificatie () {<br/>
        return anpIdentificatie;<br/>
        }<br/>
		<br/>
    public void setAnpIdentificatie (JAXBElement&lt;IdentificatieRPSBTLE&gt; value) {<br/>
        this.anpIdentificatie = value;<br/>
        }<br/>
		<br/>
    public NPSNININGBasis withInpBsn (JAXBElement&lt;BSNE&gt; value) {<br/>
        setInpBsn (value);<br/>
        return this;<br/>
        }<br/>
<br/>
    public NPSNININGBasis withAuthentiek (JAXBElement&lt;Authentiek&gt; value) {<br/>
        setAuthentiek (value);<br/>
        return this;<br/>
        }<br/>
<br/>
    public NPSNININGBasis withAnpIdentificatie (JAXBElement&lt;IdentificatieRPSBTLE&gt; value) {<br/>
        setAnpIdentificatie (value);<br/>
        return this;<br/>
        }		<br/>
}<br/>
<br/>
This generated code is exactly what I need.<br/>
I believe there should not be any difference in parsing an xs:choice with a maxOccurs and an xs:choice without a maxOccurs, since the maxOccurs attribure is pure for validation.
