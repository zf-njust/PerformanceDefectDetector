                <tr id="issuerow12959510" rel="12959510" data-issuekey="CXF-6870" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6870" href="https://issues.apache.org/jira/browse/CXF-6870">CXF-6870</a>
</td>
                                            <td class="summary"><p>
                CXF doesn&#39;t check the message body&#39;s generic type
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Neal Hu
    </td>
                                            <td class="creator">            Neal Hu
    </td>
                                            <td class="created"> 18/Apr/16 01:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Jul/16 15:39 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        3.1.3,                     3.1.6,                     3.0.9            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      mac, windows
  </td>
                                            <td class="description">      CXF doesn&#39;t check the message body&#39;s generic type, please see the sample below.<br/>
{code:java}<br/>
public class ListAProvider implements MessageBodyWriter&lt;List&lt;String&gt;&gt; <br/>
public class ListBProvider implements MessageBodyWriter&lt;List&lt;Integer&gt;&gt; <br/>
<br/>
resource class:<br/>
<br/>
	@GET<br/>
	@Path(&quot;/echo/{param}&quot;)<br/>
	@Produces(&quot;application/json&quot;)<br/>
	public List&lt;String&gt; echo(@PathParam(&quot;param&quot;)String name){<br/>
		List&lt;String&gt; list = new ArrayList&lt;String&gt;();<br/>
		list.add(&quot;hello&quot;);<br/>
		list.add(name);<br/>
		return list;<br/>
	}<br/>
	<br/>
	@GET<br/>
	@Path(&quot;/echo2/{param}&quot;)<br/>
	@Produces(&quot;application/json&quot;)<br/>
	public List&lt;Integer&gt; echo2(@PathParam(&quot;param&quot;)String name){<br/>
		List&lt;Integer&gt; list = new ArrayList&lt;Integer&gt;();<br/>
		list.add(1);<br/>
		list.add(2);<br/>
		return list;<br/>
	}<br/>
{code}<br/>
<br/>
No matter you request echo or echo2 resource method, the selected provider is ListBProvider
  </td>
