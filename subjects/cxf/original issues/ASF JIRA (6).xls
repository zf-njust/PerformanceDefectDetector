    <a class="issue-link" data-issue-key="CXF-6432" href="https://issues.apache.org/jira/browse/CXF-6432">CXF-6432</a>
</td>
                                            <td class="summary"><p>
                Remove default empty password in SamlTokenInterceptor 
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Willem Salembier
    </td>
                                            <td class="creator">            Willem Salembier
    </td>
                                            <td class="created"> 02/Jun/15 12:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:31 </td>
                                            <td class="resolutiondate"> 02/Jun/15 14:35 </td>
                                            <td class="versions">                        2.7.16            </td>
                                            <td class="fixVersions">                        2.7.17            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
