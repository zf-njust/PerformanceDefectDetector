                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      org.apache.cxf.jaxrs.client.spec.Clientimpl$WebClientImpl#resolveTemplatesFromEncoded(Map&lt;String, Object&gt; templatesMap) method should always check if client is closed first. If the input templatesMap is empty , even the client is closed it still returns this object:<br/>
{code}<br/>
<br/>
        @Override<br/>
        public WebTarget resolveTemplatesFromEncoded(Map&lt;String, Object&gt; templatesMap) {<br/>
            checkClosed();<br/>
            checkNullMap(templatesMap);<br/>
            if (templatesMap.isEmpty()) {<br/>
                return this;<br/>
            }<br/>
            return newWebTarget(getUriBuilder().resolveTemplatesFromEncoded(templatesMap));<br/>
        }<br/>
{code}
