</td>
                                            <td class="summary"><p>
                PrettyLoggingFilter not working well when using camel-cxf-transport
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            David J. M. Karlsen
    </td>
                                            <td class="creator">            David J. M. Karlsen
    </td>
                                            <td class="created"> 09/Feb/16 18:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:20 </td>
                                            <td class="resolutiondate"> 10/Feb/16 12:11 </td>
                                            <td class="versions">                        3.1.5            </td>
                                            <td class="fixVersions">                        3.1.6,                     3.2.0            </td>
                                            <td class="components">                        Configuration            </td>
                                            <td class="duedate">    &nbsp;
</td>
