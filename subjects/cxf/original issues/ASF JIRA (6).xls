                <tr id="issuerow12951256" rel="12951256" data-issuekey="CXF-6835" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6835" href="https://issues.apache.org/jira/browse/CXF-6835">CXF-6835</a>
</td>
                                            <td class="summary"><p>
                Deadlock in WS-Discovery when service called during startup
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
