&lt;response&gt;<br/>
&lt;representation mediaType=&quot;application/json&quot;&gt;<br/>
&lt;param name=&quot;result&quot; style=&quot;plain&quot; type=&quot;xs:string&quot;/&gt;<br/>
&lt;/representation&gt;<br/>
&lt;/response&gt;<br/>
&lt;/method&gt;<br/>
&lt;method name=&quot;GET&quot;&gt;<br/>
&lt;response&gt;<br/>
&lt;representation mediaType=&quot;text/plain&quot;&gt;<br/>
&lt;param name=&quot;result&quot; style=&quot;plain&quot; type=&quot;xs:string&quot;/&gt;<br/>
&lt;/representation&gt;<br/>
&lt;/response&gt;<br/>
&lt;/method&gt;<br/>
&lt;/resource&gt;<br/>
&lt;/resource&gt;<br/>
&lt;/resources&gt;<br/>
&lt;/application&gt;<br/>
<br/>
<br/>
/**<br/>
