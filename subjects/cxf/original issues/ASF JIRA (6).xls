                <tr id="issuerow12954600" rel="12954600" data-issuekey="CXF-6852" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6852" href="https://issues.apache.org/jira/browse/CXF-6852">CXF-6852</a>
</td>
                                            <td class="summary"><p>
                Java 8 java.lang.OutOfMemoryException: Metaspace issue while generating dynamic client
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Lukas Vasek
    </td>
                                            <td class="creator">            Lukas Vasek
    </td>
                                            <td class="created"> 30/Mar/16 12:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:04 </td>
                                            <td class="resolutiondate"> 22/Mar/17 19:19 </td>
                                            <td class="versions">                        2.7.16,                     3.1.6            </td>
                                            <td class="fixVersions">                        3.1.11,                     3.2.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
