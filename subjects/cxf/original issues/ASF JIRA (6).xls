                <tr id="issuerow12849291" rel="12849291" data-issuekey="CXF-6510" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6510" href="https://issues.apache.org/jira/browse/CXF-6510">CXF-6510</a>
</td>
                                            <td class="summary"><p>
                LoggingOutInterceptor: formatLoggingMessage method is not used in every case
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Vadim Guskov
    </td>
                                            <td class="creator">            Vadim Guskov
    </td>
                                            <td class="created"> 27/Jul/15 11:28 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:10 </td>
                                            <td class="resolutiondate"> 16/May/16 09:14 </td>
                                            <td class="versions">                        3.1.1            </td>
                                            <td class="fixVersions">                        3.0.10,                     3.1.7,                     3.2.0            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
