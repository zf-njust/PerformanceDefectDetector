 &lt;saml:Assertion xmlns=&quot;&quot; xmlns:saml=&quot;urn:oasis:names:tc:SAML:1.0:assertion&quot; AssertionID=&quot;saml-FA163ECA11051EE4B3E19DFDCA3B1C3E&quot; IssueInstant=&quot;2015-03-20T14:25:19Z&quot; Issuer=&quot;10.66.140.170&quot; MajorVersion=&quot;1&quot; MinorVersion=&quot;1&quot;&gt;&lt;saml:Conditions NotBefore=&quot;2015-03-20T14:25:19Z&quot; NotOnOrAfter=&quot;2015-03-20T14:30:19Z&quot;&gt;&lt;/saml:Conditions&gt;&lt;saml:AuthenticationStatement AuthenticationInstant=&quot;2015-03-20T14:25:19Z&quot; AuthenticationMethod=&quot;urn:oasis:names:tc:SAML:1.0:am:unspecified&quot;&gt;&lt;saml:Subject&gt;&lt;saml:NameIdentifier Format=&quot;urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified&quot; NameQualifier=&quot;&quot;&gt;AKROUR&lt;/saml:NameIdentifier&gt;&lt;saml:SubjectConfirmation&gt;&lt;saml:ConfirmationMethod&gt;urn:oasis:names:tc:SAML:1.0:cm:sender-vouches&lt;/saml:ConfirmationMethod&gt;&lt;/saml:SubjectConfirmation&gt;&lt;/saml:Subject&gt;&lt;/saml:AuthenticationStatement&gt;&lt;/saml:Assertion&gt;<br/>
