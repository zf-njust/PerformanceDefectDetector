                                            <td class="summary"><p>
                Aegis Databinding Deserialization Vulnerability
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Moritz Bechler
    </td>
