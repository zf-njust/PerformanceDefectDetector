</td>
                                            <td class="summary"><p>
                Race condition when publishing jax-rs server endpoints
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Eugene
    </td>
                                            <td class="creator">            Eugene
    </td>
                                            <td class="created"> 28/Jul/16 11:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/16 18:50 </td>
                                            <td class="resolutiondate"> 21/Sep/16 10:40 </td>
                                            <td class="versions">                        3.0.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
