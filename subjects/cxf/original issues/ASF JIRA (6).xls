                <tr id="issuerow12769796" rel="12769796" data-issuekey="CXF-6221" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6221" href="https://issues.apache.org/jira/browse/CXF-6221">CXF-6221</a>
</td>
                                            <td class="summary"><p>
                CDI integration extension does not detect annotations on Karaf
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andriy Redko
    </td>
                                            <td class="reporter">            Krystian Panek
    </td>
                                            <td class="creator">            Krystian Panek
    </td>
                                            <td class="created"> 24/Jan/15 01:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:07 </td>
                                            <td class="resolutiondate"> 10/Apr/15 11:46 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Integration,                     JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
