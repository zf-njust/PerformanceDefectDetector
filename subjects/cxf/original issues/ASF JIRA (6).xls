                <tr id="issuerow12980191" rel="12980191" data-issuekey="CXF-6945" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6945" href="https://issues.apache.org/jira/browse/CXF-6945">CXF-6945</a>
</td>
                                            <td class="summary"><p>
                cxf-wadl2java-plugin wadlRoot configuration parameter typo
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Jurrie Overgoor
    </td>
                                            <td class="creator">            Jurrie Overgoor
    </td>
                                            <td class="created"> 17/Jun/16 13:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:22 </td>
                                            <td class="resolutiondate"> 20/Jun/16 09:09 </td>
                                            <td class="versions">                        3.1.6            </td>
                                            <td class="fixVersions">                        3.1.7,                     3.2.0            </td>
                                            <td class="components">                        JAX-RS,                     Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      [Line 48 of WADL2JavaMojo.java|https://fisheye6.atlassian.com/browse/cxf/maven-plugins/wadl2java-plugin/src/main/java/org/apache/cxf/maven_plugin/wadlto/WADL2JavaMojo.java?r=68a567632a063c6f9bb27a73c151d21f6e855f50&amp;r=857b55796dc7fc2b302e26d99f84df1712ff9c58&amp;r=5c0ca9032922e8d269901447c70db32a7b75ca1a&amp;r=68a567632a063c6f9bb27a73c151d21f6e855f50#to48] has a typo. It should be<br/>
<br/>
$\{basedir\}/src/main/resources/wadl<br/>
<br/>
instead of<br/>
<br/>
$\{basedir\}/src/main/resources/wad<br/>
<br/>
Note the missing &quot;l&quot;<br/>
<br/>
<br/>
Workaround is obvious: include<br/>
<br/>
&lt;wadlRoot&gt;$\{basedir\}/src/main/resources/wadl&lt;/wadlRoot&gt;<br/>
<br/>
in your configuration.<br/>
<br/>
<br/>
<br/>

  </td>
