                                            <td class="description">      http://cxf.apache.org/docs/jax-rs-data-bindings.html#JAX-RSDataBindings-JAXBandMoxy<br/>
MoxyJaxbContextResolved example is outdated<br/>
<br/>
this is working :<br/>
<br/>
{code:title=MoxyJaxbContextResolver java|borderStyle=solid}<br/>
public class MoxyJaxbContextResolver implements ContextResolver&lt;JAXBContext&gt; {<br/>
<br/>
<br/>
  @Override<br/>
  public JAXBContext getContext(Class&lt;?&gt; cls) {<br/>
      try {<br/>
          return JAXBContextFactory.createContext(new Class[] {cls},null);<br/>
      } catch (JAXBException ex) {<br/>
          throw new RuntimeException(ex);<br/>
      }<br/>
  }<br/>
<br/>
}<br/>
{code}
