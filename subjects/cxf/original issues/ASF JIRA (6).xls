                <tr id="issuerow12832346" rel="12832346" data-issuekey="CXF-6421" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6421" href="https://issues.apache.org/jira/browse/CXF-6421">CXF-6421</a>
</td>
                                            <td class="summary"><p>
                Slim Exchange map down
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
