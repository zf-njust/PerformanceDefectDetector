                                            <td class="summary"><p>
                allow a kind of chain in org.apache.cxf.common.util.ClassHelper
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
