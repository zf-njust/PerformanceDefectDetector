                <tr id="issuerow12940163" rel="12940163" data-issuekey="CXF-6788" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6788" href="https://issues.apache.org/jira/browse/CXF-6788">CXF-6788</a>
</td>
                                            <td class="summary"><p>
                Allow to specify a filter class in the LogginggFeature
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
