import javax.ws.rs.Produces;<br/>
<br/>
@Path(&quot;/BasicResource&quot;)<br/>
public class BasicResourceResource {<br/>
<br/>
    @GET<br/>
    @Produces(&quot;application/json&quot;)<br/>
    @Path(&quot;/echo&quot;)<br/>
    public String getEcho() {<br/>
