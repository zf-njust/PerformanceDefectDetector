                <tr id="issuerow12768634" rel="12768634" data-issuekey="CXF-6206" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6206" href="https://issues.apache.org/jira/browse/CXF-6206">CXF-6206</a>
</td>
                                            <td class="summary"><p>
                JAASLoginInterceptor: Return proper unauthorized response when JAAS login with basic auth fails
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Christian Schneider
    </td>
                                            <td class="creator">            Christian Schneider
    </td>
                                            <td class="created"> 20/Jan/15 09:53 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:09 </td>
                                            <td class="resolutiondate"> 21/Jan/15 10:19 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.0.4,                     3.1            </td>
                                            <td class="components">                        Core,                     Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
