                                            <td class="resolutiondate"> 29/May/15 06:43 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.1.1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
