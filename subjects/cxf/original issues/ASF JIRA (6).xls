                <tr id="issuerow12940066" rel="12940066" data-issuekey="CXF-6784" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6784" href="https://issues.apache.org/jira/browse/CXF-6784">CXF-6784</a>
</td>
                                            <td class="summary"><p>
                WS-Notification subscription should support renew
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Freeman Fang
    </td>
                                            <td class="creator">            Freeman Fang
    </td>
                                            <td class="created"> 18/Feb/16 05:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:20 </td>
                                            <td class="resolutiondate"> 02/Mar/16 06:24 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.1.6,                     3.2.0            </td>
                                            <td class="components">    &nbsp;
</td>
