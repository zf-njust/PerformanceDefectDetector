                                            <td class="summary"><p>
                String cannot be cast to org.apache.ws.security.validate.Validator
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Alessio Soldano
    </td>
                                            <td class="reporter">            Alessio Soldano
    </td>
                                            <td class="creator">            Alessio Soldano
    </td>
                                            <td class="created"> 12/Mar/15 21:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
