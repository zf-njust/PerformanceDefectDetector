+        throws ParserConfigurationException, SAXException, IOException {<br/>
+        DocumentBuilderFactory documentBuilderFactory = DocumentBuilderFactory.newInstance();<br/>
+        documentBuilderFactory.setNamespaceAware(true);<br/>
+        DocumentBuilder documentBuilder = documentBuilderFactory.newDocumentBuilder();<br/>
+        Document document = documentBuilder.parse(schemaLocation);<br/>
+        return document.getDocumentElement();<br/>
