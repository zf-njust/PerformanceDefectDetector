       http://cxf.apache.org/jaxrs http://cxf.apache.org/schemas/jaxrs.xsd&quot;&gt;<br/>
<br/>
    &lt;import resource=&quot;classpath:META-INF/cxf/cxf.xml&quot;/&gt;<br/>
    &lt;import resource=&quot;classpath:META-INF/cxf/cxf-servlet.xml&quot;/&gt;<br/>
<br/>
    &lt;jaxrs:server id=&quot;posCenterService&quot; address=&quot;/&quot;&gt;<br/>
        &lt;jaxrs:serviceBeans&gt;<br/>
            &lt;bean class=&quot;com.carvin.cxf.jaxrs.services.LoginService&quot; /&gt;<br/>
        &lt;/jaxrs:serviceBeans&gt;<br/>
        &lt;jaxrs:extensionMappings&gt;<br/>
            &lt;entry key=&quot;json&quot; value=&quot;application/json&quot;/&gt;<br/>
