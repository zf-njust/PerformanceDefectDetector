                <tr id="issuerow12757805" rel="12757805" data-issuekey="CXF-6117" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6117" href="https://issues.apache.org/jira/browse/CXF-6117">CXF-6117</a>
</td>
                                            <td class="summary"><p>
                Passing a string that contains &quot;path/file.json&quot; CXF Strips out the .json before the string gets to the server
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Bobby
    </td>
                                            <td class="creator">            Bobby
    </td>
                                            <td class="created"> 25/Nov/14 21:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:41 </td>
                                            <td class="resolutiondate"> 02/Dec/14 10:48 </td>
                                            <td class="versions">                        2.2            </td>
                                            <td class="fixVersions">                        NeedMoreInfo            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Java API service, js client, java 7
  </td>
                                            <td class="description">      When calling a GET from the client with url: &quot;myserver/myservices/service/file.json&quot; the server receives &quot;myserver/myservices/service/file&quot; and strips out the .json. It does not do this for other file formats just JSON.<br/>

  </td>
