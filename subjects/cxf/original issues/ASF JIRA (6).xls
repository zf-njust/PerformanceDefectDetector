&lt;soap-env:Body wsu:Id=&quot;part-Body-21&quot; xmlns:wsu=&quot;http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd&quot;&gt;&lt;n1:echoRequest xmlns:n1=&quot;http://schema.echo.ws.highdeal.com/&quot; xmlns:prx=&quot;urn:sap.com:proxy:EMI:/1SAI/TAS36028FAD870EA3A21C56:740&quot;&gt;String 1&lt;/n1:echoRequest&gt;&lt;/soap-env:Body&gt;<br/>
