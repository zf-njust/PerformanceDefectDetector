                <tr id="issuerow12953794" rel="12953794" data-issuekey="CXF-6844" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6844" href="https://issues.apache.org/jira/browse/CXF-6844">CXF-6844</a>
</td>
                                            <td class="summary"><p>
                Cannot assign &#39;part name&#39; in SOAP WSDL for document-wrapped style
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Andrey Nikolov
    </td>
                                            <td class="creator">            Andrey Nikolov
    </td>
                                            <td class="created"> 26/Mar/16 22:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Apr/16 19:48 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        3.1.5,                     3.1.6            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
