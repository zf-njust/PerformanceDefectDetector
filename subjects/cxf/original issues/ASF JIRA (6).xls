</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Svein Otto Solem
    </td>
                                            <td class="creator">            Svein Otto Solem
    </td>
                                            <td class="created"> 01/Aug/16 09:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/16 18:45 </td>
                                            <td class="resolutiondate"> 02/Aug/16 12:04 </td>
                                            <td class="versions">                        3.1.6            </td>
                                            <td class="fixVersions">                        3.1.8,                     3.2.0            </td>
                                            <td class="components">                        JAX-RS Security            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Checks that Issuer is nonnull but outputs expiry value instead of issuer.<br/>
<br/>
{code:title=org.apache.cxf.rs.security.oauth2.provider.OAuthJSONProvider.java|borderStyle=solid}<br/>
// From line 116, version 3.1.6 <br/>
if (obj.getIss() != null) {<br/>
  sb.append(&quot;,&quot;);<br/>
  appendJsonPair(sb, &quot;iss&quot;, obj.getExp(), false); // Wrong value, shoud be obj.getIss()<br/>
}<br/>
{code}
