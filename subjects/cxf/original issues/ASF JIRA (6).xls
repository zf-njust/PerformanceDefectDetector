</td>
                                            <td class="summary"><p>
                PrettyLoggingFilter tests and improvements
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Thomas Skjølberg
    </td>
                                            <td class="creator">            Thomas Skjølberg
    </td>
                                            <td class="created"> 27/May/15 17:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Mar/17 13:21 </td>
                                            <td class="resolutiondate"> 16/Mar/17 13:20 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.2.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
