                <tr id="issuerow13004059" rel="13004059" data-issuekey="CXF-7049" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-7049" href="https://issues.apache.org/jira/browse/CXF-7049">CXF-7049</a>
</td>
                                            <td class="summary"><p>
                Getting too many CLOSE_WAIT that lives forever
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Nithesh
    </td>
                                            <td class="creator">            Nithesh
    </td>
                                            <td class="created"> 10/Sep/16 09:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Sep/16 07:52 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        3.0.6            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Bus,                     Core,                     Integration            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
