                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      public class MyApplication extends Application {<br/>
	@Context<br/>
	Application application;<br/>
	@Context<br/>
	UriInfo info;<br/>
	@Context<br/>
	Request request;<br/>
	@Context<br/>
	HttpHeaders headers;<br/>
	public java.util.Set&lt;java.lang.Class&lt;?&gt;&gt; getClasses() {<br/>
		Set&lt;Class&lt;?&gt;&gt; resources = new HashSet&lt;Class&lt;?&gt;&gt;();<br/>
		resources.add(Resource.class);<br/>
		return resources;<br/>
   }<br/>
<br/>
The application field is expected to be injected with value of MyApplication object(this), not a null value after this application is started. <br/>

  </td>
