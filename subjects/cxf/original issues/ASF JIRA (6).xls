{code}<br/>
POST /service HTTP/1.1<br/>
Content-Type: application/soap+xml; action=&quot;service-action&quot;; charset=ISO-8859-1<br/>
Accept: */*<br/>
User-Agent: Apache CXF 3.1.6<br/>
Cache-Control: no-cache<br/>
Pragma: no-cache<br/>
Host: host:8081<br/>
Connection: keep-alive<br/>
Content-Length: 2072<br/>
<br/>
&lt;soap:Envelope xmlns:soap=&quot;http://www.w3.org/2003/05/soap-envelope&quot;&gt;&lt;soap:Header&gt;...&lt;/soap:Header&gt;&lt;soap:Body&gt;...&lt;lastName&gt;Müller&lt;/lastName&gt;...&lt;/soap:Body&gt;&lt;/soap:Envelope&gt;<br/>
{code}
