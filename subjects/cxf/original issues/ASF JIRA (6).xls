                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Mar/15 02:29 </td>
                                            <td class="resolutiondate"> 28/Mar/15 02:29 </td>
                                            <td class="versions">                        3.0.3,                     3.0.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
