                                            <td class="environment"></td>
                                            <td class="description">      If @ApplicationPath value is  an encoded value, if client send request to http://localhost:8080/Application!/myresource and get 404 .<br/>
{code}<br/>
@ApplicationPath(&quot;ApplicationPath%21&quot;)<br/>
public class MyApp extends Application {<br/>
  public java.util.Set&lt;java.lang.Class&lt;?&gt;&gt; getClasses() {<br/>
        Set&lt;Class&lt;?&gt;&gt; resources = new HashSet&lt;Class&lt;?&gt;&gt;();<br/>
        resources.add(MyResource.class);<br/>
        return resources;<br/>
    }   <br/>
}<br/>
{code}<br/>
    
