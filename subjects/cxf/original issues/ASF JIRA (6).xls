    <a class="issue-link" data-issue-key="CXF-6826" href="https://issues.apache.org/jira/browse/CXF-6826">CXF-6826</a>
</td>
                                            <td class="summary"><p>
                Cache MediaTypeHeaderProvider.valueOf(String mType) results
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
