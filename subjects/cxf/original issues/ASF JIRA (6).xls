                <tr id="issuerow12927204" rel="12927204" data-issuekey="CXF-6730" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6730" href="https://issues.apache.org/jira/browse/CXF-6730">CXF-6730</a>
</td>
                                            <td class="summary"><p>
                ClassCastException TransportBinding cannot be cast to AbstractSymmetricAsymmetricBinding in AbstractBindingBuilder
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Andreas Skomedal
    </td>
                                            <td class="creator">            Andreas Skomedal
    </td>
                                            <td class="created"> 05/Jan/16 08:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:15 </td>
                                            <td class="resolutiondate"> 05/Jan/16 12:08 </td>
                                            <td class="versions">                        3.0.7,                     3.1.4            </td>
                                            <td class="fixVersions">                        3.1.5,                     3.0.8            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      From commit https://github.com/apache/cxf/commit/f399b9290e42726e30333f261d8d7f6abc4768cc<br/>
<br/>
Paranthesis error in if<br/>
<br/>
{code}<br/>
if (binding instanceof AbstractSymmetricAsymmetricBinding<br/>
  &amp;&amp; (ProtectionOrder.EncryptBeforeSigning <br/>
