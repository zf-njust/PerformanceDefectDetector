    <a class="issue-link" data-issue-key="CXF-6311" href="https://issues.apache.org/jira/browse/CXF-6311">CXF-6311</a>
</td>
                                            <td class="summary"><p>
                Unusable error message for Unmarshall Error
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
