                <tr id="issuerow12992885" rel="12992885" data-issuekey="CXF-6981" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6981" href="https://issues.apache.org/jira/browse/CXF-6981">CXF-6981</a>
</td>
                                            <td class="summary"><p>
                Getting &quot;java.io.IOException: stream is closed&quot; for &gt; 64K messages
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Michal Sabo
    </td>
                                            <td class="creator">            Michal Sabo
    </td>
                                            <td class="created"> 27/Jul/16 11:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/16 18:45 </td>
                                            <td class="resolutiondate"> 13/Oct/16 12:46 </td>
                                            <td class="versions">                        3.0.9            </td>
                                            <td class="fixVersions">                        3.1.8,                     3.0.11,                     3.2.0            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
