        &lt;bundle start-level=&quot;40&quot;&gt;mvn:org.apache.httpcomponents/httpcore-osgi/4.4.4&lt;/bundle&gt;<br/>
        &lt;bundle start-level=&quot;40&quot;&gt;mvn:org.apache.httpcomponents/httpclient-osgi/4.5.2&lt;/bundle&gt;<br/>
