                <tr id="issuerow12922828" rel="12922828" data-issuekey="CXF-6718" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6718" href="https://issues.apache.org/jira/browse/CXF-6718">CXF-6718</a>
</td>
                                            <td class="summary"><p>
                Add a non-Spring example to the Swagger2Feature documentation
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Scott Wilson
    </td>
                                            <td class="creator">            Scott Wilson
    </td>
                                            <td class="created"> 17/Dec/15 19:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:07 </td>
                                            <td class="resolutiondate"> 22/Dec/15 13:57 </td>
                                            <td class="versions">                        3.1.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      N/A
  </td>
                                            <td class="description">      This page documents how to use Swagger2Feature using Spring and Blueprint, but there is no indication of how it can be used (or even if its possible to do so) with the non-Spring version of CXF, e.g. using CXFNonSpringJaxrsServlet in web.xml:<br/>
<br/>
http://cxf.apache.org/docs/swagger2feature.html<br/>
<br/>

  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
                                            <td class="aggregatetimeestimate"></td>
                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    documentation</td>
