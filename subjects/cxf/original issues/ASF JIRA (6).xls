                <tr id="issuerow13002737" rel="13002737" data-issuekey="CXF-7040" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-7040" href="https://issues.apache.org/jira/browse/CXF-7040">CXF-7040</a>
</td>
                                            <td class="summary"><p>
                Swagger UI Feature&#39;s resource root is incorrect for executable JAR/WAR
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
