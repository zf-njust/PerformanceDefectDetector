                <tr id="issuerow12761589" rel="12761589" data-issuekey="CXF-6156" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6156" href="https://issues.apache.org/jira/browse/CXF-6156">CXF-6156</a>
</td>
                                            <td class="summary"><p>
                JMS Conduit calling Spring Connection Factory close only through Finalize
    </p>
</td>
                                            <td class="issuetype"> Test</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Incomplete
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            CXFuser1
    </td>
                                            <td class="creator">            CXFuser1
    </td>
                                            <td class="created"> 14/Dec/14 01:48 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:31 </td>
                                            <td class="resolutiondate"> 10/Feb/15 21:05 </td>
                                            <td class="versions">                        2.6.11            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JMS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
