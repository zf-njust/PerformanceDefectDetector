   at org.apache.cxf.rs.security.oauth2.filters.OAuthRequestFilter.getAuthorizationParts(OAuthRequestFilter.java:227) ~[cxf-rt-rs-security-oauth2-3.0.3.jar:3.0.3]<br/>
