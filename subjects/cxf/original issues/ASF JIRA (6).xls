</td>
                                            <td class="summary"><p>
                OAuthRequestFilter throws NullPointerException when &quot;Authorization&quot; header is missing
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Michal Sabo
    </td>
                                            <td class="creator">            Michal Sabo
    </td>
                                            <td class="created"> 12/Dec/14 15:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:08 </td>
                                            <td class="resolutiondate"> 12/Dec/14 17:11 </td>
                                            <td class="versions">                        3.0.2            </td>
                                            <td class="fixVersions">                        3.0.4,                     2.7.15,                     3.1            </td>
                                            <td class="components">                        JAX-RS Security            </td>
