                <tr id="issuerow12979353" rel="12979353" data-issuekey="CXF-6943" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6943" href="https://issues.apache.org/jira/browse/CXF-6943">CXF-6943</a>
</td>
                                            <td class="summary"><p>
                Dead lock on Async Response when timeout is set
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
