</td>
                                            <td class="summary"><p>
                javax.management.InstanceNotFoundException on Spring shutdown: Unregistering ManagedEndpoint failed
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Benedikt Waldvogel
    </td>
                                            <td class="creator">            Benedikt Waldvogel
    </td>
                                            <td class="created"> 06/Jan/16 09:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Jan/16 10:00 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.7.18            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Management            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
