    </td>
                                            <td class="reporter">            Andriy Redko
    </td>
                                            <td class="creator">            Andriy Redko
    </td>
                                            <td class="created"> 10/May/16 23:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Mar/17 17:24 </td>
                                            <td class="resolutiondate"> 11/May/16 01:46 </td>
                                            <td class="versions">                        3.2.0            </td>
                                            <td class="fixVersions">                        3.1.9,                     3.2.0            </td>
