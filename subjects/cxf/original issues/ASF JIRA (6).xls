                <tr id="issuerow12850534" rel="12850534" data-issuekey="CXF-6511" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6511" href="https://issues.apache.org/jira/browse/CXF-6511">CXF-6511</a>
</td>
                                            <td class="summary"><p>
                Method &quot;isCglibProxyClass&quot; has been deleted on Spring 4.2
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Juan Carlos García del Canto
    </td>
                                            <td class="creator">            Juan Carlos García del Canto
    </td>
                                            <td class="created"> 31/Jul/15 07:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Aug/15 10:09 </td>
                                            <td class="resolutiondate"> 31/Jul/15 08:54 </td>
                                            <td class="versions">                        3.1.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Method *isCglibProxyClass* has been deleted on Spring 4.2, but SpringAopClassHelper CXF class is using it in *getRealClassInternal* method and produces the following exception:<br/>
