                <tr id="issuerow12768444" rel="12768444" data-issuekey="CXF-6202" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6202" href="https://issues.apache.org/jira/browse/CXF-6202">CXF-6202</a>
