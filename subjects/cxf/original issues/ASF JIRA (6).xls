                <tr id="issuerow12764677" rel="12764677" data-issuekey="CXF-6182" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6182" href="https://issues.apache.org/jira/browse/CXF-6182">CXF-6182</a>
</td>
                                            <td class="summary"><p>
                Documentation imprecision concerning name of web-application!
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Colbert Philippe
    </td>
                                            <td class="creator">            Colbert Philippe
    </td>
                                            <td class="created"> 03/Jan/15 01:25 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:07 </td>
                                            <td class="resolutiondate"> 04/Jan/15 09:52 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
