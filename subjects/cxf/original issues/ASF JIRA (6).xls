  http://cxf.apache.org/blueprint/jaxrs-client http://cxf.apache.org/schemas/blueprint/jaxrs-client.xsd<br/>
  &quot;&gt;<br/>
<br/>
    &lt;bean id=&quot;personServlet&quot;<br/>
        class=&quot;net.lr.tutorial.karaf.cxf.personrest.webui.PersonServlet&quot;&gt;<br/>
        &lt;property name=&quot;personService&quot; ref=&quot;personService&quot; /&gt;<br/>
    &lt;/bean&gt;<br/>
<br/>
    &lt;cm:property-placeholder persistent-id=&quot;net.lr.tutorial.karaf.cxf.personrest.webui&quot;<br/>
        update-strategy=&quot;reload&quot;&gt;<br/>
        &lt;cm:default-properties&gt;<br/>
            &lt;cm:property name=&quot;personServiceRest.URL&quot; value=&quot;http://localhost:8181/cxf/person&quot; /&gt;<br/>
        &lt;/cm:default-properties&gt;<br/>
    &lt;/cm:property-placeholder&gt;<br/>
    <br/>
<br/>
    &lt;jaxrs-client:client id=&quot;personService&quot; serviceClass=&quot;net.lr.tutorial.karaf.cxf.personrest.model.PersonService&quot;<br/>
        address=&quot;${personServiceRest.URL}&quot; /&gt;<br/>
<br/>
    &lt;service interface=&quot;javax.servlet.http.HttpServlet&quot; ref=&quot;personServlet&quot;&gt;<br/>
        &lt;service-properties&gt;<br/>
            &lt;entry key=&quot;alias&quot; value=&quot;/personuirest&quot; /&gt;<br/>
        &lt;/service-properties&gt;<br/>
    &lt;/service&gt;<br/>
<br/>
&lt;/blueprint&gt;<br/>

