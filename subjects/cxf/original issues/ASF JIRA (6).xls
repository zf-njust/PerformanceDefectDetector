    <a class="issue-link" data-issue-key="CXF-6854" href="https://issues.apache.org/jira/browse/CXF-6854">CXF-6854</a>
</td>
                                            <td class="summary"><p>
                Application subclass can&#39;t be injected into an application lass field
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Jim Ma
    </td>
                                            <td class="reporter">            Jim Ma
    </td>
                                            <td class="creator">            Jim Ma
    </td>
                                            <td class="created"> 30/Mar/16 13:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/16 13:25 </td>
                                            <td class="resolutiondate"> 31/Mar/16 13:25 </td>
                                            <td class="versions">                        3.1.6,                     3.0.9            </td>
                                            <td class="fixVersions">                        3.0.10,                     3.1.7,                     3.2.0            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
