                <tr id="issuerow12920729" rel="12920729" data-issuekey="CXF-6704" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6704" href="https://issues.apache.org/jira/browse/CXF-6704">CXF-6704</a>
</td>
                                            <td class="summary"><p>
                Upgrade to httpclient 4.5.x
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
