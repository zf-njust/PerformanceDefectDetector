                                            <td class="summary"><p>
                Problem with resource that returns Object with CXF version == 3.1.2
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Balarami Reddy
    </td>
                                            <td class="creator">            Balarami Reddy
    </td>
                                            <td class="created"> 17/May/16 04:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/16 18:50 </td>
                                            <td class="resolutiondate"> 24/May/16 20:25 </td>
                                            <td class="versions">                        3.1.2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
