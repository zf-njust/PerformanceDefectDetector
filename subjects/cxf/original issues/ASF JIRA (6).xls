</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6323" href="https://issues.apache.org/jira/browse/CXF-6323">CXF-6323</a>
</td>
                                            <td class="summary"><p>
                WS-RM redelivery not implemented
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jochen Riedlinger
    </td>
                                            <td class="creator">            Jochen Riedlinger
    </td>
                                            <td class="created"> 30/Mar/15 13:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Apr/17 19:18 </td>
                                            <td class="resolutiondate"> 04/Apr/17 19:18 </td>
                                            <td class="versions">                        2.7.14,                     3.0.4            </td>
                                            <td class="fixVersions">                        3.2.0            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">6</td>
                                            <td class="thumbnail"></td>
