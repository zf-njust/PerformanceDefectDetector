                <tr id="issuerow12909993" rel="12909993" data-issuekey="CXF-6662" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6662" href="https://issues.apache.org/jira/browse/CXF-6662">CXF-6662</a>
</td>
                                            <td class="summary"><p>
                WS-A Action generation without explicit definition
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Bas Nossing
    </td>
                                            <td class="creator">            Bas Nossing
    </td>
                                            <td class="created"> 03/Nov/15 13:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Nov/15 09:00 </td>
                                            <td class="resolutiondate"> 03/Nov/15 21:16 </td>
                                            <td class="versions">                        2.7.17            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
