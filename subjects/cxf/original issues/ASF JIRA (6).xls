       public void process(Exchange exchange) throws Exception { <br/>
              Message message =  exchange.getOut(); <br/>
              <br/>
              message.setBody( bindMessage()); <br/>
              exchange.setOut(message); <br/>
              //java.lang.System.out.println(&quot;MIP of Http Endpoint is &quot; + message); <br/>
              java.lang.System.out.println(&quot;NEW MIP of Http Endpoint is &quot; + exchange.getPattern()); <br/>
  <br/>
       } <br/>
      <br/>
      <br/>
       private String bindMessage(){ <br/>
              return        &quot;&lt;ATT_CheckRS TimeStamp=\&quot;2016-03-08T07:01:30.175Z\&quot; Version=\&quot;1.003\&quot; TransactionIdentifier=\&quot;\&quot; PrimaryLangID=\&quot;ENG\&quot; xmlns:xsi=\&quot;http://www.w3.org/2001/XMLSchema-instance\&quot; xmlns=\&quot;http://www.travel.org/ABC/2003/05\&quot;&gt;&quot; <br/>
    +&quot;&lt;POS&gt;&quot; <br/>
    +&quot;&lt;Source PseudoCityCode=\&quot;\&quot; ISOCurrency=\&quot;\&quot;&gt;&quot; <br/>
    +&quot;&lt;RequestorID Type=\&quot;05\&quot;/&gt;&quot; <br/>
    +&quot;&lt;/Source&gt;&quot; <br/>
    +&quot;&lt;/POS&gt;&quot; <br/>
    +&quot;&lt;Errors xmlns=\&quot;\&quot;&gt;&quot; <br/>
    +&quot;&lt;Error Code=\&quot;320\&quot; Language=\&quot;en_US\&quot; ShortText=\&quot;Invalid value\&quot; Status=\&quot;\&quot; Type=\&quot;4\&quot;/&gt;&quot; <br/>
    +&quot;&lt;/Errors&gt;&quot; <br/>
    +&quot;&lt;/ATT_CheckRS&gt;&quot;; <br/>
  <br/>
  <br/>
  <br/>
       } <br/>
} <br/>
  
