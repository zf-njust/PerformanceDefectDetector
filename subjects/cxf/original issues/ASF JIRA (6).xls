                <tr id="issuerow12919513" rel="12919513" data-issuekey="CXF-6702" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6702" href="https://issues.apache.org/jira/browse/CXF-6702">CXF-6702</a>
</td>
                                            <td class="summary"><p>
                Support external executor for JMS Containers
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andrei Shakirin
    </td>
                                            <td class="reporter">            Andrei Shakirin
    </td>
                                            <td class="creator">            Andrei Shakirin
    </td>
                                            <td class="created"> 06/Dec/15 15:23 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Dec/15 19:44 </td>
                                            <td class="resolutiondate"> 08/Dec/15 19:44 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.2.0            </td>
                                            <td class="components">                        JMS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
