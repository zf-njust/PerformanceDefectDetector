</td>
                                            <td class="summary"><p>
                Unable to override Host in HTTP Header
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Damon Horrell
    </td>
                                            <td class="creator">            Damon Horrell
    </td>
                                            <td class="created"> 25/Sep/15 04:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/16 18:50 </td>
                                            <td class="resolutiondate"> 25/Sep/15 09:07 </td>
                                            <td class="versions">                        2.7.7            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
