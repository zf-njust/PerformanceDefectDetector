</td>
                                            <td class="summary"><p>
                Make all maven plugins m2e compatible
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Victor
    </td>
                                            <td class="creator">            Victor
    </td>
                                            <td class="created"> 25/Aug/15 12:43 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Aug/15 12:43 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
