    <a class="issue-link" data-issue-key="CXF-6209" href="https://issues.apache.org/jira/browse/CXF-6209">CXF-6209</a>
</td>
                                            <td class="summary"><p>
                Bug in processing Signed/Encrypted Elements policies with multiple XPaths
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
