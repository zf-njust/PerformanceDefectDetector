    <a class="issue-link" data-issue-key="CXF-6473" href="https://issues.apache.org/jira/browse/CXF-6473">CXF-6473</a>
</td>
                                            <td class="summary"><p>
                Double signatures while using AsymmetricBindingHandler
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Jordy Onrust
    </td>
                                            <td class="creator">            Jordy Onrust
    </td>
                                            <td class="created"> 24/Jun/15 10:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Oct/16 14:28 </td>
                                            <td class="resolutiondate"> 24/Jun/15 16:07 </td>
                                            <td class="versions">                        2.7.13            </td>
                                            <td class="fixVersions">                        3.0.6,                     2.7.17,                     3.1.2            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
