                <tr id="issuerow12991370" rel="12991370" data-issuekey="CXF-6973" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6973" href="https://issues.apache.org/jira/browse/CXF-6973">CXF-6973</a>
</td>
                                            <td class="summary"><p>
                Allow to configure http conduits and destinations using features
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Christian Schneider
    </td>
