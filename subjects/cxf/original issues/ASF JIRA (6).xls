                                            <td class="description">      Code:<br/>
== Service ==<br/>
{code}<br/>
@Path(&quot;/login&quot;)<br/>
public class LoginService {<br/>
    @POST<br/>
    @Produces(MediaType.TEXT_PLAIN)<br/>
    @Consumes(MediaType.APPLICATION_FORM_URLENCODED)<br/>
    public String login(@Context HttpServletRequest request) {<br/>
        String name = request.getParameter(&quot;name&quot;);<br/>
<br/>
        System.out.println(&quot;name : &quot; + name); // The name is null<br/>
        if(&quot;test&quot;.equals(name)) {<br/>
            return &quot;SUCCESS&quot;;<br/>
        }<br/>
        return &quot;FAIL&quot;;<br/>
    }<br/>
}<br/>
{code}<br/>
