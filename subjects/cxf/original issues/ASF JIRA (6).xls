                <tr id="issuerow12950198" rel="12950198" data-issuekey="CXF-6830" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6830" href="https://issues.apache.org/jira/browse/CXF-6830">CXF-6830</a>
</td>
                                            <td class="summary"><p>
                should be able to configure the certStore key type
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Freeman Fang
    </td>
                                            <td class="creator">            Freeman Fang
    </td>
                                            <td class="created"> 15/Mar/16 06:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/16 18:50 </td>
                                            <td class="resolutiondate"> 15/Mar/16 07:03 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
