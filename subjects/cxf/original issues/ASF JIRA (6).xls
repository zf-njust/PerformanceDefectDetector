                <tr id="issuerow12836853" rel="12836853" data-issuekey="CXF-6455" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6455" href="https://issues.apache.org/jira/browse/CXF-6455">CXF-6455</a>
</td>
                                            <td class="summary"><p>
                Cannot resolve the name &#39;http-conf:client&#39;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Łukasz Nowak
    </td>
                                            <td class="creator">            Łukasz Nowak
    </td>
                                            <td class="created"> 10/Jun/15 15:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jun/15 12:08 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        3.1.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Integration,                     JAX-RS            </td>
