                                            <td class="versions">                        3.1            </td>
                                            <td class="fixVersions">                        3.1.1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">172800</td>
                                            <td class="timeestimate">172800</td>
