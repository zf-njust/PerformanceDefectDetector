                <tr id="issuerow12379713" rel="12379713" data-issuekey="CXF-1088" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1088" href="https://issues.apache.org/jira/browse/CXF-1088">CXF-1088</a>
</td>
                                            <td class="summary"><p>
                document handling of case where spring aop breaks wsdl generation
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
