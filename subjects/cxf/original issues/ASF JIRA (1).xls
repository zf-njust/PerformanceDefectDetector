    <a class="issue-link" data-issue-key="CXF-1964" href="https://issues.apache.org/jira/browse/CXF-1964">CXF-1964</a>
</td>
                                            <td class="summary"><p>
                Add ability to inject WSS4J Processor objects into the WSS4JInInterceptor
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 07/Jan/09 15:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Feb/09 22:19 </td>
                                            <td class="resolutiondate"> 08/Jan/09 17:58 </td>
                                            <td class="versions">                        2.0.9,                     2.1.3            </td>
                                            <td class="fixVersions">                        2.0.10,                     2.1.4            </td>
