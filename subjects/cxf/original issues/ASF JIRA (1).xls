    <a class="issue-link" data-issue-key="CXF-1195" href="https://issues.apache.org/jira/browse/CXF-1195">CXF-1195</a>
</td>
                                            <td class="summary"><p>
                xjc dv plugin doesn&#39;t provide default values for enums
    </p>
</td>
                                            <td class="issuetype"> Test</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            kombi
    </td>
                                            <td class="creator">            kombi
    </td>
                                            <td class="created"> 09/Nov/07 16:45 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Jan/08 21:51 </td>
                                            <td class="resolutiondate"> 09/Nov/07 19:04 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        2.0.4            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
