                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:34 </td>
                                            <td class="resolutiondate"> 23/Oct/09 19:48 </td>
                                            <td class="versions">                        2.0.4            </td>
                                            <td class="fixVersions">                        2.1.8,                     2.2.5            </td>
                                            <td class="components">                        Integration            </td>
