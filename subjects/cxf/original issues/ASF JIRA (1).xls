    <a class="issue-link" data-issue-key="CXF-1791" href="https://issues.apache.org/jira/browse/CXF-1791">CXF-1791</a>
</td>
                                            <td class="summary"><p>
                Exception feedback
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
