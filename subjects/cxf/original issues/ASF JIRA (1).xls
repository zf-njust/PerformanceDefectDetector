</td>
                                            <td class="summary"><p>
                Address in use errors from attempt to repeatedly start and stop services
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Benson Margulies
    </td>
                                            <td class="creator">            Benson Margulies
    </td>
