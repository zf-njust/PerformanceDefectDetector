</td>
                                            <td class="summary"><p>
                WSDL2Java validate error for doc/lit bare wsdl.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            maomaode
    </td>
