                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Dec/07 23:04 </td>
                                            <td class="resolutiondate"> 30/Nov/07 07:21 </td>
                                            <td class="versions">                        2.0.3            </td>
                                            <td class="fixVersions">                        2.0.4            </td>
