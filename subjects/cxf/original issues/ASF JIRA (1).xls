                <tr id="issuerow12378161" rel="12378161" data-issuekey="CXF-1001" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1001" href="https://issues.apache.org/jira/browse/CXF-1001">CXF-1001</a>
</td>
                                            <td class="summary"><p>
                WSDL2Java header problem when using -exsh parameter
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            maomaode
    </td>
                                            <td class="reporter">            Julien
    </td>
                                            <td class="creator">            Julien
    </td>
                                            <td class="created"> 13/Sep/07 13:28 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Oct/07 16:46 </td>
                                            <td class="resolutiondate"> 14/Sep/07 04:36 </td>
                                            <td class="versions">                        2.0.1            </td>
                                            <td class="fixVersions">                        2.0.2            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
