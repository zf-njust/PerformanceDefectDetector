 @WebMethod<br/>
 public List&lt;Rb_stat&gt; getStatList(@WebParam(name=&quot;inputObject&quot;) Rb_stat inputObject) {<br/>
 ...<br/>
 }<br/>
<br/>
}<br/>
<br/>
<br/>
@XmlType(name=&quot;DOlrb_stat&quot;,namespace=&quot;http://rb.lite.ws.daisy.marbes.cz&quot;)<br/>
public class Rb_stat extends DOlrb_stat {<br/>
}<br/>
<br/>
<br/>
Generate invalid WSDL:<br/>
<br/>
<br/>
- &lt;xsd:schema attributeFormDefault=&quot;qualified&quot; elementFormDefault=&quot;qualified&quot; targetNamespace=&quot;http://ws.rb.modules.daisy.marbes.cz&quot; xmlns:ns1=&quot;http://rb.lite.ws.daisy.marbes.cz&quot; xmlns:tns=&quot;http://ws.rb.modules.daisy.marbes.cz&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot;&gt;<br/>
  &lt;import namespace=&quot;http://rb.lite.ws.daisy.marbes.cz&quot; xmlns=&quot;http://www.w3.org/2001/XMLSchema&quot; /&gt; <br/>
- &lt;xsd:complexType name=&quot;inputObject&quot;&gt;<br/>
- &lt;xsd:sequence&gt;<br/>
  &lt;xsd:element minOccurs=&quot;0&quot; name=&quot;ns1:id_stat&quot; nillable=&quot;true&quot; type=&quot;xsd:int&quot; /&gt; <br/>
  &lt;xsd:element minOccurs=&quot;0&quot; name=&quot;ns1:nazev_stat&quot; nillable=&quot;true&quot; type=&quot;xsd:string&quot; /&gt; <br/>
  &lt;/xsd:sequence&gt;<br/>
  &lt;/xsd:complexType&gt;<br/>
  &lt;/xsd:schema&gt;<br/>
- &lt;xsd:schema attributeFormDefault=&quot;qualified&quot; elementFormDefault=&quot;qualified&quot; targetNamespace=&quot;http://rb.lite.ws.daisy.marbes.cz&quot; xmlns:tns=&quot;http://rb.lite.ws.daisy.marbes.cz&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot;&gt;<br/>
- &lt;xsd:complexType name=&quot;DOlrb_stat&quot;&gt;<br/>
- &lt;xsd:sequence&gt;<br/>
  &lt;xsd:element minOccurs=&quot;0&quot; name=&quot;id_stat&quot; nillable=&quot;true&quot; type=&quot;xsd:int&quot; /&gt; <br/>
  &lt;xsd:element minOccurs=&quot;0&quot; name=&quot;nazev_stat&quot; nillable=&quot;true&quot; type=&quot;xsd:string&quot; /&gt; <br/>
  &lt;/xsd:sequence&gt;<br/>
  &lt;/xsd:complexType&gt;<br/>
- &lt;xsd:complexType name=&quot;ArrayOfDOlrb_stat&quot;&gt;<br/>
- &lt;xsd:sequence&gt;<br/>
  &lt;xsd:element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;DOlrb_stat&quot; nillable=&quot;true&quot; type=&quot;tns:DOlrb_stat&quot; /&gt; <br/>
  &lt;/xsd:sequence&gt;<br/>
  &lt;/xsd:complexType&gt;<br/>
  &lt;/xsd:schema&gt;<br/>
<br/>
<br/>
<br/>
From my point of view  webservice class is in one namespace and parameter class Rb_stat is in another. Return is mix of both.
