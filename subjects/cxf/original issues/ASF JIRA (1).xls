    <a class="issue-link" data-issue-key="CXF-1487" href="https://issues.apache.org/jira/browse/CXF-1487">CXF-1487</a>
</td>
                                            <td class="summary"><p>
                WS-RM policy assertions not merged properly 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
