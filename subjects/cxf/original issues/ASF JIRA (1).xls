                <tr id="issuerow12401871" rel="12401871" data-issuekey="CXF-1738" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1738" href="https://issues.apache.org/jira/browse/CXF-1738">CXF-1738</a>
</td>
                                            <td class="summary"><p>
                AbstractWSDLBasedEndpointFactory should setTransportId for local and camel transport according to the publish address 
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Freeman Fang
    </td>
                                            <td class="creator">            Freeman Fang
    </td>
                                            <td class="created"> 07/Aug/08 08:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Aug/08 18:26 </td>
                                            <td class="resolutiondate"> 07/Aug/08 10:12 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.1.2            </td>
