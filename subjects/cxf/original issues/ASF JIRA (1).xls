    <a class="issue-link" data-issue-key="CXF-1759" href="https://issues.apache.org/jira/browse/CXF-1759">CXF-1759</a>
</td>
                                            <td class="summary"><p>
                CXF and EJB 3.0 integration support
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
