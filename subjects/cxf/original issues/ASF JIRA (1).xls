    <a class="issue-link" data-issue-key="CXF-1883" href="https://issues.apache.org/jira/browse/CXF-1883">CXF-1883</a>
</td>
                                            <td class="summary"><p>
                inherited classes and attributes not generated
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
