                                            <td class="summary"><p>
                NPE with Spring 2.5.2
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            akakunin
    </td>
                                            <td class="creator">            akakunin
    </td>
                                            <td class="created"> 08/Mar/08 15:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Apr/08 15:00 </td>
                                            <td class="resolutiondate"> 10/Mar/08 21:14 </td>
                                            <td class="versions">                        2.0.4            </td>
                                            <td class="fixVersions">                        2.0.5            </td>
