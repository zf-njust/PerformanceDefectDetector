    <a class="issue-link" data-issue-key="CXF-1948" href="https://issues.apache.org/jira/browse/CXF-1948">CXF-1948</a>
</td>
                                            <td class="summary"><p>
                Interface is not visible when CXF does not have visiblility to domain classes.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
