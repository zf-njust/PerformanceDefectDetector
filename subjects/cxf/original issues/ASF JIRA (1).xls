                <tr id="issuerow12394535" rel="12394535" data-issuekey="CXF-1540" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1540" href="https://issues.apache.org/jira/browse/CXF-1540">CXF-1540</a>
</td>
                                            <td class="summary"><p>
                Maven cxf-codegen-plugin (probably wsdl2java) not creating correct default package names
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Glen Mazza
    </td>
                                            <td class="creator">            Glen Mazza
    </td>
                                            <td class="created"> 22/Apr/08 15:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Jan/09 17:14 </td>
                                            <td class="resolutiondate"> 06/May/08 06:18 </td>
                                            <td class="versions">                        2.0.5            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      For the below WSDL, the default package name is stripping off a zero in the package name.  <br/>
<br/>
It is giving a package name of:<br/>
package org.example.doubleit._1_0_0;<br/>
<br/>
but it should be:<br/>
package org.example.doubleit._1_0_0_0;<br/>
<br/>
Note if I change the namespace to end in characters it comes out correctly:<br/>
http://www.example.org/DoubleIt/1.0.0.0/abc<br/>
<br/>
Correctly turns out to:<br/>
package org.example.doubleit._1_0_0_0.abc;<br/>
<br/>
Using the Maven plugin given in: http://issues.apache.org/jira/browse/CXF-1539<br/>
<br/>
&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;<br/>
&lt;wsdl:definitions name=&quot;DoubleIt&quot; <br/>
   xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; <br/>
   xmlns:wsdl=&quot;http://schemas.xmlsoap.org/wsdl/&quot;<br/>
   xmlns:soap=&quot;http://schemas.xmlsoap.org/wsdl/soap/&quot;<br/>
   xmlns:tns=&quot;http://www.example.org/DoubleIt/1.0.0.0&quot;<br/>
   targetNamespace=&quot;http://www.example.org/DoubleIt/1.0.0.0&quot;&gt;<br/>
   &lt;wsdl:types&gt;<br/>
      &lt;xsd:schema targetNamespace=&quot;http://www.example.org/DoubleIt/1.0.0.0&quot;&gt;<br/>
         &lt;xsd:element name=&quot;DoubleIt&quot;&gt;<br/>
            &lt;xsd:complexType&gt;<br/>
               &lt;xsd:sequence&gt;<br/>
                  &lt;xsd:element name=&quot;numberToDouble&quot; type=&quot;xsd:integer&quot;/&gt;<br/>
               &lt;/xsd:sequence&gt;<br/>
            &lt;/xsd:complexType&gt;<br/>
         &lt;/xsd:element&gt;<br/>
         &lt;xsd:element name=&quot;DoubleItResponse&quot;&gt;<br/>
            &lt;xsd:complexType&gt;<br/>
               &lt;xsd:sequence&gt;<br/>
                  &lt;xsd:element name=&quot;doubledNumber&quot; type=&quot;xsd:integer&quot; /&gt;<br/>
               &lt;/xsd:sequence&gt;<br/>
            &lt;/xsd:complexType&gt;<br/>
         &lt;/xsd:element&gt;<br/>
      &lt;/xsd:schema&gt;<br/>
   &lt;/wsdl:types&gt;<br/>
   &lt;wsdl:message name=&quot;DoubleItRequest&quot;&gt;<br/>
      &lt;wsdl:part element=&quot;tns:DoubleIt&quot; name=&quot;parameters&quot; /&gt;<br/>
   &lt;/wsdl:message&gt;<br/>
   &lt;wsdl:message name=&quot;DoubleItResponse&quot;&gt;<br/>
      &lt;wsdl:part element=&quot;tns:DoubleItResponse&quot; name=&quot;parameters&quot; /&gt;<br/>
   &lt;/wsdl:message&gt;<br/>
   &lt;wsdl:portType name=&quot;DoubleItPortType&quot;&gt;<br/>
      &lt;wsdl:operation name=&quot;DoubleIt&quot;&gt;<br/>
         &lt;wsdl:input message=&quot;tns:DoubleItRequest&quot; /&gt;<br/>
         &lt;wsdl:output message=&quot;tns:DoubleItResponse&quot; /&gt;<br/>
      &lt;/wsdl:operation&gt;<br/>
   &lt;/wsdl:portType&gt;<br/>
   &lt;wsdl:binding name=&quot;DoubleItBinding&quot; type=&quot;tns:DoubleItPortType&quot;&gt;<br/>
      &lt;soap:binding style=&quot;document&quot;<br/>
         transport=&quot;http://schemas.xmlsoap.org/soap/http&quot; /&gt;<br/>
      &lt;wsdl:operation name=&quot;DoubleIt&quot;&gt;<br/>
         &lt;soap:operation soapAction=&quot;&quot;/&gt;<br/>
         &lt;wsdl:input&gt;&lt;soap:body use=&quot;literal&quot;/&gt;&lt;/wsdl:input&gt;<br/>
         &lt;wsdl:output&gt;&lt;soap:body use=&quot;literal&quot;/&gt;&lt;/wsdl:output&gt;<br/>
      &lt;/wsdl:operation&gt;<br/>
   &lt;/wsdl:binding&gt;<br/>
   &lt;wsdl:service name=&quot;DoubleItService&quot;&gt;<br/>
      &lt;wsdl:port name=&quot;DoubleItPort&quot; binding=&quot;tns:DoubleItBinding&quot;&gt;<br/>
         &lt;soap:address <br/>
            location=&quot;http://localhost:8080/doubleit/services/doubleit&quot;/&gt;<br/>
      &lt;/wsdl:port&gt;<br/>
   &lt;/wsdl:service&gt;<br/>
&lt;/wsdl:definitions&gt;<br/>
<br/>

  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
                                            <td class="aggregatetimeestimate"></td>
                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    </td>
                                            <td class="customfield_12310060"></td>
                                            <td class="customfield_12310220"></td>
                                            <td class="customfield_12312322"></td>
