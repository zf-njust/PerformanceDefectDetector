    <a class="issue-link" data-issue-key="CXF-1834" href="https://issues.apache.org/jira/browse/CXF-1834">CXF-1834</a>
</td>
                                            <td class="summary"><p>
                The corba prefix is not present in the physical part of the wsdl when a yoko corba namespace is used.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Keith Halligan
    </td>
                                            <td class="creator">            Keith Halligan
    </td>
                                            <td class="created"> 30/Sep/08 14:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Oct/08 03:59 </td>
                                            <td class="resolutiondate"> 07/Oct/08 17:06 </td>
                                            <td class="versions">                        2.1.2            </td>
                                            <td class="fixVersions">                        2.1.3            </td>
                                            <td class="components">                        CORBA Binding,                     JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
