    <a class="issue-link" data-issue-key="CXF-1635" href="https://issues.apache.org/jira/browse/CXF-1635">CXF-1635</a>
</td>
                                            <td class="summary"><p>
                JaxrsUtils checks the wrong variable for null and size in the method readFromUriParam
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Brad Moody
    </td>
                                            <td class="creator">            Brad Moody
    </td>
                                            <td class="created"> 06/Jun/08 09:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Jan/09 17:14 </td>
                                            <td class="resolutiondate"> 06/Jun/08 09:49 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
