</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1903" href="https://issues.apache.org/jira/browse/CXF-1903">CXF-1903</a>
</td>
                                            <td class="summary"><p>
                Maven Codegen Plugin Fails For CXF WSDL
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Benson Margulies
    </td>
                                            <td class="reporter">            Sarris Overbosch
    </td>
                                            <td class="creator">            Sarris Overbosch
    </td>
                                            <td class="created"> 07/Nov/08 14:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Feb/09 22:20 </td>
                                            <td class="resolutiondate"> 07/Nov/08 23:53 </td>
                                            <td class="versions">                        2.1.2,                     2.1.3            </td>
                                            <td class="fixVersions">                        2.1.4            </td>
                                            <td class="components">                        Configuration            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
