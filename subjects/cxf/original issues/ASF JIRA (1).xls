                <tr id="issuerow12400150" rel="12400150" data-issuekey="CXF-1700" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1700" href="https://issues.apache.org/jira/browse/CXF-1700">CXF-1700</a>
</td>
                                            <td class="summary"><p>
                XMLBeans - XmlBeansSchemaInitializer (Lline #177) can&#39;t handle xs:include 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Leon
    </td>
                                            <td class="creator">            Leon
    </td>
                                            <td class="created"> 12/Jul/08 01:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Mar/09 09:58 </td>
                                            <td class="resolutiondate"> 17/Jul/08 15:20 </td>
                                            <td class="versions">                        2.1.1            </td>
                                            <td class="fixVersions">                        2.1.2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      XMLBeans binding can&#39;t seem to handle an xs:include.  see XmlBeansSchemaInitializer.java (Lline #177) Here is sample .xsd to reproduce this problem. <br/>
<br/>
<br/>
&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;<br/>
&lt;xs:schema     <br/>
    xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot;<br/>
    targetNamespace=&quot;http://sample.com/procure&quot;<br/>
    xmlns:po=&quot;http://sample.com/procure&quot;<br/>
    elementFormDefault=&quot;qualified&quot;&gt;<br/>
    &lt;xs:include schemaLocation=&quot;./commonSchemas.xsd&quot;/&gt;<br/>
    &lt;xs:element name=&quot;purchase-order&quot;&gt;<br/>
        &lt;xs:complexType&gt;<br/>
            &lt;xs:sequence&gt;<br/>
                &lt;xs:element name=&quot;customer&quot; type=&quot;po:customer&quot;/&gt;<br/>
                &lt;xs:element name=&quot;shipper&quot; type=&quot;po:shipper&quot; minOccurs=&quot;0&quot;/&gt;<br/>
            &lt;/xs:sequence&gt;<br/>
        &lt;/xs:complexType&gt;<br/>
    &lt;/xs:element&gt;<br/>
&lt;/xs:schema&gt;<br/>
<br/>
<br/>
&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;<br/>
&lt;xs:schema xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns=&quot;http://sample.com/procure&quot; targetNamespace=&quot;http://sample.com/procure&quot; elementFormDefault=&quot;qualified&quot; attributeFormDefault=&quot;unqualified&quot;&gt;<br/>
    &lt;xs:complexType name=&quot;customer&quot;&gt;<br/>
        &lt;xs:sequence&gt;<br/>
            &lt;xs:element name=&quot;name&quot; type=&quot;xs:string&quot;/&gt;<br/>
