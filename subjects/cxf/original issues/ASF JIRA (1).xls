                <tr id="issuerow12379371" rel="12379371" data-issuekey="CXF-1084" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1084" href="https://issues.apache.org/jira/browse/CXF-1084">CXF-1084</a>
</td>
                                            <td class="summary"><p>
                namespace control in aegis (with jaxws) don&#39;t work for the wsdl element, only for the schemas
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Benson Margulies
    </td>
                                            <td class="reporter">            Benson Margulies
    </td>
                                            <td class="creator">            Benson Margulies
    </td>
                                            <td class="created"> 30/Sep/07 19:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Jul/08 17:22 </td>
                                            <td class="resolutiondate"> 04/Mar/08 21:09 </td>
                                            <td class="versions">                        2.0.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Aegis Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
