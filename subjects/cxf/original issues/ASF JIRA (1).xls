</td>
                                            <td class="summary"><p>
                localtransport  Concurrent problem
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            ispx_team
    </td>
                                            <td class="creator">            ispx_team
    </td>
                                            <td class="created"> 13/Jun/08 07:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Jul/08 17:19 </td>
                                            <td class="resolutiondate"> 16/Jun/08 20:15 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        2.1.1,                     2.0.7            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
