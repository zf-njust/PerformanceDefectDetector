    <a class="issue-link" data-issue-key="CXF-1860" href="https://issues.apache.org/jira/browse/CXF-1860">CXF-1860</a>
</td>
                                            <td class="summary"><p>
                JMS Transport - JMSDestination no room left on workqueue in JMSListenerThread
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Richard Holt
    </td>
                                            <td class="creator">            Richard Holt
    </td>
