                                            <td class="summary"><p>
                AttachmentDeserializer is leaving behind temp files
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            aaron pieper
    </td>
                                            <td class="creator">            aaron pieper
    </td>
                                            <td class="created"> 18/Feb/08 21:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Apr/08 15:00 </td>
                                            <td class="resolutiondate"> 20/Feb/08 14:38 </td>
                                            <td class="versions">                        2.0.4            </td>
                                            <td class="fixVersions">                        2.0.5            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
