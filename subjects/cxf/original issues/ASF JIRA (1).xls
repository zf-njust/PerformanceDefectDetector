                <tr id="issuerow12402461" rel="12402461" data-issuekey="CXF-1751" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1751" href="https://issues.apache.org/jira/browse/CXF-1751">CXF-1751</a>
</td>
                                            <td class="summary"><p>
                idl2wsdl fails to generate wsdl for IDL files with complex object reference usage
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
