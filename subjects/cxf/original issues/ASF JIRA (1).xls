    <a class="issue-link" data-issue-key="CXF-2020" href="https://issues.apache.org/jira/browse/CXF-2020">CXF-2020</a>
</td>
                                            <td class="summary"><p>
                Code generated from SwA/Mime binding when NOT using the enableMIMEContent customization throws exceptions at runtime
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
                                            <td class="created"> 02/Feb/09 22:27 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Feb/09 22:20 </td>
                                            <td class="resolutiondate"> 03/Feb/09 03:06 </td>
                                            <td class="versions">                        2.0.9,                     2.1.3            </td>
                                            <td class="fixVersions">                        2.1.4            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
