    <a class="issue-link" data-issue-key="CXF-1565" href="https://issues.apache.org/jira/browse/CXF-1565">CXF-1565</a>
</td>
                                            <td class="summary"><p>
                wsdl2java jaxws binding issues
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Adrian Corcoran
    </td>
                                            <td class="creator">            Adrian Corcoran
    </td>
