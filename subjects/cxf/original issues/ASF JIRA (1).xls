                <tr id="issuerow12396806" rel="12396806" data-issuekey="CXF-1610" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1610" href="https://issues.apache.org/jira/browse/CXF-1610">CXF-1610</a>
</td>
                                            <td class="summary"><p>
                Cannot build service model from WSDL for &#39;type&#39; part of xsd:base64binary
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
