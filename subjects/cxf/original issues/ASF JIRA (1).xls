                <tr id="issuerow12413418" rel="12413418" data-issuekey="CXF-2008" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2008" href="https://issues.apache.org/jira/browse/CXF-2008">CXF-2008</a>
</td>
                                            <td class="summary"><p>
                JMS Transport: Invalid temporary destination when using Tibco ems and temporary reply queue
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Christian Schneider
    </td>
                                            <td class="creator">            Christian Schneider
    </td>
                                            <td class="created"> 27/Jan/09 22:14 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 15:08 </td>
                                            <td class="resolutiondate"> 23/Sep/09 07:36 </td>
                                            <td class="versions">                        2.1.3            </td>
                                            <td class="fixVersions">                        2.3,                     2.2.11            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Windows Vista, Java 1.6.0-update 10, Tibco EMS 4.4.2
  </td>
                                            <td class="description">      When using the JMS Transport with Tibco EMS and using a temporary reply destination the following exception is thrown on the CXF client.<br/>
The problem was reported by Ed Scriven.<br/>
