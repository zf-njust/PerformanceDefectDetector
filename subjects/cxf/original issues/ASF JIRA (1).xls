                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/08 21:36 </td>
                                            <td class="resolutiondate"> 11/Jul/08 21:36 </td>
                                            <td class="versions">                        2.1.1,                     2.0.7            </td>
                                            <td class="fixVersions">                        2.0.8,                     2.1.2            </td>
