                                            <td class="summary"><p>
                WS Addressing Does Not Work with JAX-WS Provider Based Implementations
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            bharath reddy
    </td>
                                            <td class="creator">            bharath reddy
    </td>
                                            <td class="created"> 16/May/08 20:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
