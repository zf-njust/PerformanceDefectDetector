                <tr id="issuerow12399116" rel="12399116" data-issuekey="CXF-1671" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1671" href="https://issues.apache.org/jira/browse/CXF-1671">CXF-1671</a>
</td>
                                            <td class="summary"><p>
                Add a setter to JSONProvider to set the XML Namespace to Jettison prefix map
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Joe Sunday
    </td>
                                            <td class="creator">            Joe Sunday
    </td>
                                            <td class="created"> 26/Jun/08 21:17 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Aug/08 18:26 </td>
                                            <td class="resolutiondate"> 03/Jul/08 17:13 </td>
                                            <td class="versions">                        2.1,                     2.0.6,                     2.1.1,                     2.0.7            </td>
                                            <td class="fixVersions">                        2.1.2            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      There is currently no way to configure a REST service to pass an XML namespace to jettison prefix mapping using the default JSONProvider.<br/>
<br/>
* Move nstojns to a field instead of creating an empty map on each request<br/>
* Add a property setter to set nstojns<br/>
<br/>
This will allow you to do this in Spring:<br/>
    &lt;util:map id=&quot;jsonNamespaceMap&quot; map-class=&quot;java.util.Hashtable&quot;&gt;<br/>
        &lt;entry key=&quot;http://www.example.com/shakedown&quot; value=&quot;e&quot;/&gt;<br/>
        &lt;entry key=&quot;http://cxf.apache.org/bindings/xformat&quot; value=&quot;cxf&quot;/&gt;<br/>
    &lt;/util:map&gt;<br/>
<br/>
    &lt;bean id=&quot;jsonProvider&quot; class=&quot;org.apache.cxf.jaxrs.provider.JSONProvider&quot;&gt;<br/>
        &lt;property name=&quot;namespaceMap&quot; ref=&quot;jsonNamespaceMap&quot;/&gt;<br/>
    &lt;/bean&gt;<br/>
<br/>
    &lt;jaxrs:server id=&quot;jsonRestEndpoint&quot; address=&quot;/system&quot;&gt;<br/>
        &lt;jaxrs:serviceBeans&gt;<br/>
            &lt;ref bean=&quot;restImpl&quot;/&gt;<br/>
        &lt;/jaxrs:serviceBeans&gt;<br/>
        &lt;jaxrs:entityProviders&gt;<br/>
            &lt;ref bean=&quot;jsonProvider&quot;/&gt;<br/>
        &lt;/jaxrs:entityProviders&gt;<br/>
    &lt;/jaxrs:server&gt;
  </td>
