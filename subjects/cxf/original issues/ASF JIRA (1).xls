    </td>
                                            <td class="creator">            Dave Brosius
    </td>
                                            <td class="created"> 01/May/08 03:27 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/10 14:57 </td>
                                            <td class="resolutiondate"> 17/Dec/09 19:51 </td>
                                            <td class="versions">                        2.0.6            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        OSGi            </td>
