    </td>
                                            <td class="creator">            Andrea Bozzetto
    </td>
                                            <td class="created"> 04/Nov/08 15:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Feb/09 22:19 </td>
                                            <td class="resolutiondate"> 21/Nov/08 17:39 </td>
                                            <td class="versions">                        2.1.3            </td>
                                            <td class="fixVersions">                        2.0.10,                     2.1.4            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Linux - Ubuntu 8.04
  </td>
                                            <td class="description">      The namespace  &quot;urn:ihe:iti:xds-b:2007&quot; is encoded in this way:<br/>
<br/>
Content-ID: &lt;ae6becb4-dee4-441f-8b21-9cdffe3b2986@urn%3Aihe%3Aiti%3Axds-b%3A2007&gt;<br/>
<br/>
<br/>
<br/>
I change the class AttachmentUtil like this:<br/>
<br/>
/**<br/>
     * @param ns<br/>
     * @return<br/>
     */<br/>
    public static String createContentID(String ns) throws UnsupportedEncodingException {<br/>
        // tend to change<br/>
        String cid = URLEncoder.encode(&quot;http://cxf.apache.org/&quot;, &quot;UTF-8&quot;);<br/>
<br/>
        String name = UUID.randomUUID().toString();<br/>
        if (ns != null &amp;&amp; (ns.length() &gt; 0)) {<br/>
            try {<br/>
                URI uri = new URI(ns);<br/>
                String host = uri.toURL().getHost();<br/>
                cid = URLEncoder.encode(host, &quot;UTF-8&quot;);<br/>
            } catch (URISyntaxException e) {<br/>
                e.printStackTrace();<br/>
                return null;<br/>
            } catch (MalformedURLException e) {<br/>
                cid = ns;<br/>
            }<br/>
        }<br/>
        return URLEncoder.encode(name, &quot;UTF-8&quot;) + &quot;@&quot; + cid;<br/>
    }<br/>
<br/>
bye
  </td>
