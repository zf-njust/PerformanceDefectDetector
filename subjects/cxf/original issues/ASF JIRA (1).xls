</td>
                                            <td class="summary"><p>
            <span class="parentIssue">CXF-1004</span>
                Enhancement to JAX-RS spring configuration for registering providers
    </p>
</td>
                                            <td class="issuetype"> Sub-task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
