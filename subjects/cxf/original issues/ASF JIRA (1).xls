                                            <td class="summary"><p>
                Namespace confusion with explicit wrapper elements
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
