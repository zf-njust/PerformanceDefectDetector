                <tr id="issuerow12392017" rel="12392017" data-issuekey="CXF-1482" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1482" href="https://issues.apache.org/jira/browse/CXF-1482">CXF-1482</a>
</td>
                                            <td class="summary"><p>
                List&lt;Double&gt; parameters don&#39;t map to xsd:double in generated WSDL
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Benson Margulies
    </td>
                                            <td class="reporter">            Javier Delgadillo
    </td>
                                            <td class="creator">            Javier Delgadillo
    </td>
                                            <td class="created"> 20/Mar/08 23:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Apr/08 14:57 </td>
                                            <td class="resolutiondate"> 21/Mar/08 02:07 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        2.1            </td>
                                            <td class="components">                        Aegis Databinding,                     Soap Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Glassfish App Server
  </td>
                                            <td class="description">      When using the Mar 14 snapshot build of 2.1, CXF outputs less than desirable WSDL for any service that has an input parameter of type List&lt;Double&gt; when used in conjuction with Aegis Mapping files.<br/>
<br/>
With previous builds, the List&lt;Double&gt; would map to xsd:double, but now it creates its own namespace.<br/>
<br/>
Here&#39;s the interface:<br/>
public interface Foo<br/>
{<br/>
    int bar( List&lt;Double&gt; doublesList );<br/>
}<br/>
<br/>
Here&#39;s the Aegis mapping file:<br/>
&lt;?xml version=&quot;1.0&quot;?&gt;<br/>
&lt;!-- xmlns=&quot;http://xfire.codehaus.org/schemas/1.0/mapping.xsd&quot; --&gt;<br/>
&lt;mappings&gt;<br/>
    &lt;mapping&gt;<br/>
        &lt;method name=&quot;bar&quot;&gt;<br/>
            &lt;parameter index=&quot;0&quot; mappedName=&quot;doublesList&quot; componentType=&quot;java.lang.Double&quot;/&gt;<br/>
        &lt;/method&gt;<br/>
    &lt;/mapping&gt;<br/>
&lt;/mappings&gt;<br/>
<br/>
Here&#39;s the generated WSDL:<br/>
&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;&lt;wsdl:definitions xmlns:soap=&quot;http://schemas.xmlsoap.org/wsdl/soap/&quot; xmlns:tns=&quot;http://arcwebservices.com/v4&quot; xmlns:wsdl=&quot;http://schemas.xmlsoap.org/wsdl/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; name=&quot;Foo&quot; targetNamespace=&quot;http://arcwebservices.com/v4&quot;&gt;<br/>
  &lt;wsdl:types&gt;<br/>
&lt;xsd:schema xmlns:tns=&quot;http://lang.java&quot; attributeFormDefault=&quot;qualified&quot; elementFormDefault=&quot;qualified&quot; targetNamespace=&quot;http://lang.java&quot;&gt;<br/>
    &lt;xsd:complexType name=&quot;Double&quot;&gt;<br/>
        &lt;xsd:sequence&gt;<br/>
            &lt;xsd:element minOccurs=&quot;0&quot; name=&quot;infinite&quot; type=&quot;xsd:boolean&quot;/&gt;<br/>
            &lt;xsd:element minOccurs=&quot;0&quot; name=&quot;naN&quot; type=&quot;xsd:boolean&quot;/&gt;<br/>
        &lt;/xsd:sequence&gt;<br/>
    &lt;/xsd:complexType&gt;<br/>
    &lt;xsd:complexType name=&quot;ArrayOfDouble&quot;&gt;<br/>
        &lt;xsd:sequence&gt;<br/>
            &lt;xsd:element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;Double&quot; nillable=&quot;true&quot; type=&quot;tns:Double&quot;/&gt;<br/>
        &lt;/xsd:sequence&gt;<br/>
    &lt;/xsd:complexType&gt;<br/>
&lt;/xsd:schema&gt;<br/>
&lt;xsd:schema xmlns:ns0=&quot;http://lang.java&quot; attributeFormDefault=&quot;unqualified&quot; elementFormDefault=&quot;qualified&quot; targetNamespace=&quot;http://arcwebservices.com/v4&quot;&gt;<br/>
    &lt;xsd:import namespace=&quot;http://lang.java&quot;/&gt;<br/>
    &lt;xsd:element name=&quot;bar&quot;&gt;<br/>
        &lt;xsd:complexType&gt;<br/>
            &lt;xsd:sequence&gt;<br/>
                &lt;xsd:element name=&quot;doublesList&quot; type=&quot;ns0:ArrayOfDouble&quot;/&gt;<br/>
            &lt;/xsd:sequence&gt;<br/>
        &lt;/xsd:complexType&gt;<br/>
    &lt;/xsd:element&gt;<br/>
    &lt;xsd:element name=&quot;barResponse&quot;&gt;<br/>
        &lt;xsd:complexType&gt;<br/>
            &lt;xsd:sequence&gt;<br/>
                &lt;xsd:element name=&quot;return&quot; type=&quot;xsd:int&quot;/&gt;<br/>
            &lt;/xsd:sequence&gt;<br/>
        &lt;/xsd:complexType&gt;<br/>
    &lt;/xsd:element&gt;<br/>
&lt;/xsd:schema&gt;<br/>
  &lt;/wsdl:types&gt;<br/>
  &lt;wsdl:message name=&quot;barResponse&quot;&gt;<br/>
    &lt;wsdl:part element=&quot;tns:barResponse&quot; name=&quot;parameters&quot;/&gt;<br/>
  &lt;/wsdl:message&gt;<br/>
  &lt;wsdl:message name=&quot;bar&quot;&gt;<br/>
    &lt;wsdl:part element=&quot;tns:bar&quot; name=&quot;parameters&quot;/&gt;<br/>
  &lt;/wsdl:message&gt;<br/>
  &lt;wsdl:portType name=&quot;FooPortType&quot;&gt;<br/>
    &lt;wsdl:operation name=&quot;bar&quot;&gt;<br/>
      &lt;wsdl:input message=&quot;tns:bar&quot; name=&quot;bar&quot;/&gt;<br/>
      &lt;wsdl:output message=&quot;tns:barResponse&quot; name=&quot;barResponse&quot;/&gt;<br/>
    &lt;/wsdl:operation&gt;<br/>
  &lt;/wsdl:portType&gt;<br/>
  &lt;wsdl:binding name=&quot;FooSoapBinding&quot; type=&quot;tns:FooPortType&quot;&gt;<br/>
    &lt;soap:binding style=&quot;document&quot; transport=&quot;http://schemas.xmlsoap.org/soap/http&quot;/&gt;<br/>
    &lt;wsdl:operation name=&quot;bar&quot;&gt;<br/>
      &lt;soap:operation soapAction=&quot;&quot; style=&quot;document&quot;/&gt;<br/>
      &lt;wsdl:input name=&quot;bar&quot;&gt;<br/>
        &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
      &lt;/wsdl:input&gt;<br/>
      &lt;wsdl:output name=&quot;barResponse&quot;&gt;<br/>
        &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
      &lt;/wsdl:output&gt;<br/>
    &lt;/wsdl:operation&gt;<br/>
  &lt;/wsdl:binding&gt;<br/>
  &lt;wsdl:service name=&quot;Foo&quot;&gt;<br/>
    &lt;wsdl:port binding=&quot;tns:FooSoapBinding&quot; name=&quot;FooPort&quot;&gt;<br/>
      &lt;soap:address location=&quot;http://localhost:8080/soap/Foo&quot;/&gt;<br/>
    &lt;/wsdl:port&gt;<br/>
  &lt;/wsdl:service&gt;<br/>
&lt;/wsdl:definitions&gt;
  </td>
