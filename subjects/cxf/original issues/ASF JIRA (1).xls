                                            <td class="resolutiondate"> 03/Oct/09 18:15 </td>
                                            <td class="versions">                        2.0.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
