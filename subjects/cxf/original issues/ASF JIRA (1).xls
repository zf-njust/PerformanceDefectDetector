                <tr id="issuerow12383721" rel="12383721" data-issuekey="CXF-1246" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1246" href="https://issues.apache.org/jira/browse/CXF-1246">CXF-1246</a>
</td>
                                            <td class="summary"><p>
                &quot;mvn generate-sources&quot; works with wsdl2java but not &quot;mvn groupid:artifactid:version:goal&quot;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            maomaode
    </td>
                                            <td class="reporter">            Glen Mazza
    </td>
                                            <td class="creator">            Glen Mazza
    </td>
                                            <td class="created"> 01/Dec/07 20:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Apr/08 14:57 </td>
                                            <td class="resolutiondate"> 22/Feb/08 18:26 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        2.1            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
