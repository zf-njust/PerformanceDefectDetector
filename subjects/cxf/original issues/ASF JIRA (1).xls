  </td>
                                            <td class="description">      Code generation from &quot;test.wsdl&quot; results in errorneous java code &quot;DeliverFaultMessage.java&quot; (without exceptions/error/warnings of wsdl2java).<br/>
<br/>
---- test.wsdl ---- START<br/>
&lt;wsdl:definitions name=&quot;test&quot;<br/>
    xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; <br/>
    xmlns:soap=&quot;http://schemas.xmlsoap.org/wsdl/soap/&quot;<br/>
    xmlns:wsdl=&quot;http://schemas.xmlsoap.org/wsdl/&quot; <br/>
    xmlns:types=&quot;http://www.abc.com/mb/schema&quot; <br/>
    xmlns:tns=&quot;http://www.abc.com/mb&quot;<br/>
    xmlns:mime=&quot;http://schemas.xmlsoap.org/wsdl/mime/&quot; <br/>
    xmlns:xmime=&quot;http://www.w3.org/2005/05/xmlmime&quot; <br/>
    xmlns:SCXSD=&quot;http://www.abc.com/mb/schema.ws&quot;<br/>
    targetNamespace=&quot;http://www.abc.com/mb&quot;&gt;<br/>
<br/>
	&lt;wsdl:types&gt;<br/>
		&lt;schema xmlns=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xmime=&quot;http://www.w3.org/2005/05/xmlmime&quot; targetNamespace=&quot;http://www.abc.com/mb/schema&quot; elementFormDefault=&quot;qualified&quot;&gt;<br/>
			&lt;xsd:element name=&quot;data&quot; type=&quot;xsd:string&quot;/&gt;<br/>
			&lt;xsd:element name=&quot;comment&quot; type=&quot;xsd:string&quot;/&gt;<br/>
        &lt;/schema&gt;<br/>
    &lt;/wsdl:types&gt;<br/>
<br/>
    &lt;wsdl:message name=&quot;DeliverRequestMessage&quot;&gt;<br/>
    	&lt;wsdl:part name=&quot;header&quot; element=&quot;types:data&quot;/&gt;<br/>
    	&lt;wsdl:part name=&quot;body&quot; element=&quot;types:data&quot;/&gt;<br/>
    &lt;/wsdl:message&gt;<br/>
<br/>
    &lt;wsdl:message name=&quot;DeliverResponseMessage&quot;&gt;<br/>
    	&lt;wsdl:part name=&quot;header&quot; element=&quot;types:data&quot;/&gt;<br/>
    	&lt;wsdl:part name=&quot;body&quot; element=&quot;types:data&quot;/&gt;<br/>
    &lt;/wsdl:message&gt;<br/>
<br/>
    &lt;wsdl:message name=&quot;DeliverFaultMessage&quot;&gt;<br/>
    	&lt;wsdl:part name=&quot;comment1&quot; element=&quot;types:comment&quot;/&gt;<br/>
    	&lt;wsdl:part name=&quot;comment2&quot; element=&quot;types:comment&quot;/&gt;<br/>
    &lt;/wsdl:message&gt;<br/>
    <br/>
    &lt;wsdl:portType name=&quot;DeliverPortType&quot;&gt;<br/>
        &lt;wsdl:operation name=&quot;Deliver&quot;&gt;<br/>
            &lt;wsdl:input message=&quot;tns:DeliverRequestMessage&quot;/&gt;<br/>
            &lt;wsdl:output message=&quot;tns:DeliverResponseMessage&quot;/&gt;<br/>
            &lt;wsdl:fault name=&quot;runtimeexception&quot; message=&quot;tns:DeliverFaultMessage&quot;/&gt;<br/>
        &lt;/wsdl:operation&gt;<br/>
    &lt;/wsdl:portType&gt;<br/>
    <br/>
    &lt;wsdl:binding name=&quot;DeliveryBinding&quot; type=&quot;tns:DeliverPortType&quot;&gt;<br/>
        &lt;soap:binding style=&quot;document&quot; transport=&quot;http://schemas.xmlsoap.org/soap/http&quot;/&gt;<br/>
        &lt;wsdl:operation name=&quot;Deliver&quot;&gt;<br/>
            &lt;soap:operation soapAction=&quot;&quot;/&gt;<br/>
            &lt;wsdl:input&gt;<br/>
            	&lt;soap:header message=&quot;tns:DeliverRequestMessage&quot; part=&quot;header&quot; use=&quot;literal&quot;/&gt;<br/>
                &lt;soap:body use=&quot;literal&quot; parts=&quot;body&quot;/&gt;<br/>
            &lt;/wsdl:input&gt;<br/>
            &lt;wsdl:output&gt;<br/>
            	&lt;soap:header message=&quot;tns:DeliverResponseMessage&quot; part=&quot;header&quot; use=&quot;literal&quot;/&gt;<br/>
                &lt;soap:body use=&quot;literal&quot; parts=&quot;body&quot;/&gt;<br/>
            &lt;/wsdl:output&gt;<br/>
            &lt;wsdl:fault name=&quot;runtimeexception&quot;&gt;<br/>
            	&lt;soap:fault name=&quot;runtimeexception&quot; use=&quot;literal&quot;/&gt;<br/>
            &lt;/wsdl:fault&gt;<br/>
        &lt;/wsdl:operation&gt;<br/>
    &lt;/wsdl:binding&gt;<br/>
<br/>
    &lt;wsdl:service name=&quot;DeliverService&quot;&gt;<br/>
        &lt;wsdl:port name=&quot;DeliverPort&quot; binding=&quot;tns:DeliveryBinding&quot;&gt;<br/>
            &lt;soap:address location=&quot;http://localhost:1001/deliver&quot;/&gt;<br/>
        &lt;/wsdl:port&gt;<br/>
    &lt;/wsdl:service&gt;<br/>
<br/>
&lt;/wsdl:definitions&gt;<br/>
---- test.wsdl ---- END<br/>
<br/>
<br/>

