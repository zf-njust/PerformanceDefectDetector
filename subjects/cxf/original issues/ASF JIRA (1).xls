                <tr id="issuerow12380125" rel="12380125" data-issuekey="CXF-1105" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1105" href="https://issues.apache.org/jira/browse/CXF-1105">CXF-1105</a>
</td>
                                            <td class="summary"><p>
                Arrays with Aegis+JAX-WS produce incorrect WSDL
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Benson Margulies
    </td>
                                            <td class="creator">            Benson Margulies
    </td>
                                            <td class="created"> 11/Oct/07 00:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Dec/07 19:23 </td>
                                            <td class="resolutiondate"> 22/Oct/07 19:17 </td>
                                            <td class="versions">                        2.0.2            </td>
                                            <td class="fixVersions">                        2.0.3            </td>
                                            <td class="components">                        Aegis Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
