                                            <td class="summary"><p>
                JAXB schema validation fails for RPC
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Benson Margulies
    </td>
                                            <td class="creator">            Benson Margulies
    </td>
                                            <td class="created"> 10/Dec/07 14:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:34 </td>
                                            <td class="resolutiondate"> 02/Nov/09 17:35 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        2.2.5            </td>
