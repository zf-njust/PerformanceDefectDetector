                <tr id="issuerow12403353" rel="12403353" data-issuekey="CXF-1771" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1771" href="https://issues.apache.org/jira/browse/CXF-1771">CXF-1771</a>
</td>
                                            <td class="summary"><p>
                WstxUnexpectedCharException when returning a String from a CXF SOAP service containing specific characters (used with CXF client)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Martijn Brinkers
    </td>
                                            <td class="creator">            Martijn Brinkers
    </td>
                                            <td class="created"> 29/Aug/08 08:27 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/May/09 19:00 </td>
                                            <td class="resolutiondate"> 02/Sep/08 20:23 </td>
                                            <td class="versions">                        2.1.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
