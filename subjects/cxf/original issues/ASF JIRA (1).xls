                                            <td class="description">      Support following methods defined in JAX-WS 2.1 Spec <br/>
    <br/>
public &lt;T&gt; Dispatch&lt;T&gt; createDispatch(QName portName,<br/>
                                          Class&lt;T&gt; type,<br/>
                                          Mode mode,<br/>
                                          WebServiceFeature... features) {<br/>
        throw new UnsupportedOperationException();<br/>
    }<br/>
<br/>
    public &lt;T&gt; Dispatch&lt;T&gt; createDispatch(EndpointReference endpointReference,<br/>
                                          Class&lt;T&gt; type,<br/>
                                          Mode mode,<br/>
                                          WebServiceFeature... features) {<br/>
        throw new UnsupportedOperationException();<br/>
    }<br/>
<br/>
    public Dispatch&lt;Object&gt; createDispatch(QName portName,<br/>
                                           JAXBContext context,<br/>
                                           Mode mode,<br/>
                                           WebServiceFeature... features) {<br/>
        throw new UnsupportedOperationException();<br/>
    }<br/>
<br/>
    public Dispatch&lt;Object&gt; createDispatch(EndpointReference endpointReference,<br/>
                                           JAXBContext context,<br/>
                                           Mode mode,<br/>
                                           WebServiceFeature... features) {<br/>
        throw new UnsupportedOperationException();<br/>
    }
