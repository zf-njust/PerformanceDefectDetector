    <a class="issue-link" data-issue-key="CXF-1929" href="https://issues.apache.org/jira/browse/CXF-1929">CXF-1929</a>
</td>
                                            <td class="summary"><p>
                CXF-Bundle should include JSR311-API
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
