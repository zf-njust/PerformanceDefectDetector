                <tr id="issuerow12412741" rel="12412741" data-issuekey="CXF-1993" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1993" href="https://issues.apache.org/jira/browse/CXF-1993">CXF-1993</a>
</td>
                                            <td class="summary"><p>
                Adding namespaces to the soap envelope
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            K U
    </td>
                                            <td class="creator">            K U
    </td>
                                            <td class="created"> 19/Jan/09 12:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Feb/09 22:20 </td>
                                            <td class="resolutiondate"> 19/Jan/09 19:51 </td>
                                            <td class="versions">                        2.1.3            </td>
                                            <td class="fixVersions">                        2.1.4            </td>
                                            <td class="components">                        Soap Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
