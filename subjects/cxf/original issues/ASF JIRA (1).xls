                                            <td class="summary"><p>
                Schema wrong (?) for message part info in one JAXWS+JAXB case
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Benson Margulies
    </td>
                                            <td class="creator">            Benson Margulies
    </td>
                                            <td class="created"> 11/Nov/07 16:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Jan/09 17:14 </td>
                                            <td class="resolutiondate"> 11/Nov/07 21:29 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
