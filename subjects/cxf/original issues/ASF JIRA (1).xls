        &lt;/schema&gt;<br/>
    &lt;/wsdl:types&gt;<br/>
    &lt;wsdl:message name=&quot;sayHiRequest&quot;&gt;<br/>
        &lt;wsdl:part element=&quot;x1:sayHi&quot; name=&quot;in&quot;/&gt;<br/>
    &lt;/wsdl:message&gt;<br/>
    &lt;wsdl:message name=&quot;sayHiResponse&quot;&gt;<br/>
        &lt;wsdl:part element=&quot;x1:sayHiResponse&quot; name=&quot;out&quot;/&gt;<br/>
