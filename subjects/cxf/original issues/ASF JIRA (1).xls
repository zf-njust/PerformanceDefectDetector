                                            <td class="summary"><p>
                mtom-enabled property case sensitive
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Adrian Corcoran
    </td>
                                            <td class="creator">            Adrian Corcoran
    </td>
                                            <td class="created"> 13/Oct/08 09:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Feb/09 22:20 </td>
                                            <td class="resolutiondate"> 14/Oct/08 23:01 </td>
                                            <td class="versions">                        2.0.8            </td>
                                            <td class="fixVersions">                        2.1.4            </td>
                                            <td class="components">                        Configuration            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
