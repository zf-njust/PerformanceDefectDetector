                <tr id="issuerow12404261" rel="12404261" data-issuekey="CXF-1797" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1797" href="https://issues.apache.org/jira/browse/CXF-1797">CXF-1797</a>
</td>
                                            <td class="summary"><p>
                Trouble with services having multiple methods/operations 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Juan Velez
    </td>
                                            <td class="creator">            Juan Velez
    </td>
                                            <td class="created"> 12/Sep/08 16:23 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Oct/08 04:52 </td>
                                            <td class="resolutiondate"> 12/Sep/08 17:24 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        2.0.9,                     2.1.3            </td>
                                            <td class="components">                        Soap Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
