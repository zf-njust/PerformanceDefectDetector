                <tr id="issuerow12387058" rel="12387058" data-issuekey="CXF-1404" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1404" href="https://issues.apache.org/jira/browse/CXF-1404">CXF-1404</a>
</td>
                                            <td class="summary"><p>
                wsdl2java generating void response instead of bare object 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
                                            <td class="created"> 24/Jan/08 16:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Apr/08 14:57 </td>
                                            <td class="resolutiondate"> 24/Jan/08 20:41 </td>
                                            <td class="versions">                        2.0.3            </td>
                                            <td class="fixVersions">                        2.1            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
