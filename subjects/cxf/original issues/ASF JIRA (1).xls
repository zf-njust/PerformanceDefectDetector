    <a class="issue-link" data-issue-key="CXF-1788" href="https://issues.apache.org/jira/browse/CXF-1788">CXF-1788</a>
</td>
                                            <td class="summary"><p>
                Problem with Calendar
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Alejandro 
    </td>
                                            <td class="creator">            Alejandro 
    </td>
                                            <td class="created"> 08/Sep/08 17:37 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Oct/08 03:59 </td>
                                            <td class="resolutiondate"> 14/Sep/08 00:46 </td>
                                            <td class="versions">                        2.1.2            </td>
                                            <td class="fixVersions">                        2.1.3            </td>
                                            <td class="components">                        Aegis Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
