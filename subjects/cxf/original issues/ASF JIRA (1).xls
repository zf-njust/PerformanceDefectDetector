                <tr id="issuerow12398197" rel="12398197" data-issuekey="CXF-1648" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1648" href="https://issues.apache.org/jira/browse/CXF-1648">CXF-1648</a>
</td>
                                            <td class="summary"><p>
            <span class="parentIssue">CXF-1243</span>
                org.apache.cxf.binding.soap.SoapFault: Error reading XMLStreamReader.
    </p>
</td>
                                            <td class="issuetype"> Sub-task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            victor escutia
    </td>
                                            <td class="creator">            victor escutia
    </td>
                                            <td class="created"> 12/Jun/08 22:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Mar/11 03:41 </td>
                                            <td class="resolutiondate"> 19/Jun/09 19:18 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
