     [java] Caused by: org.apache.cxf.service.factory.ServiceConstructionExcepti<br/>
on<br/>
     [java]     at org.apache.cxf.frontend.ServerFactoryBean.create(ServerFactor<br/>
yBean.java:134)<br/>
     [java]     at org.apache.cxf.jaxws.JaxWsServerFactoryBean.create(JaxWsServe<br/>
rFactoryBean.java:160)<br/>
     [java]     at org.apache.cxf.jaxws.EndpointImpl.getServer(EndpointImpl.java<br/>
:327)<br/>
