                <tr id="issuerow12378385" rel="12378385" data-issuekey="CXF-1028" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1028" href="https://issues.apache.org/jira/browse/CXF-1028">CXF-1028</a>
</td>
                                            <td class="summary"><p>
                Fault is being returned as general SOAPFaultException instead of specific fault
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Richard Mixon
    </td>
                                            <td class="creator">            Richard Mixon
    </td>
                                            <td class="created"> 17/Sep/07 01:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Dec/07 19:23 </td>
                                            <td class="resolutiondate"> 10/Oct/07 20:21 </td>
                                            <td class="versions">                        2.0.1,                     2.1            </td>
                                            <td class="fixVersions">                        2.0.2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
