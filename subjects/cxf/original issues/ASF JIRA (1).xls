                <tr id="issuerow12413087" rel="12413087" data-issuekey="CXF-2000" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-2000" href="https://issues.apache.org/jira/browse/CXF-2000">CXF-2000</a>
</td>
                                            <td class="summary"><p>
                ReadHeadersInterceptor ignoring DataBinding when creating SoapHeader
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Peter Liljenberg
    </td>
                                            <td class="creator">            Peter Liljenberg
    </td>
                                            <td class="created"> 23/Jan/09 12:13 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Feb/09 22:19 </td>
                                            <td class="resolutiondate"> 23/Jan/09 18:07 </td>
                                            <td class="versions">                        2.1.2            </td>
                                            <td class="fixVersions">                        2.0.10,                     2.1.4            </td>
                                            <td class="components">                        Soap Binding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
