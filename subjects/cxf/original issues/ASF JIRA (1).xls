</td>
                                            <td class="summary"><p>
                Add official support for Axis2 saaj implementation
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Mike Youngstrom
    </td>
                                            <td class="creator">            Mike Youngstrom
    </td>
                                            <td class="created"> 24/Dec/08 21:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Feb/09 22:20 </td>
                                            <td class="resolutiondate"> 25/Dec/08 18:03 </td>
                                            <td class="versions">                        2.1.3            </td>
                                            <td class="fixVersions">                        2.1.4            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
