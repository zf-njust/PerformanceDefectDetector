                <tr id="issuerow12381136" rel="12381136" data-issuekey="CXF-1136" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1136" href="https://issues.apache.org/jira/browse/CXF-1136">CXF-1136</a>
</td>
                                            <td class="summary"><p>
                Custom exception not appearing in SOAP fault response
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            ed p
    </td>
                                            <td class="creator">            ed p
    </td>
                                            <td class="created"> 25/Oct/07 10:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Dec/07 19:23 </td>
                                            <td class="resolutiondate"> 02/Nov/07 14:11 </td>
                                            <td class="versions">                        2.0.2            </td>
                                            <td class="fixVersions">                        2.0.3            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
