                <tr id="issuerow12405926" rel="12405926" data-issuekey="CXF-1844" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1844" href="https://issues.apache.org/jira/browse/CXF-1844">CXF-1844</a>
</td>
                                            <td class="summary"><p>
                Add support for byte and Byte
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Brett
    </td>
                                            <td class="creator">            Brett
    </td>
                                            <td class="created"> 07/Oct/08 14:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Feb/09 22:20 </td>
                                            <td class="resolutiondate"> 07/Oct/08 23:11 </td>
                                            <td class="versions">                        2.0.8,                     2.1.2            </td>
                                            <td class="fixVersions">                        2.1.4            </td>
                                            <td class="components">                        Aegis Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
