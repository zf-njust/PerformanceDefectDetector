                <tr id="issuerow12383482" rel="12383482" data-issuekey="CXF-1240" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1240" href="https://issues.apache.org/jira/browse/CXF-1240">CXF-1240</a>
</td>
                                            <td class="summary"><p>
                JAX-RS demo not working with return type String
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jervis Liu
    </td>
                                            <td class="reporter">            Jervis Liu
    </td>
                                            <td class="creator">            Jervis Liu
    </td>
                                            <td class="created"> 29/Nov/07 03:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Nov/07 06:32 </td>
                                            <td class="resolutiondate"> 30/Nov/07 06:20 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        2.1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">1</td>
