                <tr id="issuerow12382838" rel="12382838" data-issuekey="CXF-1220" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1220" href="https://issues.apache.org/jira/browse/CXF-1220">CXF-1220</a>
</td>
                                            <td class="summary"><p>
                Confused or dropped namespace in WSDL generated by java2wsdl function in the cxf-codegen-plugin 
    </p>
