    <a class="issue-link" data-issue-key="CXF-1794" href="https://issues.apache.org/jira/browse/CXF-1794">CXF-1794</a>
</td>
                                            <td class="summary"><p>
                codegen plugin not merging autodetected options with the options in the poms correctly...
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
