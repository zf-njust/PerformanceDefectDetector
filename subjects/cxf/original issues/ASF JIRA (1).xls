    <a class="issue-link" data-issue-key="CXF-1459" href="https://issues.apache.org/jira/browse/CXF-1459">CXF-1459</a>
</td>
                                            <td class="summary"><p>
                ClassCastException occurs on HTTPS web service call made by app deployed to BEA WebLogic 9.2
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
