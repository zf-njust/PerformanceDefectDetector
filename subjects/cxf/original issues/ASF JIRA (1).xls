                <tr id="issuerow12378397" rel="12378397" data-issuekey="CXF-1029" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1029" href="https://issues.apache.org/jira/browse/CXF-1029">CXF-1029</a>
</td>
                                            <td class="summary"><p>
                The given example is not correct!
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Willem Jiang
    </td>
                                            <td class="reporter">            Hubert zhang
    </td>
                                            <td class="creator">            Hubert zhang
    </td>
                                            <td class="created"> 17/Sep/07 06:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Dec/07 19:23 </td>
