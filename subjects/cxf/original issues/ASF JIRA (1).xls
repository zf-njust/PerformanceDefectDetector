    <a class="issue-link" data-issue-key="CXF-1902" href="https://issues.apache.org/jira/browse/CXF-1902">CXF-1902</a>
</td>
                                            <td class="summary"><p>
                Generated WSDL has incorrect character casing
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Ryan Diehl
    </td>
                                            <td class="creator">            Ryan Diehl
    </td>
                                            <td class="created"> 05/Nov/08 16:02 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/May/09 19:00 </td>
                                            <td class="resolutiondate"> 03/Dec/08 20:17 </td>
                                            <td class="versions">                        2.0.7            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
