    <a class="issue-link" data-issue-key="CXF-1529" href="https://issues.apache.org/jira/browse/CXF-1529">CXF-1529</a>
</td>
                                            <td class="summary"><p>
                Deploying a JAXWS Service with a HandlerChain specified causes NPE
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sean O&#39;Callaghan
    </td>
                                            <td class="reporter">            Scott Paisey
    </td>
                                            <td class="creator">            Scott Paisey
    </td>
                                            <td class="created"> 15/Apr/08 21:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Apr/08 14:57 </td>
                                            <td class="resolutiondate"> 17/Apr/08 14:32 </td>
                                            <td class="versions">                        2.0.5            </td>
                                            <td class="fixVersions">                        2.1            </td>
