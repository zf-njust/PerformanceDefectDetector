                <tr id="issuerow12405011" rel="12405011" data-issuekey="CXF-1817" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1817" href="https://issues.apache.org/jira/browse/CXF-1817">CXF-1817</a>
</td>
                                            <td class="summary"><p>
                wsdl2java RandomValueProvider gives StackOverflowException on bidirectional reference
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Bob Fields
    </td>
                                            <td class="creator">            Bob Fields
    </td>
                                            <td class="created"> 23/Sep/08 20:38 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:34 </td>
                                            <td class="resolutiondate"> 29/Oct/09 14:57 </td>
                                            <td class="versions">                        2.1.2,                     2.2            </td>
                                            <td class="fixVersions">                        2.1.8,                     2.2.5            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
