    <a class="issue-link" data-issue-key="CXF-1761" href="https://issues.apache.org/jira/browse/CXF-1761">CXF-1761</a>
</td>
                                            <td class="summary"><p>
                JAX-WS: NoSuchMethodException: getPortClassMap() 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Frank Lawlor
    </td>
                                            <td class="creator">            Frank Lawlor
    </td>
                                            <td class="created"> 21/Aug/08 14:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Aug/08 14:59 </td>
                                            <td class="resolutiondate"> 21/Aug/08 14:59 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
