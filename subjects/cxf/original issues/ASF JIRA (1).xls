                <tr id="issuerow12386565" rel="12386565" data-issuekey="CXF-1397" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1397" href="https://issues.apache.org/jira/browse/CXF-1397">CXF-1397</a>
</td>
                                            <td class="summary"><p>
                Make MTOM work for Aegis
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Benson Margulies
    </td>
                                            <td class="reporter">            Benson Margulies
    </td>
                                            <td class="creator">            Benson Margulies
    </td>
                                            <td class="created"> 18/Jan/08 02:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Apr/08 14:57 </td>
                                            <td class="resolutiondate"> 04/Mar/08 21:08 </td>
                                            <td class="versions">                        2.0.4,                     2.1            </td>
                                            <td class="fixVersions">                        2.1            </td>
                                            <td class="components">                        Aegis Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
