</td>
                                            <td class="summary"><p>
                wsdl2java utility throws exception on naming collision - &quot;Two declarations cause a collision in the ObjectFactory class&quot;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Mike Lenner
    </td>
                                            <td class="creator">            Mike Lenner
    </td>
                                            <td class="created"> 05/Sep/08 19:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Jul/09 20:35 </td>
                                            <td class="resolutiondate"> 28/Jul/09 20:07 </td>
                                            <td class="versions">                        2.1.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
