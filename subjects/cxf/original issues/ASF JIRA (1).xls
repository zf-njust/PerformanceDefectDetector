                <tr id="issuerow12387049" rel="12387049" data-issuekey="CXF-1403" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1403" href="https://issues.apache.org/jira/browse/CXF-1403">CXF-1403</a>
</td>
                                            <td class="summary"><p>
                JettyHttpDestination can not be created if enpoint address is null
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Sergey Beryozkin
    </td>
                                            <td class="creator">            Sergey Beryozkin
    </td>
                                            <td class="created"> 24/Jan/08 15:27 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Apr/08 14:57 </td>
                                            <td class="resolutiondate"> 24/Jan/08 21:50 </td>
                                            <td class="versions">                        2.1            </td>
                                            <td class="fixVersions">                        2.1            </td>
                                            <td class="components">                        Transports            </td>
