    <a class="issue-link" data-issue-key="CXF-1588" href="https://issues.apache.org/jira/browse/CXF-1588">CXF-1588</a>
</td>
                                            <td class="summary"><p>
                NullPointerException in JbiConduitOutputStream
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
