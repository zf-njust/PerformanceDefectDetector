                <tr id="issuerow12406705" rel="12406705" data-issuekey="CXF-1877" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1877" href="https://issues.apache.org/jira/browse/CXF-1877">CXF-1877</a>
</td>
                                            <td class="summary"><p>
                It doesn&#39;t generate the corresponding java enums for xsd enumerations which exceed more than a limit of enumeration entries.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Narasimha
    </td>
                                            <td class="creator">            Narasimha
    </td>
                                            <td class="created"> 17/Oct/08 18:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Jan/09 17:14 </td>
                                            <td class="resolutiondate"> 17/Oct/08 18:34 </td>
                                            <td class="versions">                        2.1.1            </td>
