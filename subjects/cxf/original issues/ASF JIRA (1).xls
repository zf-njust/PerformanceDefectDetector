                <tr id="issuerow12400559" rel="12400559" data-issuekey="CXF-1707" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1707" href="https://issues.apache.org/jira/browse/CXF-1707">CXF-1707</a>
</td>
