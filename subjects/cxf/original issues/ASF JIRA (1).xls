                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Oct/08 04:52 </td>
                                            <td class="resolutiondate"> 22/Aug/08 14:15 </td>
                                            <td class="versions">    &nbsp;
</td>
