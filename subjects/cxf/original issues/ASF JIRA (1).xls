</td>
                                            <td class="summary"><p>
                JettyHTTPDestination does not set a thread default bus
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Sergey Beryozkin
    </td>
                                            <td class="creator">            Sergey Beryozkin
    </td>
                                            <td class="created"> 05/Dec/07 18:38 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Jan/08 21:51 </td>
                                            <td class="resolutiondate"> 05/Dec/07 21:34 </td>
                                            <td class="versions">                        2.0,                     2.0.1,                     2.0.2,                     2.0.3            </td>
                                            <td class="fixVersions">                        2.0.4            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
