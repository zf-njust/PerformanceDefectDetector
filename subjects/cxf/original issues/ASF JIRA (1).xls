                <tr id="issuerow12394566" rel="12394566" data-issuekey="CXF-1542" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1542" href="https://issues.apache.org/jira/browse/CXF-1542">CXF-1542</a>
</td>
                                            <td class="summary"><p>
                jaxws:endpoint&#39;s wsdllocation wrongfully(?) defaults to wsdl/hello_world.wsdl
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Glen Mazza
    </td>
                                            <td class="creator">            Glen Mazza
    </td>
                                            <td class="created"> 22/Apr/08 19:48 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Jan/09 17:14 </td>
                                            <td class="resolutiondate"> 22/Apr/08 20:02 </td>
                                            <td class="versions">                        2.0.5            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
