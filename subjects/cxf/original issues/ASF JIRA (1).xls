                <tr id="issuerow12403247" rel="12403247" data-issuekey="CXF-1768" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1768" href="https://issues.apache.org/jira/browse/CXF-1768">CXF-1768</a>
</td>
                                            <td class="summary"><p>
                WSDL First leads to javax.wsdl.WSDLException: WSDLException
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Mirko Sertic
    </td>
                                            <td class="creator">            Mirko Sertic
    </td>
                                            <td class="created"> 28/Aug/08 12:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Dec/09 22:35 </td>
                                            <td class="resolutiondate"> 13/Nov/09 17:38 </td>
                                            <td class="versions">                        2.1.1,                     2.1.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
