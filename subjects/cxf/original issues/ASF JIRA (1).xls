                <tr id="issuerow12403388" rel="12403388" data-issuekey="CXF-1772" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1772" href="https://issues.apache.org/jira/browse/CXF-1772">CXF-1772</a>
</td>
                                            <td class="summary"><p>
                Generated WSDL has a char
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
