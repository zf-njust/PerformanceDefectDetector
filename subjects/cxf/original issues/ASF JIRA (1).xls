    <a class="issue-link" data-issue-key="CXF-1239" href="https://issues.apache.org/jira/browse/CXF-1239">CXF-1239</a>
</td>
                                            <td class="summary"><p>
                addition test for JAXBcontext when callback is used but only reference to Endpoint reference is nested in a complex type
    </p>
</td>
                                            <td class="issuetype"> Test</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            maomaode
    </td>
                                            <td class="reporter">            Gary Tully
    </td>
                                            <td class="creator">            Gary Tully
    </td>
