        FAILED<br/>
expected:&lt;Some validation error&gt; but was:&lt;null&gt;<br/>
junit.framework.ComparisonFailure: expected:&lt;Some validation error&gt; but was:&lt;null&gt;<br/>
        at org.jboss.test.ws.jaxws.samples.exception.ExceptionTestCase.testApplicationException(ExceptionTestCase.java:125)<br/>
<br/>
<br/>
   public void testApplicationException() throws Exception<br/>
   {<br/>
      try<br/>
      {<br/>
         proxy.throwApplicationException();<br/>
         fail(&quot;Expected UserException&quot;);<br/>
      }<br/>
      catch (UserException_Exception e)<br/>
      {<br/>
         UserException ue = e.getFaultInfo();<br/>
         assertEquals(&quot;Some validation error&quot;, ue.getMessage());<br/>
         assertEquals(&quot;validation&quot;, ue.getErrorCategory());<br/>
         assertEquals(123, ue.getErrorCode());<br/>
      }<br/>
   }<br/>

