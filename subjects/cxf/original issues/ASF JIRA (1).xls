                                            <td class="customfield_12310060"></td>
                                            <td class="customfield_12310220">            <span title="13/Apr/09 18:40"><time class="livestamp allow-future" datetime="2009-04-13T18:40:04+0000">13/Apr/09 6:40 PM</time></span>
    </td>
