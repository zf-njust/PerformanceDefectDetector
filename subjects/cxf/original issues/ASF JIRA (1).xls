                                            <td class="customfield_12310220">            <span title="06/Oct/08 11:05"><time class="livestamp allow-future" datetime="2008-10-06T11:05:12+0000">06/Oct/08 11:05 AM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
                                            <td class="customfield_12312520"></td>
                                            <td class="customfield_12312323"></td>
                                            <td class="customfield_12312521">    8 years, 43 weeks ago

                        </td>
                                            <td class="customfield_12312320"></td>
