                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The corba prefix is not present in the physical part of the wsdl returned on the wire, when the original wsdl used the old yoko corba namespace: &quot;http://schemas.apache.org/yoko/bindings/corba&quot;<br/>
<br/>
eg. <br/>
&lt;wsdl:binding name=&quot;HelloWorldCORBABinding&quot; type=&quot;tns:HelloWorld&quot;&gt;<br/>
    &lt;ns2:binding xmlns:ns2=&quot;http://cxf.apache.org/bindings/corba&quot; bases=&quot;&quot; repositoryID=&quot;IDL:HelloWorld:1.0&quot; /&gt;<br/>
    &lt;wsdl:operation name=&quot;greetMe&quot;&gt;<br/>
      &lt;ns2:operation xmlns:ns2=&quot;http://cxf.apache.org/bindings/corba&quot; name=&quot;greetMe&quot;&gt;<br/>
        &lt;ns2:param mode=&quot;in&quot; idltype=&quot;ns2:string&quot; name=&quot;inparameter&quot; /&gt;<br/>
        &lt;ns2:return idltype=&quot;ns2:string&quot; name=&quot;outparameter&quot; /&gt;<br/>
      &lt;/ns2:operation&gt;<br/>
      &lt;wsdl:input name=&quot;greetMeRequest&quot;&gt;<br/>
      &lt;/wsdl:input&gt;<br/>
      &lt;wsdl:output name=&quot;greetMeResponse&quot;&gt;<br/>
      &lt;/wsdl:output&gt;<br/>
    &lt;/wsdl:operation&gt;<br/>
  &lt;/wsdl:binding&gt;<br/>
  &lt;wsdl:service name=&quot;HelloWorldCORBAService&quot;&gt;<br/>
    &lt;wsdl:port name=&quot;HelloWorldCORBAPort&quot; binding=&quot;tns:HelloWorldCORBABinding&quot;&gt;<br/>
      &lt;ns2:address xmlns:ns2=&quot;http://cxf.apache.org/bindings/corba&quot; location=&quot;corbaloc::localhost:40001/hw&quot; /&gt;<br/>
    &lt;/wsdl:port&gt;<br/>
  &lt;/wsdl:service&gt;<br/>
  &lt;ns2:typeMapping xmlns:ns2=&quot;http://cxf.apache.org/bindings/corba&quot; targetNamespace=&quot;http://schemas.apache.org/yoko/idl/HelloWorld/corba/typemap/&quot; /&gt;<br/>
&lt;/wsdl:definitions&gt;
