    <a class="issue-link" data-issue-key="CXF-1118" href="https://issues.apache.org/jira/browse/CXF-1118">CXF-1118</a>
</td>
                                            <td class="summary"><p>
                JAXB serialized private fields of faults
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
