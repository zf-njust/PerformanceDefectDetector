                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Jan/08 21:51 </td>
                                            <td class="resolutiondate"> 03/Dec/07 22:06 </td>
                                            <td class="versions">                        2.0.2,                     2.0.3            </td>
                                            <td class="fixVersions">                        2.0.4            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
