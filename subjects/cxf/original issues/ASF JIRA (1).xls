                <tr id="issuerow12395111" rel="12395111" data-issuekey="CXF-1562" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-1562" href="https://issues.apache.org/jira/browse/CXF-1562">CXF-1562</a>
</td>
                                            <td class="summary"><p>
                OSGI needed manifest modifications
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Dave Brosius
    </td>
                                            <td class="creator">            Dave Brosius
    </td>
                                            <td class="created"> 30/Apr/08 23:37 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Jul/08 17:19 </td>
                                            <td class="resolutiondate"> 16/Jun/08 17:11 </td>
                                            <td class="versions">                        2.0.6            </td>
                                            <td class="fixVersions">                        2.1.1,                     2.0.7            </td>
                                            <td class="components">                        Bus            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The manifest for cxf needs to specify<br/>
<br/>
Bundle-ClassPath: .,cxf-2.0.5-incubator.jar<br/>
<br/>
and not just<br/>
<br/>
Bundle-ClassPath: cxf-2.0.5-incubator.jar<br/>
<br/>
(or whatever the jar is called now). That is add the .    (root directory)<br/>
<br/>
Also<br/>
<br/>
add<br/>
<br/>
META-INF.services<br/>
<br/>
to the Export-Package list<br/>
<br/>
The reason is that BusFactory.getBusFactoryClass can&#39;t load &#39;META-INF/services/org.apache.cxf.bus.factory&#39; from an OSGI class loader without it.<br/>
<br/>

  </td>
