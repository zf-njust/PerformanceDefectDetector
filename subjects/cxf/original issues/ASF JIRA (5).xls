    </td>
                                            <td class="creator">            Tom Magowan
    </td>
                                            <td class="created"> 24/Jun/14 11:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Dec/15 13:14 </td>
                                            <td class="resolutiondate"> 01/Jul/14 19:50 </td>
                                            <td class="versions">                        2.7.10            </td>
                                            <td class="fixVersions">                        2.6.15,                     2.7.12,                     3.0.1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
