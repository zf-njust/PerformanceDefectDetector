                <tr id="issuerow12726537" rel="12726537" data-issuekey="CXF-5867" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5867" href="https://issues.apache.org/jira/browse/CXF-5867">CXF-5867</a>
</td>
                                            <td class="summary"><p>
                Implement STS distributed token store using Hazelcast
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Implemented
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jean-Baptiste Onofré
    </td>
                                            <td class="creator">            Jean-Baptiste Onofré
    </td>
                                            <td class="created"> 10/Jul/14 09:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:06 </td>
                                            <td class="resolutiondate"> 10/Jul/14 09:45 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        STS            </td>
                                            <td class="duedate">    &nbsp;
