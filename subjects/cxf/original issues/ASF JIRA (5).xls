</td>
                                            <td class="summary"><p>
                Logging interceptors fail with large inbound messages (XML document structures must start and end within the same entity)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Patrick Decat
    </td>
                                            <td class="creator">            Patrick Decat
    </td>
                                            <td class="created"> 27/Jun/14 10:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Apr/16 11:43 </td>
                                            <td class="resolutiondate"> 01/Jul/14 17:13 </td>
                                            <td class="versions">                        2.6.14            </td>
                                            <td class="fixVersions">                        2.6.15            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
