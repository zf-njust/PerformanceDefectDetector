                <tr id="issuerow12669198" rel="12669198" data-issuekey="CXF-5287" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5287" href="https://issues.apache.org/jira/browse/CXF-5287">CXF-5287</a>
