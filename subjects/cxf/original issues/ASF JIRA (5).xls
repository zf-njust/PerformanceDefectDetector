                <tr id="issuerow12682287" rel="12682287" data-issuekey="CXF-5433" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5433" href="https://issues.apache.org/jira/browse/CXF-5433">CXF-5433</a>
</td>
                                            <td class="summary"><p>
                JAX-RS method invocation failes in case @Mutipart(required=false) is used on primitives
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Valentin Mayamsin
    </td>
                                            <td class="creator">            Valentin Mayamsin
    </td>
                                            <td class="created"> 03/Dec/13 01:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 03/Dec/13 17:38 </td>
                                            <td class="versions">                        2.7.6            </td>
                                            <td class="fixVersions">                        2.6.12,                     2.7.9,                     3.0.0-milestone2            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Here is a sample resource:<br/>
<br/>
{code}<br/>
@Path(&quot;res&quot;)<br/>
interface SomeResource {<br/>
    @PUT<br/>
    @Consumes(MediaType.MULTIPART_FORM_DATA)<br/>
    void uploadFile(@Multipart(&quot;bin&quot;) byte[] fileBytes, <br/>
                             @Multipart(value = &quot;timestamp&quot;, type = &quot;text/plain&quot;) long timestamp);<br/>
}<br/>
{code}<br/>
<br/>
An attempt to upload a file without specifying &#39;timestamp&#39; part ends up with an exception:<br/>
<br/>
{code}<br/>
java.lang.IllegalArgumentException<br/>
        at sun.reflect.NativeMethodAccessorImpl.invoke0(Native Method)<br/>
        at sun.reflect.NativeMethodAccessorImpl.invoke(NativeMethodAccessorImpl.java:57)<br/>
        at sun.reflect.DelegatingMethodAccessorImpl.invoke(DelegatingMethodAccessorImpl.java:43)<br/>
