                <tr id="issuerow12687447" rel="12687447" data-issuekey="CXF-5482" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5482" href="https://issues.apache.org/jira/browse/CXF-5482">CXF-5482</a>
</td>
                                            <td class="summary"><p>
                XKMS: provide direct trust validator
    </p>
</td>
