<br/>
			org.apache.cxf.endpoint.Client clientEnd = ClientProxy.getClient(client);<br/>
			clientEnd.getOutInterceptors().add(new MyLogInterceptor());<br/>
			<br/>
			SendEmailReq sendEmailReq = new SendEmailReq();<br/>
			sendEmailReq.setEmailSubject(&quot;test&quot;);<br/>
