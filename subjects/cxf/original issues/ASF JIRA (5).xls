                <tr id="issuerow12685593" rel="12685593" data-issuekey="CXF-5470" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5470" href="https://issues.apache.org/jira/browse/CXF-5470">CXF-5470</a>
</td>
                                            <td class="summary"><p>
                Usage of HttpAsyncClient with async calls is unstable
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Anthony Communier
    </td>
                                            <td class="creator">            Anthony Communier
    </td>
                                            <td class="created"> 19/Dec/13 13:49 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 17/Jan/14 19:04 </td>
                                            <td class="versions">                        2.7.8            </td>
                                            <td class="fixVersions">                        3.0.0-milestone1            </td>
                                            <td class="components">    &nbsp;
</td>
