</td>
                                            <td class="summary"><p>
                IllegalStateException calling Oneway method using JMS and WSA
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Wouter Dhaeze
    </td>
                                            <td class="creator">            Wouter Dhaeze
    </td>
                                            <td class="created"> 05/Dec/13 11:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:09 </td>
                                            <td class="resolutiondate"> 05/May/14 19:59 </td>
                                            <td class="versions">                        2.7.5,                     2.7.7            </td>
                                            <td class="fixVersions">                        2.6.15,                     2.7.12            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
