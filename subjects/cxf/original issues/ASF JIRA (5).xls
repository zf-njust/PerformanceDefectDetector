                <tr id="issuerow12694096" rel="12694096" data-issuekey="CXF-5553" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5553" href="https://issues.apache.org/jira/browse/CXF-5553">CXF-5553</a>
</td>
                                            <td class="summary"><p>
                How to make asynchronous client request using dispatch mechanism in cxf with out generating stubs
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            KRISHNA SAI MULPURI
    </td>
                                            <td class="creator">            KRISHNA SAI MULPURI
    </td>
                                            <td class="created"> 08/Feb/14 13:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 10/Feb/14 19:26 </td>
                                            <td class="versions">                        3.0.0-milestone1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
