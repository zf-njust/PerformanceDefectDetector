                <tr id="issuerow12680829" rel="12680829" data-issuekey="CXF-5418" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5418" href="https://issues.apache.org/jira/browse/CXF-5418">CXF-5418</a>
</td>
                                            <td class="summary"><p>
                WebClient QName representation can get a query added to it
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Sergey Beryozkin
    </td>
                                            <td class="creator">            Sergey Beryozkin
    </td>
                                            <td class="created"> 22/Nov/13 22:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 25/Nov/13 10:08 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        3.0.0-milestone2            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
