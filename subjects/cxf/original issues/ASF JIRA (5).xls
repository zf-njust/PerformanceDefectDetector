</td>
                                            <td class="summary"><p>
                Suppressed deprecations using BeanDefinitionBuilder.addConstructorArg causing issues with Spring STS 3.4.0.201310051539-RELEASE
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            David Graff
    </td>
                                            <td class="creator">            David Graff
    </td>
                                            <td class="created"> 19/Nov/13 14:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 20/Nov/13 02:22 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.7.7            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core,                     Transports            </td>
