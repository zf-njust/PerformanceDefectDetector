                                            <td class="summary"><p>
                The publish attribute on jaxws:endpoint doesn&#39;t support placeholder in spring configuration
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Xilai Dai
    </td>
                                            <td class="creator">            Xilai Dai
    </td>
                                            <td class="created"> 24/Oct/14 03:23 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:08 </td>
                                            <td class="resolutiondate"> 24/Oct/14 17:50 </td>
                                            <td class="versions">                        2.7.12            </td>
                                            <td class="fixVersions">                        3.0.3,                     2.7.14            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
