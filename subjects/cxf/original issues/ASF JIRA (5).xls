    <a class="issue-link" data-issue-key="CXF-5154" href="https://issues.apache.org/jira/browse/CXF-5154">CXF-5154</a>
</td>
                                            <td class="summary"><p>
                PEP only sends Operation Namespace + Name to the PDP
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
