    <a class="issue-link" data-issue-key="CXF-5198" href="https://issues.apache.org/jira/browse/CXF-5198">CXF-5198</a>
</td>
                                            <td class="summary"><p>
                FiqlParser fails to parse an expression with camel case when SearchBean is used
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Adam Lider
    </td>
                                            <td class="creator">            Adam Lider
    </td>
                                            <td class="created"> 13/Aug/13 12:23 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Sep/13 18:18 </td>
                                            <td class="resolutiondate"> 21/Aug/13 13:32 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.6.10,                     2.7.7,                     3.0.0-milestone1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
