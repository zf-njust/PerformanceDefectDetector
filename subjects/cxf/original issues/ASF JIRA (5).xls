                <tr id="issuerow12662673" rel="12662673" data-issuekey="CXF-5191" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5191" href="https://issues.apache.org/jira/browse/CXF-5191">CXF-5191</a>
</td>
                                            <td class="summary"><p>
                StaxUtils readQName does not accept leading and trailing whitespaces
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Akitoshi Yoshida
    </td>
                                            <td class="reporter">            Akitoshi Yoshida
    </td>
                                            <td class="creator">            Akitoshi Yoshida
    </td>
                                            <td class="created"> 08/Aug/13 18:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Sep/13 18:18 </td>
                                            <td class="resolutiondate"> 09/Aug/13 13:01 </td>
                                            <td class="versions">                        2.6.9,                     2.7.6            </td>
                                            <td class="fixVersions">                        2.6.10,                     2.7.7,                     3.0.0-milestone1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
