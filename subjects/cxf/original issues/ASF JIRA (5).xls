                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Parwiz Rezai
    </td>
                                            <td class="creator">            Parwiz Rezai
    </td>
                                            <td class="created"> 18/Mar/14 08:23 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:51 </td>
                                            <td class="resolutiondate"> 18/Mar/14 22:00 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.7.11,                     3.0            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
