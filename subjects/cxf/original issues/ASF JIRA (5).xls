                <tr id="issuerow12703169" rel="12703169" data-issuekey="CXF-5637" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5637" href="https://issues.apache.org/jira/browse/CXF-5637">CXF-5637</a>
</td>
                                            <td class="summary"><p>
                WSDL First approach : Xsd import in wsdl causing validation errors while generating client.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Anshul Rohilla
    </td>
                                            <td class="creator">            Anshul Rohilla
    </td>
                                            <td class="created"> 24/Mar/14 10:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:04 </td>
                                            <td class="resolutiondate"> 04/Apr/17 18:54 </td>
                                            <td class="versions">                        2.7.5            </td>
                                            <td class="fixVersions">                        3.1.11,                     3.2.0            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
