                <tr id="issuerow12662929" rel="12662929" data-issuekey="CXF-5195" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5195" href="https://issues.apache.org/jira/browse/CXF-5195">CXF-5195</a>
</td>
                                            <td class="summary"><p>
                Wrong schema may be returned from LSResourceResolver.resolveResource() with null system ID
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Alex Halovanic
    </td>
                                            <td class="creator">            Alex Halovanic
    </td>
                                            <td class="created"> 09/Aug/13 19:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Sep/13 18:18 </td>
                                            <td class="resolutiondate"> 14/Aug/13 18:06 </td>
                                            <td class="versions">                        2.7.6            </td>
                                            <td class="fixVersions">                        2.6.10,                     2.7.7            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
