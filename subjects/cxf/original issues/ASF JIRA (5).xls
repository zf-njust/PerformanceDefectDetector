                <tr id="issuerow12696479" rel="12696479" data-issuekey="CXF-5574" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5574" href="https://issues.apache.org/jira/browse/CXF-5574">CXF-5574</a>
</td>
                                            <td class="summary"><p>
                CXF JAX-RS loops infinitely when server closes connection on receipt of message
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Duplicate
</td>
