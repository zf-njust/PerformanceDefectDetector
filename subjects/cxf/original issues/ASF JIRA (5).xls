<br/>
{code:languge=java}<br/>
void logProtocolHeaders(Level level) {<br/>
        for (String header : headers.keySet()) {<br/>
            List&lt;?&gt; headerList = headers.get(header);<br/>
            for (Object value : headerList) {<br/>
                // value is null<br/>
