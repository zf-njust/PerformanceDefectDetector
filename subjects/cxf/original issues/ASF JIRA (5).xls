    at org.jboss.ws.tools.cmd.WSConsume.importServices(WSConsume.java:279)<br/>
    at org.jboss.ws.tools.cmd.WSConsume.mainInternal(WSConsume.java:104)<br/>
    at org.jboss.ws.tools.cmd.WSConsume.main(WSConsume.java:92)<br/>
