                                            <td class="summary"><p>
                NTLM authentication does not work
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
