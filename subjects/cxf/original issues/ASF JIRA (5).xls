                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      {code:java}<br/>
public class FiqlParserTest {<br/>
<br/>
    private FiqlParser&lt;SearchBean&gt; parser = new FiqlParser&lt;SearchBean&gt;(SearchBean.class);<br/>
<br/>
    @Test<br/>
    public void lowerCase() throws SearchParseException {<br/>
        parser.parse(&quot;thename==king&quot;);<br/>
    }<br/>
<br/>
    @Test<br/>
    public void camelCase() throws SearchParseException {<br/>
        parser.parse(&quot;theName==king&quot;);<br/>
    }<br/>
}<br/>
{code}<br/>
<br/>
The problem was introduced in revision: 1468852 and exists in all versions created later on.
