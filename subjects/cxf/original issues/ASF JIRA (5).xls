                <tr id="issuerow12667101" rel="12667101" data-issuekey="CXF-5253" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5253" href="https://issues.apache.org/jira/browse/CXF-5253">CXF-5253</a>
</td>
                                            <td class="summary"><p>
                Update JPA visitor to use a strict match for Strings unless they have wildcards or a user property enables a wildcard match
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Sergey Beryozkin
    </td>
                                            <td class="creator">            Sergey Beryozkin
    </td>
                                            <td class="created"> 05/Sep/13 13:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Sep/13 18:18 </td>
                                            <td class="resolutiondate"> 05/Sep/13 13:31 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.7.7,                     3.0.0-milestone1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
