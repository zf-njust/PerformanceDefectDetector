                                            <td class="aggregatetimeestimate">86400</td>
                                            <td class="aggregatetimeoriginalestimate">86400</td>
                                            <td class="labels">    exception-handling, exceptions, soapfault, stacktrace</td>
                                            <td class="customfield_12310060">    Moderate
</td>
                                            <td class="customfield_12310220">            <span title="30/Apr/14 09:42"><time class="livestamp allow-future" datetime="2014-04-30T09:42:21+0000">30/Apr/14 9:42 AM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
                                            <td class="customfield_12312520"></td>
                                            <td class="customfield_12312323"></td>
                                            <td class="customfield_12312521">    3 years, 7 weeks, 6 days ago

                        </td>
                                            <td class="customfield_12312320"></td>
                                            <td class="customfield_12310420">      389744
  </td>
                                            <td class="customfield_12312321"></td>
                                            <td class="customfield_12312120">
</td>
                                            <td class="customfield_12312121"><span class="sla-agent-restricted">Restricted to agents</span>
</td>
                                            <td class="customfield_12312328"></td>
                                            <td class="customfield_12312329"></td>
                                            <td class="customfield_12312923"></td>
                                            <td class="customfield_12312326"></td>
