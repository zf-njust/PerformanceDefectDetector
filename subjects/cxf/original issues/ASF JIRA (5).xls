                <tr id="issuerow12658516" rel="12658516" data-issuekey="CXF-5137" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5137" href="https://issues.apache.org/jira/browse/CXF-5137">CXF-5137</a>
</td>
                                            <td class="summary"><p>
                PrimitiveStatement.value contains unwanted data
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Chris Eineke
    </td>
                                            <td class="creator">            Chris Eineke
    </td>
                                            <td class="created"> 18/Jul/13 13:15 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Aug/13 15:56 </td>
                                            <td class="resolutiondate"> 23/Jul/13 13:19 </td>
                                            <td class="versions">                        2.6.7            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
