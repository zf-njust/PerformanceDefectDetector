    <a class="issue-link" data-issue-key="CXF-5232" href="https://issues.apache.org/jira/browse/CXF-5232">CXF-5232</a>
</td>
                                            <td class="summary"><p>
                CXF unable to resolve wsdl when XLST Transformation applied
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
