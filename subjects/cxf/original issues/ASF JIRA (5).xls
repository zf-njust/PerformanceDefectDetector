                                            <td class="resolutiondate"> 26/May/14 16:23 </td>
                                            <td class="versions">                        2.7.11,                     2.6.14,                     3.0            </td>
                                            <td class="fixVersions">                        2.6.15,                     2.7.12,                     3.0.1            </td>
