                <tr id="issuerow12738257" rel="12738257" data-issuekey="CXF-5981" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5981" href="https://issues.apache.org/jira/browse/CXF-5981">CXF-5981</a>
</td>
                                            <td class="summary"><p>
                AbstractTransportFactory does not have register method in CXF 3.0
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Piyush Muthal
    </td>
                                            <td class="creator">            Piyush Muthal
    </td>
                                            <td class="created"> 01/Sep/14 12:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:41 </td>
                                            <td class="resolutiondate"> 02/Dec/14 10:51 </td>
                                            <td class="versions">                        3.0.1            </td>
                                            <td class="fixVersions">                        NeedMoreInfo            </td>
                                            <td class="components">                        Bus,                     Core,                     JAX-RS,                     Resources            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
