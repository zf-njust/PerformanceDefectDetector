    <a class="issue-link" data-issue-key="CXF-5447" href="https://issues.apache.org/jira/browse/CXF-5447">CXF-5447</a>
</td>
                                            <td class="summary"><p>
                IllegalStateException: Already connected when sending empty POST request
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Rafael B.C.
    </td>
                                            <td class="creator">            Rafael B.C.
    </td>
                                            <td class="created"> 09/Dec/13 15:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 09/Dec/13 17:50 </td>
                                            <td class="versions">                        2.7.7,                     2.7.8            </td>
                                            <td class="fixVersions">                        2.7.9,                     3.0.0-milestone2            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
