			&lt;xs:element name=&quot;Reason&quot; type=&quot;xs:string&quot; /&gt;<br/>
			&lt;xs:element name=&quot;Detail&quot; type=&quot;xs:string&quot; /&gt;<br/>
		&lt;/xs:sequence&gt;<br/>
