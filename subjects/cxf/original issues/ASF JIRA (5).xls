		&lt;/wsdl:operation&gt;<br/>
		&lt;wsdl:operation name=&quot;endpoint1_operation2&quot;&gt;<br/>
			&lt;wsdl:input message=&quot;tns:endpoint1_operation2_request&quot; /&gt;<br/>
			&lt;wsdl:output message=&quot;tns:endpoint1_operation2_response&quot; /&gt;<br/>
			&lt;wsdl:fault name=&quot;OperationFault&quot; message=&quot;tns:OperationFault&quot; /&gt;<br/>
		&lt;/wsdl:operation&gt;<br/>
	&lt;/wsdl:portType&gt;<br/>
	<br/>
