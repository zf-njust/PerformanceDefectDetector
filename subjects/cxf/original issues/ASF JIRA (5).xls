		&lt;wsdl:operation name=&quot;endpoint1_operation1&quot;&gt;<br/>
			&lt;wsdl:input message=&quot;tns:endpoint1_operation1_request&quot; /&gt;<br/>
			&lt;wsdl:output message=&quot;tns:endpoint1_operation1_response&quot; /&gt;<br/>
