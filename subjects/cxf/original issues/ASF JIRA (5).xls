                <tr id="issuerow12718661" rel="12718661" data-issuekey="CXF-5789" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5789" href="https://issues.apache.org/jira/browse/CXF-5789">CXF-5789</a>
</td>
                                            <td class="summary"><p>
                Add methods to get input and output SOAP headers to SOAPBindingUtil
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Peter Frandsen
    </td>
                                            <td class="creator">            Peter Frandsen
    </td>
                                            <td class="created"> 05/Jun/14 16:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:09 </td>
                                            <td class="resolutiondate"> 01/Jul/14 23:01 </td>
                                            <td class="versions">                        3.0            </td>
                                            <td class="fixVersions">                        2.7.12,                     3.0.1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      SOAPBindingUtil has methods to get the first input and output SOAP header for a BindingOperation.<br/>
Add methods to get list of all the headers.<br/>
<br/>
The method getSoapHeaders(List&lt;ExtensibilityElement&gt; exts) cannot be used as the BindingOperation.getBindingInput().getExtensibilityElements() and BindingOperation.getBindingOutput().getExtensibilityElements() returns List&lt;Object&gt; and not List&lt;ExtensibilityElement&gt; which cannot safely be casted to List&lt;ExtensibilityElement&gt; without checking the type of each element in the list (...getExtensibilityElements()  instanceof List&lt;ExtensibilityElement&gt; not legal with Java generics).<br/>
<br/>
{code:title=org.apache.cxf.binding.soap.SOAPBindingUtil|language=java}<br/>
    public static List&lt;SoapHeader&gt; getBindingInputSOAPHeaders(BindingOperation bop) {<br/>
        List&lt;SoapHeader&gt; headers = new ArrayList&lt;SoapHeader&gt;();<br/>
        BindingInput bindingInput = bop.getBindingInput();<br/>
        if (bindingInput != null) {<br/>
            for (Object obj : bindingInput.getExtensibilityElements()) {<br/>
                if (isSOAPHeader(obj)) {<br/>
                    headers.add(getProxy(SoapHeader.class, obj));<br/>
                }<br/>
            }<br/>
        }<br/>
        return headers;<br/>
    }<br/>
<br/>
    public static List&lt;SoapHeader&gt; getBindingOutputSOAPHeaders(BindingOperation bop) {<br/>
        List&lt;SoapHeader&gt; headers = new ArrayList&lt;SoapHeader&gt;();<br/>
        BindingOutput bindingOutput = bop.getBindingOutput();<br/>
        if (bindingOutput != null) {<br/>
            for (Object obj : bindingOutput.getExtensibilityElements()) {<br/>
                if (isSOAPHeader(obj)) {<br/>
                    headers.add(getProxy(SoapHeader.class, obj));<br/>
                }<br/>
            }<br/>
        }<br/>
        return headers;<br/>
    }<br/>
{code}
  </td>
