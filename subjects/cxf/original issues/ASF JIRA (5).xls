    <a class="issue-link" data-issue-key="CXF-5787" href="https://issues.apache.org/jira/browse/CXF-5787">CXF-5787</a>
</td>
                                            <td class="summary"><p>
                org.apache.cxf.interceptor.Fault:Unmarshalling Error: Unexpected EOF; was expecting a close tag for element
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Geert Zijlmans
    </td>
                                            <td class="creator">            Geert Zijlmans
    </td>
