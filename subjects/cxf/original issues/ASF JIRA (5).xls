</td>
                                            <td class="summary"><p>
                Latest Jetty doesn&#39;t like the -D jvmargs added to generated build.xml
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Daniel Kulp
    </td>
                                            <td class="creator">            Daniel Kulp
    </td>
                                            <td class="created"> 11/Dec/13 18:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:51 </td>
                                            <td class="resolutiondate"> 12/Dec/13 18:39 </td>
                                            <td class="versions">                        3.0.0-milestone1,                     2.7.8            </td>
                                            <td class="fixVersions">                        2.6.12,                     2.7.9,                     3.0.0-milestone2            </td>
