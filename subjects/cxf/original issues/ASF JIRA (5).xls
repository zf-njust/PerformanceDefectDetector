                <tr id="issuerow12703222" rel="12703222" data-issuekey="CXF-5640" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5640" href="https://issues.apache.org/jira/browse/CXF-5640">CXF-5640</a>
</td>
                                            <td class="summary"><p>
                CXF bundle is not compatible with new spring features from Karaf
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Igor Lazebny
    </td>
                                            <td class="creator">            Igor Lazebny
    </td>
                                            <td class="created"> 24/Mar/14 15:45 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 25/Mar/14 13:30 </td>
                                            <td class="versions">                        2.7.11            </td>
                                            <td class="fixVersions">                        2.7.11            </td>
