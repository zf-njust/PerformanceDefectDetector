                <tr id="issuerow12700715" rel="12700715" data-issuekey="CXF-5603" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5603" href="https://issues.apache.org/jira/browse/CXF-5603">CXF-5603</a>
</td>
                                            <td class="summary"><p>
                The DefaultSecurityContext should use a supplied username to help find the User Principal
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Colm O hEigeartaigh
    </td>
                                            <td class="creator">            Colm O hEigeartaigh
    </td>
                                            <td class="created"> 11/Mar/14 15:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 11/Mar/14 16:40 </td>
                                            <td class="versions">                        2.7.10            </td>
                                            <td class="fixVersions">                        2.7.11,                     3.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
