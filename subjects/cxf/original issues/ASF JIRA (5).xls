                                            <td class="description">      {code}<br/>
@Path(&quot;/bookstore&quot;)<br/>
@Produces(&quot;application/xml&quot;)<br/>
public class BookStore {<br/>
    @Context <br/>
    private UriInfo ui;<br/>
<br/>
    @GET<br/>
    @Path(&quot;/books/{id}&quot;)<br/>
    public Response getBookRoot(@PathParam(&quot;id&quot;) Long id) {<br/>
        System.out.println(ui.getAbsolutePath());<br/>
        Book b = books.get(id);<br/>
        if (b == null) {<br/>
            return Response.status(Status.NOT_FOUND).build();<br/>
        }<br/>
        return Response.ok(b).build();<br/>
    }<br/>
}<br/>
{code}<br/>
<br/>
The GET call prints: http://localhost:8888bookstore/books/123 .<br/>

