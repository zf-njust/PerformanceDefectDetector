    </td>
                                            <td class="reporter">            Akitoshi Yoshida
    </td>
                                            <td class="creator">            Akitoshi Yoshida
    </td>
                                            <td class="created"> 12/Jul/13 08:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Aug/13 15:49 </td>
                                            <td class="resolutiondate"> 12/Jul/13 12:42 </td>
                                            <td class="versions">                        2.6.8,                     2.7.5            </td>
                                            <td class="fixVersions">                        2.5.11,                     2.6.9,                     2.7.6            </td>
