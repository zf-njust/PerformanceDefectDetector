</td>
                                            <td class="summary"><p>
                IllegalArgumentException: wrong number of arguments while invoking operation with only an implicit header parameter
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Akitoshi Yoshida
    </td>
                                            <td class="reporter">            Andreas Gudian
    </td>
                                            <td class="creator">            Andreas Gudian
    </td>
                                            <td class="created"> 07/Apr/14 07:37 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:51 </td>
                                            <td class="resolutiondate"> 15/Apr/14 16:45 </td>
                                            <td class="versions">                        3.0.0-milestone2,                     2.7.10            </td>
                                            <td class="fixVersions">                        3.0,                     2.6.15,                     2.7.12            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
