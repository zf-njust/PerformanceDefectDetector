    <a class="issue-link" data-issue-key="CXF-6055" href="https://issues.apache.org/jira/browse/CXF-6055">CXF-6055</a>
</td>
                                            <td class="summary"><p>
                WebClient adds Content-Type to GET requests
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
