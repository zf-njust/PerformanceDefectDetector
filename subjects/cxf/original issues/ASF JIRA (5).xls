</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Current WSDLGetInterceptor build up the out message interceptor chain like this<br/>
{code}<br/>
Iterator&lt;Interceptor&lt;? extends Message&gt;&gt; iterator = mout.getInterceptorChain().iterator();<br/>
            while (iterator.hasNext()) {<br/>
                Interceptor&lt;? extends Message&gt; inInterceptor = iterator.next();<br/>
                if (!inInterceptor.getClass().equals(StaxOutInterceptor.class)<br/>
                    &amp;&amp; !inInterceptor.getClass().equals(GZIPOutInterceptor.class)<br/>
                    &amp;&amp; !inInterceptor.getClass().equals(MessageSenderInterceptor.class)) {<br/>
                    mout.getInterceptorChain().remove(inInterceptor);<br/>
                }<br/>
            }<br/>
{code}<br/>
<br/>
It causes some troubles when users use some customer interceptors.<br/>
 
  </td>
