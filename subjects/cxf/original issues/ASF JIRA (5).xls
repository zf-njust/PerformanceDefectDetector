    </td>
                                            <td class="created"> 04/Apr/14 08:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Jul/17 15:29 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        3.0.0-milestone2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAX-RS Security            </td>
