    <a class="issue-link" data-issue-key="CXF-5197" href="https://issues.apache.org/jira/browse/CXF-5197">CXF-5197</a>
</td>
                                            <td class="summary"><p>
                No Java extensionType found to represent {http://www.w3.org/2006/05/addressing/wsdl}UsingAddressing
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Alessio Soldano
    </td>
                                            <td class="reporter">            Alessio Soldano
    </td>
                                            <td class="creator">            Alessio Soldano
    </td>
                                            <td class="created"> 12/Aug/13 13:57 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Sep/13 18:18 </td>
                                            <td class="resolutiondate"> 12/Aug/13 15:55 </td>
                                            <td class="versions">                        2.7.7            </td>
                                            <td class="fixVersions">                        2.7.7            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
