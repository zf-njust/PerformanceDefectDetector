                                            <td class="summary"><p>
                LuceneQueryVisitor is not reusable / not thread-safe
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andriy Redko
    </td>
                                            <td class="reporter">            Andriy Redko
    </td>
