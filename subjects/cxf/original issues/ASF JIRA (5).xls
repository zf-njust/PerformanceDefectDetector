                                            <td class="summary"><p>
                wsdl2java marker file name can exceed 255 chars
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
