    <a class="issue-link" data-issue-key="CXF-5811" href="https://issues.apache.org/jira/browse/CXF-5811">CXF-5811</a>
</td>
                                            <td class="summary"><p>
                Client fails with UnmarshalException if WSS4JInInterceptor is used
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Roland Mueller
    </td>
                                            <td class="creator">            Roland Mueller
    </td>
