                <tr id="issuerow12694975" rel="12694975" data-issuekey="CXF-5562" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5562" href="https://issues.apache.org/jira/browse/CXF-5562">CXF-5562</a>
</td>
                                            <td class="summary"><p>
                value of @QueryParam/@PathParam Annotation inside @BeanParam Classes will be ignored
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
