                <tr id="issuerow12721357" rel="12721357" data-issuekey="CXF-5806" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5806" href="https://issues.apache.org/jira/browse/CXF-5806">CXF-5806</a>
</td>
                                            <td class="summary"><p>
                FIQL: Problem with mapping on ManyToMany or OnToMany associations of 2nd level
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Romain Castan
    </td>
                                            <td class="creator">            Romain Castan
    </td>
                                            <td class="created"> 16/Jun/14 08:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:09 </td>
                                            <td class="resolutiondate"> 19/Jun/14 11:51 </td>
                                            <td class="versions">                        2.6.13,                     3.0            </td>
                                            <td class="fixVersions">                        2.6.15,                     2.7.12,                     3.0.1            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The simplest is used an example to illustrate the problem<br/>
{code:title=Example}<br/>
class ClassA {<br/>
    ClassB b;<br/>
    List&lt;ClassD&gt; listD;<br/>
};<br/>
class ClassB {<br/>
    List&lt;ClassC&gt; listC;<br/>
};<br/>
class ClassC {<br/>
    String name;<br/>
};<br/>
class ClassD {<br/>
    String name;<br/>
}<br/>
{code}<br/>
The following request works:<br/>
{code:title=Fiql request OK (1er level)}<br/>
properties: <br/>
nameD=listD.name<br/>
Request:<br/>
?_s=nameD==xxxx<br/>
{code}<br/>
The following request doesn&#39;t work:<br/>
{code:title=Fiql request KO (2nd level)}<br/>
properties: <br/>
nameC=b.listC.name<br/>
Request:<br/>
?_s=nameC==xxxx<br/>
{code}<br/>
<br/>

  </td>
