    <a class="issue-link" data-issue-key="CXF-5567" href="https://issues.apache.org/jira/browse/CXF-5567">CXF-5567</a>
</td>
                                            <td class="summary"><p>
                Policy attached to messages input/output  of the binding not picked for dispatch case.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            renu gupta
    </td>
                                            <td class="creator">            renu gupta
    </td>
                                            <td class="created"> 18/Feb/14 14:15 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 18/Mar/14 18:36 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        STS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
