            &lt;/sec:cipherSuitesFilter&gt;<br/>
        &lt;/http:tlsClientParameters&gt;<br/>
<br/>
        &lt;http:client AutoRedirect=&quot;true&quot; Connection=&quot;Keep-Alive&quot;/&gt;<br/>
<br/>
    &lt;/http:conduit&gt;<br/>
