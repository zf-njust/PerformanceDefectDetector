                <tr id="issuerow12667534" rel="12667534" data-issuekey="CXF-5260" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5260" href="https://issues.apache.org/jira/browse/CXF-5260">CXF-5260</a>
</td>
                                            <td class="summary"><p>
                XKMS-client should not contain CryptoProviderFactory interface
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Christian Schneider
    </td>
                                            <td class="reporter">            Christian Schneider
    </td>
                                            <td class="creator">            Christian Schneider
    </td>
                                            <td class="created"> 09/Sep/13 09:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Sep/13 18:18 </td>
                                            <td class="resolutiondate"> 09/Sep/13 13:57 </td>
                                            <td class="versions">    &nbsp;
</td>
