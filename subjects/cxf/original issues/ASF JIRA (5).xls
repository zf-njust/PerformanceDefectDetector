                <tr id="issuerow12693485" rel="12693485" data-issuekey="CXF-5545" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5545" href="https://issues.apache.org/jira/browse/CXF-5545">CXF-5545</a>
</td>
                                            <td class="summary"><p>
                wsdl2java sholud create java.lang.Exception matching constructors for fault with no fields
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Kamil Wiśniewski
    </td>
                                            <td class="creator">            Kamil Wiśniewski
    </td>
                                            <td class="created"> 06/Feb/14 02:58 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:37 </td>
                                            <td class="resolutiondate"> 31/Mar/17 17:06 </td>
                                            <td class="versions">                        3.0.0-milestone1            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      wsdl2java when exceptionSuperclass is java.lang.Exception (the default) should create respective constructors of java.lang.Exception in case when <br/>
fault has no fields.<br/>
<br/>
*When operation is defined*<br/>
<br/>
   &lt;wsdl:operation name=&quot;QueryAllReasons&quot;&gt;<br/>
            &lt;wsdl:input name=&quot;QueryAllReasonsRQ&quot; message=&quot;rds:ReasonQueryAllRQ&quot;/&gt;<br/>
            &lt;wsdl:output name=&quot;QueryAllReasonsRS&quot; message=&quot;rds:ReasonQueryAllRS&quot;/&gt;<br/>
            &lt;wsdl:fault name=&quot;ServiceFault&quot; message=&quot;rds:ReasonDefinitionServiceFault&quot;/&gt;           <br/>
        &lt;/wsdl:operation&gt;<br/>
<br/>
*and message part for fault is empty*<br/>
<br/>
 &lt;wsdl:message name=&quot;ReasonDefinitionServiceFault&quot;&gt;       <br/>
    &lt;/wsdl:message&gt;<br/>
<br/>
*generated java class should look like this:*<br/>
<br/>
package com.sabre.apd.cm.jaxb.plugin;<br/>
<br/>
import javax.xml.ws.WebFault;<br/>
<br/>
<br/>
/**<br/>
 * This class was generated by Apache CXF 3.0.0-milestone1<br/>
 * 2014-02-06T03:28:41.558+01:00<br/>
 * Generated source version: 3.0.0-milestone1<br/>
 */<br/>
<br/>
public class ReasonDefinitionServiceFault extends Exception {<br/>
    public ReasonDefinitionServiceFault() {<br/>
    }<br/>
<br/>
    public ReasonDefinitionServiceFault(String message) {<br/>
        super(message);<br/>
    }<br/>
<br/>
    public ReasonDefinitionServiceFault(String message, Throwable cause) {<br/>
        super(message, cause);<br/>
    }<br/>
<br/>
    public ReasonDefinitionServiceFault(Throwable cause) {<br/>
        super(cause);<br/>
    }<br/>
}<br/>

  </td>
