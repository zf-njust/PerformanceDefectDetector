</td>
                                            <td class="summary"><p>
                Share an existing global ehcache manager for ws security replay caches
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jason Pell
    </td>
                                            <td class="reporter">            Jason Pell
    </td>
                                            <td class="creator">            Jason Pell
    </td>
                                            <td class="created"> 13/Jun/14 01:08 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Jun/14 17:22 </td>
                                            <td class="resolutiondate"> 15/Jun/14 06:13 </td>
                                            <td class="versions">                        2.7.11,                     2.6.14,                     3.0            </td>
                                            <td class="fixVersions">                        2.6.15,                     2.7.12,                     3.0.1            </td>
                                            <td class="components">    &nbsp;
</td>
