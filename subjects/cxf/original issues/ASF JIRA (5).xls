                <tr id="issuerow12736603" rel="12736603" data-issuekey="CXF-5970" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5970" href="https://issues.apache.org/jira/browse/CXF-5970">CXF-5970</a>
</td>
                                            <td class="summary"><p>
                review org.apache.cxf.jaxrs.provider.ProviderFactory.Message*ReaderComparator
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Later
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Romain Manni-Bucau
    </td>
                                            <td class="creator">            Romain Manni-Bucau
    </td>
                                            <td class="created"> 25/Aug/14 19:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Mar/17 19:41 </td>
                                            <td class="resolutiondate"> 27/Aug/14 10:07 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        NeedMoreInfo            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
