    <a class="issue-link" data-issue-key="CXF-5671" href="https://issues.apache.org/jira/browse/CXF-5671">CXF-5671</a>
</td>
                                            <td class="summary"><p>
                NTLM API not exposed
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
