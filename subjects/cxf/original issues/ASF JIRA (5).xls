                <tr id="issuerow12674989" rel="12674989" data-issuekey="CXF-5351" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5351" href="https://issues.apache.org/jira/browse/CXF-5351">CXF-5351</a>
</td>
                                            <td class="summary"><p>
                Support @DefaultValue with @Multipart
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Implemented
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Fabien Thouny
    </td>
                                            <td class="creator">            Fabien Thouny
    </td>
                                            <td class="created"> 22/Oct/13 08:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 10/Apr/17 19:07 </td>
                                            <td class="resolutiondate"> 28/Oct/13 21:03 </td>
                                            <td class="versions">                        2.7.7            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      It would be nice to be able to use @DefaultValue with @Multipart like we do other @*Param<br/>
<br/>
{code}<br/>
@POST<br/>
@Consumes(&quot;multipart/form-data&quot;)<br/>
@Produces(&quot;application/xml&quot;)<br/>
Response someResource(<br/>
          @DefaultValue(&quot;default value&quot;) @Multipart(value = &quot;someParam&quot;, required = &quot;false&quot;) String someParam);<br/>
{code}<br/>
<br/>
I&#39;m not sure if &quot;required=false&quot; should be mandatory. Perhaps it should be implied by @DefaultValue ?
