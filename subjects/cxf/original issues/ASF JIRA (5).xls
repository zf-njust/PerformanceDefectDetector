	at org.springframework.jms.listener.DefaultMessageListenerContainer$AsyncMessageListenerInvoker.executeOngoingLoop(DefaultMessageListenerContainer.java:1051)<br/>
	at org.springframework.jms.listener.DefaultMessageListenerContainer$AsyncMessageListenerInvoker.run(DefaultMessageListenerContainer.java:948)<br/>
	at java.lang.Thread.run(Unknown Source)<br/>
Caused by: java.lang.IllegalStateException: Already connected<br/>
	at java.net.HttpURLConnection.setFixedLengthStreamingMode(Unknown Source)<br/>
	at org.apache.cxf.transport.http.URLConnectionHTTPConduit$URLConnectionWrappedOutputStream.setFixedLengthStreamingMode(URLConnectionHTTPConduit.java:272)<br/>
