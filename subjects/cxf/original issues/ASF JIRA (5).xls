    <a class="issue-link" data-issue-key="CXF-5079" href="https://issues.apache.org/jira/browse/CXF-5079">CXF-5079</a>
</td>
                                            <td class="summary"><p>
                Add support for mustunderstand = false in PolicyBasedWSS4JOutInterceptor
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
