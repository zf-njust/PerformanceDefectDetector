                <tr id="issuerow12693786" rel="12693786" data-issuekey="CXF-5548" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5548" href="https://issues.apache.org/jira/browse/CXF-5548">CXF-5548</a>
</td>
                                            <td class="summary"><p>
                Import of relative sub-schemas for multiple services within the same WSDL
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Roman Vottner
    </td>
                                            <td class="creator">            Roman Vottner
    </td>
                                            <td class="created"> 07/Feb/14 00:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Feb/14 10:42 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.7.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Simple Frontend            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">172800</td>
                                            <td class="timeestimate">172800</td>
