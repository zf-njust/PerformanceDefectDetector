	&lt;wsdl:binding name=&quot;Endpoint1_Binding&quot; type=&quot;tns:Endpoint1_Endpoint&quot;&gt;<br/>
		&lt;soap:binding style=&quot;document&quot; transport=&quot;http://schemas.xmlsoap.org/soap/http&quot; /&gt;<br/>
		&lt;wsdl:operation name=&quot;endpoint1_operation1&quot;&gt;<br/>
			&lt;soap:operation soapAction=&quot;http://serviceoperations.namespace/Endpoing1Operation1&quot; style=&quot;document&quot; /&gt;<br/>
			&lt;wsdl:input&gt;<br/>
				&lt;soap:body parts=&quot;in&quot; use=&quot;literal&quot; /&gt;<br/>
			&lt;/wsdl:input&gt;<br/>
			&lt;wsdl:output&gt;<br/>
				&lt;soap:body parts=&quot;out&quot; use=&quot;literal&quot; /&gt;<br/>
			&lt;/wsdl:output&gt;<br/>
			&lt;wsdl:fault name=&quot;OperationFault&quot;&gt;<br/>
				&lt;soap:fault name=&quot;OperationFault&quot; use=&quot;literal&quot; /&gt;<br/>
			&lt;/wsdl:fault&gt;<br/>
		&lt;/wsdl:operation&gt;<br/>
		&lt;wsdl:operation name=&quot;endpoint1_operation2&quot;&gt;<br/>
			&lt;soap:operation soapAction=&quot;http://serviceoperations.namespace/Endpoing1Operation2&quot; style=&quot;document&quot; /&gt;<br/>
			&lt;wsdl:input&gt;<br/>
				&lt;soap:body parts=&quot;in&quot; use=&quot;literal&quot; /&gt;<br/>
			&lt;/wsdl:input&gt;<br/>
			&lt;wsdl:output&gt;<br/>
				&lt;soap:body parts=&quot;out&quot; use=&quot;literal&quot; /&gt;<br/>
			&lt;/wsdl:output&gt;<br/>
			&lt;wsdl:fault name=&quot;OperationFault&quot;&gt;<br/>
				&lt;soap:fault name=&quot;OperationFault&quot; use=&quot;literal&quot; /&gt;<br/>
			&lt;/wsdl:fault&gt;<br/>
		&lt;/wsdl:operation&gt;<br/>
	&lt;/wsdl:binding&gt;<br/>
	<br/>
	&lt;wsdl:binding name=&quot;Endpoint2_Binding&quot; type=&quot;tns:Endpoint2_Endpoint&quot;&gt;<br/>
		&lt;soap:binding style=&quot;document&quot; transport=&quot;http://schemas.xmlsoap.org/soap/http&quot; /&gt;<br/>
		&lt;wsdl:operation name=&quot;endpoint2_operation&quot;&gt;<br/>
			&lt;soap:operation soapAction=&quot;http://serviceoperations.namespace/Endpoing2Operation&quot; style=&quot;document&quot; /&gt;<br/>
			&lt;wsdl:input&gt;<br/>
				&lt;soap:body parts=&quot;in&quot; use=&quot;literal&quot; /&gt;<br/>
			&lt;/wsdl:input&gt;<br/>
			&lt;wsdl:output&gt;<br/>
				&lt;soap:body parts=&quot;out&quot; use=&quot;literal&quot; /&gt;<br/>
			&lt;/wsdl:output&gt;<br/>
			&lt;wsdl:fault name=&quot;OperationFault&quot;&gt;<br/>
				&lt;soap:fault name=&quot;OperationFault&quot; use=&quot;literal&quot; /&gt;<br/>
			&lt;/wsdl:fault&gt;<br/>
		&lt;/wsdl:operation&gt;<br/>
	&lt;/wsdl:binding&gt;<br/>
	<br/>
	&lt;!-- ======================= Service delclarations ===================== --&gt;<br/>
	&lt;wsdl:service name=&quot;Endpoint1_Service&quot;&gt;<br/>
		&lt;wsdl:port name=&quot;Endpoint1ServicePort&quot; binding=&quot;tns:Endpoint1_Binding&quot;&gt;<br/>
			&lt;soap:address location=&quot;http://localhost:8080/endpoint1&quot; /&gt;<br/>
		&lt;/wsdl:port&gt;<br/>
