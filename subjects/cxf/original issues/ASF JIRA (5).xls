                <tr id="issuerow12750604" rel="12750604" data-issuekey="CXF-6065" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6065" href="https://issues.apache.org/jira/browse/CXF-6065">CXF-6065</a>
</td>
                                            <td class="summary"><p>
                Is the CXF endpoint multthread capable?
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Colbert Philippe
    </td>
                                            <td class="creator">            Colbert Philippe
    </td>
                                            <td class="created"> 26/Oct/14 15:16 </td>
