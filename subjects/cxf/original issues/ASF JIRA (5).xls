    <a class="issue-link" data-issue-key="CXF-5229" href="https://issues.apache.org/jira/browse/CXF-5229">CXF-5229</a>
</td>
                                            <td class="summary"><p>
                Question on configuring multiple policies inside WSDL bindings
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Syed Abdul Wadood
    </td>
                                            <td class="creator">            Syed Abdul Wadood
    </td>
                                            <td class="created"> 22/Aug/13 18:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Dec/13 19:05 </td>
                                            <td class="resolutiondate"> 26/Aug/13 19:25 </td>
                                            <td class="versions">                        2.6.2            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        WS-* Components            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">345600</td>
                                            <td class="timeestimate">345600</td>
                                            <td class="timespent"></td>
                                            <td class="workratio">            0%
    </td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      All platforms
  </td>
                                            <td class="description">      When WS-Security policy in WSDL is configured as shown below, we are seeing some intermittent problems because incorrect policy is applied sometimes.<br/>
Is this policy configuration supported by CXF?  We are using neethi policy engine with CXF.<br/>
<br/>
<br/>
&lt;wsdl:binding name=&quot;TestSoapBinding1&quot; type=&quot;tns:TestSig&quot;&gt;<br/>
   &lt;wsp:PolicyReference URI=&quot;#GenericPolicy&quot; /&gt;        <br/>
   &lt;soap:binding style=&quot;document&quot; transport=&quot;http://schemas.xmlsoap.org/soap/http&quot;/&gt;<br/>
      &lt;wsdl:operation name=&quot;invoke&quot;&gt;<br/>
         &lt;soap:operation soapAction=&quot;&quot; style=&quot;document&quot;/&gt;<br/>
         &lt;wsdl:input name=&quot;testRequest&quot;&gt;<br/>
            &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
         &lt;/wsdl:input&gt;<br/>
         &lt;wsdl:output name=&quot;testResponse&quot;&gt;<br/>
            &lt;wsp:PolicyReference URI=&quot;#OutboundPolicy&quot; /&gt;<br/>
            &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
         &lt;/wsdl:output&gt;<br/>
      &lt;/wsdl:operation&gt;<br/>
&lt;/wsdl:binding&gt;<br/>
<br/>
&lt;wsdl:binding name=&quot;TestSoapBinding1&quot; type=&quot;tns:TestSig&quot;&gt;<br/>
   &lt;wsp:PolicyReference URI=&quot;#GenericPolicy&quot; /&gt;        <br/>
   &lt;soap:binding style=&quot;document&quot; transport=&quot;http://schemas.xmlsoap.org/soap/http&quot;/&gt;<br/>
      &lt;wsdl:operation name=&quot;invoke&quot;&gt;<br/>
         &lt;soap:operation soapAction=&quot;&quot; style=&quot;document&quot;/&gt;<br/>
         &lt;wsdl:input name=&quot;testRequest&quot;&gt; <br/>
            &lt;wsp:PolicyReference URI=&quot;#InboundPolicy&quot; /&gt;<br/>
            &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
         &lt;/wsdl:input&gt;<br/>
         &lt;wsdl:output name=&quot;testResponse&quot;&gt;<br/>
            &lt;soap:body use=&quot;literal&quot;/&gt;<br/>
         &lt;/wsdl:output&gt;<br/>
      &lt;/wsdl:operation&gt;<br/>
&lt;/wsdl:binding&gt;<br/>
<br/>
<br/>
<br/>
<br/>

