                <tr id="issuerow12693109" rel="12693109" data-issuekey="CXF-5538" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5538" href="https://issues.apache.org/jira/browse/CXF-5538">CXF-5538</a>
</td>
                                            <td class="summary"><p>
                Parameterized Types do not work on Exception Classes
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            mustafa
    </td>
                                            <td class="creator">            mustafa
    </td>
                                            <td class="created"> 04/Feb/14 14:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/May/17 19:42 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.7.9            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAXB Databinding            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        CXF-4874                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      As part of the fix CXF-4542 we believe introduced this regression where an Exception class with a Collection was always represented as the Collection type instead of the Paramatized Type.<br/>
<br/>
Example:<br/>
<br/>
{code:title=CustomException.java|borderStyle=solid}<br/>
@WebFault<br/>
public class CustomException extends Exception {<br/>
private ArrayList&lt;MyData&gt; names;<br/>
{code}<br/>
<br/>
This is what you get using fixes from CXF-4542<br/>
<br/>
{code:xml}<br/>
&lt;xs:complexType name=&quot;CustomException&quot;&gt;<br/>
&lt;xs:sequence&gt;<br/>
&lt;xs:element name=&quot;names&quot; nillable=&quot;true&quot; type=&quot;tns:arrayList&quot;/&gt;<br/>
&lt;/xs:sequence&gt;<br/>
{code}<br/>
<br/>
But it should be<br/>
{code:xml}<br/>
&lt;xs:complexType name=&quot;CustomException&quot;&gt;<br/>
&lt;xs:sequence&gt;<br/>
&lt;xs:element maxOccurs=&quot;unbounded&quot; minOccurs=&quot;0&quot; name=&quot;names&quot; type=&quot;tns:myData&quot;/&gt;<br/>
&lt;/xs:sequence&gt;<br/>
{code}
  </td>
