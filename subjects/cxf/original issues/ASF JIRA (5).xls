    <a class="issue-link" data-issue-key="CXF-5098" href="https://issues.apache.org/jira/browse/CXF-5098">CXF-5098</a>
</td>
                                            <td class="summary"><p>
                References to Kerberos Tokens are not created correctly in responses
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
