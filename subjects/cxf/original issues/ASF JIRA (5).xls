    <a class="issue-link" data-issue-key="CXF-5560" href="https://issues.apache.org/jira/browse/CXF-5560">CXF-5560</a>
</td>
                                            <td class="summary"><p>
                MTOM does not work
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Alekhya Gumudavelli
    </td>
