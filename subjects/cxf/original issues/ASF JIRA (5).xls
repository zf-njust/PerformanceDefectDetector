                <tr id="issuerow12743732" rel="12743732" data-issuekey="CXF-6022" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-6022" href="https://issues.apache.org/jira/browse/CXF-6022">CXF-6022</a>
</td>
                                            <td class="summary"><p>
                GZIPOutInterceptor - Exception when using headers
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            member sound
    </td>
                                            <td class="creator">            member sound
    </td>
                                            <td class="created"> 24/Sep/14 07:45 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Nov/14 18:48 </td>
                                            <td class="resolutiondate"> 12/Nov/14 18:48 </td>
                                            <td class="versions">                        3.0.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Bus,                     Core,                     JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
