                <tr id="issuerow12674811" rel="12674811" data-issuekey="CXF-5348" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5348" href="https://issues.apache.org/jira/browse/CXF-5348">CXF-5348</a>
</td>
                                            <td class="summary"><p>
                Exception mappers implementing ExceptionMapper through an abstract class are not mapped to the declared exception 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Fabien Thouny
    </td>
                                            <td class="creator">            Fabien Thouny
    </td>
                                            <td class="created"> 21/Oct/13 15:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Aug/15 10:17 </td>
                                            <td class="resolutiondate"> 31/Jan/14 18:34 </td>
                                            <td class="versions">                        2.7.7            </td>
                                            <td class="fixVersions">                        3.0.0-milestone2,                     2.7.10            </td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      If we consider the following exception mapper, all Throwables will be mapped instead of only the SomeClientExceptions :<br/>
<br/>
{code}<br/>
@Provider<br/>
public class SomeClientExceptionMapper extends AbstractBadRequestExceptionMapper&lt;SomeClientException&gt; {}<br/>
<br/>
abstract class AbstractBadRequestExceptionMapper&lt;T extends Throwable&gt; implements ExceptionMapper&lt;T&gt; {<br/>
<br/>
    @Override<br/>
    public Response toResponse(T exception) {<br/>
        return Response.status(Status.BAD_REQUEST).entity(exception.getMessage()).build();<br/>
    }<br/>
}<br/>
{code}<br/>
<br/>
Please find attached, a sample project with some ITs showing the problem.<br/>
<br/>

