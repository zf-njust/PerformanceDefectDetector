                <tr id="issuerow12723916" rel="12723916" data-issuekey="CXF-5826" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5826" href="https://issues.apache.org/jira/browse/CXF-5826">CXF-5826</a>
</td>
                                            <td class="summary"><p>
                Issue on QueryParam with @BeanParam Annotation
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Satheish Kumar Chandraprakasam
    </td>
                                            <td class="creator">            Satheish Kumar Chandraprakasam
    </td>
                                            <td class="created"> 26/Jun/14 17:00 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:54 </td>
                                            <td class="resolutiondate"> 26/Jun/14 21:28 </td>
                                            <td class="versions">                        3.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAX-RS            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      TIssue:  @Beanparam annotation class with @queryparam method and method parameters throws array index out of bounds exception<br/>
Example - queryxyz(@BeanParam final foo object) <br/>
public class Foo{<br/>
@QueryParam(&quot;q&quot;)<br/>
public String getQ(){<br/>
return &quot;Valid Query&quot;;<br/>
}<br/>
<br/>
query<br/>
<br/>
Both these line of code seems to be contradictory.<br/>
<br/>
//Method can&#39;t be retrieved if there is a parameter<br/>
Method getter = bean.getClass().getMethod(&quot;get&quot; + propertyName, new Class[]{});<br/>
     <br/>
//But, here it expects atleast one parameter that throws the exception.  But the exception is swallowed<br/>
values.put(annotationValue, new BeanPair(value, m.getParameterAnnotations()[0]));<br/>
<br/>
//No Action here<br/>
catch (Throwable t) {<br/>
<br/>
                }<br/>
<br/>
     <br/>
<br/>
<br/>
private Map&lt;String, BeanPair&gt; getValuesFromBeanParam(Object bean, Class&lt;? extends Annotation&gt; annClass) {<br/>
        for (Method m : bean.getClass().getMethods()) {<br/>
            Annotation annotation = m.getAnnotation(annClass);<br/>
            if (annotation != null) {<br/>
                try {<br/>
     <br/>
                    Method getter = bean.getClass().getMethod(&quot;get&quot; + propertyName, new Class[]{});<br/>
     <br/>
                    values.put(annotationValue, new BeanPair(value, m.getParameterAnnotations()[0]));<br/>
                } catch (Throwable t) {<br/>
<br/>
                }<br/>
            }<br/>
        }<br/>
        return values;<br/>
    }
  </td>
