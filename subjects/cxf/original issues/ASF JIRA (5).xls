</td>
                                            <td class="summary"><p>
                Deploy error when publishing CXF WebService to Glassfish4
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Patrick Bédert
    </td>
                                            <td class="creator">            Patrick Bédert
    </td>
                                            <td class="created"> 28/Jan/14 08:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 28/Jan/14 10:43 </td>
                                            <td class="versions">                        3.0.0-milestone1            </td>
                                            <td class="fixVersions">                        2.7.9,                     3.0.0-milestone2            </td>
