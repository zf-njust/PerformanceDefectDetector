</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      @POST<br/>
@Path(&quot;/method/{param1}/param2}&quot;)<br/>
@Consumes(MediaType.APPLICATION_JSON)<br/>
public void method(@PathParam(&quot;param1&quot;) String param1, @PathParam(&quot;param2&quot;) String param2, MyPojo myPojo)<br/>
<br/>
if myPojo is null, i got a NullPointerException :<br/>
java.lang.NullPointerException<br/>
	at org.apache.cxf.jaxrs.client.ClientProxyImpl.invoke(ClientProxyImpl.java:207)<br/>
<br/>
because : params[bodyIndex] is null and the method ask : params[bodyIndex].getClass()<br/>

