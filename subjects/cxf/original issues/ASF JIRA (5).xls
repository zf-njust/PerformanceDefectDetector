                                            <td class="resolutiondate"> 09/Feb/15 21:15 </td>
                                            <td class="versions">                        2.7.3            </td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
