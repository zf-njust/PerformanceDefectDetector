                                            <td class="resolutiondate"> 11/Jul/13 09:10 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.5.11,                     2.6.9,                     2.7.6,                     3.0.0-milestone1            </td>
                                            <td class="components">                        Core,                     Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
