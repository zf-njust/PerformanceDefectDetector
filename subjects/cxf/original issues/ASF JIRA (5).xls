    <a class="issue-link" data-issue-key="CXF-5244" href="https://issues.apache.org/jira/browse/CXF-5244">CXF-5244</a>
</td>
                                            <td class="summary"><p>
                It is not possible to update Content-Type inside JAX-RS 2.0 ContainerRequestFilter 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Dmitry Treskunov
    </td>
                                            <td class="creator">            Dmitry Treskunov
    </td>
                                            <td class="created"> 29/Aug/13 16:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
