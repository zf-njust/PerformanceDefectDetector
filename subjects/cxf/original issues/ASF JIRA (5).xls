                <tr id="issuerow12680708" rel="12680708" data-issuekey="CXF-5416" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5416" href="https://issues.apache.org/jira/browse/CXF-5416">CXF-5416</a>
</td>
                                            <td class="summary"><p>
                UriInfo injection - not getting correct path/base path from UriInfo object which gets injected
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Sergey Beryozkin
    </td>
                                            <td class="reporter">            Srikanth Hugar
    </td>
                                            <td class="creator">            Srikanth Hugar
    </td>
                                            <td class="created"> 22/Nov/13 09:14 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Dec/13 19:05 </td>
                                            <td class="resolutiondate"> 22/Nov/13 09:36 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        Invalid            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
