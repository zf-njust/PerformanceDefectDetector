                <tr id="issuerow12663823" rel="12663823" data-issuekey="CXF-5208" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5208" href="https://issues.apache.org/jira/browse/CXF-5208">CXF-5208</a>
</td>
                                            <td class="summary"><p>
                Anonymous types in an exception aren&#39;t generated in WSDL
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Tadayoshi Sato
    </td>
                                            <td class="creator">            Tadayoshi Sato
    </td>
                                            <td class="created"> 15/Aug/13 09:45 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:54 </td>
                                            <td class="resolutiondate"> 05/Jun/14 10:08 </td>
                                            <td class="versions">                        2.7.6            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        JAXB Databinding,                     Tooling            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Anonymous types (annotated with {{@XmlType(name = &quot;&quot;)}}) in an exception class aren&#39;t generated at all in WSDL.<br/>
<br/>
Web service classes:<br/>
{code:java}<br/>
@WebService<br/>
public class GreetingService {<br/>
  @WebMethod<br/>
  public void hello() throws MyException {}<br/>
  ...<br/>
{code}<br/>
<br/>
{code:java}<br/>
public class MyException extends Exception {<br/>
  private String     str;<br/>
  private MyAnonType myAnonObj;<br/>
<br/>
  public String getStr() { return str; }<br/>
  public void setStr(String str) { this.str = str; }<br/>
<br/>
  public MyAnonType getMyAnonObj() { return myAnonObj; }<br/>
  public void setMyAnonObj(MyAnonType myAnonObj) { this.myAnonObj = myAnonObj; }<br/>
  ...<br/>
{code}<br/>
<br/>
{code:java}<br/>
@XmlType(name = &quot;&quot;)<br/>
public class MyAnonType { ...<br/>
{code}<br/>
<br/>
Generated WSDL:<br/>
{code:xml}<br/>
  &lt;wsdl:types&gt;<br/>
&lt;xs:schema ...&gt;<br/>
  ...<br/>
  &lt;xs:complexType name=&quot;MyException&quot;&gt;<br/>
    &lt;xs:sequence&gt;<br/>
      &lt;xs:element name=&quot;str&quot; nillable=&quot;true&quot; type=&quot;xs:string&quot;/&gt;<br/>
    &lt;/xs:sequence&gt;<br/>
  &lt;/xs:complexType&gt;<br/>
{code}<br/>
<br/>
Note that the same type ({{MyAnonType}}) is generated in WSDL if the {{@XmlType(name = &quot;&quot;)}} annotation is removed.
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
