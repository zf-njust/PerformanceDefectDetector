                <tr id="issuerow12737737" rel="12737737" data-issuekey="CXF-5977" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5977" href="https://issues.apache.org/jira/browse/CXF-5977">CXF-5977</a>
</td>
                                            <td class="summary"><p>
                Calling a WebService in a different domain ends up in UnknownHostException because the domain is lost
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
