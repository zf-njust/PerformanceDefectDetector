</td>
                                            <td class="summary"><p>
                @UseAsyncMethod annotation doesn&#39;t work for classes implementing Provider&lt;T&gt;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andrei Shakirin
    </td>
                                            <td class="reporter">            Andrei Shakirin
    </td>
                                            <td class="creator">            Andrei Shakirin
    </td>
                                            <td class="created"> 22/Jan/14 17:12 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:50 </td>
                                            <td class="resolutiondate"> 23/Jan/14 14:54 </td>
                                            <td class="versions">                        3.0.0-milestone1            </td>
                                            <td class="fixVersions">                        2.7.9,                     3.0.0-milestone2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
