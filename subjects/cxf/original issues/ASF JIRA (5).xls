                                            <td class="versions">                        2.5.10,                     2.6.8,                     2.7.5            </td>
                                            <td class="fixVersions">                        2.5.11,                     2.6.9,                     2.7.6            </td>
                                            <td class="components">                        JAX-WS Runtime            </td>
