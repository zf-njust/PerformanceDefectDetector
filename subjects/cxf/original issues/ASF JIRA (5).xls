http://cxf.apache.org/jaxws http://cxf.apache.org/schemas/jaxws.xsd&quot;&gt;<br/>
<br/>
    &lt;import resource=&quot;classpath:META-INF/cxf/cxf.xml&quot; /&gt; <br/>
    &lt;import resource=&quot;classpath:META-INF/cxf/cxf-extension-soap.xml&quot; /&gt;<br/>
    &lt;import resource=&quot;classpath:META-INF/cxf/cxf-servlet.xml&quot; /&gt; <br/>
<br/>
    &lt;jaxws:endpoint id=&quot;orderProcess&quot; implementor=&quot;demo.order.OrderProcessImpl&quot; address=&quot;/OrderProcess&quot; &gt;<br/>
<br/>
      &lt;jaxws:inInterceptors&gt;<br/>
         &lt;bean<br/>
            class=&quot;org.apache.cxf.ws.security.wss4j.WSS4JInInterceptor&quot;&gt;<br/>
            &lt;constructor-arg&gt;<br/>
                &lt;map&gt;<br/>
                  &lt;entry key=&quot;action&quot; value=&quot;UsernameToken&quot;/&gt;<br/>
                  &lt;entry key=&quot;passwordType&quot; value=&quot;PasswordDigest&quot;/&gt;<br/>
                  &lt;entry key=&quot;passwordCallbackRef&quot; value-ref=&quot;myPasswordCallback&quot;/&gt;<br/>
               &lt;/map&gt; <br/>
            &lt;/constructor-arg&gt;<br/>
         &lt;/bean&gt;<br/>
      &lt;/jaxws:inInterceptors&gt;<br/>
      &lt;/jaxws:endpoint&gt;<br/>
      &lt;bean id=&quot;myPasswordCallback&quot; class=&quot;service.ServerPasswordCallback&quot; /&gt;  <br/>
&lt;/beans&gt;<br/>
<br/>
<br/>
<br/>
<br/>
Client xml request Code:<br/>
<br/>
