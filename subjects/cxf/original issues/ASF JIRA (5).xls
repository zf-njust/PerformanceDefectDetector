                <tr id="issuerow12659262" rel="12659262" data-issuekey="CXF-5148" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5148" href="https://issues.apache.org/jira/browse/CXF-5148">CXF-5148</a>
</td>
                                            <td class="summary"><p>
                can&#39;t use property place holder in http:server|http:client with blueprint
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Freeman Fang
    </td>
                                            <td class="creator">            Freeman Fang
    </td>
                                            <td class="created"> 23/Jul/13 06:30 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Dec/13 11:53 </td>
                                            <td class="resolutiondate"> 26/Jul/13 09:14 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.6.10,                     2.7.7,                     3.0.0-milestone1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        CXF-5272,                                                CXF-5440                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      some configuration like<br/>
{code}<br/>
    &lt;cm:property-placeholder persistent-id=&quot;org.apache.servicemix.examples&quot;&gt;<br/>
        &lt;cm:default-properties&gt;<br/>
            &lt;cm:property name=&quot;ReceiveTimeout&quot; value=&quot;1&quot;/&gt;<br/>
            &lt;cm:property name=&quot;contentType&quot; value=&quot;my-content&quot;/&gt;<br/>
        &lt;/cm:default-properties&gt;<br/>
    &lt;/cm:property-placeholder&gt;<br/>
<br/>
    &lt;http-conf:destination<br/>
            name=&quot;*.http-destination&quot;&gt;<br/>
        &lt;http-conf:server ReceiveTimeout=&quot;${ReceiveTimeout}&quot;<br/>
                      ContentType=&quot;${contentType}&quot;/&gt;<br/>
    &lt;/http-conf:destination&gt;<br/>
<br/>
{code}<br/>
<br/>
or <br/>
{code}<br/>
&lt;http:conduit id=&quot;identificationConduit&quot; name=&quot;*&quot;&gt;<br/>
    &lt;http:client ConnectionTimeout=&quot;${connect-timeout}&quot;<br/>
       ReceiveTimeout=&quot;${read-timeout}&quot; /&gt;<br/>
&lt;/http:conduit&gt;<br/>
{code}<br/>
The placeholder here never get replaced.<br/>
<br/>

  </td>
