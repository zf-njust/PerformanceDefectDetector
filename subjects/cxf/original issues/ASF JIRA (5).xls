    <a class="issue-link" data-issue-key="CXF-5946" href="https://issues.apache.org/jira/browse/CXF-5946">CXF-5946</a>
</td>
                                            <td class="summary"><p>
                ensure unregister cxf http transport Servlet OSGi service before we re-register it
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Freeman Fang
    </td>
                                            <td class="reporter">            Freeman Fang
    </td>
                                            <td class="creator">            Freeman Fang
    </td>
                                            <td class="created"> 14/Aug/14 08:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Feb/15 16:09 </td>
                                            <td class="resolutiondate"> 14/Aug/14 08:28 </td>
                                            <td class="versions">                        3.0.1            </td>
                                            <td class="fixVersions">                        3.0.2,                     3.1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
