</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5518" href="https://issues.apache.org/jira/browse/CXF-5518">CXF-5518</a>
</td>
                                            <td class="summary"><p>
                Setting SecurityConstants.STS_TOKEN_ACT_AS as string improper handling
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Colm O hEigeartaigh
    </td>
                                            <td class="reporter">            Rebecca Searls
    </td>
                                            <td class="creator">            Rebecca Searls
    </td>
                                            <td class="created"> 23/Jan/14 21:14 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/14 12:51 </td>
                                            <td class="resolutiondate"> 24/Jan/14 11:59 </td>
                                            <td class="versions">                        3.0.0-milestone1,                     2.7.8            </td>
                                            <td class="fixVersions">                        2.6.12,                     2.7.9,                     3.0.0-milestone2            </td>
                                            <td class="components">                        JAX-RS Security            </td>
                                            <td class="duedate">    &nbsp;
</td>
