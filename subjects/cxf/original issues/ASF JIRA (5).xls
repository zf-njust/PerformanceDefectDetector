                <tr id="issuerow12667446" rel="12667446" data-issuekey="CXF-5257" class="issuerow">
                                            <td class="project">    CXF
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CXF-5257" href="https://issues.apache.org/jira/browse/CXF-5257">CXF-5257</a>
</td>
                                            <td class="summary"><p>
                cxf-rt-transports-jms jms expiration is not set in JMSUtils.setJMSMessageHeaderProperties()
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Daniel Kulp
    </td>
                                            <td class="reporter">            Arturo Medecigo
    </td>
                                            <td class="creator">            Arturo Medecigo
    </td>
                                            <td class="created"> 07/Sep/13 11:37 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Sep/13 18:18 </td>
                                            <td class="resolutiondate"> 09/Sep/13 17:24 </td>
                                            <td class="versions">                        2.3.9,                     2.7.6            </td>
                                            <td class="fixVersions">                        2.6.10,                     2.7.7            </td>
                                            <td class="components">                        Transports            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">14400</td>
                                            <td class="timeestimate">14400</td>
                                            <td class="timespent"></td>
                                            <td class="workratio">            0%
    </td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      CXf client frontends cxf-rt-frontend-jaxws, cxf-rt-transports-jms version 2.7.5
  </td>
                                            <td class="description">      When configuring a JaxWsProxyFactoryBean client with a JMSConduit either programmatically, or via spring configuration, the JMSTimeToLive header property is not set. <br/>
<br/>
<br/>
Java code: <br/>
<br/>
JMSConfiguration jmsConfig =  new JMSConfiguration();			<br/>
JNDIConfiguration jndiConfig = new JNDIConfiguration();<br/>
JndiTemplate jndiTemplate = new JndiTemplate();<br/>
Properties env = new Properties();<br/>
JMSConfigFeature jmsFeature = new JMSConfigFeature();<br/>
List &lt;Feature&gt; featureList= new ArrayList &lt;Feature&gt;();<br/>
<br/>
env.put(Context.PROVIDER_URL, JMS_BROKER_URL);<br/>
env.put(Context.INITIAL_CONTEXT_FACTORY, INITIAL_CONTEXT_FACTORY);<br/>
jndiTemplate.setEnvironment(env);<br/>
jndiConfig.setJndiConnectionFactoryName(CONNECTION_FACTORY_NAME);			<br/>
jndiConfig.setEnvironment(env);		<br/>
jmsConfig.setJndiTemplate(jndiTemplate);<br/>
jmsConfig.setJndiConfig(jndiConfig);<br/>
jmsConfig.setTimeToLive(TIME_TO_LIVE);<br/>
jmsConfig.setTargetDestination(JMS_DESTINATION);<br/>
jmsConfig.setReplyDestination(JMS_REPLY_DESTINATION);			<br/>
jmsFeature.setJmsConfig(jmsConfig);<br/>
<br/>
featureList.add(jmsFeature);			<br/>
proxyFactoryProto.setFeatures(featureList);		<br/>
<br/>
proxyFactoryProto.create();<br/>
<br/>
or via spring:<br/>
<br/>
<br/>
&lt;bean id=&quot;proxyFactoryProto&quot; class=&quot;org.apache.cxf.jaxws.JaxWsProxyFactoryBean&quot;&gt;<br/>
	&lt;property name=&quot;serviceClass&quot; value=&quot;com.myservice.HelloWorld&quot;/&gt;<br/>
	&lt;property name=&quot;transportId&quot; value=&quot;#{T(org.apache.cxf.transport.jms.spec.JMSSpecConstants).SOAP_JMS_SPECIFICATION_TRANSPORTID}&quot;&gt;&lt;/property&gt;<br/>
	<br/>
			<br/>
	&lt;property name=&quot;features&quot;&gt;<br/>
		&lt;list&gt;<br/>
			&lt;ref bean=&quot;jmsConfigFeature&quot;/&gt;<br/>
		&lt;/list&gt;		<br/>
	&lt;/property&gt;<br/>
&lt;/bean&gt;<br/>
		<br/>
<br/>
<br/>
&lt;bean id=&quot;jmsConfigFeature&quot; class=&quot;org.apache.cxf.transport.jms.JMSConfigFeature&quot;&gt;<br/>
	&lt;property name=&quot;jmsConfig&quot; ref=&quot;jmsConfig&quot;/&gt;		<br/>
	<br/>
&lt;/bean&gt;<br/>
<br/>
&lt;bean id=&quot;jmsConfig&quot; class=&quot;org.apache.cxf.transport.jms.JMSConfiguration&quot;&gt;<br/>
	&lt;property name=&quot;connectionFactory&quot; ref=&quot;connectionFactory&quot;/&gt;    	<br/>
	&lt;property name=&quot;timeToLive&quot; value=&quot;5000&quot;/&gt;<br/>
	&lt;property name=&quot;targetDestination&quot; value=&quot;service.hello&quot;/&gt;<br/>
	&lt;property name=&quot;replyDestination&quot; value=&quot;service.hello.reply&quot;/&gt;    	<br/>
&lt;/bean&gt;<br/>
<br/>
<br/>
To fix it simply uncomment the following code at org.apache.cxf.transport.jms.JMSUtils.setJMSMessageHeaderProperties()<br/>
<br/>
//if (messageProperties.isSetTimeToLive()) {<br/>
//	jmsMessage.setJMSExpiration(expiration);<br/>
// }<br/>
<br/>
and fix with:<br/>
<br/>
if (messageProperties.isSetTimeToLive()) {      <br/>
  	    jmsMessage.setJMSExpiration(messageProperties.getJMSExpiration());<br/>
}<br/>

  </td>
                                            <td class="security"></td>
