<cluster>
<group name="root">
<item name="org.apache.ivy.core.settings.IvySettings.addConfigured(ConflictManager)" />
<group name="upper">
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.plugins.conflict.ConflictManager.getName()" />
<item name="org.apache.ivy.core.settings.IvySettings.addConflictManager(String, ConflictManager)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.core.settings.IvySettings.init(Object)" />
</group>
<group name="Layer-3">
<item name="org.apache.ivy.plugins.resolver.DependencyResolver.setSettings(ResolverSettings)" />
<item name="org.apache.ivy.plugins.IvySettingsAware.setSettings(IvySettings)" />
</group>
</group>
</group>
</cluster>
