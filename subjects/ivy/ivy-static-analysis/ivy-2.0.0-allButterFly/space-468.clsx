<cluster>
<group name="root">
<item name="org.apache.ivy.osgi.updatesite.xml.Require.setVersion(Version)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.osgi.updatesite.xml.FeatureParser.ImportHandler.handleAttributes(Attributes)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.osgi.updatesite.xml.Require.setFeature(String)" />
<item name="org.apache.ivy.osgi.updatesite.xml.Require.setMatch(String)" />
<item name="org.apache.ivy.osgi.updatesite.xml.Require.setPlugin(String)" />
<item name="org.apache.ivy.osgi.updatesite.xml.Require.setFilter(String)" />
<item name="org.apache.ivy.osgi.util.Version.Version(String)" />
</group>
</group>
<group name="lower">
</group>
</group>
</cluster>
