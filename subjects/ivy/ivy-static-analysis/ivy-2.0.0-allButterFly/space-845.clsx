</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.resolver.AbstractResolver.getName()" />
<item name="org.apache.ivy.plugins.resolver.JarResolver.getJarRepository()" />
</group>
<group name="Layer-3">
<item name="org.apache.ivy.plugins.resolver.RepositoryResolver.getRepository()" />
</group>
</group>
<group name="lower">
</group>
</group>
</cluster>
