</group>
<group name="Layer-2">
<item name="org.apache.ivy.osgi.core.BundleInfo.addArtifact(BundleArtifact)" />
<item name="org.apache.ivy.osgi.core.BundleArtifact.isSource()" />
<item name="org.apache.ivy.osgi.core.BundleArtifact.getFormat()" />
<item name="org.apache.ivy.osgi.core.BundleInfo.getArtifacts()" />
</group>
</group>
<group name="lower">
</group>
</group>
</cluster>
