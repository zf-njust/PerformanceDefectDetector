<cluster>
<group name="root">
<item name="org.apache.ivy.osgi.util.Version.compareUnqualified(Version)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.osgi.util.VersionRange.contains(Version)" />
<item name="org.apache.ivy.osgi.util.Version.compareTo(Version)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.osgi.util.Version.ensureSplitted()" />
</group>
</group>
</group>
</cluster>
