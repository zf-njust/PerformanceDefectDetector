<cluster>
<group name="root">
<item name="org.apache.ivy.util.StringUtils.decrypt(String)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.util.EncrytedProperties.setProperty(String, String)" />
<item name="org.apache.ivy.util.EncrytedProperties.values()" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.util.StringUtils.encrypt(String)" />
</group>
</group>
<group name="lower">
</group>
</group>
</cluster>
