<cluster>
<group name="root">
<item name="org.apache.ivy.util.ChecksumHelper.compute(File, String)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.util.ChecksumHelper.computeAsString(File, String)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.util.ChecksumHelper.byteArrayToHexString(byte[])" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.util.ChecksumHelper.getMessageDigest(String)" />
</group>
</group>
</group>
</cluster>
