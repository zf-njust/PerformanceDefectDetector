<item name="org.apache.ivy.core.cache.ParserSettingsMonitor.(Anon_1).substitute(String)" />
<item name="org.apache.ivy.plugins.resolver.AbstractResolver.ResolverParserSettings.substitute(String)" />
<item name="org.apache.ivy.core.cache.DefaultResolutionCacheManager.CacheParserSettings.substitute(String)" />
<item name="org.apache.ivy.plugins.parser.xml.XmlModuleDescriptorUpdater.UpdaterHandler.substitute(ParserSettings, String)" />
<item name="org.apache.ivy.plugins.parser.xml.XmlModuleDescriptorParser.Parser.getPatternMatcher(String)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.parser.ParserSettings.getMatcher(String)" />
<item name="org.apache.ivy.util.XMLHelper.escape(String)" />
<item name="org.apache.ivy.util.Message.debug(String)" />
<item name="org.apache.ivy.plugins.resolver.AbstractResolver.getSettings()" />
</group>
<group name="Layer-3">
<item name="org.apache.ivy.util.Message.getLogger()" />
<item name="org.apache.ivy.util.MessageLogger.debug(String)" />
</group>
<group name="Layer-4">
<item name="org.apache.ivy.core.IvyContext.getMessageLogger()" />
<item name="org.apache.ivy.core.IvyContext.getContext()" />
</group>
<group name="Layer-5">
