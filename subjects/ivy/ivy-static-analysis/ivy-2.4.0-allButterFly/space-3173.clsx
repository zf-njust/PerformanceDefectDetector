<cluster>
<group name="root">
<item name="org.apache.ivy.osgi.filter.OSGiFilter.eval(Map)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.osgi.filter.OrFilter.eval(Map)" />
<item name="org.apache.ivy.osgi.filter.AndFilter.eval(Map)" />
<item name="org.apache.ivy.osgi.filter.NotFilter.eval(Map)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.osgi.filter.UniOperatorFilter.getSubFilter()" />
<item name="org.apache.ivy.osgi.filter.MultiOperatorFilter.getSubFilters()" />
</group>
</group>
<group name="lower">
</group>
</group>
</cluster>
