<cluster>
<group name="root">
<item name="org.apache.ivy.osgi.core.ManifestParser.parseManifest(File)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.ant.IvyCachePath.addToPath(Path, File)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.osgi.core.BundleInfo.getClasspath()" />
</group>
</group>
<group name="lower">
</group>
</group>
</cluster>
