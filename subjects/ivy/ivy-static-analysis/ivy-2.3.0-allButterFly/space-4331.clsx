<cluster>
<group name="root">
<item name="org.apache.ivy.core.settings.IvySettings.addConfigured(CircularDependencyStrategy)" />
<group name="upper">
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.core.settings.IvySettings.addCircularDependencyStrategy(CircularDependencyStrategy)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.circular.CircularDependencyStrategy.getName()" />
</group>
</group>
</group>
</cluster>
