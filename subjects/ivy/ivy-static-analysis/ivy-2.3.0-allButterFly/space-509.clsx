<cluster>
<group name="root">
<item name="org.apache.ivy.plugins.resolver.ChainResolver.getLatestStrategyName(DependencyResolver)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.plugins.resolver.ChainResolver.setLatestIfRequired(DependencyResolver, LatestStrategy)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.resolver.ChainResolver.setLatest(DependencyResolver, LatestStrategy)" />
<item name="org.apache.ivy.plugins.resolver.ChainResolver.getLatest(DependencyResolver)" />
</group>
<group name="Layer-3">
<item name="org.apache.ivy.plugins.resolver.util.HasLatestStrategy.setLatestStrategy(LatestStrategy)" />
<item name="org.apache.ivy.plugins.resolver.util.HasLatestStrategy.getLatestStrategy()" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.plugins.resolver.util.HasLatestStrategy.getLatest()" />
</group>
</group>
</group>
</cluster>
