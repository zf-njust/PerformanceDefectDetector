<cluster>
<group name="root">
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.parse(URI, InputStream)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.osgi.obr.OBRResolver.loadRepoFromFile(URI, File, String)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.resolver.AbstractResolver.getName()" />
<item name="org.apache.ivy.osgi.repo.AbstractOSGiResolver.setRepoDescriptor(RepoDescriptor)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.RepositoryHandler.RepositoryHandler(URI)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.osgi.util.DelegetingHandler.addChild(DelegetingHandler, ChildElementHandler)" />
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.ResourceHandler.ResourceHandler()" />
<item name="org.apache.ivy.osgi.util.DelegetingHandler.DelegetingHandler(String)" />
</group>
<group name="Layer-3">
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.ResourceLicenseHandler.ResourceLicenseHandler()" />
<item name="org.apache.ivy.osgi.util.DelegetingHandler.setSkipOnError(boolean)" />
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.ResourceDocumentationHandler.ResourceDocumentationHandler()" />
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.CapabilityHandler.CapabilityHandler()" />
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.RequireHandler.RequireHandler()" />
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.ResourceDescriptionHandler.ResourceDescriptionHandler()" />
<item name="org.apache.ivy.osgi.util.DelegetingHandler.getName()" />
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.ResourceSizeHandler.ResourceSizeHandler()" />
</group>
<group name="Layer-4">
<item name="org.apache.ivy.osgi.util.DelegetingHandler.setBufferingChar(boolean)" />
<item name="org.apache.ivy.osgi.obr.xml.OBRXMLParser.CapabilityPropertyHandler.CapabilityPropertyHandler()" />
</group>
</group>
</group>
</cluster>
