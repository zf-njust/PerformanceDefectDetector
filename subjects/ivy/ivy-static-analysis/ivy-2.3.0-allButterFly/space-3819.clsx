<cluster>
<group name="root">
<item name="org.apache.ivy.core.settings.IvySettings.addSignatureGenerator(SignatureGenerator)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.core.settings.IvySettings.addConfigured(SignatureGenerator)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.core.settings.IvySettings.init(Object)" />
<item name="org.apache.ivy.plugins.signer.SignatureGenerator.getName()" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.resolver.DependencyResolver.setSettings(ResolverSettings)" />
<item name="org.apache.ivy.plugins.IvySettingsAware.setSettings(IvySettings)" />
</group>
</group>
</group>
</cluster>
