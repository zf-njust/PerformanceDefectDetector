<cluster>
<group name="root">
<item name="org.apache.ivy.util.XMLHelper.toSystemId(URL)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.plugins.parser.m2.PomReader.PomReader(URL, Resource)" />
<item name="org.apache.ivy.util.XMLHelper.parse(URL, URL, DefaultHandler, LexicalHandler)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.parser.m2.PomReader.getFirstChildElement(Element, String)" />
<item name="org.apache.ivy.util.XMLHelper.parse(InputSource, URL, DefaultHandler, LexicalHandler)" />
<item name="org.apache.ivy.plugins.repository.Resource.getName()" />
<item name="org.apache.ivy.util.url.URLHandlerRegistry.getDefault()" />
<item name="org.apache.ivy.util.url.URLHandler.openStream(URL)" />
<item name="org.apache.ivy.plugins.parser.m2.PomReader.AddDTDFilterInputStream.AddDTDFilterInputStream(InputStream)" />
<item name="org.apache.ivy.util.XMLHelper.parseToDom(InputSource, EntityResolver)" />
</group>
<group name="Layer-3">
<item name="org.apache.ivy.util.XMLHelper.getDocBuilder(EntityResolver)" />
<item name="org.apache.ivy.util.XMLHelper.newSAXParser(URL, InputStream)" />
</group>
</group>
<group name="lower">
</group>
</group>
</cluster>
