<cluster>
<group name="root">
<item name="org.apache.ivy.core.IvyPatternHelper.substituteParams(String, Map)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.util.Configurator.MacroDef.replaceParam(String, Map)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.core.IvyPatternHelper.substituteParams(String, IvyVariableContainer, Stack)" />
<item name="org.apache.ivy.core.settings.IvyVariableContainerImpl.IvyVariableContainerImpl(Map)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.core.IvyPatternHelper.substituteVariables(String, IvyVariableContainer, Stack)" />
<item name="org.apache.ivy.core.settings.IvyVariableContainer.getVariable(String)" />
</group>
</group>
</group>
</cluster>
