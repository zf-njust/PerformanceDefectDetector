<cluster>
<group name="root">
<item name="org.apache.ivy.core.settings.IvySettings.validate()" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.core.settings.XmlSettingsParser.doParse(URL)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.util.url.URLHandlerRegistry.getDefault()" />
<item name="org.apache.ivy.util.url.URLHandler.openStream(URL)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.core.settings.IvySettings.validateAll(Collection)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.core.settings.Validatable.validate()" />
</group>
</group>
</group>
</cluster>
