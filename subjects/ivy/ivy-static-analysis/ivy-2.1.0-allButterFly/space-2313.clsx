<cluster>
<group name="root">
<item name="org.apache.ivy.plugins.resolver.RepositoryResolver.setName(String)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.plugins.resolver.CacheResolver.CacheResolver(ResolverSettings)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.resolver.RepositoryResolver.setSettings(ResolverSettings)" />
</group>
<group name="Layer-3">
<item name="org.apache.ivy.plugins.resolver.ResolverSettings.getVariable(String)" />
<item name="org.apache.ivy.plugins.resolver.AbstractResolver.setSettings(ResolverSettings)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.plugins.repository.AbstractRepository.setName(String)" />
<item name="org.apache.ivy.plugins.resolver.AbstractResolver.setName(String)" />
</group>
</group>
</group>
</cluster>
