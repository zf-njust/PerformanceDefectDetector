<cluster>
<group name="root">
<item name="org.apache.ivy.util.Checks.checkAbsolute(File, String)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.plugins.repository.file.FileRepository.setBaseDir(File)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.util.Checks.checkNotNull(Object, String)" />
</group>
</group>
</group>
</cluster>
