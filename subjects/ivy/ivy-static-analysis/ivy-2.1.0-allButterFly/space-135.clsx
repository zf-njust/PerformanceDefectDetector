<cluster>
<group name="root">
<item name="org.apache.ivy.core.IvyContext.getMessageLogger()" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.util.Message.getLogger()" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.core.IvyContext.getContext()" />
</group>
<group name="Layer-3">
<item name="org.apache.ivy.core.IvyContext.getCurrentStack()" />
<item name="org.apache.ivy.core.IvyContext.IvyContext()" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.util.Message.getDefaultLogger()" />
<item name="org.apache.ivy.Ivy.getLoggerEngine()" />
<item name="org.apache.ivy.core.IvyContext.peekIvy()" />
</group>
</group>
</group>
</cluster>
