<cluster>
<group name="root">
<item name="org.apache.ivy.core.settings.IvySettings.addResolver(DependencyResolver)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.core.settings.IvySettings.addConfigured(DependencyResolver)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.ivy.plugins.resolver.DualResolver.getArtifactResolver()" />
<item name="org.apache.ivy.core.settings.IvySettings.init(Object)" />
<item name="org.apache.ivy.plugins.resolver.ChainResolver.getResolvers()" />
<item name="org.apache.ivy.plugins.resolver.DependencyResolver.getName()" />
<item name="org.apache.ivy.plugins.resolver.DualResolver.getIvyResolver()" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.resolver.DependencyResolver.setSettings(ResolverSettings)" />
<item name="org.apache.ivy.plugins.IvySettingsAware.setSettings(IvySettings)" />
</group>
</group>
</group>
</cluster>
