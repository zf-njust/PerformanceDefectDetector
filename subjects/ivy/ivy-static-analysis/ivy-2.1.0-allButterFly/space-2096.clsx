<cluster>
<group name="root">
<item name="org.apache.ivy.plugins.resolver.ResolverSettings.configureRepositories(boolean)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.ivy.plugins.resolver.IvyRepResolver.ensureIvyConfigured(ResolverSettings)" />
<item name="org.apache.ivy.plugins.resolver.IvyRepResolver.ensureArtifactConfigured(ResolverSettings)" />
<item name="org.apache.ivy.plugins.resolver.IBiblioResolver.ensureConfigured(ResolverSettings)" />
</group>
<group name="Layer-2">
<item name="org.apache.ivy.plugins.resolver.ResolverSettings.getVariable(String)" />
<item name="org.apache.ivy.plugins.resolver.IvyRepResolver.updateWholeIvyPattern()" />
<item name="org.apache.ivy.plugins.resolver.IBiblioResolver.updateWholePattern()" />
<item name="org.apache.ivy.plugins.resolver.IvyRepResolver.updateWholeArtPattern()" />
</group>
<group name="Layer-3">
<item name="org.apache.ivy.plugins.resolver.IBiblioResolver.getWholePattern()" />
<item name="org.apache.ivy.plugins.resolver.AbstractPatternsBasedResolver.isM2compatible()" />
<item name="org.apache.ivy.plugins.resolver.IvyRepResolver.getWholeArtPattern()" />
<item name="org.apache.ivy.plugins.resolver.AbstractPatternsBasedResolver.setArtifactPatterns(List)" />
<item name="org.apache.ivy.plugins.resolver.IBiblioResolver.isUsepoms()" />
<item name="org.apache.ivy.plugins.resolver.AbstractPatternsBasedResolver.setIvyPatterns(List)" />
<item name="org.apache.ivy.plugins.resolver.IvyRepResolver.getWholeIvyPattern()" />
</group>
</group>
<group name="lower">
</group>
</group>
</cluster>
