</td>
                                            <td class="summary"><p>
                Ivy License Column not populating
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Kevin Gann
    </td>
                                            <td class="creator">            Kevin Gann
    </td>
                                            <td class="created"> 04/Mar/09 14:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Oct/09 21:55 </td>
