                                            <td class="resolutiondate"> 18/Dec/13 16:06 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.4.0-RC1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">2</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
