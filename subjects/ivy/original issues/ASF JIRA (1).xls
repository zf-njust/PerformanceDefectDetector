    <a class="issue-link" data-issue-key="IVY-1254" href="https://issues.apache.org/jira/browse/IVY-1254">IVY-1254</a>
</td>
                                            <td class="summary"><p>
                Cannot resolve maven2 transitive dependency from child that has parent with two dependency management scopes
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
