                                            <td class="summary"><p>
                NullPointerException thrown when calling buildnumber task
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
