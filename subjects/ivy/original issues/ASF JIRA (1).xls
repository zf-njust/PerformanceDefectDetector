		&lt;conf name=&quot;dists&quot; visibility=&quot;public&quot;/&gt;<br/>
		&lt;conf name=&quot;runtime&quot; visibility=&quot;private&quot; description=&quot;Classpath for running the compiled sources.&quot; extends=&quot;compile&quot;/&gt;<br/>
		&lt;conf name=&quot;testCompile&quot; visibility=&quot;private&quot; description=&quot;Classpath for compiling the test sources.&quot; extends=&quot;compile&quot;/&gt;<br/>
		&lt;conf name=&quot;testRuntime&quot; visibility=&quot;private&quot; description=&quot;Classpath for running the test sources.&quot; extends=&quot;runtime,testCompile&quot;/&gt;<br/>
