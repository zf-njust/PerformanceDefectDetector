                                            <td class="summary"><p>
                Ivy reports a bogus unresolved dependency
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Archie Cobbs
    </td>
                                            <td class="creator">            Archie Cobbs
    </td>
                                            <td class="created"> 22/Sep/10 20:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Jul/12 22:48 </td>
