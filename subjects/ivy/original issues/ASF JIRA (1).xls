    <a class="issue-link" data-issue-key="IVY-1437" href="https://issues.apache.org/jira/browse/IVY-1437">IVY-1437</a>
</td>
                                            <td class="summary"><p>
                defaultconfmapping not inherited
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Marcin Wisnicki
    </td>
                                            <td class="creator">            Marcin Wisnicki
    </td>
                                            <td class="created"> 29/Aug/13 16:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Aug/13 17:59 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.3.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
