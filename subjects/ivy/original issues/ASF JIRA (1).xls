    <a class="issue-link" data-issue-key="IVY-1303" href="https://issues.apache.org/jira/browse/IVY-1303">IVY-1303</a>
</td>
                                            <td class="summary"><p>
                ParseException when a dependency follows a global exclude in ivy.xml
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Chris Birchall
    </td>
                                            <td class="creator">            Chris Birchall
    </td>
                                            <td class="created"> 16/Jun/11 05:14 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Aug/13 14:22 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.1.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
