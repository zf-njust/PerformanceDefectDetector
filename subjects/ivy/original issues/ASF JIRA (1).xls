                <tr id="issuerow12415171" rel="12415171" data-issuekey="IVY-1031" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1031" href="https://issues.apache.org/jira/browse/IVY-1031">IVY-1031</a>
</td>
                                            <td class="summary"><p>
                Support for Web Proxy exclusions
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
