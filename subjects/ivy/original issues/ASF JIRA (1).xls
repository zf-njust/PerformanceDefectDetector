                <tr id="issuerow12596075" rel="12596075" data-issuekey="IVY-1360" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1360" href="https://issues.apache.org/jira/browse/IVY-1360">IVY-1360</a>
</td>
                                            <td class="summary"><p>
                NPE when using the updatesite resolver
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Christopher Frost
    </td>
                                            <td class="creator">            Christopher Frost
    </td>
                                            <td class="created"> 27/Jun/12 12:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Aug/12 22:25 </td>
                                            <td class="resolutiondate"> 19/Aug/12 22:25 </td>
                                            <td class="versions">                        2.3.0-RC1            </td>
                                            <td class="fixVersions">                        2.3.0-RC2            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
