</td>
                                            <td class="summary"><p>
                ApacheURLLister does not allow directories not containing a dot
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
