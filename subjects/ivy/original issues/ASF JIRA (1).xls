                <tr id="issuerow12668017" rel="12668017" data-issuekey="IVY-1439" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1439" href="https://issues.apache.org/jira/browse/IVY-1439">IVY-1439</a>
</td>
                                            <td class="summary"><p>
                ivy:retrieve with symlinkmass=&quot;true&quot; and sync=&quot;true&quot; deletes all retrieved links
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Tim Whittington
    </td>
                                            <td class="creator">            Tim Whittington
    </td>
                                            <td class="created"> 11/Sep/13 10:08 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Sep/13 10:08 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        master            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
