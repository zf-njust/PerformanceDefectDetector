                <tr id="issuerow12608952" rel="12608952" data-issuekey="IVY-1377" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1377" href="https://issues.apache.org/jira/browse/IVY-1377">IVY-1377</a>
</td>
                                            <td class="summary"><p>
                Resolution fails with zero-length file content
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Stephen Kestle
    </td>
                                            <td class="creator">            Stephen Kestle
    </td>
                                            <td class="created"> 25/Sep/12 00:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Sep/12 00:42 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0,                     2.3.0-RC2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
