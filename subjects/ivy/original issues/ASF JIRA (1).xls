                <tr id="issuerow12676863" rel="12676863" data-issuekey="IVY-1449" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1449" href="https://issues.apache.org/jira/browse/IVY-1449">IVY-1449</a>
</td>
                                            <td class="summary"><p>
                Ivy doesn&#39;t actually delete files during syncing on Windows
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Dejan Ćebetarević
    </td>
                                            <td class="creator">            Dejan Ćebetarević
    </td>
                                            <td class="created"> 31/Oct/13 14:37 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Oct/13 14:41 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.3.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
