    <a class="issue-link" data-issue-key="IVY-1023" href="https://issues.apache.org/jira/browse/IVY-1023">IVY-1023</a>
</td>
                                            <td class="summary"><p>
                Report does not deliver ivy-report.css when xsl transformation is specified
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
