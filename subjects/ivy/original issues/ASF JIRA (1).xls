                <tr id="issuerow12606074" rel="12606074" data-issuekey="IVY-1376" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1376" href="https://issues.apache.org/jira/browse/IVY-1376">IVY-1376</a>
</td>
                                            <td class="summary"><p>
                IVY erratic behavior
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Edgardo Vega
    </td>
                                            <td class="creator">            Edgardo Vega
    </td>
                                            <td class="created"> 04/Sep/12 13:08 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Dec/12 22:19 </td>
                                            <td class="resolutiondate"> 10/Dec/12 21:00 </td>
                                            <td class="versions">                        2.3.0-RC1            </td>
                                            <td class="fixVersions">                        2.3.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        IVY-1390,                                                IVY-1394                        </td>
                                            <td class="environment">      Windows 7 
  </td>
                                            <td class="description">      <br/>
Using the following, we get erratic mixes of failure and success.<br/>
<br/>
$ cat build.xml<br/>
&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;no&quot;?&gt;<br/>
&lt;project name=&quot;project&quot; basedir=&quot;.&quot; default=&quot;build&quot;<br/>
    xmlns:tomcat=&quot;antlib:org.apache.catalina.ant&quot; xmlns:ivy=&quot;antlib:org.apache.ivy.ant&quot;&gt;<br/>
<br/>
    &lt;!-- IVY stuff: used initially to fetch 3rd party jars --&gt;<br/>
    &lt;!-- Pull in ivy tasks from either ANT library or local jar --&gt;<br/>
    &lt;path id=&quot;ivy.lib.path&quot;&gt;<br/>
        &lt;fileset dir=&quot;${libdir}&quot; includes=&quot;ivy*.jar&quot; /&gt;<br/>
    &lt;/path&gt;<br/>
    &lt;taskdef resource=&quot;org/apache/ivy/ant/antlib.xml&quot; uri=&quot;antlib:org.apache.ivy.ant&quot;<br/>
        classpathref=&quot;ivy.lib.path&quot; /&gt;<br/>
    &lt;!-- ivy: get 3rd party jars --&gt;<br/>
    &lt;target name=&quot;ivy&quot; description=&quot;get 3rd party jars via ivy&quot;&gt;<br/>
        &lt;ivy:configure /&gt;<br/>
        &lt;ivy:resolve file=&quot;ivy.xml&quot; /&gt;<br/>
        &lt;ivy:retrieve<br/>
            pattern=&quot;${warlibdir}/[artifact]-[revision](-[classifier]).[ext]&quot; /&gt;<br/>
    &lt;/target&gt;<br/>
<br/>
    &lt;!-- ivy-cleancache: delete the host cache --&gt;<br/>
    &lt;target name=&quot;ivy-cleancache&quot; description=&quot;delete host cache&quot;&gt;<br/>
        &lt;ivy:cleancache /&gt;<br/>
    &lt;/target&gt;<br/>
&lt;/project&gt;<br/>
<br/>
$ cat ivy.xml<br/>
&lt;ivy-module version=&quot;2.0&quot;&gt;<br/>
        &lt;info organisation=&quot;com.usorg&quot; module=&quot;hello-ivy&quot; /&gt;<br/>
        &lt;dependencies&gt;<br/>
<br/>
                &lt;!-- Logging items --&gt;<br/>
                &lt;dependency org=&quot;org.slf4j&quot; name=&quot;slf4j-log4j12&quot; rev=&quot;1.6.6&quot; /&gt;<br/>
<br/>
                &lt;!-- JAX-RS items --&gt;<br/>
                &lt;dependency org=&quot;com.sun.jersey&quot; name=&quot;jersey-bundle&quot; rev=&quot;1.13&quot; /&gt;<br/>
<br/>
<br/>
                &lt;override org=&quot;org.jboss.weld&quot; module=&quot;weld-api&quot; rev=&quot;1.1.Final&quot; /&gt;<br/>
                &lt;override org=&quot;org.jboss.weld&quot; module=&quot;weld-spi&quot; rev=&quot;1.1.Final&quot; /&gt;<br/>
<br/>
        &lt;/dependencies&gt;<br/>
&lt;/ivy-module&gt;<br/>
<br/>
<br/>
cat ivysettings.xml<br/>
&lt;ivysettings&gt;<br/>
        &lt;property name=&quot;interceptor.api.version&quot; value=&quot;1.0.1.Final&quot; /&gt;<br/>
        &lt;property name=&quot;jsr250.api.version&quot; value=&quot;1.0&quot; /&gt;<br/>
        &lt;property name=&quot;atinject.api.version&quot; value=&quot;1&quot; /&gt;<br/>
<br/>
        &lt;settings defaultResolver=&quot;jaxws-chain&quot; /&gt;<br/>
        &lt;resolvers&gt;<br/>
                &lt;chain name=&quot;jaxws-chain&quot; returnFirst=&quot;true&quot;&gt;<br/>
                        &lt;ibiblio name=&quot;maven&quot; root=&quot;http://mvnrepository.com/artifact/&quot;<br/>
                                m2compatible=&quot;true&quot; /&gt;<br/>
                        &lt;ibiblio name=&quot;ibiblio-maven2&quot; m2compatible=&quot;true&quot; /&gt;<br/>
                        &lt;ibiblio name=&quot;java-net-maven2&quot; root=&quot;http://download.java.net/maven/2/&quot;<br/>
                                m2compatible=&quot;true&quot; /&gt;<br/>
                        &lt;ibiblio name=&quot;eclipse&quot; m2compatible=&quot;true&quot;<br/>
                                root=&quot;http://download.eclipse.org/rt/eclipselink/maven.repo/&quot; /&gt;<br/>
                        &lt;ibiblio name=&quot;java-net&quot; m2compatible=&quot;true&quot; usepoms=&quot;true&quot;<br/>
                                pattern=&quot;[organisation]/[module]/[revision]/[artifact]-[revision](-[classifier]).[ext]&quot;<br/>
                                root=&quot;http://download.java.net/maven/2&quot; /&gt;<br/>
                        &lt;ibiblio name=&quot;maven2&quot; m2compatible=&quot;true&quot; /&gt;<br/>
                        &lt;ibiblio name=&quot;central&quot; m2compatible=&quot;true&quot; /&gt;<br/>
                &lt;/chain&gt;<br/>
        &lt;/resolvers&gt;<br/>
&lt;/ivysettings&gt;<br/>
<br/>
$ ant ivy<br/>
Buildfile: C:\Users\evega\workspace\project\build.xml<br/>
<br/>
ivy:<br/>
[ivy:configure] :: Apache Ivy 2.3.0-rc1 - 20120416000235 :: http://ant.apache.org/ivy/ ::<br/>
