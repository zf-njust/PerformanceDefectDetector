    <a class="issue-link" data-issue-key="IVY-1339" href="https://issues.apache.org/jira/browse/IVY-1339">IVY-1339</a>
</td>
                                            <td class="summary"><p>
                LatestCompatibleConflictManager exception on conflict
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Sven Zethelius
    </td>
                                            <td class="creator">            Sven Zethelius
    </td>
                                            <td class="created"> 20/Mar/12 20:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Mar/12 21:18 </td>
                                            <td class="resolutiondate"> 21/Mar/12 21:18 </td>
                                            <td class="versions">                        2.2.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
