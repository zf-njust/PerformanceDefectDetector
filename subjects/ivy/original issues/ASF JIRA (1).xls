    <a class="issue-link" data-issue-key="IVY-1502" href="https://issues.apache.org/jira/browse/IVY-1502">IVY-1502</a>
</td>
                                            <td class="summary"><p>
                 Be a nice freedesktop citizen, move the ~/.ivy to the appropriate location 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            PerfectCarl
    </td>
                                            <td class="creator">            PerfectCarl
    </td>
                                            <td class="created"> 02/Dec/14 13:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/Dec/14 13:34 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.3.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
