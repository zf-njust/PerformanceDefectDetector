    </td>
                                            <td class="creator">            Alexey Kuznetsov
    </td>
                                            <td class="created"> 09/Sep/10 13:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Sep/10 15:34 </td>
                                            <td class="resolutiondate"> 09/Sep/10 15:34 </td>
                                            <td class="versions">                        2.1.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
