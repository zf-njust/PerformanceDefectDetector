                <tr id="issuerow12416050" rel="12416050" data-issuekey="IVY-1039" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1039" href="https://issues.apache.org/jira/browse/IVY-1039">IVY-1039</a>
</td>
                                            <td class="summary"><p>
                Ivy fails to cache something, m2 resolver
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Stepan Koltsov
    </td>
                                            <td class="creator">            Stepan Koltsov
    </td>
                                            <td class="created"> 04/Mar/09 01:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Mar/09 22:23 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Something wrong. Ivy downloads something from network on each run. So compilation always very long.<br/>
<br/>
ivy.xml:<br/>
<br/>
{code}<br/>
&lt;ivy-module version=&quot;2.0&quot;&gt;<br/>
    &lt;info revision=&quot;0.2&quot; organisation=&quot;ru.yandex&quot; module=&quot;mysql-diff&quot;/&gt;<br/>
    <br/>
    &lt;dependencies&gt;<br/>
        &lt;dependency org=&quot;org.scalaforge&quot; name=&quot;scalax&quot; rev=&quot;0.1&quot;/&gt;<br/>
    &lt;/dependencies&gt;<br/>
        <br/>
&lt;/ivy-module&gt;<br/>
{code}<br/>
<br/>
ivysettings.xml:<br/>
<br/>
{code}<br/>
&lt;ivysettings&gt;<br/>
    &lt;settings defaultResolver=&quot;default&quot;/&gt;<br/>
    <br/>
    &lt;resolvers&gt;<br/>
        &lt;chain name=&quot;default&quot;&gt;<br/>
            &lt;ibiblio name=&quot;scala-tools&quot; root=&quot;http://scala-tools.org/repo-releases/&quot; m2compatible=&quot;true&quot;/&gt;<br/>
        &lt;/chain&gt;<br/>
    &lt;/resolvers&gt;<br/>
&lt;/ivysettings&gt;<br/>
{code}<br/>
<br/>
build.xml:<br/>
<br/>
{code}<br/>
&lt;project name=&quot;mysqlDiff&quot; default=&quot;dist&quot; xmlns:ivy=&quot;antlib:org.apache.ivy.ant&quot;&gt;<br/>
    <br/>
    &lt;property name=&quot;ivy.version&quot; value=&quot;2.0.0&quot;/&gt;<br/>
    <br/>
    &lt;available property=&quot;ivy.available&quot; file=&quot;lib/ivy/ivy-${ivy.version}.jar&quot;/&gt;<br/>
    &lt;target name=&quot;download-ivy&quot; unless=&quot;ivy.available&quot;&gt;<br/>
        &lt;delete dir=&quot;lib/ivy&quot;/&gt;<br/>
        &lt;mkdir dir=&quot;lib/ivy&quot;/&gt;<br/>
        <br/>
        &lt;echo&gt;Downloading ivy&lt;/echo&gt;<br/>
        <br/>
        &lt;get src=&quot;http://repo1.maven.org/maven2/org/apache/ivy/ivy/${ivy.version}/ivy-${ivy.version}.jar&quot;<br/>
                dest=&quot;lib/ivy/ivy-${ivy.version}.jar&quot;/&gt;<br/>
    &lt;/target&gt;<br/>
    <br/>
    &lt;target name=&quot;resolve&quot; depends=&quot;download-ivy&quot;&gt;<br/>
        &lt;taskdef resource=&quot;org/apache/ivy/ant/antlib.xml&quot;<br/>
                uri=&quot;antlib:org.apache.ivy.ant&quot;&gt;<br/>
            &lt;classpath&gt;<br/>
                &lt;fileset dir=&quot;lib/ivy&quot; includes=&quot;*.jar&quot;/&gt;<br/>
            &lt;/classpath&gt;<br/>
        &lt;/taskdef&gt;<br/>
        <br/>
        &lt;ivy:retrieve pattern=&quot;lib/dep/[organisation]-[artifact]-[revision].[ext]&quot; sync=&quot;true&quot; type=&quot;jar&quot;/&gt;<br/>
    &lt;/target&gt;<br/>
    <br/>
&lt;/project&gt;<br/>
{code}
  </td>
