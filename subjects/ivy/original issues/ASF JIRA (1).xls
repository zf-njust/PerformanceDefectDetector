                <tr id="issuerow12436169" rel="12436169" data-issuekey="IVY-1127" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1127" href="https://issues.apache.org/jira/browse/IVY-1127">IVY-1127</a>
</td>
                                            <td class="summary"><p>
                branch field of dependencies is null after doing programmatic parsing of a module descriptor
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
