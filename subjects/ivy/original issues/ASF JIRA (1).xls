                <tr id="issuerow12412704" rel="12412704" data-issuekey="IVY-1008" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1008" href="https://issues.apache.org/jira/browse/IVY-1008">IVY-1008</a>
</td>
                                            <td class="summary"><p>
                overwrite=&quot;false&quot; does *not* prevent a url resolver from publishing
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Jing Xue
    </td>
                                            <td class="creator">            Jing Xue
    </td>
                                            <td class="created"> 18/Jan/09 16:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/09 22:29 </td>
                                            <td class="resolutiondate"> 04/Feb/09 21:17 </td>
                                            <td class="versions">                        2.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Somewhat ironic (in contrast to IVY-1007), once I commented out the code throwing exception in URLRepository.put(), I&#39;m able to publish even when the pubrevision specified already exists, and when I set overwrite=&quot;false&quot; on the publish task.
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
