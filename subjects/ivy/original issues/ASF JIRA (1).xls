                <tr id="issuerow12617114" rel="12617114" data-issuekey="IVY-1389" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1389" href="https://issues.apache.org/jira/browse/IVY-1389">IVY-1389</a>
</td>
                                            <td class="summary"><p>
                Missing artifacts on double (all direct and specific artifact by way of transitive) dependency to lib
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Janelle Dahling
    </td>
                                            <td class="creator">            Janelle Dahling
    </td>
                                            <td class="created"> 21/Nov/12 15:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
