</td>
                                            <td class="summary"><p>
                Ivy pattern with optional extra attribute is not resolved correctly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Michael Scheetz
    </td>
                                            <td class="creator">            Michael Scheetz
    </td>
                                            <td class="created"> 10/Sep/09 20:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Jan/10 22:41 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.1.0-RC2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
