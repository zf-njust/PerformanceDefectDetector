    <a class="issue-link" data-issue-key="IVY-1402" href="https://issues.apache.org/jira/browse/IVY-1402">IVY-1402</a>
</td>
                                            <td class="summary"><p>
                http authentication is disabled
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Kelly Schoenhofen
    </td>
                                            <td class="creator">            Kelly Schoenhofen
    </td>
                                            <td class="created"> 31/Jan/13 15:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Jan/13 16:11 </td>
                                            <td class="resolutiondate"> 31/Jan/13 16:11 </td>
                                            <td class="versions">                        2.3.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Ant            </td>
                                            <td class="duedate">    &nbsp;
