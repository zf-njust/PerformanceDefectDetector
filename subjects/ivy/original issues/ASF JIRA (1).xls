    <a class="issue-link" data-issue-key="IVY-1341" href="https://issues.apache.org/jira/browse/IVY-1341">IVY-1341</a>
</td>
                                            <td class="summary"><p>
                Ivy - ivy.xml with duplicate child element
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
