    <a class="issue-link" data-issue-key="IVY-1269" href="https://issues.apache.org/jira/browse/IVY-1269">IVY-1269</a>
</td>
                                            <td class="summary"><p>
                quiet=&quot;true&quot; does not surpress download &#39;dots&#39; on packager resolver
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Jonathan Williams
    </td>
                                            <td class="creator">            Jonathan Williams
    </td>
                                            <td class="created"> 14/Feb/11 23:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Mar/11 23:21 </td>
                                            <td class="resolutiondate"> 16/Feb/11 23:21 </td>
                                            <td class="versions">                        2.2.0            </td>
                                            <td class="fixVersions">                        2.3.0-RC1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
