                <tr id="issuerow12445162" rel="12445162" data-issuekey="IVY-1160" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1160" href="https://issues.apache.org/jira/browse/IVY-1160">IVY-1160</a>
</td>
                                            <td class="summary"><p>
                Add command line support for installing projects from one repository to another. 
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ignacio de Lucas Rodrigo
    </td>
