                <tr id="issuerow12716748" rel="12716748" data-issuekey="IVY-1474" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1474" href="https://issues.apache.org/jira/browse/IVY-1474">IVY-1474</a>
</td>
                                            <td class="summary"><p>
                Ivy Bintray resolver
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Nicolas Lalevée
    </td>
                                            <td class="reporter">            Evgeny Goldin
    </td>
                                            <td class="creator">            Evgeny Goldin
    </td>
                                            <td class="created"> 27/May/14 08:14 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/Dec/14 02:16 </td>
                                            <td class="resolutiondate"> 13/Dec/14 15:50 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.4.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      This patch add an Ivy Bintray resolver which can the be used as follows:<br/>
<br/>
{code}<br/>
&lt;ivysettings&gt;<br/>
  &lt;settings defaultResolver=&quot;chain&quot;/&gt;<br/>
  &lt;resolvers&gt;<br/>
    &lt;chain name=&quot;chain&quot;&gt;<br/>
      &lt;!-- http://dl.bintray.com/jfrog/jfrog-jars/ --&gt;<br/>
      &lt;bintray subject=&quot;jfrog&quot; repo=&quot;jfrog-jars&quot;/&gt;<br/>
      &lt;!-- http://jcenter.bintray.com/ --&gt;<br/>
      &lt;bintray /&gt;<br/>
    &lt;/chain&gt;<br/>
  &lt;/resolvers&gt;<br/>
&lt;/ivysettings&gt;<br/>
{code}<br/>
<br/>
See {{&quot;src/example/bintray&quot;}} for complete example.
  </td>
