    <a class="issue-link" data-issue-key="IVY-1079" href="https://issues.apache.org/jira/browse/IVY-1079">IVY-1079</a>
</td>
                                            <td class="summary"><p>
                Resolve with Extra Attributes, Forced Dependencies causes invalid delivered ivy file
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
