                                            <td class="description">      **************************<br/>
Ivy file of the module is<br/>
**************************<br/>
&lt;ivy-module version=&quot;1.0&quot;&gt;<br/>
    &lt;info organisation=&quot;org.efe4it&quot; module=&quot;test-wrapper-ivydeps-standalone&quot;/&gt;<br/>
    &lt;configurations&gt;<br/>
    	&lt;conf name=&quot;main-compile&quot; description=&quot;compilation of main source tree&quot;/&gt;<br/>
    	&lt;conf name=&quot;javadoc&quot; extends=&quot;main-compile&quot; description=&quot;documentation&quot;/&gt;<br/>
    	&lt;conf name=&quot;test-compile&quot; description=&quot;compilation of test source tree&quot;/&gt;<br/>
    	&lt;conf name=&quot;runtime&quot; extends=&quot;main-compile&quot; visibility=&quot;private&quot; description=&quot;run&quot;/&gt;<br/>
    	&lt;conf name=&quot;test&quot; extends=&quot;test-compile,runtime&quot; visibility=&quot;private&quot; description=&quot;test&quot;/&gt;<br/>
    &lt;/configurations&gt;<br/>
    &lt;publications&gt;<br/>
    	&lt;artifact name=&quot;${ivy.module}-main&quot; type=&quot;jar&quot;  conf=&quot;main-compile&quot; ext=&quot;jar&quot;/&gt;<br/>
    	&lt;artifact name=&quot;${ivy.module}-test&quot; type=&quot;jar&quot;  conf=&quot;test-compile&quot; ext=&quot;jar&quot;/&gt;<br/>
		&lt;artifact name=&quot;${ivy-module}-javadoc&quot; type=&quot;javadoc&quot; conf=&quot;javadoc&quot; ext=&quot;zip&quot;/&gt;<br/>
    &lt;/publications&gt;<br/>
    &lt;dependencies&gt;<br/>
        &lt;dependency org=&quot;org.slf4j&quot; name=&quot;slf4j&quot; rev=&quot;1.5.8&quot; conf=&quot;main-compile-&gt;core&quot;/&gt;<br/>
        &lt;dependency org=&quot;org.slf4j&quot; name=&quot;slf4j&quot; rev=&quot;1.5.8&quot; conf=&quot;runtime-&gt;log4j&quot;/&gt;<br/>
        &lt;dependency org=&quot;org.junit&quot; name=&quot;junit&quot; rev=&quot;4.5&quot; conf=&quot;test-compile,test-&gt;default&quot;/&gt;<br/>
        &lt;dependency org=&quot;org.apache.commons&quot; name=&quot;commons-collections&quot; rev=&quot;3.2.1&quot; conf=&quot;main-compile-&gt;default&quot;/&gt;<br/>
    &lt;/dependencies&gt;<br/>
&lt;/ivy-module&gt;<br/>
<br/>
**************************<br/>
Ant target calling deliver<br/>
**************************<br/>
	&lt;target	name=&quot;-ivy-info&quot; depends=&quot;-init, -ivy-configure&quot;&gt;<br/>
		&lt;ivy:info/&gt;<br/>
	&lt;/target&gt;<br/>
	&lt;target	name=&quot;-ivy-deliver&quot;	depends=&quot;-init, -ivy-info&quot;&gt;<br/>
		&lt;echo message=&quot;deliver ivy pattern: ${ivy.deliver.ivy.pattern}&quot;/&gt;  --&gt; becomes build/lib/ivy.xml<br/>
		&lt;echo message=&quot;deliver ivy revision: ${ivy.deliver.revision}&quot;/&gt; --&gt; &quot;trunk&quot;<br/>
		&lt;ivy:deliver conf=&quot;*(public)&quot;<br/>
			deliverpattern=&quot;${ivy.deliver.ivy.pattern}&quot;<br/>
			pubrevision=&quot;${ivy.deliver.revision}&quot;<br/>
		/&gt;<br/>
	&lt;/target&gt;<br/>
<br/>
**************************<br/>
Delivered Ivy file<br/>
**************************<br/>
&lt;ivy-module version=&quot;1.0&quot;&gt;<br/>
    &lt;info organisation=&quot;org.efe4it&quot; module=&quot;test-wrapper-ivydeps-standalone&quot; revision=&quot;trunk&quot; status=&quot;integration&quot; publication=&quot;20110601151114&quot;/&gt;<br/>
    &lt;configurations&gt;<br/>
    	&lt;conf name=&quot;main-compile&quot; description=&quot;compilation of main source tree&quot;/&gt;<br/>
    	&lt;conf name=&quot;javadoc&quot; extends=&quot;main-compile&quot; description=&quot;documentation&quot;/&gt;<br/>
    	&lt;conf name=&quot;test-compile&quot; description=&quot;compilation of test source tree&quot;/&gt;<br/>
    &lt;/configurations&gt;<br/>
    &lt;publications&gt;<br/>
    	&lt;artifact name=&quot;test-wrapper-ivydeps-standalone-main&quot; type=&quot;jar&quot; conf=&quot;main-compile&quot; ext=&quot;jar&quot;/&gt;<br/>
    	&lt;artifact name=&quot;test-wrapper-ivydeps-standalone-test&quot; type=&quot;jar&quot; conf=&quot;test-compile&quot; ext=&quot;jar&quot;/&gt;<br/>
		&lt;artifact name=&quot;${ivy-module}-javadoc&quot; type=&quot;javadoc&quot; conf=&quot;javadoc&quot; ext=&quot;zip&quot;/&gt;<br/>
    &lt;/publications&gt;<br/>
    &lt;dependencies&gt;<br/>
        &lt;dependency org=&quot;org.slf4j&quot; name=&quot;slf4j&quot; rev=&quot;1.5.8&quot; conf=&quot;main-compile-&gt;core&quot;/&gt;<br/>
        &lt;dependency org=&quot;org.junit&quot; name=&quot;junit&quot; rev=&quot;4.5&quot; conf=&quot;test-compile-&gt;default&quot;/&gt;<br/>
