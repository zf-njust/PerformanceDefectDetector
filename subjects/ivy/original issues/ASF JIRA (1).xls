                <tr id="issuerow12423044" rel="12423044" data-issuekey="IVY-1066" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1066" href="https://issues.apache.org/jira/browse/IVY-1066">IVY-1066</a>
</td>
                                            <td class="summary"><p>
                Ivy doesn&#39;t handle maven dependencies with type &#39;test-jar&#39; correctly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Hans Dockter
    </td>
                                            <td class="creator">            Hans Dockter
    </td>
                                            <td class="created"> 16/Apr/09 19:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Jun/09 22:55 </td>
                                            <td class="resolutiondate"> 16/Apr/09 21:54 </td>
                                            <td class="versions">                        2.1.0-RC1            </td>
                                            <td class="fixVersions">                        2.1.0-RC2            </td>
                                            <td class="components">                        Maven Compatibility            </td>
                                            <td class="duedate">    &nbsp;
</td>
