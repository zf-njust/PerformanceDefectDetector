    <a class="issue-link" data-issue-key="IVY-1229" href="https://issues.apache.org/jira/browse/IVY-1229">IVY-1229</a>
</td>
                                            <td class="summary"><p>
                makepom ignores the artifact type in generated dependencies
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Andreas Mandel
    </td>
                                            <td class="creator">            Andreas Mandel
    </td>
                                            <td class="created"> 22/Sep/10 08:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Aug/11 21:40 </td>
                                            <td class="resolutiondate"> 11/Aug/11 21:40 </td>
                                            <td class="versions">                        2.0,                     2.2.0-RC1            </td>
                                            <td class="fixVersions">                        2.3.0-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The ant task makepom greates a pom.xml that does not hold the information given with the type attribute in the ivy.xml.<br/>
<br/>
{code:xml|title=ivy.xml}<br/>
   ...<br/>
    &lt;dependency org=&quot;docbook&quot; name=&quot;docbook-xsl&quot; rev=&quot;1.73.2&quot;&gt;<br/>
      &lt;artifact name=&quot;docbook-xsl&quot; type=&quot;zip&quot; /&gt;<br/>
    &lt;/dependency&gt;<br/>
   ...<br/>
{code}<br/>
gets<br/>
{code:xml|title=pom.xml}<br/>
   ...<br/>
    &lt;dependency&gt;<br/>
      &lt;groupId&gt;docbook&lt;/groupId&gt;<br/>
      &lt;artifactId&gt;docbook-xsl&lt;/artifactId&gt;<br/>
      &lt;version&gt;1.73.2&lt;/version&gt;<br/>
      &lt;optional&gt;true&lt;/optional&gt;<br/>
    &lt;/dependency&gt;<br/>
   ...<br/>
{code}<br/>
<br/>
I would expect:<br/>
{code:xml|title=pom.xml}<br/>
   ...<br/>
    &lt;dependency&gt;<br/>
      &lt;groupId&gt;docbook&lt;/groupId&gt;<br/>
      &lt;artifactId&gt;docbook-xsl&lt;/artifactId&gt;<br/>
      &lt;version&gt;1.73.2&lt;/version&gt;<br/>
      &lt;type&gt;zip&lt;/type&gt;<br/>
      &lt;optional&gt;true&lt;/optional&gt;<br/>
    &lt;/dependency&gt;<br/>
   ...<br/>
{code}<br/>

  </td>
