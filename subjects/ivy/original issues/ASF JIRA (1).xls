                <tr id="issuerow12504098" rel="12504098" data-issuekey="IVY-1286" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1286" href="https://issues.apache.org/jira/browse/IVY-1286">IVY-1286</a>
</td>
                                            <td class="summary"><p>
                publish task ins&#39;t working after inline resolve
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Bart Dooms
    </td>
                                            <td class="creator">            Bart Dooms
    </td>
                                            <td class="created"> 12/Apr/11 20:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Nov/12 14:01 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.2.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
