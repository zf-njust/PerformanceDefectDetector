                <tr id="issuerow12774184" rel="12774184" data-issuekey="IVY-1511" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1511" href="https://issues.apache.org/jira/browse/IVY-1511">IVY-1511</a>
</td>
                                            <td class="summary"><p>
                Ivy fails to resolve maven dependencies that were build with the maven-javadoc-plugin and option &quot;maven.javadoc.skip&quot; 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Carsten Rohde
    </td>
                                            <td class="creator">            Carsten Rohde
    </td>
                                            <td class="created"> 11/Feb/15 11:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Jul/16 06:49 </td>
                                            <td class="resolutiondate"> 28/Jul/16 06:49 </td>
                                            <td class="versions">                        2.4.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Maven Compatibility            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Ant + Ivy, Windows, Java 1.6.0 32 Bit, Maven2-Repository (Artifactory)
  </td>
                                            <td class="description">      Given: <br/>
************<br/>
- An ivy module that depends on a module built with Maven. <br/>
- The Maven module was built using the maven-javadoc-plugin (inherited from its parent) but with &quot;maven.javadoc.skip&quot; set to &quot;true&quot;, thus generating no -javadoc artifact.<br/>
- In general, the resolution of maven artifacts works flawlessly using the ibiblio resolver (m2compatible=true)<br/>
<br/>
Problem:<br/>
************<br/>
- Resolution fails because ivy assumes that the -javadoc artifact is present which is not the case<br/>
<br/>
Workaround:<br/>
************<br/>
- Exclude artifacts with -javadoc classifier<br/>
<br/>
Suggestions:<br/>
************<br/>
- Include publications for maven artifacts with classifier javadoc (sources...) only if those files are actually present on the repository, or <br/>
<br/>
Examples:<br/>
***********<br/>
<br/>
Ivy-Dependency Declaration:<br/>
&lt;dependency org=&quot;my.company&quot; name=&quot;my-maven-module&quot; rev=&quot;1.0.0-SNAPSHOT&quot;  conf=&quot;myconf&quot;/&gt;<br/>
<br/>
Effective Maven Pom:<br/>
&lt;?xml version=&quot;1.0&quot;?&gt; <br/>
&lt;project xsi:schemaLocation=&quot;http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd&quot; xmlns=&quot;http://maven.apache.org/POM/4.0.0&quot; <br/>
    xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;&gt; <br/>
  &lt;modelVersion&gt;4.0.0&lt;/modelVersion&gt; <br/>
<br/>
  &lt;groupId&gt;my.company&lt;/groupId&gt; <br/>
  &lt;artifactId&gt;my-maven-module&lt;/artifactId&gt; <br/>
  &lt;version&gt;1.0.0-SNAPSHOT&lt;/version&gt;<br/>
  <br/>
  &lt;properties&gt; <br/>
    &lt;maven.javadoc.skip&gt;true&lt;/maven.javadoc.skip&gt; <br/>
  &lt;/properties&gt; <br/>
<br/>
  &lt;build&gt; <br/>
    &lt;plugins&gt; <br/>
      &lt;plugin&gt; <br/>
        &lt;artifactId&gt;maven-javadoc-plugin&lt;/artifactId&gt; <br/>
        &lt;version&gt;2.10&lt;/version&gt; <br/>
        &lt;executions&gt; <br/>
          &lt;execution&gt; <br/>
            &lt;id&gt;attach-javadocs&lt;/id&gt; <br/>
            &lt;goals&gt; <br/>
              &lt;goal&gt;jar&lt;/goal&gt; <br/>
            &lt;/goals&gt; <br/>
          &lt;/execution&gt; <br/>
        &lt;/executions&gt; <br/>
      &lt;/plugin&gt; <br/>
      &lt;plugin&gt; <br/>
        &lt;artifactId&gt;maven-source-plugin&lt;/artifactId&gt; <br/>
        &lt;version&gt;2.2.1&lt;/version&gt; <br/>
        &lt;executions&gt; <br/>
          &lt;execution&gt; <br/>
            &lt;id&gt;attach-sources&lt;/id&gt; <br/>
            &lt;goals&gt; <br/>
              &lt;goal&gt;jar-no-fork&lt;/goal&gt; <br/>
            &lt;/goals&gt; <br/>
          &lt;/execution&gt; <br/>
        &lt;/executions&gt; <br/>
      &lt;/plugin&gt; <br/>
    &lt;/plugins&gt; <br/>
  &lt;/build&gt; <br/>
&lt;/project&gt;<br/>
<br/>
Generated Ivy File derived from the Maven Pom above:<br/>
[...]<br/>
	&lt;configurations&gt;<br/>
		&lt;conf name=&quot;default&quot; visibility=&quot;public&quot; description=&quot;runtime dependencies and master artifact can be used with this conf&quot; extends=&quot;runtime,master&quot;/&gt;<br/>
		&lt;conf name=&quot;master&quot; visibility=&quot;public&quot; description=&quot;contains only the artifact published by this module itself, with no transitive dependencies&quot;/&gt;<br/>
		&lt;conf name=&quot;compile&quot; visibility=&quot;public&quot; description=&quot;this is the default scope, used if none is specified. Compile dependencies are available in all classpaths.&quot;/&gt;<br/>
		&lt;conf name=&quot;provided&quot; visibility=&quot;public&quot; description=&quot;this is much like compile, but indicates you expect the JDK or a container to provide it. It is only available on the compilation classpath, and is not transitive.&quot;/&gt;<br/>
		&lt;conf name=&quot;runtime&quot; visibility=&quot;public&quot; description=&quot;this scope indicates that the dependency is not required for compilation, but is for execution. It is in the runtime and test classpaths, but not the compile classpath.&quot; extends=&quot;compile&quot;/&gt;<br/>
		&lt;conf name=&quot;test&quot; visibility=&quot;private&quot; description=&quot;this scope indicates that the dependency is not required for normal use of the application, and is only available for the test compilation and execution phases.&quot; extends=&quot;runtime&quot;/&gt;<br/>
		&lt;conf name=&quot;system&quot; visibility=&quot;public&quot; description=&quot;this scope is similar to provided except that you have to provide the JAR which contains it explicitly. The artifact is always available and is not looked up in a repository.&quot;/&gt;<br/>
		&lt;conf name=&quot;sources&quot; visibility=&quot;public&quot; description=&quot;this configuration contains the source artifact of this module, if any.&quot;/&gt;<br/>
		&lt;conf name=&quot;javadoc&quot; visibility=&quot;public&quot; description=&quot;this configuration contains the javadoc artifact of this module, if any.&quot;/&gt;<br/>
		&lt;conf name=&quot;optional&quot; visibility=&quot;public&quot; description=&quot;contains all optional dependencies&quot;/&gt;<br/>
	&lt;/configurations&gt;<br/>
	&lt;publications&gt;<br/>
		&lt;artifact name=&quot;my-maven-module&quot; type=&quot;jar&quot; ext=&quot;jar&quot; conf=&quot;master&quot;/&gt;<br/>
		&lt;artifact name=&quot;my-maven-module&quot; type=&quot;source&quot; ext=&quot;jar&quot; conf=&quot;sources&quot; m:classifier=&quot;sources&quot;/&gt;<br/>
		&lt;artifact name=&quot;my-maven-module&quot; type=&quot;javadoc&quot; ext=&quot;jar&quot; conf=&quot;javadoc&quot; m:classifier=&quot;javadoc&quot;/&gt;<br/>
	&lt;/publications&gt;<br/>
[...]<br/>

