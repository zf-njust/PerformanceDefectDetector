    <a class="issue-link" data-issue-key="IVY-1145" href="https://issues.apache.org/jira/browse/IVY-1145">IVY-1145</a>
</td>
                                            <td class="summary"><p>
                metadata lock files not always deleted from cache
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
