                <tr id="issuerow12547389" rel="12547389" data-issuekey="IVY-1340" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1340" href="https://issues.apache.org/jira/browse/IVY-1340">IVY-1340</a>
</td>
                                            <td class="summary"><p>
                NullPointerException from URLResolver (URLRepository
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Sven Zethelius
    </td>
                                            <td class="creator">            Sven Zethelius
    </td>
                                            <td class="created"> 21/Mar/12 14:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Mar/12 15:53 </td>
                                            <td class="resolutiondate"> 23/Mar/12 23:12 </td>
                                            <td class="versions">                        2.2.0            </td>
                                            <td class="fixVersions">                        2.3.0-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
