                <tr id="issuerow12710702" rel="12710702" data-issuekey="IVY-1469" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1469" href="https://issues.apache.org/jira/browse/IVY-1469">IVY-1469</a>
</td>
                                            <td class="summary"><p>
                Artifact is excluding itself
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Brian Hawkins
    </td>
                                            <td class="creator">            Brian Hawkins
    </td>
                                            <td class="created"> 26/Apr/14 03:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Dec/16 07:22 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.3.0,                     2.4.0-RC1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
