    <a class="issue-link" data-issue-key="IVY-1459" href="https://issues.apache.org/jira/browse/IVY-1459">IVY-1459</a>
</td>
                                            <td class="summary"><p>
                include in dependency doesn&#39;t work as expected with extra attributes
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Olivier Patry
    </td>
                                            <td class="creator">            Olivier Patry
    </td>
                                            <td class="created"> 03/Feb/14 16:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Feb/14 16:35 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.3.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
