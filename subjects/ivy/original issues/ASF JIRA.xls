                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Oct/08 12:10 </td>
                                            <td class="resolutiondate"> 22/Oct/08 12:10 </td>
                                            <td class="versions">                        2.0-RC1            </td>
                                            <td class="fixVersions">                        2.0-RC2            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
