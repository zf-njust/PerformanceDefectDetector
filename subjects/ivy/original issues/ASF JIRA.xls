    </td>
                                            <td class="created"> 17/Sep/08 09:13 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/08 22:02 </td>
                                            <td class="resolutiondate"> 18/Sep/08 21:15 </td>
                                            <td class="versions">                        2.0-RC1            </td>
                                            <td class="fixVersions">                        2.0-RC2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
