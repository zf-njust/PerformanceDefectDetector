                <tr id="issuerow12356794" rel="12356794" data-issuekey="IVY-187" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-187" href="https://issues.apache.org/jira/browse/IVY-187">IVY-187</a>
</td>
                                            <td class="summary"><p>
                ivy resolve slowdown
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Karl Baum
    </td>
                                            <td class="creator">            Karl Baum
    </td>
                                            <td class="created"> 07/Mar/06 10:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/06 12:07 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:04 </td>
                                            <td class="versions">                        1.3-RC2            </td>
                                            <td class="fixVersions">                        1.4-RC1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      all
  </td>
                                            <td class="description">      I&#39;ve noticed a slowdown in the resolve task since I&#39;ve upgraded to ivy 1.3 and used some of ivy&#39;s new features.  <br/>
<br/>
