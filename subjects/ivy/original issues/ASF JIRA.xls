    <a class="issue-link" data-issue-key="IVY-673" href="https://issues.apache.org/jira/browse/IVY-673">IVY-673</a>
</td>
                                            <td class="summary"><p>
                Display full graph when a circular dependency is detected
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Maarten Coene
    </td>
                                            <td class="creator">            Maarten Coene
    </td>
                                            <td class="created"> 17/Dec/07 16:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Dec/07 16:09 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0.0-beta-1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
