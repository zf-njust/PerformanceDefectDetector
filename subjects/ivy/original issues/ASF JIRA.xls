    <a class="issue-link" data-issue-key="IVY-25" href="https://issues.apache.org/jira/browse/IVY-25">IVY-25</a>
</td>
                                            <td class="summary"><p>
                bad eviction of required artefacts
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Matthieu Brouillard
    </td>
                                            <td class="creator">            Matthieu Brouillard
    </td>
                                            <td class="created"> 01/Apr/05 12:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Sep/05 16:08 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:02 </td>
                                            <td class="versions">                        unspecified            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
