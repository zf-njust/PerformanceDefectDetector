    <a class="issue-link" data-issue-key="IVY-577" href="https://issues.apache.org/jira/browse/IVY-577">IVY-577</a>
</td>
                                            <td class="summary"><p>
                Missing artifacts on double (all direct and specific artifact by way of transitive) dependency to lib
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Johannes Stamminger
    </td>
                                            <td class="creator">            Johannes Stamminger
    </td>
                                            <td class="created"> 18/Jul/07 12:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Jun/08 16:57 </td>
                                            <td class="resolutiondate"> 25/Jun/08 16:57 </td>
                                            <td class="versions">                        1.4.1            </td>
                                            <td class="fixVersions">                        2.0-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
