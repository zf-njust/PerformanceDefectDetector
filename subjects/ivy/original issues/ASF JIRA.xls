    <a class="issue-link" data-issue-key="IVY-895" href="https://issues.apache.org/jira/browse/IVY-895">IVY-895</a>
</td>
                                            <td class="summary"><p>
                Transactional Publishing to the FileSytemResolver doesn&#39;t work as expected.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Steve Brown
    </td>
                                            <td class="creator">            Steve Brown
    </td>
                                            <td class="created"> 04/Sep/08 15:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Oct/08 20:38 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0.0-beta-2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
