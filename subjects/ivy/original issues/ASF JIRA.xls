                <tr id="issuerow12358361" rel="12358361" data-issuekey="IVY-353" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-353" href="https://issues.apache.org/jira/browse/IVY-353">IVY-353</a>
</td>
                                            <td class="summary"><p>
                ivy:retrieve should be able to create symlinks
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Gilles Scokart
    </td>
                                            <td class="reporter">            John Williams
    </td>
                                            <td class="creator">            John Williams
    </td>
                                            <td class="created"> 12/Dec/06 03:38 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Aug/07 20:45 </td>
                                            <td class="resolutiondate"> 08/Jun/07 11:16 </td>
                                            <td class="versions">                        1.4.1            </td>
                                            <td class="fixVersions">                        2.0.0-alpha-2            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
