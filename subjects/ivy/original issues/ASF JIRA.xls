                <tr id="issuerow12384783" rel="12384783" data-issuekey="IVY-675" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-675" href="https://issues.apache.org/jira/browse/IVY-675">IVY-675</a>
</td>
                                            <td class="summary"><p>
                Wrong graph of nodes is logged when circular dependency is detected
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Maarten Coene
    </td>
                                            <td class="creator">            Maarten Coene
    </td>
                                            <td class="created"> 17/Dec/07 16:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Sep/08 21:22 </td>
                                            <td class="resolutiondate"> 01/Sep/08 21:22 </td>
                                            <td class="versions">                        2.0.0-beta-1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
