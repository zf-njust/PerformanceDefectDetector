                <tr id="issuerow12372441" rel="12372441" data-issuekey="IVY-953" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-953" href="https://issues.apache.org/jira/browse/IVY-953">IVY-953</a>
</td>
                                            <td class="summary"><p>
                Ivy should set the ${basedir} property
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Nicolas Lalevée
    </td>
                                            <td class="reporter">            Maarten Coene
    </td>
                                            <td class="creator">            Maarten Coene
    </td>
