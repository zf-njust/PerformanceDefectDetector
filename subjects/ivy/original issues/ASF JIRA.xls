                <tr id="issuerow12356841" rel="12356841" data-issuekey="IVY-234" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-234" href="https://issues.apache.org/jira/browse/IVY-234">IVY-234</a>
</td>
                                            <td class="summary"><p>
                NullPointerException when the creation of Ivy file in cache fails
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Maarten Coene
    </td>
                                            <td class="creator">            Maarten Coene
    </td>
                                            <td class="created"> 27/Apr/06 09:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/06 18:27 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:04 </td>
                                            <td class="versions">                        1.3.1            </td>
                                            <td class="fixVersions">                        1.4-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Hi,<br/>
<br/>
If the creation of the Ivy file in the cache fails for a module without an Ivy file, a NullPointerException is thrown (caused because ivyRef == null).<br/>
This patch fixes this:<br/>
<br/>
--- C:\java\ivy-20060426192557\src\java\fr\jayasoft\ivy\resolver\BasicResolver.java.orig	Wed Apr 26 19:28:54 2006<br/>
+++ C:\java\ivy-20060426192557\src\java\fr\jayasoft\ivy\resolver\BasicResolver.java	Thu Apr 27 15:05:52 2006<br/>
@@ -384,7 +384,11 @@<br/>
                 }<br/>
 	        }<br/>
         } catch (Exception e) {<br/>
+        	if (ivyRef == null) {<br/>
+        		Message.warn(&quot;impossible to create ivy file in cache for module : &quot; + resolvedMrid);<br/>
+        	} else {<br/>
             Message.warn(&quot;impossible to copy ivy file to cache : &quot;+ivyRef.getResource());<br/>
+        	}<br/>
         }<br/>
         <br/>
         data.getIvy().saveResolver(data.getCache(), systemMd, getName());<br/>

  </td>
