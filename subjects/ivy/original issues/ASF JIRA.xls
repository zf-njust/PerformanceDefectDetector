    <a class="issue-link" data-issue-key="IVY-233" href="https://issues.apache.org/jira/browse/IVY-233">IVY-233</a>
</td>
                                            <td class="summary"><p>
                ModuleRevisionId encode/decode doesn&#39;t work if revision is empty
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Maarten Coene
    </td>
                                            <td class="creator">            Maarten Coene
    </td>
                                            <td class="created"> 26/Apr/06 10:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/06 18:26 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:04 </td>
                                            <td class="versions">                        1.3.1            </td>
                                            <td class="fixVersions">                        1.4-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
