</td>
                                            <td class="summary"><p>
                post-download-artifact trigger file.property points to cache location
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ross Camara
    </td>
                                            <td class="creator">            Ross Camara
    </td>
                                            <td class="created"> 06/Aug/08 20:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/Sep/08 13:31 </td>
                                            <td class="resolutiondate"> 02/Sep/08 13:31 </td>
                                            <td class="versions">                        2.0.0-beta-2,                     2.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
