    <a class="issue-link" data-issue-key="IVY-822" href="https://issues.apache.org/jira/browse/IVY-822">IVY-822</a>
</td>
                                            <td class="summary"><p>
                Incorrect proxy configuration in FAQ: use &quot;http.proxyUser&quot; instead of &quot;http.proxyUserName&quot;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Trivial
</td>
