    <a class="issue-link" data-issue-key="IVY-375" href="https://issues.apache.org/jira/browse/IVY-375">IVY-375</a>
</td>
                                            <td class="summary"><p>
                Refactoring / documentation / test of matcher package
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Trivial
</td>
