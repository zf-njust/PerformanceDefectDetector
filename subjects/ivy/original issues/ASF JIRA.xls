                <tr id="issuerow12407805" rel="12407805" data-issuekey="IVY-965" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-965" href="https://issues.apache.org/jira/browse/IVY-965">IVY-965</a>
</td>
                                            <td class="summary"><p>
                Support useOrigin for artifacts with a set url attribute
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            alex322
    </td>
                                            <td class="creator">            alex322
    </td>
                                            <td class="created"> 04/Nov/08 18:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Dec/08 22:34 </td>
                                            <td class="resolutiondate"> 17/Nov/08 22:39 </td>
                                            <td class="versions">                        2.0-RC1            </td>
                                            <td class="fixVersions">                        2.0            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Currently artifacts with a specified url are always considered remote because the code instantiates URLResource.<br/>
This change would allow using FileResource when the url is &quot;file://*&quot;.<br/>
<br/>
{noformat}<br/>
--- BasicResolver.java.original        Mon Oct 20 16:47:15 2008<br/>
+++ BasicResolver.java  Mon Nov 03 15:38:48 2008<br/>
@@ -64,6 +64,8 @@<br/>
 import org.apache.ivy.plugins.repository.ArtifactResourceResolver;<br/>
 import org.apache.ivy.plugins.repository.Resource;<br/>
 import org.apache.ivy.plugins.repository.ResourceDownloader;<br/>
+import org.apache.ivy.plugins.repository.file.FileRepository;<br/>
+import org.apache.ivy.plugins.repository.file.FileResource;<br/>
 import org.apache.ivy.plugins.repository.url.URLRepository;<br/>
 import org.apache.ivy.plugins.repository.url.URLResource;<br/>
 import org.apache.ivy.plugins.resolver.util.MDResolvedResource;<br/>
@@ -918,7 +920,14 @@<br/>
