                <tr id="issuerow12356678" rel="12356678" data-issuekey="IVY-70" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-70" href="https://issues.apache.org/jira/browse/IVY-70">IVY-70</a>
</td>
                                            <td class="summary"><p>
                chain resolver always returns first
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Stephen Nesbitt
    </td>
                                            <td class="creator">            Stephen Nesbitt
    </td>
                                            <td class="created"> 24/Aug/05 08:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/05 19:16 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:05 </td>
                                            <td class="versions">                        1.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
