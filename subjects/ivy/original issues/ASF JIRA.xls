    <a class="issue-link" data-issue-key="IVY-843" href="https://issues.apache.org/jira/browse/IVY-843">IVY-843</a>
</td>
                                            <td class="summary"><p>
                NPE in Ivy:install task if the repository cache dir has been cleared
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Erik-Berndt Scheper
    </td>
                                            <td class="creator">            Erik-Berndt Scheper
    </td>
                                            <td class="created"> 16/Jun/08 10:43 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Jul/08 10:55 </td>
                                            <td class="resolutiondate"> 04/Jul/08 10:55 </td>
                                            <td class="versions">                        2.0-RC1            </td>
                                            <td class="fixVersions">                        2.0-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
