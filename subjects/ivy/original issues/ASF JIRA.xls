                                            <td class="summary"><p>
                Global Exclusions Fail to Work Transitively
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
