    <a class="issue-link" data-issue-key="IVY-356" href="https://issues.apache.org/jira/browse/IVY-356">IVY-356</a>
</td>
                                            <td class="summary"><p>
                Resolve Slowness in 1.4.1
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
