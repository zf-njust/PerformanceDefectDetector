                <tr id="issuerow12401436" rel="12401436" data-issuekey="IVY-869" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-869" href="https://issues.apache.org/jira/browse/IVY-869">IVY-869</a>
</td>
                                            <td class="summary"><p>
                Bootstrapping ivy instruction
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Stepan Koltsov
    </td>
                                            <td class="creator">            Stepan Koltsov
    </td>
                                            <td class="created"> 31/Jul/08 19:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Aug/08 18:26 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0.0-beta-2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      I use following code to bootstrap ivy:<br/>
<br/>
{code}<br/>
&lt;available property=&quot;ivy.available&quot; file=&quot;lib/ivy/ivy-2.0.0-beta2.jar&quot;/&gt;<br/>
&lt;target name=&quot;download-ivy&quot; unless=&quot;ivy.available&quot;&gt;<br/>
        &lt;mkdir dir=&quot;lib/ivy&quot;/&gt;<br/>
<br/>
        &lt;echo&gt;Downloading ivy&lt;/echo&gt;<br/>
<br/>
        &lt;get src=&quot;http://repo1.maven.org/maven2/org/apache/ivy/ivy/2.0.0-beta2/ivy-2.0.0-beta2.jar&quot;<br/>
                dest=&quot;lib/ivy/ivy-2.0.0-beta2.jar&quot;/&gt;<br/>
&lt;/target&gt;<br/>
<br/>
&lt;target name=&quot;resolve&quot; depends=&quot;download-ivy&quot;&gt;<br/>
        &lt;taskdef resource=&quot;org/apache/ivy/ant/antlib.xml&quot;<br/>
                uri=&quot;antlib:org.apache.ivy.ant&quot;&gt;<br/>
            &lt;classpath&gt;<br/>
                &lt;fileset dir=&quot;lib/ivy&quot; includes=&quot;*.jar&quot;/&gt;<br/>
            &lt;/classpath&gt;<br/>
        &lt;/taskdef&gt;<br/>
<br/>
        &lt;ivy:retrieve pattern=&quot;lib/dep/[organisation]-[artifact]-[revision].[ext]&quot; sync=&quot;true&quot;/&gt;<br/>
&lt;/target&gt;<br/>
<br/>
{code}<br/>
<br/>
This should be possibly included into the documentation.
  </td>
