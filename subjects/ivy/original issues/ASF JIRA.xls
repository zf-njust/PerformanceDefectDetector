                <tr id="issuerow12356679" rel="12356679" data-issuekey="IVY-71" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-71" href="https://issues.apache.org/jira/browse/IVY-71">IVY-71</a>
</td>
                                            <td class="summary"><p>
                Property for changes since last resolve
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Rick Riemer
