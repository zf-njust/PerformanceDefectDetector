    <a class="issue-link" data-issue-key="IVY-777" href="https://issues.apache.org/jira/browse/IVY-777">IVY-777</a>
</td>
                                            <td class="summary"><p>
                No error or warning when a resolver references a non-existent cache
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Carlton Brown
    </td>
                                            <td class="creator">            Carlton Brown
    </td>
                                            <td class="created"> 18/Mar/08 13:17 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Apr/08 14:24 </td>
                                            <td class="resolutiondate"> 03/Apr/08 14:24 </td>
                                            <td class="versions">                        2.0.0-beta-2            </td>
                                            <td class="fixVersions">                        2.0-RC1            </td>
                                            <td class="components">    &nbsp;
</td>
