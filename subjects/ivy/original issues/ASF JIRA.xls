    <a class="issue-link" data-issue-key="IVY-877" href="https://issues.apache.org/jira/browse/IVY-877">IVY-877</a>
</td>
                                            <td class="summary"><p>
                Error using namespace 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
