                <tr id="issuerow12356846" rel="12356846" data-issuekey="IVY-239" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-239" href="https://issues.apache.org/jira/browse/IVY-239">IVY-239</a>
</td>
                                            <td class="summary"><p>
                value of confmappingoverride from imported configurations is lost when writing Ivy file
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Maarten Coene
    </td>
                                            <td class="creator">            Maarten Coene
    </td>
                                            <td class="created"> 03/May/06 15:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/06 18:29 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:04 </td>
                                            <td class="versions">                        1.3.1            </td>
                                            <td class="fixVersions">                        1.4-RC1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
