                <tr id="issuerow12376826" rel="12376826" data-issuekey="IVY-596" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-596" href="https://issues.apache.org/jira/browse/IVY-596">IVY-596</a>
</td>
                                            <td class="summary"><p>
                HOWTO - Resolve dependencies on demand
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            John Wu
    </td>
                                            <td class="creator">            John Wu
    </td>
                                            <td class="created"> 24/Aug/07 18:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Aug/07 18:09 </td>
                                            <td class="resolutiondate"> 24/Aug/07 18:08 </td>
                                            <td class="versions">                        1.4.1            </td>
                                            <td class="fixVersions">                        1.4.1            </td>
                                            <td class="components">                        Documentation            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
