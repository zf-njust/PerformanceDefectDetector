                <tr id="issuerow12356881" rel="12356881" data-issuekey="IVY-274" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-274" href="https://issues.apache.org/jira/browse/IVY-274">IVY-274</a>
</td>
                                            <td class="summary"><p>
                and documentation for all
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
