                <tr id="issuerow12369836" rel="12369836" data-issuekey="IVY-513" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-513" href="https://issues.apache.org/jira/browse/IVY-513">IVY-513</a>
</td>
                                            <td class="summary"><p>
                ivy should stop telling me off twice for ivyconf.xml files
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Gilles Scokart
    </td>
                                            <td class="reporter">            Steve Loughran
    </td>
                                            <td class="creator">            Steve Loughran
    </td>
                                            <td class="created"> 21/May/07 13:26 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Apr/10 08:08 </td>
                                            <td class="resolutiondate"> 30/May/07 20:00 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0.0-alpha-2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
