    <a class="issue-link" data-issue-key="IVY-500" href="https://issues.apache.org/jira/browse/IVY-500">IVY-500</a>
</td>
                                            <td class="summary"><p>
                packaging data not parsed in maven 2 pom
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jeffrey Blattman
    </td>
                                            <td class="creator">            Jeffrey Blattman
    </td>
                                            <td class="created"> 12/May/07 00:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Oct/07 13:36 </td>
                                            <td class="resolutiondate"> 12/May/07 10:37 </td>
                                            <td class="versions">                        2.0.0-alpha-1            </td>
                                            <td class="fixVersions">                        2.0.0-alpha-2            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
