                <tr id="issuerow12372259" rel="12372259" data-issuekey="IVY-531" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-531" href="https://issues.apache.org/jira/browse/IVY-531">IVY-531</a>
</td>
                                            <td class="summary"><p>
                ivyconf: &lt;classpath/&gt; to accept complex path
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Eric Crahen
    </td>
                                            <td class="creator">            Eric Crahen
    </td>
                                            <td class="created"> 23/Jun/07 01:31 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Jul/12 23:04 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
