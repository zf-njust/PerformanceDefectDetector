    <a class="issue-link" data-issue-key="IVY-297" href="https://issues.apache.org/jira/browse/IVY-297">IVY-297</a>
</td>
                                            <td class="summary"><p>
                Change allownomd and skipbuildwithoutivy into a more semantically correct name
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Stephane Bailliez
    </td>
