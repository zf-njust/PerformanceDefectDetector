    <a class="issue-link" data-issue-key="IVY-872" href="https://issues.apache.org/jira/browse/IVY-872">IVY-872</a>
</td>
                                            <td class="summary"><p>
                Improve performance
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
