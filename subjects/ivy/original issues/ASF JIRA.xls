    <a class="issue-link" data-issue-key="IVY-968" href="https://issues.apache.org/jira/browse/IVY-968">IVY-968</a>
</td>
                                            <td class="summary"><p>
                FileSystem resolver with m2compatible=true throws error when publishing modules with dotted organisation names
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Michael Kebe
    </td>
