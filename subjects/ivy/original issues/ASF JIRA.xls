                <tr id="issuerow12403914" rel="12403914" data-issuekey="IVY-898" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-898" href="https://issues.apache.org/jira/browse/IVY-898">IVY-898</a>
</td>
                                            <td class="summary"><p>
                ivy.cache.dir.${settingsRef} is set to default instead of the defaultCacheDir from the ivysettings.xml after ivy:resolve
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Steve Benigan
    </td>
                                            <td class="creator">            Steve Benigan
    </td>
                                            <td class="created"> 08/Sep/08 17:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Sep/08 15:51 </td>
                                            <td class="resolutiondate"> 10/Sep/08 22:30 </td>
                                            <td class="versions">                        2.0.0-beta-2            </td>
                                            <td class="fixVersions">                        2.0-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
