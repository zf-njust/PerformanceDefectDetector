    <a class="issue-link" data-issue-key="IVY-271" href="https://issues.apache.org/jira/browse/IVY-271">IVY-271</a>
</td>
                                            <td class="summary"><p>
                Explicitly specify artifact download URL
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
