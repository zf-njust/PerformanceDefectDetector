</td>
                                            <td class="summary"><p>
                Ivy build system: fix build.xml to allow &quot;ant coverage-report&quot; behind a proxy
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Erik-Berndt Scheper
    </td>
                                            <td class="creator">            Erik-Berndt Scheper
    </td>
                                            <td class="created"> 10/Jun/08 10:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Jun/08 06:58 </td>
                                            <td class="resolutiondate"> 11/Jun/08 21:04 </td>
                                            <td class="versions">                        2.0-RC1            </td>
                                            <td class="fixVersions">                        2.0-RC1            </td>
