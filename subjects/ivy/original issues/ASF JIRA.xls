                <tr id="issuerow12375430" rel="12375430" data-issuekey="IVY-589" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-589" href="https://issues.apache.org/jira/browse/IVY-589">IVY-589</a>
</td>
                                            <td class="summary"><p>
                replace * by *(public) when resolving inline
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Gilles Scokart
    </td>
                                            <td class="reporter">            Gilles Scokart
    </td>
                                            <td class="creator">            Gilles Scokart
    </td>
                                            <td class="created"> 06/Aug/07 15:00 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Dec/07 22:21 </td>
                                            <td class="resolutiondate"> 06/Aug/07 19:15 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0.0-beta-1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
