                <tr id="issuerow12356671" rel="12356671" data-issuekey="IVY-63" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-63" href="https://issues.apache.org/jira/browse/IVY-63">IVY-63</a>
</td>
                                            <td class="summary"><p>
                XML Schema does not restrict &#39;&#39;status&#39; type
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Stephane Bailliez
    </td>
                                            <td class="creator">            Stephane Bailliez
    </td>
                                            <td class="created"> 29/Jul/05 18:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Aug/06 08:03 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:03 </td>
                                            <td class="versions">                        1.1            </td>
                                            <td class="fixVersions">                        1.4-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      The xsd should define what is documented in the code (and documentation) for the status type allowed to be set:<br/>
<br/>
For example:<br/>
&lt;xs:attribute name=&quot;status&quot; type=&quot;statusType&quot;/&gt;<br/>
<br/>
  &lt;xsd:simpleType name = &quot;statusType&quot;&gt;<br/>
    &lt;xsd:annotation&gt;<br/>
      &lt;xsd:documentation&gt;A module status indicates how stable a module revision can be considered&lt;/xsd:documentation&gt;<br/>
    &lt;/xsd:annotation&gt;<br/>
    &lt;xsd:restriction base = &quot;xsd:string&quot;&gt;<br/>
      &lt;xsd:enumeration value = &quot;release&quot;/&gt;<br/>
      &lt;xsd:enumeration value = &quot;milestone&quot;/&gt;<br/>
      &lt;xsd:enumeration value = &quot;integration&quot;/&gt;<br/>
    &lt;/xsd:restriction&gt;<br/>
  &lt;/xsd:simpleType&gt;<br/>

  </td>
