                                            <td class="labels">    </td>
                                            <td class="customfield_12310220">            <span title="16/Mar/07 06:58"><time class="livestamp allow-future" datetime="2007-03-16T06:58:12+0000">16/Mar/07 6:58 AM</time></span>
