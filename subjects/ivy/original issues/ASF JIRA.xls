                <tr id="issuerow12356820" rel="12356820" data-issuekey="IVY-213" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-213" href="https://issues.apache.org/jira/browse/IVY-213">IVY-213</a>
</td>
                                            <td class="summary"><p>
                Ivy fails when downloading from a server that supports NTLM authentication
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Damon Rand
    </td>
                                            <td class="creator">            Damon Rand
    </td>
                                            <td class="created"> 10/Apr/06 19:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Aug/06 18:36 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:04 </td>
                                            <td class="versions">                        1.3.1            </td>
                                            <td class="fixVersions">                        1.4-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
