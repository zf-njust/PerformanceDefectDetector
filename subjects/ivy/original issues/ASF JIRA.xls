                <tr id="issuerow12356811" rel="12356811" data-issuekey="IVY-204" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-204" href="https://issues.apache.org/jira/browse/IVY-204">IVY-204</a>
</td>
                                            <td class="summary"><p>
                Need global exclude
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
