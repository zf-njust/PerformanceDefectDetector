    <a class="issue-link" data-issue-key="IVY-602" href="https://issues.apache.org/jira/browse/IVY-602">IVY-602</a>
</td>
                                            <td class="summary"><p>
                Resolving dynamic version fails when using multiple patterns if only one pattern find a revision and others don&#39;t
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Xavier Hanin
    </td>
                                            <td class="creator">            Xavier Hanin
    </td>
                                            <td class="created"> 06/Sep/07 16:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Sep/07 17:08 </td>
                                            <td class="resolutiondate"> 06/Sep/07 17:08 </td>
                                            <td class="versions">                        2.0.0-alpha-2            </td>
                                            <td class="fixVersions">                        2.0.0-beta-1            </td>
                                            <td class="components">                        Core            </td>
