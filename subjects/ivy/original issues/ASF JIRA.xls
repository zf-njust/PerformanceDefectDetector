</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-421" href="https://issues.apache.org/jira/browse/IVY-421">IVY-421</a>
</td>
                                            <td class="summary"><p>
                useOrigin information should be self-contained in the resolved data
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Stephane Bailliez
    </td>
                                            <td class="creator">            Stephane Bailliez
    </td>
                                            <td class="created"> 07/Mar/07 22:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
