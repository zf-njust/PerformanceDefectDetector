                <tr id="issuerow12390728" rel="12390728" data-issuekey="IVY-765" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-765" href="https://issues.apache.org/jira/browse/IVY-765">IVY-765</a>
</td>
                                            <td class="summary"><p>
                Ignore maven metadata files when listing revisions
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Xavier Hanin
    </td>
