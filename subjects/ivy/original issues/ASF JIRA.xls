                <tr id="issuerow12404172" rel="12404172" data-issuekey="IVY-902" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-902" href="https://issues.apache.org/jira/browse/IVY-902">IVY-902</a>
</td>
                                            <td class="summary"><p>
                Maven Snapshot resolution does not work with dual resolver
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Hans Dockter
    </td>
                                            <td class="creator">            Hans Dockter
    </td>
                                            <td class="created"> 11/Sep/08 15:28 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Sep/08 20:15 </td>
                                            <td class="resolutiondate"> 15/Sep/08 07:33 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Maven Compatibility            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Here is an example for an unsucessful retrieval of a snapshot dependency when using a dual resolver. The same example works fine, if only the IBiblio resolver is used.<br/>
<br/>
{code:xml}<br/>
&lt;ivysettings&gt;<br/>
    &lt;settings defaultResolver=&quot;main&quot; validate=&quot;false&quot;/&gt;<br/>
    &lt;resolvers&gt;<br/>
        &lt;dual name=&quot;main&quot;&gt;<br/>
            &lt;ibiblio name=&quot;ivy&quot; m2compatible=&quot;true&quot; root=&quot;http://snapshots.jboss.org/maven2&quot;/&gt;<br/>
            &lt;url name=&quot;artifact&quot; m2compatible=&quot;true&quot;&gt;<br/>
                &lt;artifact pattern=&quot;http://snapshots.jboss.org/maven2/[module]/[revision]/[artifact]-[revision].[ext]&quot;/&gt;<br/>
            &lt;/url&gt;<br/>
        &lt;/dual&gt;<br/>
    &lt;/resolvers&gt;<br/>
&lt;/ivysettings&gt;<br/>
{code}<br/>
<br/>
{code:xml}<br/>
&lt;ivy-module version=&quot;2.0&quot;&gt;<br/>
    &lt;info organisation=&quot;apache&quot; module=&quot;hello-ivy&quot;/&gt;<br/>
    &lt;dependencies&gt;<br/>
        &lt;dependency org=&quot;jboss.jbossws-common&quot; name=&quot;jbossws-common&quot; rev=&quot;1.0.5-SNAPSHOT&quot;/&gt;<br/>
    &lt;/dependencies&gt;<br/>
&lt;/ivy-module&gt;<br/>
{code}
  </td>
