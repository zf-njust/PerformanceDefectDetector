    <a class="issue-link" data-issue-key="IVY-552" href="https://issues.apache.org/jira/browse/IVY-552">IVY-552</a>
</td>
                                            <td class="summary"><p>
                Support useOrigin in IvyCacheFileset in Ivy 1.4.x
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
