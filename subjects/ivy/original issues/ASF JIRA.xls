                <tr id="issuerow12356762" rel="12356762" data-issuekey="IVY-155" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-155" href="https://issues.apache.org/jira/browse/IVY-155">IVY-155</a>
</td>
                                            <td class="summary"><p>
                ivy report generate full graph from automated build
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Karl Baum
    </td>
                                            <td class="creator">            Karl Baum
    </td>
                                            <td class="created"> 26/Jan/06 15:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 20/Sep/06 08:54 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:04 </td>
                                            <td class="versions">                        unspecified            </td>
                                            <td class="fixVersions">                        1.4-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
