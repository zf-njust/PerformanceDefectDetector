                                            <td class="summary"><p>
                Add transitive dependency version and branch override mechanism
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Xavier Hanin
    </td>
                                            <td class="creator">            Xavier Hanin
    </td>
