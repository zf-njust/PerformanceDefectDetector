    <a class="issue-link" data-issue-key="IVY-580" href="https://issues.apache.org/jira/browse/IVY-580">IVY-580</a>
</td>
                                            <td class="summary"><p>
                organization and module seem redundant in ivy.xml in ivyrep
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
