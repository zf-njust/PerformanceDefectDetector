Platform: PC
  </td>
                                            <td class="description">      The problem occures when calling completion on organisation.<br/>
<br/>
#### start of ivy-conf.xml ####<br/>
&lt;ivyconf&gt;<br/>
	&lt;conf defaultResolver=&quot;dual&quot;/&gt;<br/>
	&lt;resolvers&gt;<br/>
		&lt;dual name=&quot;dual&quot;&gt;<br/>
			&lt;ivyrep name=&quot;ivyrep&quot; /&gt;<br/>
			&lt;chain&gt;<br/>
				&lt;ibiblio name=&quot;ibiblio&quot; /&gt;<br/>
				&lt;ibiblio name=&quot;ibiblio-os&quot;<br/>
pattern=&quot;[organisation]/jars/[module]-[revision].jar&quot; /&gt;<br/>
			&lt;/chain&gt;<br/>
		&lt;/dual&gt;<br/>
	&lt;/resolvers&gt;<br/>
	&lt;modules&gt;<br/>
		&lt;module organisation=&quot;opensymphony&quot; name=&quot;.*&quot; resolver=&quot;ibiblio-os&quot;/&gt;<br/>
	&lt;/modules&gt;<br/>
&lt;/ivyconf&gt;<br/>
#### end of ivy-conf.xml ####<br/>
<br/>
#### start of ivy.xml ####<br/>
&lt;?xml version=&quot;1.0&quot; encoding=&quot;ISO-8859-1&quot;?&gt;<br/>
&lt;?xml-stylesheet type=&quot;text/xsl&quot;<br/>
href=&quot;http://www.jayasoft.fr/org/ivyrep/ivy-doc.xsl&quot;?&gt;<br/>
&lt;ivy-module version=&quot;1.0&quot;&gt;<br/>
    &lt;info <br/>
        organisation=&quot;Jayasoft&quot;<br/>
        module=&quot;ivy-test&quot;<br/>
        status=&quot;integration&quot;&gt;<br/>
	&lt;/info&gt;<br/>
	&lt;dependencies&gt;<br/>
		&lt;dependency org=&quot;&quot;&gt;&lt;/dependency&gt;<br/>
		&lt;dependency org=&quot;hibernate&quot; name=&quot;hibernate&quot; rev=&quot;2.1.8&quot; conf=&quot;default-&gt;oscache&quot;/&gt;<br/>
	&lt;/dependencies&gt;<br/>
&lt;/ivy-module&gt;<br/>
#### end of ivy.xml ####<br/>
<br/>
<br/>
<br/>
