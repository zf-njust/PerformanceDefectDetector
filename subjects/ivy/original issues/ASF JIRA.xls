</td>
                                            <td class="summary"><p>
                The deprecated &quot;keep&quot; attribute on post resolve tasks causes an error
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Scott Goldstein
    </td>
                                            <td class="creator">            Scott Goldstein
    </td>
