    </td>
                                            <td class="created"> 26/Nov/07 18:39 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Nov/07 19:15 </td>
                                            <td class="resolutiondate"> 27/Nov/07 19:15 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0.0-beta-1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
