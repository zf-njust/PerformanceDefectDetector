    <a class="issue-link" data-issue-key="IVY-618" href="https://issues.apache.org/jira/browse/IVY-618">IVY-618</a>
</td>
                                            <td class="summary"><p>
                NPE in case of eviction
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Gilles Scokart
    </td>
                                            <td class="creator">            Gilles Scokart
    </td>
                                            <td class="created"> 08/Oct/07 11:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Oct/07 14:20 </td>
                                            <td class="resolutiondate"> 08/Oct/07 14:20 </td>
                                            <td class="versions">                        2.0.0-beta-1            </td>
                                            <td class="fixVersions">                        2.0.0-beta-1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
