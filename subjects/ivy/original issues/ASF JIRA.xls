                <tr id="issuerow12383533" rel="12383533" data-issuekey="IVY-653" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-653" href="https://issues.apache.org/jira/browse/IVY-653">IVY-653</a>
</td>
                                            <td class="summary"><p>
                Only display unique circular dependencies during Resolve
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
