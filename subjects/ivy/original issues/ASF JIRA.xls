</td>
                                            <td class="summary"><p>
                &lt;ivy:settings&gt; task incorrectly reports a disallowed override
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Archie Cobbs
    </td>
                                            <td class="creator">            Archie Cobbs
    </td>
                                            <td class="created"> 20/Mar/08 17:37 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Mar/09 20:39 </td>
                                            <td class="resolutiondate"> 20/Mar/08 19:32 </td>
                                            <td class="versions">                        2.0.0-beta-2            </td>
                                            <td class="fixVersions">                        2.0-RC1            </td>
