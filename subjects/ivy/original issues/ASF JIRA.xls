    <a class="issue-link" data-issue-key="IVY-572" href="https://issues.apache.org/jira/browse/IVY-572">IVY-572</a>
</td>
                                            <td class="summary"><p>
                Standardise the attribute names
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
