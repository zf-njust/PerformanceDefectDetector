    </td>
                                            <td class="created"> 10/Jun/08 14:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Sep/08 09:30 </td>
                                            <td class="resolutiondate"> 04/Sep/08 09:26 </td>
