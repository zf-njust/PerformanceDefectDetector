                                            <td class="summary"><p>
                latest.integration dependecy may lead to stackoverflowexception
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Koen janssens
    </td>
                                            <td class="creator">            Koen janssens
    </td>
                                            <td class="created"> 19/Jul/05 11:31 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Sep/05 16:04 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:03 </td>
                                            <td class="versions">                        1.1            </td>
                                            <td class="fixVersions">                        1.2            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
