                <tr id="issuerow12356799" rel="12356799" data-issuekey="IVY-192" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-192" href="https://issues.apache.org/jira/browse/IVY-192">IVY-192</a>
</td>
                                            <td class="summary"><p>
                Pass artifact to repository when calling &quot;put&quot;
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Peter Hayes
    </td>
                                            <td class="creator">            Peter Hayes
    </td>
                                            <td class="created"> 07/Mar/06 17:48 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Sep/06 08:15 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:04 </td>
                                            <td class="versions">                        1.3-RC2            </td>
                                            <td class="fixVersions">                        1.4-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
