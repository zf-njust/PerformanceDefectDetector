</td>
                                            <td class="summary"><p>
                sftp/ssh/vfs-ftp resolver throws nullpointerexception if artifact not found
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Tycho Lamerigts
    </td>
