                <tr id="issuerow12412147" rel="12412147" data-issuekey="IVY-1002" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-1002" href="https://issues.apache.org/jira/browse/IVY-1002">IVY-1002</a>
</td>
                                            <td class="summary"><p>
                doc/settings/resolvers.html should contain example of how to add resolved into existing/default chain
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Pavel Savara
    </td>
                                            <td class="creator">            Pavel Savara
    </td>
                                            <td class="created"> 11/Jan/09 15:15 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jan/09 15:15 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0-RC2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Documentation            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Maybe something like this:<br/>
<br/>
&lt;ivysettings&gt;<br/>
    &lt;settings defaultResolver=&quot;default&quot;/&gt;<br/>
    &lt;include url=&quot;${ivy.default.conf.dir}/ivysettings-public.xml&quot;/&gt;<br/>
    &lt;include url=&quot;${ivy.default.conf.dir}/ivysettings-shared.xml&quot;/&gt;<br/>
    &lt;resolvers&gt;<br/>
        &lt;ibiblio name=&quot;robocode-public&quot; m2compatible=&quot;true&quot; root=&quot;http://robocode.sourceforge.net/maven2&quot;/&gt;<br/>
        &lt;chain name=&quot;web&quot; dual=&quot;true&quot;&gt;<br/>
            &lt;resolver ref=&quot;robocode-public&quot;/&gt;<br/>
            &lt;resolver ref=&quot;public&quot;/&gt;<br/>
        &lt;/chain&gt;<br/>
        &lt;chain name=&quot;main&quot; dual=&quot;true&quot;&gt;<br/>
            &lt;resolver ref=&quot;shared&quot;/&gt;<br/>
            &lt;resolver ref=&quot;web&quot;/&gt;<br/>
        &lt;/chain&gt;<br/>
    &lt;/resolvers&gt;<br/>
    &lt;include url=&quot;${ivy.default.conf.dir}/ivysettings-local.xml&quot;/&gt;<br/>
    &lt;include url=&quot;${ivy.default.conf.dir}/ivysettings-default-chain.xml&quot;/&gt;<br/>
&lt;/ivysettings&gt;<br/>
<br/>
BTW: quality of documentation is excellent :-)<br/>
Cheers!
  </td>
