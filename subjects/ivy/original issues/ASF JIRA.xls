                <tr id="issuerow12394836" rel="12394836" data-issuekey="IVY-810" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-810" href="https://issues.apache.org/jira/browse/IVY-810">IVY-810</a>
</td>
                                            <td class="summary"><p>
                Duplidate entries after a resolve.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            James Rosko
    </td>
                                            <td class="creator">            James Rosko
    </td>
                                            <td class="created"> 25/Apr/08 22:23 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/May/08 09:43 </td>
                                            <td class="resolutiondate"> 07/May/08 09:43 </td>
                                            <td class="versions">                        2.0.0-beta-2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
