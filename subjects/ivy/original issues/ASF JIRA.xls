                <tr id="issuerow12359341" rel="12359341" data-issuekey="IVY-359" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-359" href="https://issues.apache.org/jira/browse/IVY-359">IVY-359</a>
</td>
                                            <td class="summary"><p>
                Please typedef CacheResolver as &quot;cache&quot; for us
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
