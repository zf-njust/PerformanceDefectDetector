                                            <td class="summary"><p>
                Dependent jars missing in ivy binaries
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
