</td>
                                            <td class="reporter">            Jyri Kytömäki
    </td>
                                            <td class="creator">            Jyri Kytömäki
    </td>
                                            <td class="created"> 10/Oct/08 08:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Nov/13 09:59 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0-RC1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core,                     Maven Compatibility            </td>
