                <tr id="issuerow12363844" rel="12363844" data-issuekey="IVY-414" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-414" href="https://issues.apache.org/jira/browse/IVY-414">IVY-414</a>
</td>
                                            <td class="summary"><p>
                ivy html reports still seem to refer to images on http://ivy.jayasoft.org
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Gilles Scokart
    </td>
                                            <td class="reporter">            John Gill
    </td>
                                            <td class="creator">            John Gill
    </td>
                                            <td class="created"> 01/Mar/07 03:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Jun/08 09:59 </td>
                                            <td class="resolutiondate"> 25/Jun/08 09:59 </td>
                                            <td class="versions">                        1.4.1            </td>
                                            <td class="fixVersions">                        2.0-RC1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
