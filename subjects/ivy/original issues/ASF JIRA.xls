    <a class="issue-link" data-issue-key="IVY-130" href="https://issues.apache.org/jira/browse/IVY-130">IVY-130</a>
</td>
                                            <td class="summary"><p>
                Conflict badly solved in some complex case
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
