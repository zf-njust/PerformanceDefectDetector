                <tr id="issuerow12356894" rel="12356894" data-issuekey="IVY-287" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-287" href="https://issues.apache.org/jira/browse/IVY-287">IVY-287</a>
</td>
                                            <td class="summary"><p>
                Custom attributes and build list does not work
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Xavier Hanin
    </td>
                                            <td class="reporter">            Andreas Fester
    </td>
                                            <td class="creator">            Andreas Fester
    </td>
                                            <td class="created"> 05/Sep/06 15:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Sep/06 14:28 </td>
                                            <td class="resolutiondate"> 26/Nov/06 07:05 </td>
                                            <td class="versions">                        1.4-RC1            </td>
                                            <td class="fixVersions">                        1.4-RC1            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    17/Nov/06
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
