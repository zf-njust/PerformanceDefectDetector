                                            <td class="resolutiondate"> 03/Apr/08 11:28 </td>
                                            <td class="versions">                        1.4-RC1            </td>
                                            <td class="fixVersions">                        2.0-RC1            </td>
                                            <td class="components">                        Core            </td>
