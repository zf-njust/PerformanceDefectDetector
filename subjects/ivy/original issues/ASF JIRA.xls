                <tr id="issuerow12356725" rel="12356725" data-issuekey="IVY-117" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-117" href="https://issues.apache.org/jira/browse/IVY-117">IVY-117</a>
</td>
                                            <td class="summary"><p>
                stack overflow error in some conflicts cases
