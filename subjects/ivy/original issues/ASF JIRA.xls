                <tr id="issuerow12356721" rel="12356721" data-issuekey="IVY-113" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-113" href="https://issues.apache.org/jira/browse/IVY-113">IVY-113</a>
</td>
                                            <td class="summary"><p>
                Artifact pattern list attribute for the ivy:publish
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
