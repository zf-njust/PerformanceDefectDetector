                <tr id="issuerow12367208" rel="12367208" data-issuekey="IVY-474" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-474" href="https://issues.apache.org/jira/browse/IVY-474">IVY-474</a>
</td>
                                            <td class="summary"><p>
                Strict conflictmanager seems to not support dynamic revisions
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Robert Macaulay
    </td>
                                            <td class="creator">            Robert Macaulay
    </td>
                                            <td class="created"> 14/Apr/07 19:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Dec/07 20:09 </td>
                                            <td class="resolutiondate"> 06/Dec/07 23:25 </td>
                                            <td class="versions">                        1.4.2,                     2.0.0-alpha-2            </td>
                                            <td class="fixVersions">                        2.0.0-beta-2            </td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">2</td>
