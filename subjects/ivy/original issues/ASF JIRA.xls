                <tr id="issuerow12381140" rel="12381140" data-issuekey="IVY-632" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-632" href="https://issues.apache.org/jira/browse/IVY-632">IVY-632</a>
</td>
                                            <td class="summary"><p>
                support changing organisations
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
