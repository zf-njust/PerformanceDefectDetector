                <tr id="issuerow12405067" rel="12405067" data-issuekey="IVY-919" class="issuerow">
                                            <td class="project">    Ivy
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-919" href="https://issues.apache.org/jira/browse/IVY-919">IVY-919</a>
</td>
                                            <td class="summary"><p>
                build.xml: checkstyle + checkstyle-report dont work together
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maarten Coene
    </td>
                                            <td class="reporter">            Jan Matèrne
    </td>
                                            <td class="creator">            Jan Matèrne
    </td>
                                            <td class="created"> 24/Sep/08 12:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Sep/08 21:38 </td>
                                            <td class="resolutiondate"> 24/Sep/08 21:38 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
