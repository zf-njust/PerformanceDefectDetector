                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 14/May/07 10:12 </td>
                                            <td class="resolutiondate"> 14/May/07 10:12 </td>
                                            <td class="versions">                        2.0.0-alpha-1            </td>
                                            <td class="fixVersions">                        2.0.0-alpha-2            </td>
