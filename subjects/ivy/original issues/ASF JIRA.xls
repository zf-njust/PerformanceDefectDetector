</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="IVY-643" href="https://issues.apache.org/jira/browse/IVY-643">IVY-643</a>
</td>
                                            <td class="summary"><p>
                Ship ivy with commons-vfs-sandbox.jar, because it provides the webdav support
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ivan &quot;Rambius&quot; Ivanov
    </td>
                                            <td class="creator">            Ivan &quot;Rambius&quot; Ivanov
    </td>
                                            <td class="created"> 15/Nov/07 17:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Jun/09 07:36 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0.0-alpha-2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Core            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
