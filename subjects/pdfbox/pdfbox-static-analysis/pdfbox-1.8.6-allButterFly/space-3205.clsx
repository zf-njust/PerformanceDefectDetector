<cluster>
<group name="root">
<item name="org.apache.pdfbox.pdmodel.markedcontent.PDPropertyList.putMapping(COSName, COSDictionary)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.pdfbox.pdmodel.markedcontent.PDPropertyList.putMapping(COSName, PDOptionalContentGroup)" />
</group>
<group name="Layer-2">
<item name="org.apache.pdfbox.pdmodel.graphics.optionalcontent.PDOptionalContentGroup.getCOSObject()" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.pdfbox.cos.COSDictionary.setItem(COSName, COSBase)" />
</group>
<group name="Layer-2">
<item name="org.apache.pdfbox.cos.COSDictionary.removeItem(COSName)" />
</group>
</group>
</group>
</cluster>
