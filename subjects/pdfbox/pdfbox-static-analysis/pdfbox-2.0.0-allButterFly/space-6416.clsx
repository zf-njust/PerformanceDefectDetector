<cluster>
<group name="root">
<item name="org.apache.pdfbox.cos.COSDocument.getObjectByType(COSName)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.pdfbox.cos.COSDocument.getCatalog()" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.pdfbox.cos.COSName.equals(Object)" />
<item name="org.apache.pdfbox.cos.COSDictionary.getItem(COSName)" />
<item name="org.apache.pdfbox.cos.COSObject.getObject()" />
</group>
</group>
</group>
</cluster>
