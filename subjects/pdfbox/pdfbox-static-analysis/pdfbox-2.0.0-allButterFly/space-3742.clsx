<cluster>
<group name="root">
<item name="org.apache.pdfbox.text.PDFTextStripper.writeWordSeparator()" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.pdfbox.text.PDFTextStripper.writeLine(List)" />
</group>
<group name="Layer-2">
<item name="org.apache.pdfbox.text.PDFTextStripper.writeString(String, List)" />
<item name="org.apache.pdfbox.text.PDFTextStripper.WordWithTextPositions.getText()" />
<item name="org.apache.pdfbox.text.PDFTextStripper.WordWithTextPositions.getTextPositions()" />
</group>
<group name="Layer-3">
<item name="org.apache.pdfbox.text.PDFTextStripper.writeString(String)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.pdfbox.text.PDFTextStripper.getWordSeparator()" />
</group>
</group>
</group>
</cluster>
