<cluster>
<group name="root">
<item name="org.apache.pdfbox.cos.COSDictionary.containsKey(String)" />
<group name="upper">
<group name="Layer-1">
<item name="org.apache.pdfbox.preflight.font.descriptor.FontDescriptorHelper.checkMandatoryFields(COSDictionary)" />
</group>
<group name="Layer-2">
<item name="org.apache.pdfbox.preflight.ValidationResult.ValidationError.ValidationError(String, String)" />
<item name="org.apache.pdfbox.preflight.font.container.FontContainer.push(ValidationError)" />
</group>
<group name="Layer-3">
<item name="org.apache.pdfbox.preflight.ValidationResult.ValidationError.ValidationError(String)" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.pdfbox.cos.COSDictionary.containsKey(COSName)" />
<item name="org.apache.pdfbox.cos.COSName.getPDFName(String)" />
</group>
<group name="Layer-2">
<item name="org.apache.pdfbox.cos.COSName.COSName(String, boolean)" />
</group>
</group>
</group>
</cluster>
