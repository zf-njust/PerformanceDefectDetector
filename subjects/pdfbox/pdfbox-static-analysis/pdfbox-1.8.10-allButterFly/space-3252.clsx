<item name="org.apache.pdfbox.PDFBox.showMessageAndExit()" />
</group>
<group name="Layer-2">
<item name="org.apache.pdfbox.Version.usage()" />
</group>
</group>
<group name="lower">
<group name="Layer-1">
<item name="org.apache.pdfbox.util.ResourceLoader.loadProperties(String, boolean)" />
</group>
<group name="Layer-2">
<item name="org.apache.pdfbox.util.ResourceLoader.loadResource(String)" />
</group>
</group>
</group>
</cluster>
