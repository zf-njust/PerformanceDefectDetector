                <tr id="issuerow12508388" rel="12508388" data-issuekey="PDFBOX-1018" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1018" href="https://issues.apache.org/jira/browse/PDFBOX-1018">PDFBOX-1018</a>
</td>
                                            <td class="summary"><p>
                Remove imageIO dependency (was: PDPage convertToImage bug creates white images from black and white pdf files.)
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Roland Quast
    </td>
                                            <td class="creator">            Roland Quast
    </td>
                                            <td class="created"> 26/May/11 05:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/May/11 05:29 </td>
                                            <td class="resolutiondate"> 30/May/11 05:29 </td>
                                            <td class="versions">                        1.2.0,                     1.2.1,                     1.3.1,                     1.4.0,                     1.5.0            </td>
                                            <td class="fixVersions">                        1.6.0            </td>
                                            <td class="components">    &nbsp;
</td>
