</td>
                                            <td class="summary"><p>
                The font gets gibbrish when adding a line of text to an existing PDF with a table
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Anita Kulkarni
    </td>
                                            <td class="creator">            Anita Kulkarni
    </td>
                                            <td class="created"> 22/Oct/13 14:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Nov/13 17:02 </td>
                                            <td class="resolutiondate"> 26/Oct/13 09:41 </td>
                                            <td class="versions">                        1.8.2            </td>
                                            <td class="fixVersions">                        1.8.3,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
