    <a class="issue-link" data-issue-key="PDFBOX-1229" href="https://issues.apache.org/jira/browse/PDFBOX-1229">PDFBOX-1229</a>
</td>
                                            <td class="summary"><p>
                PDFBox: PDFReader invokes heap memory exception while loading big documents
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
