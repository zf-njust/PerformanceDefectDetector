                <tr id="issuerow12545560" rel="12545560" data-issuekey="PDFBOX-1248" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1248" href="https://issues.apache.org/jira/browse/PDFBOX-1248">PDFBOX-1248</a>
</td>
                                            <td class="summary"><p>
                PDNumberTreeNode method setNumbers( Map numbers ) sets the key for the for the Nums dictionary entry to Names rather than Nums
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Sheila Morrissey
    </td>
                                            <td class="creator">            Sheila Morrissey
    </td>
                                            <td class="created"> 07/Mar/12 21:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/May/12 16:21 </td>
                                            <td class="resolutiondate"> 13/Mar/12 22:15 </td>
                                            <td class="versions">                        1.6.0            </td>
                                            <td class="fixVersions">                        1.7.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
