	at com.biosignia.framework.functionalTests.webServices.TestPDFBox.main(TestPDFBox.java:12)<br/>
Caused by: java.lang.ClassCastException: org.apache.pdfbox.cos.COSInteger cannot be cast to org.apache.pdfbox.cos.COSObject<br/>
	at org.apache.pdfbox.pdfparser.PDFParser.readVersionInTrailer(PDFParser.java:859)<br/>
	at org.apache.pdfbox.pdfparser.PDFParser.parseTrailer(PDFParser.java:845)<br/>
	at org.apache.pdfbox.pdfparser.PDFParser.parseObject(PDFParser.java:502)<br/>
	at org.apache.pdfbox.pdfparser.PDFParser.parse(PDFParser.java:194)<br/>
	... 4 more<br/>
{code&gt;
