                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Jul/15 06:35 </td>
                                            <td class="resolutiondate"> 25/May/15 15:22 </td>
                                            <td class="versions">                        1.8.2,                     1.8.9,                     1.8.10            </td>
                                            <td class="fixVersions">                        1.8.10,                     2.0.0            </td>
                                            <td class="components">                        Preflight,                     XmpBox            </td>
                                            <td class="duedate">    &nbsp;
</td>
