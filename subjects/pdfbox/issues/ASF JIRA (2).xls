                                            <td class="summary"><p>
                White page when converting first page to image
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Hong-Thai Nguyen
    </td>
                                            <td class="creator">            Hong-Thai Nguyen
    </td>
                                            <td class="created"> 25/Mar/14 14:25 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:07 </td>
                                            <td class="resolutiondate"> 25/Mar/14 17:29 </td>
                                            <td class="versions">                        1.8.4            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
