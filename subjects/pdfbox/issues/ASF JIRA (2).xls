                <tr id="issuerow12649902" rel="12649902" data-issuekey="PDFBOX-1615" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1615" href="https://issues.apache.org/jira/browse/PDFBOX-1615">PDFBOX-1615</a>
</td>
                                            <td class="summary"><p>
                Color map not correctly copied when PDF file is split
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Tom Taylor
    </td>
                                            <td class="creator">            Tom Taylor
    </td>
                                            <td class="created"> 29/May/13 12:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/Jun/13 13:35 </td>
                                            <td class="resolutiondate"> 29/May/13 18:01 </td>
                                            <td class="versions">                        1.8.1            </td>
                                            <td class="fixVersions">                        1.8.2            </td>
                                            <td class="components">                        PDModel,                     Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
