    <a class="issue-link" data-issue-key="PDFBOX-1360" href="https://issues.apache.org/jira/browse/PDFBOX-1360">PDFBOX-1360</a>
</td>
                                            <td class="summary"><p>
                Adding page from one doc to another (as a layer) results in faulty doc
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Tobias Skarman
    </td>
                                            <td class="creator">            Tobias Skarman
    </td>
                                            <td class="created"> 20/Jul/12 21:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Oct/14 18:50 </td>
                                            <td class="resolutiondate"> 13/Oct/14 18:50 </td>
                                            <td class="versions">                        1.7.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
