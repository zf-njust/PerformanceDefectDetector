    <a class="issue-link" data-issue-key="PDFBOX-1060" href="https://issues.apache.org/jira/browse/PDFBOX-1060">PDFBOX-1060</a>
</td>
                                            <td class="summary"><p>
                convertToImage includes &quot;ghost&quot; annotation outlines
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Gilad Denneboom
    </td>
                                            <td class="creator">            Gilad Denneboom
    </td>
                                            <td class="created"> 11/Jul/11 10:08 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Dec/14 14:15 </td>
                                            <td class="resolutiondate"> 10/Nov/14 11:27 </td>
                                            <td class="versions">                        1.8.7,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.8,                     2.0.0            </td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
