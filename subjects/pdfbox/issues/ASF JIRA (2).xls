    <a class="issue-link" data-issue-key="PDFBOX-1716" href="https://issues.apache.org/jira/browse/PDFBOX-1716">PDFBOX-1716</a>
</td>
                                            <td class="summary"><p>
                PDDocument.getNumberOfPages() return 0 for certain PDF document
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Tom
    </td>
