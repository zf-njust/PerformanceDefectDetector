    <a class="issue-link" data-issue-key="PDFBOX-1278" href="https://issues.apache.org/jira/browse/PDFBOX-1278">PDFBOX-1278</a>
</td>
                                            <td class="summary"><p>
                PDF file containing PDCIDFontType0 (PDType1CFont) does not render correctly to image
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Hamed Iravanchi
    </td>
                                            <td class="creator">            Hamed Iravanchi
    </td>
