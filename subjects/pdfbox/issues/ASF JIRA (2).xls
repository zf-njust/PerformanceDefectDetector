                <tr id="issuerow12529659" rel="12529659" data-issuekey="PDFBOX-1154" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1154" href="https://issues.apache.org/jira/browse/PDFBOX-1154">PDFBOX-1154</a>
</td>
                                            <td class="summary"><p>
                pdfbox exports 1200+ images from a pdf instead of one
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Pontus Hulin
    </td>
                                            <td class="creator">            Pontus Hulin
    </td>
                                            <td class="created"> 01/Nov/11 14:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Jul/14 18:10 </td>
                                            <td class="resolutiondate"> 28/Jul/14 18:10 </td>
                                            <td class="versions">                        1.6.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Rendering,                     Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
