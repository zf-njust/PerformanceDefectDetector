    <a class="issue-link" data-issue-key="PDFBOX-1886" href="https://issues.apache.org/jira/browse/PDFBOX-1886">PDFBOX-1886</a>
</td>
                                            <td class="summary"><p>
                Merge Function strips OCR layer in acrobat
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
