    <a class="issue-link" data-issue-key="PDFBOX-1587" href="https://issues.apache.org/jira/browse/PDFBOX-1587">PDFBOX-1587</a>
</td>
                                            <td class="summary"><p>
                 Update the dependency on Bouncy Castle to 1.48
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
