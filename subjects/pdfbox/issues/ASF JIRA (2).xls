                <tr id="issuerow12604215" rel="12604215" data-issuekey="PDFBOX-1394" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1394" href="https://issues.apache.org/jira/browse/PDFBOX-1394">PDFBOX-1394</a>
</td>
                                            <td class="summary"><p>
                Image streams are lost when adding new images to page
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Juraj Lonc
    </td>
                                            <td class="creator">            Juraj Lonc
    </td>
                                            <td class="created"> 21/Aug/12 13:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Mar/13 12:56 </td>
                                            <td class="resolutiondate"> 23/Aug/12 15:46 </td>
                                            <td class="versions">                        1.7.1            </td>
                                            <td class="fixVersions">                        1.8.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
