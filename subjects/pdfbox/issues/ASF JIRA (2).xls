    <a class="issue-link" data-issue-key="PDFBOX-1798" href="https://issues.apache.org/jira/browse/PDFBOX-1798">PDFBOX-1798</a>
</td>
                                            <td class="summary"><p>
                Performance problem with PDDocument.saveIncremental (when signing document)
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
