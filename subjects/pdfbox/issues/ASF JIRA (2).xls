    <a class="issue-link" data-issue-key="PDFBOX-1593" href="https://issues.apache.org/jira/browse/PDFBOX-1593">PDFBOX-1593</a>
</td>
                                            <td class="summary"><p>
                Adobe encrypted document doesn&#39;t parse correct (Acrobat 9 compatibility)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">            Thomas Chojecki
    </td>
