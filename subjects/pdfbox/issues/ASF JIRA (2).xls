                                            <td class="summary"><p>
                Empty pages after rendering images: org.apache.pdfbox.util.operator.pagedrawer.Invoke
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
