    <a class="issue-link" data-issue-key="PDFBOX-1215" href="https://issues.apache.org/jira/browse/PDFBOX-1215">PDFBOX-1215</a>
</td>
                                            <td class="summary"><p>
                Can not render PDF with Simplified Chinese due to changing font to the default font
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
