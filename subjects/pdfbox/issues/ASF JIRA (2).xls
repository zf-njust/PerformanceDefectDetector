                <tr id="issuerow12605984" rel="12605984" data-issuekey="PDFBOX-1405" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1405" href="https://issues.apache.org/jira/browse/PDFBOX-1405">PDFBOX-1405</a>
</td>
                                            <td class="summary"><p>
                Non-Ascii chars are not decoded correctly by pdfbox but works fine with pdftotext
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
