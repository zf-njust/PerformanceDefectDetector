    <a class="issue-link" data-issue-key="PDFBOX-1578" href="https://issues.apache.org/jira/browse/PDFBOX-1578">PDFBOX-1578</a>
</td>
                                            <td class="summary"><p>
                The English Words are shown as Symbols and wrongly displayed 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
