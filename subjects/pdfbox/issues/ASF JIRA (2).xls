                <tr id="issuerow12696935" rel="12696935" data-issuekey="PDFBOX-1938" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1938" href="https://issues.apache.org/jira/browse/PDFBOX-1938">PDFBOX-1938</a>
</td>
                                            <td class="summary"><p>
                PDF2Image gives garbled text in image
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ed Sawdon
    </td>
                                            <td class="creator">            Ed Sawdon
    </td>
                                            <td class="created"> 24/Feb/14 15:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 24/Feb/14 17:44 </td>
                                            <td class="resolutiondate"> 24/Feb/14 17:44 </td>
                                            <td class="versions">                        1.8.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
