</td>
                                            <td class="summary"><p>
                Missing character encoding in MacRoman &amp; WinAnsi
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Eric Leleu
    </td>
                                            <td class="reporter">            Eric Leleu
    </td>
                                            <td class="creator">            Eric Leleu
    </td>
                                            <td class="created"> 10/Jul/12 19:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Jun/14 13:01 </td>
                                            <td class="resolutiondate"> 10/Jul/12 19:06 </td>
                                            <td class="versions">                        1.7.0            </td>
                                            <td class="fixVersions">                        1.7.1            </td>
