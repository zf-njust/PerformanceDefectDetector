    <a class="issue-link" data-issue-key="PDFBOX-1701" href="https://issues.apache.org/jira/browse/PDFBOX-1701">PDFBOX-1701</a>
</td>
                                            <td class="summary"><p>
                Better font than the standard font
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
