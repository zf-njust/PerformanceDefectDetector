    <a class="issue-link" data-issue-key="PDFBOX-1540" href="https://issues.apache.org/jira/browse/PDFBOX-1540">PDFBOX-1540</a>
</td>
                                            <td class="summary"><p>
                Add XML output option to preflight
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Guillaume Bailleul
    </td>
                                            <td class="reporter">            William Palmer
    </td>
                                            <td class="creator">            William Palmer
    </td>
                                            <td class="created"> 13/Mar/13 11:02 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Nov/13 17:02 </td>
                                            <td class="resolutiondate"> 18/Jun/13 09:46 </td>
                                            <td class="versions">                        1.8.0            </td>
                                            <td class="fixVersions">                        1.8.3,                     2.0.0            </td>
