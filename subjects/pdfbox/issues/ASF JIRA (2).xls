    <a class="issue-link" data-issue-key="PDFBOX-1642" href="https://issues.apache.org/jira/browse/PDFBOX-1642">PDFBOX-1642</a>
</td>
                                            <td class="summary"><p>
                NPE when parsing XMP schema definition with &quot;closed Choice&quot; value type
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Petras
    </td>
                                            <td class="creator">            Petras
    </td>
