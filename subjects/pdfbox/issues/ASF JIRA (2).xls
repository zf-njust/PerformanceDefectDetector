<br/>
	$jar = &quot;pdf_lib/pdf_box/lib/pdfbox-app-1.8.2.jar&quot;;<br/>
	$pdf_box = new PDFBox\PDFBox($jar);<br/>
	$extract_text = new PDFBox\ExtractText($pdf_box);<br/>
<br/>
	$extract_text-&gt;parse($pdfLocation);<br/>
<br/>

