</td>
                                            <td class="aggregatetimespent"></td>
                                            <td class="aggregatetimeestimate"></td>
                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    </td>
                                            <td class="customfield_12310220">            <span title="06/Dec/12 20:15"><time class="livestamp allow-future" datetime="2012-12-06T20:15:58+0000">06/Dec/12 8:15 PM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
                                            <td class="customfield_12312520"></td>
                                            <td class="customfield_12312323"></td>
                                            <td class="customfield_12312521">    4 years, 28 weeks, 4 days ago

                        </td>
                                            <td class="customfield_12312320"></td>
                                            <td class="customfield_12310420">      257846
  </td>
