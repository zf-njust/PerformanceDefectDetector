</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      We use the PDFMergerUtility to add cover pages to documents automatically. We&#39;re finding that when we do so, it strips the OCR data from the source of the merged files.<br/>
<br/>
{code}<br/>
        PDFMergerUtility merger = new PDFMergerUtility();<br/>
        File outputFile = File.createTempFile();        merger.setDestinationStream(new FileOutputStream(outputFile));<br/>
        for (File file : files) {<br/>
            merger.addSource(file);<br/>
        }<br/>
        merger.mergeDocuments();<br/>
        return outputFile;<br/>
{code}
  </td>
