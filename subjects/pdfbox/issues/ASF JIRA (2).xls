                <tr id="issuerow12525493" rel="12525493" data-issuekey="PDFBOX-1127" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1127" href="https://issues.apache.org/jira/browse/PDFBOX-1127">PDFBOX-1127</a>
</td>
                                            <td class="summary"><p>
                PDF supplies glyph-&gt;unicode mapping, but PDFBox doesn&#39;t use it.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Robert Muir
    </td>
                                            <td class="creator">            Robert Muir
    </td>
                                            <td class="created"> 02/Oct/11 20:08 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/May/13 02:29 </td>
                                            <td class="resolutiondate"> 03/Oct/11 15:23 </td>
                                            <td class="versions">                        1.7.0            </td>
                                            <td class="fixVersions">                        1.7.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
