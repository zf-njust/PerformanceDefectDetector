                <tr id="issuerow12670304" rel="12670304" data-issuekey="PDFBOX-1725" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1725" href="https://issues.apache.org/jira/browse/PDFBOX-1725">PDFBOX-1725</a>
</td>
                                            <td class="summary"><p>
                Character rendered at wrong position
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
