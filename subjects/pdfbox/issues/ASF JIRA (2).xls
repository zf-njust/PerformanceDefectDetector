    <a class="issue-link" data-issue-key="PDFBOX-1079" href="https://issues.apache.org/jira/browse/PDFBOX-1079">PDFBOX-1079</a>
</td>
                                            <td class="summary"><p>
                TestCOSFloat occasionally fails: Is something wrong with my machine?
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Guillaume Bailleul
    </td>
                                            <td class="reporter">            Aaron Stewart
    </td>
                                            <td class="creator">            Aaron Stewart
    </td>
                                            <td class="created"> 29/Jul/11 19:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Aug/11 09:43 </td>
                                            <td class="resolutiondate"> 15/Aug/11 09:43 </td>
                                            <td class="versions">                        1.7.0            </td>
                                            <td class="fixVersions">                        1.7.0            </td>
                                            <td class="components">    &nbsp;
</td>
