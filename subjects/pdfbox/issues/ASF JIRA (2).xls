                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Sébastien Dailly
    </td>
                                            <td class="creator">            Sébastien Dailly
    </td>
                                            <td class="created"> 15/Nov/11 13:53 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/May/13 12:12 </td>
                                            <td class="resolutiondate"> 19/May/13 12:12 </td>
                                            <td class="versions">                        1.6.0,                     1.7.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
