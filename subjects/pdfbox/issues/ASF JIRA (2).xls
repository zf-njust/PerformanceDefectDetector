    <a class="issue-link" data-issue-key="PDFBOX-1111" href="https://issues.apache.org/jira/browse/PDFBOX-1111">PDFBOX-1111</a>
</td>
                                            <td class="summary"><p>
                Add Duplex and PrintScaling to viewer preferences
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
