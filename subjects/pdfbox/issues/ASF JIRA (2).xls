</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Windows 7, Eclipse Helios SR2
  </td>
                                            <td class="description">      When using PDPage.convertToImage() to export PNG files of pages with annotations on them, &quot;ghost&quot; outlines of the annotations sometimes appear on the generated image. The outlines do not correspond to the location of the annotations. See the attached files.<br/>
<br/>
Code used:<br/>
<br/>
		String inputFilePath = &quot;C:/Gilad/input/3 Pages from batch_sequences.pdf&quot;;<br/>
		<br/>
		PDDocument doc = PDDocument.load(inputFilePath);<br/>
<br/>
		for (int p=0; p&lt;doc.getNumberOfPages(); p++) {<br/>
<br/>
		    PDPage page = (PDPage) doc.getDocumentCatalog().getAllPages().get(p);<br/>
		    BufferedImage bImg = page.convertToImage();<br/>
		    String imagePath = FilenameUtils.getFullPath(inputFilePath) + &quot;PAGE&quot;+ Integer.toString(p) + &quot;.png&quot;;<br/>
		    File yourImageFile = new File(imagePath);<br/>
		    ImageIO.write(bImg,&quot;png&quot;,yourImageFile);<br/>
		}
  </td>
