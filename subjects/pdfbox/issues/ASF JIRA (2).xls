                                            <td class="resolutiondate"> 24/Apr/14 18:55 </td>
                                            <td class="versions">                        1.6.0            </td>
                                            <td class="fixVersions">                        1.8.5,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
