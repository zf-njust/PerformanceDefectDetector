    </td>
                                            <td class="created"> 12/Sep/13 09:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Oct/13 18:00 </td>
                                            <td class="resolutiondate"> 28/Oct/13 18:00 </td>
                                            <td class="versions">                        1.8.2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
