</td>
                                            <td class="summary"><p>
                PDFParser should set &quot;direct&quot; property in COSBase if this object is direct
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Petras
    </td>
                                            <td class="creator">            Petras
    </td>
                                            <td class="created"> 18/May/12 08:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Feb/14 19:01 </td>
                                            <td class="resolutiondate"> 14/Nov/13 22:05 </td>
                                            <td class="versions">                        1.6.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
