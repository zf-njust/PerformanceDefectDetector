    <a class="issue-link" data-issue-key="PDFBOX-1818" href="https://issues.apache.org/jira/browse/PDFBOX-1818">PDFBOX-1818</a>
</td>
                                            <td class="summary"><p>
                Push back buffer is full error
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
