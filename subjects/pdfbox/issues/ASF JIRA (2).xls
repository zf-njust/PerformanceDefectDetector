    <a class="issue-link" data-issue-key="PDFBOX-1894" href="https://issues.apache.org/jira/browse/PDFBOX-1894">PDFBOX-1894</a>
</td>
                                            <td class="summary"><p>
                Images from XIPLAYER0 xobject not being extracted 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
