</td>
                                            <td class="summary"><p>
                Merging PDFs with interactive forms produces incorrect result
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maruan Sahyoun
    </td>
                                            <td class="reporter">            Gerhard Temper
    </td>
