                <tr id="issuerow12648354" rel="12648354" data-issuekey="PDFBOX-1603" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1603" href="https://issues.apache.org/jira/browse/PDFBOX-1603">PDFBOX-1603</a>
</td>
                                            <td class="summary"><p>
                Regression in PDDocument.loadNonSeq ?
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
