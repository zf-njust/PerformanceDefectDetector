                <tr id="issuerow12630873" rel="12630873" data-issuekey="PDFBOX-1508" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1508" href="https://issues.apache.org/jira/browse/PDFBOX-1508">PDFBOX-1508</a>
</td>
                                            <td class="summary"><p>
                Extracting page causes incorrect clipping
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Adina Toma
    </td>
                                            <td class="creator">            Adina Toma
    </td>
                                            <td class="created"> 05/Feb/13 13:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Mar/13 09:58 </td>
                                            <td class="resolutiondate"> 09/Mar/13 15:40 </td>
                                            <td class="versions">                        1.7.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Parsing,                     Swing GUI            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
