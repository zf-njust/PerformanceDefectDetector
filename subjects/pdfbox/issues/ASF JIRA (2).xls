                <tr id="issuerow12662911" rel="12662911" data-issuekey="PDFBOX-1687" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1687" href="https://issues.apache.org/jira/browse/PDFBOX-1687">PDFBOX-1687</a>
</td>
                                            <td class="summary"><p>
                add dispose() in pdfbox\pdmodel\PDPage.convertToImage()
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 09/Aug/13 18:28 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Nov/13 17:02 </td>
                                            <td class="resolutiondate"> 25/Aug/13 14:40 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        1.8.3,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      I suggest to add these two lines at the end of pdfbox\pdmodel\PDPage.convertToImage()<br/>
<br/>
        drawer.dispose();<br/>
        graphics.dispose();<br/>
<br/>
This would speed up cleanup after rendering. (Alternatively, delete the PageDrawer.dispose() function, because it is never used)
  </td>
