                <tr id="issuerow12548680" rel="12548680" data-issuekey="PDFBOX-1273" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1273" href="https://issues.apache.org/jira/browse/PDFBOX-1273">PDFBOX-1273</a>
</td>
                                            <td class="summary"><p>
                java.io.IOException: Error: Unknown annotation type null
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            William
    </td>
                                            <td class="creator">            William
    </td>
                                            <td class="created"> 29/Mar/12 14:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Dec/14 14:15 </td>
                                            <td class="resolutiondate"> 23/Oct/14 17:43 </td>
                                            <td class="versions">                        1.7.0,                     1.8.7,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.8,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
