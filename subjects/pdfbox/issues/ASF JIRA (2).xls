    <a class="issue-link" data-issue-key="PDFBOX-1596" href="https://issues.apache.org/jira/browse/PDFBOX-1596">PDFBOX-1596</a>
</td>
                                            <td class="summary"><p>
                OverlayPDF logic should be moved into a library class
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            James Green
    </td>
                                            <td class="creator">            James Green
    </td>
                                            <td class="created"> 08/May/13 11:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/Jul/14 12:34 </td>
                                            <td class="resolutiondate"> 12/Jun/14 18:33 </td>
                                            <td class="versions">                        1.8.1            </td>
                                            <td class="fixVersions">                        1.8.6,                     2.0.0            </td>
                                            <td class="components">                        Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
