    <a class="issue-link" data-issue-key="PDFBOX-1922" href="https://issues.apache.org/jira/browse/PDFBOX-1922">PDFBOX-1922</a>
</td>
                                            <td class="summary"><p>
                NonSequentialParser not reading version in header and trailer
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Tim Allison
    </td>
                                            <td class="creator">            Tim Allison
    </td>
