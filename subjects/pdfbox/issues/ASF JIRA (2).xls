    <a class="issue-link" data-issue-key="PDFBOX-1057" href="https://issues.apache.org/jira/browse/PDFBOX-1057">PDFBOX-1057</a>
</td>
                                            <td class="summary"><p>
                PDXObjectImage create diferences between pdf on mac and windows
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Jose robles
    </td>
                                            <td class="creator">            Jose robles
    </td>
                                            <td class="created"> 01/Jul/11 17:00 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Jan/12 16:48 </td>
                                            <td class="resolutiondate"> 31/Jan/12 16:48 </td>
                                            <td class="versions">                        1.5.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
