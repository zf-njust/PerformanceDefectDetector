    <a class="issue-link" data-issue-key="PDFBOX-1796" href="https://issues.apache.org/jira/browse/PDFBOX-1796">PDFBOX-1796</a>
</td>
                                            <td class="summary"><p>
                Infiniteloop BaseParser.java:1010
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Manfred Schauer
    </td>
                                            <td class="creator">            Manfred Schauer
    </td>
                                            <td class="created"> 05/Dec/13 14:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Jan/14 06:46 </td>
                                            <td class="resolutiondate"> 06/Dec/13 21:04 </td>
                                            <td class="versions">                        1.8.3            </td>
                                            <td class="fixVersions">                        1.8.4,                     2.0.0            </td>
                                            <td class="components">                        Parsing            </td>
