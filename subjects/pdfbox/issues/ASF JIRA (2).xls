                                            <td class="versions">                        1.8.2            </td>
                                            <td class="fixVersions">                        1.8.6,                     2.0.0            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
