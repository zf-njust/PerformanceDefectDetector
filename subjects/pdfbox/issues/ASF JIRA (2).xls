    <a class="issue-link" data-issue-key="PDFBOX-1588" href="https://issues.apache.org/jira/browse/PDFBOX-1588">PDFBOX-1588</a>
</td>
                                            <td class="summary"><p>
                Performance problem with ResourceLoader while running in WebStart environment
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Unresolved
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Mirko Sertic
    </td>
                                            <td class="creator">            Mirko Sertic
    </td>
                                            <td class="created"> 30/Apr/13 18:43 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Feb/14 23:12 </td>
                                            <td class="resolutiondate"> 08/Feb/14 18:26 </td>
                                            <td class="versions">                        1.7.1,                     1.8.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
