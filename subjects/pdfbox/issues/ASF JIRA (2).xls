    <a class="issue-link" data-issue-key="PDFBOX-1183" href="https://issues.apache.org/jira/browse/PDFBOX-1183">PDFBOX-1183</a>
</td>
                                            <td class="summary"><p>
                RenderingProblem at PDFReader
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
