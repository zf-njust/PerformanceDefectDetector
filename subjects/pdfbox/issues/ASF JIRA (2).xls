try{<br/>
            <br/>
            PDDocument pd=PDDocument.load(new File(&quot;Data/BookShelf/AVI/DEFAULT/apa_editorial_style.pdf&quot;));<br/>
            List allPages = pd.getDocumentCatalog().getAllPages(); <br/>
            System.out.println(&quot;Number of Pages :&quot;+pd.getNumberOfPages());<br/>
            PDFPagePanel p=new PDFPagePanel();<br/>
            PDPage firstPage = null;<br/>
            if(allPages.size()&gt;0){<br/>
                 firstPage = (PDPage)allPages.get(0);<br/>
                 p.setPage(firstPage);<br/>
                 read.add(p); // read is a JPanel<br/>
                 jScrollPane1.setViewportView(p);<br/>
                 pd.close();<br/>
