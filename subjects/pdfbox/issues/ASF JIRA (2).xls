</td>
                                            <td class="summary"><p>
                __NSAutoreleaseNoPool messages in headless mode on Mac OS X
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
