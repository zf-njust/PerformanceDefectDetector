                <tr id="issuerow12600561" rel="12600561" data-issuekey="PDFBOX-1367" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1367" href="https://issues.apache.org/jira/browse/PDFBOX-1367">PDFBOX-1367</a>
</td>
                                            <td class="summary"><p>
                Do not generate preflight jar with dependencies at each build
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Guillaume Bailleul
    </td>
                                            <td class="creator">            Guillaume Bailleul
    </td>
                                            <td class="created"> 28/Jul/12 14:36 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/May/13 02:30 </td>
                                            <td class="resolutiondate"> 10/Mar/13 18:34 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.8.0            </td>
                                            <td class="components">                        Preflight            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        PDFBOX-1531                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      Each time pdfbox is built, a big jar is created in preflight module containing all dependencies of preflight.<br/>
<br/>
I propose to not generate this jar by default (see patch).<br/>
<br/>
To create this jar, useful when testing pdf/a files, only use the mvn command line :<br/>
<br/>
mvn package -DskipAssembly=false<br/>

  </td>
