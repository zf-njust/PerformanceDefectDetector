</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1847" href="https://issues.apache.org/jira/browse/PDFBOX-1847">PDFBOX-1847</a>
</td>
                                            <td class="summary"><p>
                TSA Time Signature
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            John Hewson
    </td>
                                            <td class="reporter">            vakhtang koroghlishvili
    </td>
                                            <td class="creator">            vakhtang koroghlishvili
    </td>
                                            <td class="created"> 15/Jan/14 11:46 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:06 </td>
                                            <td class="resolutiondate"> 12/Dec/14 22:17 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Signing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
