                                            <td class="labels">    </td>
                                            <td class="customfield_12310220">            <span title="05/Apr/13 06:47"><time class="livestamp allow-future" datetime="2013-04-05T06:47:04+0000">05/Apr/13 6:47 AM</time></span>
    </td>
