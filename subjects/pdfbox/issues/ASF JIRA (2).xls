                <tr id="issuerow12693307" rel="12693307" data-issuekey="PDFBOX-1885" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1885" href="https://issues.apache.org/jira/browse/PDFBOX-1885">PDFBOX-1885</a>
</td>
                                            <td class="summary"><p>
                Add reference to ECM REWOO Scope
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Rewoo Technologies AG
    </td>
                                            <td class="creator">            Rewoo Technologies AG
    </td>
                                            <td class="created"> 05/Feb/14 09:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Feb/14 09:35 </td>
                                            <td class="resolutiondate"> 24/Feb/14 11:49 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Documentation            </td>
                                            <td class="duedate">    &nbsp;
</td>
