                <tr id="issuerow12654531" rel="12654531" data-issuekey="PDFBOX-1649" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1649" href="https://issues.apache.org/jira/browse/PDFBOX-1649">PDFBOX-1649</a>
</td>
                                            <td class="summary"><p>
                PNG images with alpha channel displays thin grey lines
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Niels Beekman
    </td>
                                            <td class="creator">            Niels Beekman
    </td>
                                            <td class="created"> 24/Jun/13 15:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Jun/14 16:26 </td>
                                            <td class="resolutiondate"> 21/May/14 19:43 </td>
                                            <td class="versions">                        1.8.2            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Writing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
