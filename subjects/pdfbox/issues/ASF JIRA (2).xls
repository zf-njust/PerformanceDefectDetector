</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1926" href="https://issues.apache.org/jira/browse/PDFBOX-1926">PDFBOX-1926</a>
</td>
                                            <td class="summary"><p>
                Document.save() after Document.close() causes Null Pointer Exception
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Bastian Preindl
    </td>
                                            <td class="creator">            Bastian Preindl
    </td>
                                            <td class="created"> 19/Feb/14 12:54 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:26 </td>
                                            <td class="resolutiondate"> 03/Jul/14 01:35 </td>
                                            <td class="versions">                        1.8.4            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">    &nbsp;
