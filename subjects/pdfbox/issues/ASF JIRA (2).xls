</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1503" href="https://issues.apache.org/jira/browse/PDFBOX-1503">PDFBOX-1503</a>
</td>
                                            <td class="summary"><p>
                Double logging of exceptions
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Juraj Lonc
    </td>
                                            <td class="creator">            Juraj Lonc
    </td>
                                            <td class="created"> 30/Jan/13 14:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:08 </td>
                                            <td class="resolutiondate"> 03/Jul/14 01:09 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
