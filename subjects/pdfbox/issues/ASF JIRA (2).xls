    <a class="issue-link" data-issue-key="PDFBOX-1494" href="https://issues.apache.org/jira/browse/PDFBOX-1494">PDFBOX-1494</a>
</td>
                                            <td class="summary"><p>
                PDF box color distortion
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
