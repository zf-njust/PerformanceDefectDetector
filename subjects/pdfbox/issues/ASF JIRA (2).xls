    <a class="issue-link" data-issue-key="PDFBOX-1083" href="https://issues.apache.org/jira/browse/PDFBOX-1083">PDFBOX-1083</a>
</td>
                                            <td class="summary"><p>
                PDType0Font incomplete
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Wulf Berschin
    </td>
                                            <td class="creator">            Wulf Berschin
    </td>
                                            <td class="created"> 08/Aug/11 15:58 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/14 01:45 </td>
                                            <td class="resolutiondate"> 11/Oct/14 01:45 </td>
                                            <td class="versions">                        1.6.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
