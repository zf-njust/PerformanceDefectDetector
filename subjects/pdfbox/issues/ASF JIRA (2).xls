    </td>
                                            <td class="creator">            Marco Metting
    </td>
                                            <td class="created"> 22/Mar/13 18:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Apr/13 13:13 </td>
                                            <td class="resolutiondate"> 13/Apr/13 13:13 </td>
                                            <td class="versions">                        1.7.0,                     1.7.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
