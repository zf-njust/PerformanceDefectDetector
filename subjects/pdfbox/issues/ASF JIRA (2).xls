    <a class="issue-link" data-issue-key="PDFBOX-1075" href="https://issues.apache.org/jira/browse/PDFBOX-1075">PDFBOX-1075</a>
</td>
                                            <td class="summary"><p>
                Can&#39;t get images from a PDF
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Antoni Mylka
    </td>
                                            <td class="creator">            Antoni Mylka
    </td>
                                            <td class="created"> 25/Jul/11 13:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/May/14 13:16 </td>
                                            <td class="resolutiondate"> 23/Oct/11 14:55 </td>
                                            <td class="versions">                        1.6.0,                     1.7.0            </td>
                                            <td class="fixVersions">                        1.7.0            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
