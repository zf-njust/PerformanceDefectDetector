                <tr id="issuerow12603895" rel="12603895" data-issuekey="PDFBOX-1390" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1390" href="https://issues.apache.org/jira/browse/PDFBOX-1390">PDFBOX-1390</a>
</td>
                                            <td class="summary"><p>
                Is COSNumber mutable or immutable?
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Aaron Stewart
    </td>
                                            <td class="creator">            Aaron Stewart
    </td>
                                            <td class="created"> 17/Aug/12 18:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Jan/15 12:28 </td>
                                            <td class="resolutiondate"> 27/Jan/15 12:28 </td>
                                            <td class="versions">                        1.7.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
