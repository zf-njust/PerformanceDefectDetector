                <tr id="issuerow12688078" rel="12688078" data-issuekey="PDFBOX-1839" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1839" href="https://issues.apache.org/jira/browse/PDFBOX-1839">PDFBOX-1839</a>
</td>
                                            <td class="summary"><p>
                PDFImageWriter default BufferedImage type makes output colors look poor
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 09/Jan/14 15:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 31/Jan/14 06:46 </td>
                                            <td class="resolutiondate"> 11/Jan/14 11:00 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.8.4,                     2.0.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
