                                            <td class="aggregatetimeestimate"></td>
                                            <td class="aggregatetimeoriginalestimate"></td>
                                            <td class="labels">    </td>
                                            <td class="customfield_12310220">            <span title="23/Jan/14 19:25"><time class="livestamp allow-future" datetime="2014-01-23T19:25:56+0000">23/Jan/14 7:25 PM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
