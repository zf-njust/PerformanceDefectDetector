</td>
                                            <td class="summary"><p>
                Span tags are not implemented
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Corentin Regal
    </td>
                                            <td class="creator">            Corentin Regal
    </td>
                                            <td class="created"> 14/Feb/14 09:19 </td>
                                            <td class="lastViewed"> &nbsp; </td>
