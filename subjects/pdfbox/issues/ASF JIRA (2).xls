    <a class="issue-link" data-issue-key="PDFBOX-1695" href="https://issues.apache.org/jira/browse/PDFBOX-1695">PDFBOX-1695</a>
</td>
                                            <td class="summary"><p>
                Improve pdfbox tests
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
