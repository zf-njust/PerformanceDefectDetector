    <a class="issue-link" data-issue-key="PDFBOX-1032" href="https://issues.apache.org/jira/browse/PDFBOX-1032">PDFBOX-1032</a>
</td>
                                            <td class="summary"><p>
                Signing improvement (settable signature size)
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
