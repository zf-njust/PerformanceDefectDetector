</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1601" href="https://issues.apache.org/jira/browse/PDFBOX-1601">PDFBOX-1601</a>
</td>
                                            <td class="summary"><p>
                java.lang.IllegalArgumentException: Width (4032) and height (-2880) cannot be &lt;= 0
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Asmita Joshi
    </td>
                                            <td class="creator">            Asmita Joshi
    </td>
