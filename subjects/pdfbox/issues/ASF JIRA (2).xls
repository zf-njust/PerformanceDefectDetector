    </td>
                                            <td class="creator">            Joern Kottmann
    </td>
                                            <td class="created"> 03/Sep/12 12:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/14 00:58 </td>
                                            <td class="resolutiondate"> 11/Oct/14 00:58 </td>
                                            <td class="versions">                        1.7.1            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
