    <a class="issue-link" data-issue-key="PDFBOX-1074" href="https://issues.apache.org/jira/browse/PDFBOX-1074">PDFBOX-1074</a>
</td>
                                            <td class="summary"><p>
                TIFFFaxDecoder5 when using PDFImageWriter
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Anton Stremoukhov
    </td>
                                            <td class="creator">            Anton Stremoukhov
    </td>
                                            <td class="created"> 21/Jul/11 09:37 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/May/14 06:12 </td>
                                            <td class="resolutiondate"> 26/Mar/14 06:50 </td>
                                            <td class="versions">                        1.6.0,                     1.8.4,                     1.8.5            </td>
                                            <td class="fixVersions">                        1.8.5,                     2.0.0            </td>
                                            <td class="components">                        Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">3</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
