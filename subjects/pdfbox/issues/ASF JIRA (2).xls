                <tr id="issuerow12616102" rel="12616102" data-issuekey="PDFBOX-1446" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1446" href="https://issues.apache.org/jira/browse/PDFBOX-1446">PDFBOX-1446</a>
</td>
                                            <td class="summary"><p>
                PreflightDocument constructor ignores given PreflightConfiguration instance
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Eric Leleu
    </td>
                                            <td class="reporter">            Petras
    </td>
                                            <td class="creator">            Petras
    </td>
                                            <td class="created"> 14/Nov/12 19:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Dec/12 20:16 </td>
                                            <td class="resolutiondate"> 06/Dec/12 20:15 </td>
                                            <td class="versions">                        1.8.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Preflight            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      One of the constructor in PreflightDocument document, where custom PreflightConfiguration instance can be passed, does not set it to the internal class variable &quot;config&quot; and therefore ignores it. Here is the patch to fix this bug:<br/>
<br/>
Index: PreflightDocument.java<br/>
===================================================================<br/>
--- PreflightDocument.java	(revision 1409245)<br/>
+++ PreflightDocument.java	(working copy)<br/>
@@ -91,6 +91,7 @@<br/>
 	public PreflightDocument(COSDocument doc, Format format, PreflightConfiguration cfg) {<br/>
 		super(doc);<br/>
 		this.specification = format;<br/>
+		this.config = cfg;<br/>
 		if (this.config == null) {<br/>
 			initConfiguration(format);<br/>
 		}<br/>

  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
