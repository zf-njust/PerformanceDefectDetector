                                            <td class="resolutiondate"> 08/Jul/12 13:57 </td>
                                            <td class="versions">                        1.7.0            </td>
                                            <td class="fixVersions">                        1.7.1            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
