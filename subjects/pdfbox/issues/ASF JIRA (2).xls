    </td>
                                            <td class="creator">            Dmytro Karimov
    </td>
                                            <td class="created"> 06/Dec/13 16:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Dec/14 14:15 </td>
                                            <td class="resolutiondate"> 31/Oct/14 10:56 </td>
                                            <td class="versions">                        1.8.3,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.8,                     2.0.0            </td>
                                            <td class="components">                        Signing,                     Writing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">5</td>
                                            <td class="thumbnail"></td>
