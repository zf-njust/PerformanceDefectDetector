  </td>
                                            <td class="description">      I practice the PDF generate code for chinese character and load the chinese font ttf, but can not get the chinese PDF with correct display.&#39;<br/>
The code is as below: The font coding is UTF-8<br/>
<br/>
            doc = new PDDocument();<br/>
            PDPage page = new PDPage();<br/>
            doc.addPage( page );<br/>
            PDFont font = PDTrueTypeFont.loadTTF(doc, &quot;d:\\temp\\ttf\\fireflysung.ttf&quot;);<br/>
            PDPageContentStream contentStream = new PDPageContentStream(doc, page);<br/>
            contentStream.beginText();<br/>
            contentStream.moveTextPositionByAmount(100, 700);<br/>
             contentStream.setFont(font,12);<br/>
            <br/>
            contentStream.drawString(&quot;中文測試&quot;);<br/>
            contentStream.endText();<br/>
            contentStream.close();<br/>
            doc.save(&quot;d:\\temp\\helloworld.pdf&quot;);
  </td>
