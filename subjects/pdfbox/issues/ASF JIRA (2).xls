    <a class="issue-link" data-issue-key="PDFBOX-1872" href="https://issues.apache.org/jira/browse/PDFBOX-1872">PDFBOX-1872</a>
</td>
                                            <td class="summary"><p>
                PDMetadata.exportXMPMetadata fails when Metadata has encrypted stream
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
