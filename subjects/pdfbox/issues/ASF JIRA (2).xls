                <tr id="issuerow12629714" rel="12629714" data-issuekey="PDFBOX-1502" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-1502" href="https://issues.apache.org/jira/browse/PDFBOX-1502">PDFBOX-1502</a>
</td>
                                            <td class="summary"><p>
                Not Extracting Text from PDF Document
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
