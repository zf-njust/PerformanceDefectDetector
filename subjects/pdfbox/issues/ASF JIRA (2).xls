</td>
                                            <td class="summary"><p>
                Classes from generated sources are not included in preflight jar
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Guillaume Bailleul
    </td>
