                                            <td class="summary"><p>
                Problems processing pdf created with PDFlib 7.0.3
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Unresolved
</td>
