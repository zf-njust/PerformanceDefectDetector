                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Jul/12 15:09 </td>
                                            <td class="resolutiondate"> 15/Mar/12 19:52 </td>
                                            <td class="versions">                        1.6.0,                     1.7.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Parsing            </td>
