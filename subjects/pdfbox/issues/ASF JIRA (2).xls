</td>
                                            <td class="summary"><p>
                NonSequentialPDFParser does not set security handler for access check
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Timo Boehme
    </td>
