</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3815" href="https://issues.apache.org/jira/browse/PDFBOX-3815">PDFBOX-3815</a>
</td>
                                            <td class="summary"><p>
                Removing the first page doesn&#39;t work
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Bug
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Sascha Becher
    </td>
                                            <td class="creator">            Sascha Becher
    </td>
                                            <td class="created"> 01/Jun/17 08:57 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 06/Jun/17 08:42 </td>
                                            <td class="resolutiondate"> 02/Jun/17 13:04 </td>
                                            <td class="versions">                        2.0.6            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Windows 10, Java 8; PDF 1.5
  </td>
                                            <td class="description">      Does nothing to page 1:<br/>
try (PDDocument doc = PDDocument.load(file)) {<br/>
	doc.removePage(0);<br/>
	doc.save(file);<br/>
	doc.close();<br/>
}<br/>
This would remove page 2:<br/>
doc.removePage(1);<br/>
<br/>
seems not to be new: <br/>
https://stackoverflow.com/questions/37865415/pdfbox-does-not-remove-first-page<br/>
If there are any restrictions to removing pages, the javadoc should note this.
  </td>
