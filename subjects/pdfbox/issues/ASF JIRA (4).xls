    <a class="issue-link" data-issue-key="PDFBOX-3209" href="https://issues.apache.org/jira/browse/PDFBOX-3209">PDFBOX-3209</a>
</td>
                                            <td class="summary"><p>
                Overlay class does not work with in-memory PDFs
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
