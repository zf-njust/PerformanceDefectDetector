                <tr id="issuerow13023270" rel="13023270" data-issuekey="PDFBOX-3594" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3594" href="https://issues.apache.org/jira/browse/PDFBOX-3594">PDFBOX-3594</a>
</td>
                                            <td class="summary"><p>
                Use PDOutlineItem#findDestinationPage() cannot get PDPage, return was null
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            kohdai
    </td>
                                            <td class="creator">            kohdai
    </td>
                                            <td class="created"> 25/Nov/16 00:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:12 </td>
                                            <td class="resolutiondate"> 25/Nov/16 16:39 </td>
                                            <td class="versions">                        1.8.12,                     2.0.3            </td>
                                            <td class="fixVersions">                        1.8.13,                     2.0.4,                     3.0.0            </td>
