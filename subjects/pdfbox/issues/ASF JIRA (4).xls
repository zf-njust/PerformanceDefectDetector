</td>
                                            <td class="summary"><p>
                Images wrong color
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Duplicate
