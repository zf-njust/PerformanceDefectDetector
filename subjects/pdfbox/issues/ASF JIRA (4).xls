    <a class="issue-link" data-issue-key="PDFBOX-3620" href="https://issues.apache.org/jira/browse/PDFBOX-3620">PDFBOX-3620</a>
</td>
                                            <td class="summary"><p>
                Acroform fields bad encoding
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
