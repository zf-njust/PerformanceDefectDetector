                                            <td class="labels">    </td>
                                            <td class="customfield_12310220">            <span title="03/Nov/15 17:41"><time class="livestamp allow-future" datetime="2015-11-03T17:41:52+0000">03/Nov/15 5:41 PM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
