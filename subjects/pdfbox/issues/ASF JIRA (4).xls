                                            <td class="resolutiondate"> 20/May/16 11:34 </td>
                                            <td class="versions">                        1.8.12,                     2.0.1,                     2.0.2,                     3.0.0            </td>
                                            <td class="fixVersions">                        1.8.13,                     2.0.2,                     3.0.0            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
