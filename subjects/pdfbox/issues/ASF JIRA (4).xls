                                            <td class="description">      For this PDF file attached, this function will hang:<br/>
<br/>
public void testNewVersion() throws IOException {<br/>
        PDDocument doc = PDDocument.load(PdfVerificationTest.class.getClassLoader().getResource(&quot;infinite_loop.pdf&quot;).openStream());<br/>
       PDFRenderer pdfRenderer = new PDFRenderer(doc);<br/>
       for(int i=1;i&lt;doc.getNumberOfPages();i++) {<br/>
            pdfRenderer.renderImageWithDPI(i, 300, ImageType.RGB);<br/>
      }<br/>
    }
