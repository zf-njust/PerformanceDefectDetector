                <tr id="issuerow12957140" rel="12957140" data-issuekey="PDFBOX-3311" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3311" href="https://issues.apache.org/jira/browse/PDFBOX-3311">PDFBOX-3311</a>
</td>
                                            <td class="summary"><p>
                Make SecurityHandlerFactory uses a genenic provider
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
