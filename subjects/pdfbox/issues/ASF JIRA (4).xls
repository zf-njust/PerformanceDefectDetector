                <tr id="issuerow13015961" rel="13015961" data-issuekey="PDFBOX-3546" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3546" href="https://issues.apache.org/jira/browse/PDFBOX-3546">PDFBOX-3546</a>
</td>
                                            <td class="summary"><p>
                IOException over DataFormatException, &quot;invalid stored block lengths&quot; on a valid PDF
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Seva Alekseyev
    </td>
                                            <td class="creator">            Seva Alekseyev
    </td>
                                            <td class="created"> 27/Oct/16 20:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:13 </td>
                                            <td class="resolutiondate"> 02/Nov/16 17:05 </td>
                                            <td class="versions">                        1.8.12,                     2.0.3            </td>
                                            <td class="fixVersions">                        1.8.13,                     2.0.4,                     3.0.0            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">5</td>
