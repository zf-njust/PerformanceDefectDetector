    <a class="issue-link" data-issue-key="PDFBOX-3140" href="https://issues.apache.org/jira/browse/PDFBOX-3140">PDFBOX-3140</a>
</td>
                                            <td class="summary"><p>
                Different fallback font rendering first and second time
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
