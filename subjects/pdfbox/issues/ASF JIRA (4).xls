    <a class="issue-link" data-issue-key="PDFBOX-3522" href="https://issues.apache.org/jira/browse/PDFBOX-3522">PDFBOX-3522</a>
</td>
                                            <td class="summary"><p>
                SEVERE: Cannot read JPEG2000 image
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Baki
    </td>
                                            <td class="creator">            Baki
    </td>
                                            <td class="created"> 04/Oct/16 12:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Oct/16 16:34 </td>
                                            <td class="resolutiondate"> 04/Oct/16 16:34 </td>
                                            <td class="versions">                        2.0.3            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
