    <a class="issue-link" data-issue-key="PDFBOX-3391" href="https://issues.apache.org/jira/browse/PDFBOX-3391">PDFBOX-3391</a>
</td>
                                            <td class="summary"><p>
                PDButton.getOnValues seems to be using the wrong source for getting the allowed values
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maruan Sahyoun
    </td>
                                            <td class="reporter">            Scott Coldwell
    </td>
                                            <td class="creator">            Scott Coldwell
    </td>
                                            <td class="created"> 21/Jun/16 07:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:13 </td>
                                            <td class="resolutiondate"> 28/Jun/16 19:19 </td>
                                            <td class="versions">                        2.0.1            </td>
                                            <td class="fixVersions">                        2.0.3,                     3.0.0            </td>
                                            <td class="components">                        AcroForm            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
