                <tr id="issuerow12964097" rel="12964097" data-issuekey="PDFBOX-3333" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3333" href="https://issues.apache.org/jira/browse/PDFBOX-3333">PDFBOX-3333</a>
</td>
                                            <td class="summary"><p>
                Wrong appearance generation for rotated AcroForms fields
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maruan Sahyoun
    </td>
                                            <td class="reporter">            Richard Brown
    </td>
                                            <td class="creator">            Richard Brown
    </td>
                                            <td class="created"> 30/Apr/16 20:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:13 </td>
                                            <td class="resolutiondate"> 03/May/16 06:00 </td>
                                            <td class="versions">                        2.0.1,                     2.0.2,                     3.0.0            </td>
                                            <td class="fixVersions">                        2.0.2,                     3.0.0            </td>
                                            <td class="components">                        AcroForm            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
