                <tr id="issuerow12941007" rel="12941007" data-issuekey="PDFBOX-3243" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3243" href="https://issues.apache.org/jira/browse/PDFBOX-3243">PDFBOX-3243</a>
</td>
                                            <td class="summary"><p>
                Lost font after merge
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Matthias Braun
    </td>
                                            <td class="creator">            Matthias Braun
    </td>
                                            <td class="created"> 22/Feb/16 10:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:12 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0.0,                     2.0.1,                     3.0.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
