    <a class="issue-link" data-issue-key="PDFBOX-3284" href="https://issues.apache.org/jira/browse/PDFBOX-3284">PDFBOX-3284</a>
</td>
                                            <td class="summary"><p>
                Big Pdf parsing to text - Out of memory
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
