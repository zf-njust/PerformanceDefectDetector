</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        PDFBOX-3660                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      When processing the attached PDF the renderImage fails due to the exception below. This doesn&#39;t occur on other PDFs that I have tried, so perhaps its a problem with the file?<br/>
<br/>
The processing logic fails early on so it can be simplified to<br/>
{code}<br/>
try (PDDocument document = PDDocument.load(file)) {<br/>
  for (int i = 0; i &lt; document.getNumberOfPages(); i++) {<br/>
    PDFRenderer pdfRenderer = new PDFRenderer(document);<br/>
    BufferedImage image = pdfRenderer.renderImageWithDPI(i, 200);<br/>
    ...<br/>
  }<br/>
}<br/>
{code}<br/>
<br/>
{code}<br/>
java.lang.IndexOutOfBoundsException: Index: 2, Size: 0<br/>
	at java.util.ArrayList.rangeCheck(ArrayList.java:653)<br/>
	at java.util.ArrayList.get(ArrayList.java:429)<br/>
	at org.apache.pdfbox.cos.COSArray.get(COSArray.java:210)<br/>
	at org.apache.pdfbox.rendering.PageDrawer.getAnnotationBorder(PageDrawer.java:987)<br/>
	at org.apache.pdfbox.rendering.PageDrawer.drawAnnotationLinkBorder(PageDrawer.java:1039)<br/>
	at org.apache.pdfbox.rendering.PageDrawer.showAnnotation(PageDrawer.java:960)<br/>
	at org.apache.pdfbox.rendering.PageDrawer.drawPage(PageDrawer.java:193)<br/>
	at org.apache.pdfbox.rendering.PDFRenderer.renderImage(PDFRenderer.java:145)<br/>
	at org.apache.pdfbox.rendering.PDFRenderer.renderImageWithDPI(PDFRenderer.java:80)<br/>
{code}
