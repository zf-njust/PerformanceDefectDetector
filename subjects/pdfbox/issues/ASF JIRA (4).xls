                <tr id="issuerow12977532" rel="12977532" data-issuekey="PDFBOX-3379" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3379" href="https://issues.apache.org/jira/browse/PDFBOX-3379">PDFBOX-3379</a>
</td>
                                            <td class="summary"><p>
                PDType0Font Subsetting Monospace DejaVuSansMono
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Christian Maierhofer
    </td>
                                            <td class="creator">            Christian Maierhofer
    </td>
                                            <td class="created"> 10/Jun/16 08:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:13 </td>
                                            <td class="resolutiondate"> 13/Jun/16 16:44 </td>
                                            <td class="versions">                        2.0.2,                     2.0.3,                     3.0.0            </td>
                                            <td class="fixVersions">                        2.0.3,                     3.0.0            </td>
                                            <td class="components">                        FontBox            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
