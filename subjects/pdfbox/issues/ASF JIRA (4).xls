</td>
                                            <td class="summary"><p>
                XMP parsing fails if XMP contain comments
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maruan Sahyoun
    </td>
                                            <td class="reporter">            Petras
    </td>
                                            <td class="creator">            Petras
    </td>
                                            <td class="created"> 23/Aug/16 08:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:12 </td>
                                            <td class="resolutiondate"> 25/Aug/16 05:19 </td>
                                            <td class="versions">                        2.0.2            </td>
                                            <td class="fixVersions">                        2.0.3,                     3.0.0            </td>
                                            <td class="components">                        XmpBox            </td>
