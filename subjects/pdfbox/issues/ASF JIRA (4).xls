                <tr id="issuerow12909211" rel="12909211" data-issuekey="PDFBOX-3072" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3072" href="https://issues.apache.org/jira/browse/PDFBOX-3072">PDFBOX-3072</a>
</td>
                                            <td class="summary"><p>
                Allow missing page type
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
