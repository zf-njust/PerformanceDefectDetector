                <tr id="issuerow12979360" rel="12979360" data-issuekey="PDFBOX-3382" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3382" href="https://issues.apache.org/jira/browse/PDFBOX-3382">PDFBOX-3382</a>
</td>
                                            <td class="summary"><p>
                pdf creation very slow
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
