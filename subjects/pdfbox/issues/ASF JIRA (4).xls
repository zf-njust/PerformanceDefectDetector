    <a class="issue-link" data-issue-key="PDFBOX-3554" href="https://issues.apache.org/jira/browse/PDFBOX-3554">PDFBOX-3554</a>
</td>
                                            <td class="summary"><p>
                Crash in kerning calculations
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Lawrence Kesteloot
    </td>
                                            <td class="creator">            Lawrence Kesteloot
    </td>
                                            <td class="created"> 04/Nov/16 06:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Nov/16 07:00 </td>
                                            <td class="resolutiondate"> 04/Nov/16 07:00 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        FontBox            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
