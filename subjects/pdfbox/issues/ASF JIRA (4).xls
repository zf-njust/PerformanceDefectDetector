                <tr id="issuerow13068168" rel="13068168" data-issuekey="PDFBOX-3772" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3772" href="https://issues.apache.org/jira/browse/PDFBOX-3772">PDFBOX-3772</a>
</td>
                                            <td class="summary"><p>
                Add COSBoolean(false) as option in PDDocumentCatalog&#39;s getOpenAction
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Tim Allison
    </td>
                                            <td class="creator">            Tim Allison
    </td>
                                            <td class="created"> 01/May/17 16:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/May/17 20:28 </td>
                                            <td class="resolutiondate"> 01/May/17 18:53 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        2.0.6,                     3.0.0            </td>
                                            <td class="components">    &nbsp;
