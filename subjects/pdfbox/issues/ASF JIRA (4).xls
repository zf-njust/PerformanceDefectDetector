                                            <td class="labels">    print</td>
                                            <td class="customfield_12310220">            <span title="02/Aug/16 16:36"><time class="livestamp allow-future" datetime="2016-08-02T16:36:40+0000">02/Aug/16 4:36 PM</time></span>
    </td>
