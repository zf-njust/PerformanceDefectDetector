    <a class="issue-link" data-issue-key="PDFBOX-3144" href="https://issues.apache.org/jira/browse/PDFBOX-3144">PDFBOX-3144</a>
</td>
                                            <td class="summary"><p>
                NullPointerException in TTFSubsetter
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            John Hewson
    </td>
                                            <td class="reporter">            Philip Helger
    </td>
                                            <td class="creator">            Philip Helger
    </td>
                                            <td class="created"> 01/Dec/15 15:41 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:08 </td>
                                            <td class="resolutiondate"> 02/Dec/15 17:09 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        FontBox            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
