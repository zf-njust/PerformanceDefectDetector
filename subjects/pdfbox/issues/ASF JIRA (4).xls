                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:12 </td>
                                            <td class="resolutiondate"> 30/Jun/16 17:36 </td>
                                            <td class="versions">                        2.0.2,                     2.0.3,                     3.0.0            </td>
                                            <td class="fixVersions">                        2.0.3,                     3.0.0            </td>
                                            <td class="components">                        FontBox,                     Writing            </td>
                                            <td class="duedate">    &nbsp;
</td>
