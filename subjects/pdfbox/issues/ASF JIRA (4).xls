                <tr id="issuerow13068147" rel="13068147" data-issuekey="PDFBOX-3771" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3771" href="https://issues.apache.org/jira/browse/PDFBOX-3771">PDFBOX-3771</a>
</td>
                                            <td class="summary"><p>
                Signing example does not work if inFile = outFile
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Manu Schiller
    </td>
                                            <td class="creator">            Manu Schiller
    </td>
                                            <td class="created"> 01/May/17 15:30 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/May/17 16:17 </td>
                                            <td class="resolutiondate"> 01/May/17 16:17 </td>
                                            <td class="versions">                        2.0.5            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Signing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
