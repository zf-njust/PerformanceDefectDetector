</td>
                                            <td class="summary"><p>
                Calendar values are parsed with unknown timezones
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Robert Šiška
    </td>
                                            <td class="creator">            Robert Šiška
    </td>
                                            <td class="created"> 17/May/16 13:12 </td>
                                            <td class="lastViewed"> &nbsp; </td>
