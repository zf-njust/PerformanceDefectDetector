                                            <td class="resolutiondate"> 21/Oct/15 17:05 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
