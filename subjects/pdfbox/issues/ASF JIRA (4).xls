    <a class="issue-link" data-issue-key="PDFBOX-3718" href="https://issues.apache.org/jira/browse/PDFBOX-3718">PDFBOX-3718</a>
</td>
                                            <td class="summary"><p>
                Incorrect Appearance on setting a field value and flattening a form
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
