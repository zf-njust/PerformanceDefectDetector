                <tr id="issuerow13074409" rel="13074409" data-issuekey="PDFBOX-3806" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3806" href="https://issues.apache.org/jira/browse/PDFBOX-3806">PDFBOX-3806</a>
</td>
                                            <td class="summary"><p>
                Nullpointer exception in getLeftSideBearing
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Resolved
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Daniel Persson
    </td>
                                            <td class="creator">            Daniel Persson
    </td>
                                            <td class="created"> 24/May/17 06:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/May/17 12:40 </td>
                                            <td class="resolutiondate"> 26/May/17 12:40 </td>
                                            <td class="versions">                        2.0.6            </td>
                                            <td class="fixVersions">                        2.0.7,                     3.0.0            </td>
                                            <td class="components">                        FontBox            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
