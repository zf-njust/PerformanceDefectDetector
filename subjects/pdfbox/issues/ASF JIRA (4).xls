    <a class="issue-link" data-issue-key="PDFBOX-3149" href="https://issues.apache.org/jira/browse/PDFBOX-3149">PDFBOX-3149</a>
</td>
                                            <td class="summary"><p>
                Failure to decrypt empty strings (AES 128)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
