                <tr id="issuerow12914579" rel="12914579" data-issuekey="PDFBOX-3122" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3122" href="https://issues.apache.org/jira/browse/PDFBOX-3122">PDFBOX-3122</a>
</td>
                                            <td class="summary"><p>
                IllegalArgumentException: dash lengths all zero
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 19/Nov/15 19:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:06 </td>
                                            <td class="resolutiondate"> 19/Nov/15 19:05 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      {code}<br/>
Caused by: java.lang.IllegalArgumentException: dash lengths all zero<br/>
    org.apache.pdfbox.rendering.PageDrawer.getStroke(PageDrawer.java:563)<br/>
    org.apache.pdfbox.rendering.PageDrawer.strokePath(PageDrawer.java:571)<br/>
    org.apache.pdfbox.contentstream.operator.graphics.StrokePath.process(StrokePath.java:36)<br/>
{code}<br/>
The content stream has this:<br/>
{code}<br/>
  [ 0.0 0.0 ] 0 d<br/>
{code}<br/>
