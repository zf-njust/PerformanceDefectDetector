{code:java}<br/>
@Test<br/>
public void testRendering() throws IOException {<br/>
    File pdfFile = new File(&quot;a.pdf&quot;);<br/>
    Assert.assertTrue(pdfFile.canRead());<br/>
<br/>
    PDDocument document = PDDocument.load(pdfFile);<br/>
    Assert.assertEquals(2, document.getNumberOfPages());<br/>
<br/>
    PDFRenderer pdfRenderer = new PDFRenderer(document);<br/>
    BufferedImage firstPageImage = pdfRenderer.renderImage(0, 1, ImageType.RGB);<br/>
<br/>
    File pngFile = new File(&quot;a.png&quot;);<br/>
    ImageIO.write(firstPageImage, &quot;png&quot;, pngFile);<br/>
}<br/>
{code}<br/>
<br/>
The generated image is blank.
