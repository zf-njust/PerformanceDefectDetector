    </td>
                                            <td class="created"> 15/Oct/15 17:30 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 15/Mar/16 17:13 </td>
                                            <td class="resolutiondate"> 15/Mar/16 17:13 </td>
                                            <td class="versions">                        1.8.9,                     1.8.10,                     2.0.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        XmpBox            </td>
