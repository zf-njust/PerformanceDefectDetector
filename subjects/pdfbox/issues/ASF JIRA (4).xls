                <tr id="issuerow13061773" rel="13061773" data-issuekey="PDFBOX-3745" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3745" href="https://issues.apache.org/jira/browse/PDFBOX-3745">PDFBOX-3745</a>
</td>
                                            <td class="summary"><p>
                Wrong character width
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Ch. Schlatter
    </td>
                                            <td class="creator">            Ch. Schlatter
    </td>
                                            <td class="created"> 05/Apr/17 15:29 </td>
                                            <td class="lastViewed"> 20/Jun/17 06:16 </td>
                                            <td class="updated"> 15/May/17 20:28 </td>
                                            <td class="resolutiondate"> 06/Apr/17 17:57 </td>
                                            <td class="versions">                        2.0.5            </td>
                                            <td class="fixVersions">                        2.0.6,                     3.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
