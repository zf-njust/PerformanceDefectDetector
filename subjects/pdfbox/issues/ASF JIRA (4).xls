                                            <td class="environment"></td>
                                            <td class="description">      code below image does not match the PDF:<br/>
{code:java}<br/>
    try (PDDocument document = PDDocument.load(attachedFile)) {<br/>
            PDPage page = (PDPage) document.getDocumentCatalog().getAllPages().get(0);<br/>
            File imageFile = File.createTempFile(&quot;test1&quot;, &quot;.png&quot;);<br/>
            imageFile.deleteOnExit();<br/>
<br/>
            BufferedImage image = page.convertToImage();<br/>
            ImageIO.write(image, &quot;png&quot;, imageFile);<br/>
<br/>
            // image file is a mess<br/>
        }<br/>
{code}
