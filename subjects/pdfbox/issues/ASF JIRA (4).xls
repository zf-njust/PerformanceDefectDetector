	&lt;paragraph&gt;<br/>
		Einfacher Textinhalt - 2* eingerückt<br/>
		Einfacher Textinhalt - 2* eingerückt<br/>
		Einfacher Textinhalt - 2* eingerückt<br/>
	&lt;/paragraph&gt;<br/>
&lt;/article&gt;<br/>
