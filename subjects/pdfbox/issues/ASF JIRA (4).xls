                                            <td class="summary"><p>
                Incorrect color space processing for inline images
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Evgeniy Muravitskiy
    </td>
                                            <td class="creator">            Evgeniy Muravitskiy
    </td>
                                            <td class="created"> 01/Oct/15 15:23 </td>
                                            <td class="lastViewed"> 20/Jun/17 06:50 </td>
                                            <td class="updated"> 17/Mar/16 19:07 </td>
                                            <td class="resolutiondate"> 07/Oct/15 19:19 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
