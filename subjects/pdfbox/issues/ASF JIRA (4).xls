                                            <td class="versions">                        2.0.0,                     3.0.0            </td>
                                            <td class="fixVersions">                        2.0.1,                     3.0.0            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
