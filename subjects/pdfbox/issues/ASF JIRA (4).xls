    <a class="issue-link" data-issue-key="PDFBOX-3153" href="https://issues.apache.org/jira/browse/PDFBOX-3153">PDFBOX-3153</a>
</td>
                                            <td class="summary"><p>
                Direct JPEG extraction results in invalid images in 2.0.0 releases.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            John Logan
    </td>
                                            <td class="creator">            John Logan
    </td>
                                            <td class="created"> 04/Dec/15 23:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Jan/16 12:01 </td>
                                            <td class="resolutiondate"> 05/Dec/15 07:36 </td>
                                            <td class="versions">                        1.8.10,                     1.8.11,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.11,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">5</td>
