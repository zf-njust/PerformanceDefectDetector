                <tr id="issuerow12924775" rel="12924775" data-issuekey="PDFBOX-3175" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3175" href="https://issues.apache.org/jira/browse/PDFBOX-3175">PDFBOX-3175</a>
</td>
                                            <td class="summary"><p>
                PDFTextStreamEngine probably miscalculates text height
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Leo
    </td>
                                            <td class="creator">            Leo
    </td>
                                            <td class="created"> 30/Dec/15 01:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:07 </td>
                                            <td class="resolutiondate"> 06/Jan/16 20:57 </td>
