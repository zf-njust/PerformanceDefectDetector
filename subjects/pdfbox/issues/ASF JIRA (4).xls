                <tr id="issuerow13041204" rel="13041204" data-issuekey="PDFBOX-3679" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3679" href="https://issues.apache.org/jira/browse/PDFBOX-3679">PDFBOX-3679</a>
</td>
                                            <td class="summary"><p>
                renderImage IndexOutOfBoundsException
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ben Manes
    </td>
                                            <td class="creator">            Ben Manes
    </td>
                                            <td class="created"> 07/Feb/17 23:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Feb/17 05:35 </td>
                                            <td class="resolutiondate"> 08/Feb/17 05:35 </td>
                                            <td class="versions">                        2.0.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
