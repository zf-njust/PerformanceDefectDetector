                <tr id="issuerow12989103" rel="12989103" data-issuekey="PDFBOX-3420" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3420" href="https://issues.apache.org/jira/browse/PDFBOX-3420">PDFBOX-3420</a>
</td>
                                            <td class="summary"><p>
                Can&#39;t sign pdf with a particular attachment
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Daniel Zsigus
    </td>
                                            <td class="creator">            Daniel Zsigus
    </td>
                                            <td class="created"> 13/Jul/16 12:45 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Dec/16 10:56 </td>
                                            <td class="resolutiondate"> 19/Jul/16 16:04 </td>
                                            <td class="versions">                        1.8.12            </td>
                                            <td class="fixVersions">                        1.8.13            </td>
                                            <td class="components">                        Signing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
