                                            <td class="resolutiondate"> 23/Aug/16 18:04 </td>
                                            <td class="versions">                        1.8.12,                     1.8.13,                     2.0.2,                     2.0.3,                     3.0.0            </td>
                                            <td class="fixVersions">                        1.8.13,                     2.0.3,                     3.0.0            </td>
                                            <td class="components">                        Preflight            </td>
                                            <td class="duedate">    &nbsp;
</td>
