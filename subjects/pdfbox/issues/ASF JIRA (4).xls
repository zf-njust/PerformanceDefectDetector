                                            <td class="description">      _PDFTextStripper_ or inherently used classes probably do not close all opened streams under all circumstances. You can reproduce that by the following snippet of code and the attached PDF file.<br/>
<br/>
{code}<br/>
try (RandomAccessBuffer rab = new RandomAccessBuffer(is)) {<br/>
            PDFParser parser = new PDFParser(rab);<br/>
            parser.parse();<br/>
            try (COSDocument cosDoc = parser.getDocument();PDDocument pdDoc = new PDDocument(cosDoc);){<br/>
                PDFTextStripper pdfStripper = new PDFTextStripper();<br/>
                pdfStripper.getText(pdDoc);<br/>
            }<br/>
        } catch (IOException e) {<br/>
            throw new RuntimeException(e);<br/>
        }<br/>
{code}
