                <tr id="issuerow12909296" rel="12909296" data-issuekey="PDFBOX-3074" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3074" href="https://issues.apache.org/jira/browse/PDFBOX-3074">PDFBOX-3074</a>
</td>
                                            <td class="summary"><p>
                Mark transparency groups
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Daniel Persson
    </td>
                                            <td class="creator">            Daniel Persson
    </td>
                                            <td class="created"> 30/Oct/15 19:12 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Oct/15 19:49 </td>
                                            <td class="resolutiondate"> 30/Oct/15 19:21 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
