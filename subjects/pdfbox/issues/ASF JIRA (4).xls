{code}<br/>
java.io.IOException: Missing root object specification in trailer.<br/>
    org.apache.pdfbox.pdfparser.COSParser.parseTrailerValuesDynamically(COSParser.java:2156)<br/>
    org.apache.pdfbox.pdfparser.PDFParser.initialParse(PDFParser.java:222)<br/>
    org.apache.pdfbox.pdfparser.PDFParser.parse(PDFParser.java:271)<br/>
    org.apache.pdfbox.pdmodel.PDDocument.load(PDDocument.java:987)<br/>
    org.apache.pdfbox.pdmodel.PDDocument.load(PDDocument.java:943)<br/>
