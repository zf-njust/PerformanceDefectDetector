    <a class="issue-link" data-issue-key="PDFBOX-3776" href="https://issues.apache.org/jira/browse/PDFBOX-3776">PDFBOX-3776</a>
</td>
                                            <td class="summary"><p>
                Printing a PDF with transparent images causes nothing to print for that page
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jon Ominsky
    </td>
                                            <td class="creator">            Jon Ominsky
    </td>
                                            <td class="created"> 03/May/17 17:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/May/17 16:51 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0.5            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
