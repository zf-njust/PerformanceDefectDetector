	&lt;paragraph&gt;<br/>
		Einfacher Textinhalt - nicht eingerückt<br/>
		Einfacher Textinhalt - nicht eingerückt<br/>
		Einfacher Textinhalt - nicht eingerückt<br/>
	&lt;/paragraph&gt;<br/>
&lt;/article&gt;<br/>
