    <a class="issue-link" data-issue-key="PDFBOX-3654" href="https://issues.apache.org/jira/browse/PDFBOX-3654">PDFBOX-3654</a>
</td>
                                            <td class="summary"><p>
                Parse error reading embedded Type1 font
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Dennis Noordsij
    </td>
                                            <td class="creator">            Dennis Noordsij
    </td>
                                            <td class="created"> 18/Jan/17 15:31 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:13 </td>
                                            <td class="resolutiondate"> 19/Jan/17 05:44 </td>
                                            <td class="versions">                        2.0.4            </td>
                                            <td class="fixVersions">                        2.0.5,                     3.0.0            </td>
                                            <td class="components">                        FontBox            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
