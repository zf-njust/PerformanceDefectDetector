    <a class="issue-link" data-issue-key="PDFBOX-3470" href="https://issues.apache.org/jira/browse/PDFBOX-3470">PDFBOX-3470</a>
</td>
                                            <td class="summary"><p>
                Set border and background color in AcroForm field appearance
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 22/Aug/16 15:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:13 </td>
                                            <td class="resolutiondate"> 22/Aug/16 15:20 </td>
                                            <td class="versions">                        2.0.1,                     2.0.2,                     2.0.3            </td>
                                            <td class="fixVersions">                        2.0.3,                     3.0.0            </td>
                                            <td class="components">                        AcroForm            </td>
                                            <td class="duedate">    &nbsp;
</td>
