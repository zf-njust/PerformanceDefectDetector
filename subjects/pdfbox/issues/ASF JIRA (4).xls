                <tr id="issuerow12956434" rel="12956434" data-issuekey="PDFBOX-3309" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3309" href="https://issues.apache.org/jira/browse/PDFBOX-3309">PDFBOX-3309</a>
</td>
                                            <td class="summary"><p>
                PDFBox 2.0.0 not printing pdf with different font
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Gayan Wijenayaka
    </td>
                                            <td class="creator">            Gayan Wijenayaka
    </td>
                                            <td class="created"> 06/Apr/16 09:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Apr/16 17:59 </td>
                                            <td class="resolutiondate"> 27/Apr/16 17:59 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
