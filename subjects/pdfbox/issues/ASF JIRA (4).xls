    <a class="issue-link" data-issue-key="PDFBOX-3500" href="https://issues.apache.org/jira/browse/PDFBOX-3500">PDFBOX-3500</a>
</td>
                                            <td class="summary"><p>
                Error expected floating point number actual=&#39;0.-262&#39;
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 15/Sep/16 19:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:12 </td>
                                            <td class="resolutiondate"> 16/Sep/16 16:09 </td>
                                            <td class="versions">                        1.8.12,                     1.8.13,                     2.0.3,                     3.0.0            </td>
                                            <td class="fixVersions">                        1.8.13,                     2.0.4,                     3.0.0            </td>
                                            <td class="components">                        Parsing            </td>
