                <tr id="issuerow12919827" rel="12919827" data-issuekey="PDFBOX-3157" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3157" href="https://issues.apache.org/jira/browse/PDFBOX-3157">PDFBOX-3157</a>
</td>
                                            <td class="summary"><p>
                PDOutputIntent has N=3 (RGB) hardcoded
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 07/Dec/15 19:56 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Jan/16 12:01 </td>
                                            <td class="resolutiondate"> 07/Dec/15 20:19 </td>
                                            <td class="versions">                        1.8.10,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.11,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      This code is suspicious:<br/>
{code}<br/>
    private PDStream configureOutputProfile (PDDocument doc, InputStream colorProfile) throws IOException {<br/>
        PDStream stream = new PDStream(doc,colorProfile, false); <br/>
        stream.getStream().setFilters(COSName.FLATE_DECODE); <br/>
        stream.getStream().setInt( COSName.LENGTH, stream.getByteArray().length ); <br/>
        stream.getStream().setInt(COSName.N, 3); <br/>
        stream.addCompression(); <br/>
        return stream;<br/>
    }<br/>
{code}<br/>
N is hardcoded to 3, although it could be a CMYK profile.
  </td>
