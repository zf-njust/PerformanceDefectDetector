                                            <td class="issuelinks">                                        PDFBOX-3258                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      While working on PDFBOX-3027 I found that once a property has been set the value can not be changed.<br/>
<br/>
{code}<br/>
PDFAIdentificationSchema pdfaid = metadata.createAndAddPFAIdentificationSchema();<br/>
<br/>
pdfaid.setConformance(&quot;A&quot;);<br/>
Assert.assertEquals(&quot;A&quot;, pdfaid.getConformance());<br/>
pdfaid.setConformance(&quot;B&quot;);<br/>
Assert.assertEquals(&quot;B&quot;, pdfaid.getConformance()); &lt;- this fails with the value still being &#39;A&#39;<br/>
{code}<br/>

  </td>
