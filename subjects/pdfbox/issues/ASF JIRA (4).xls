                                            <td class="environment">      (any)
  </td>
                                            <td class="description">      I was just hoping to do a simple extension, using this class but, due to the private constructor, can&#39;t:<br/>
{code}<br/>
import org.apache.pdfbox.ExtractText;<br/>
<br/>
public class MultiPDFtoText<br/>
{<br/>
  public static void main (String[] args)<br/>
  {<br/>
    for (String pdf : args)<br/>
    {<br/>
      String txt = pdf.replaceFirst(&quot;\\.pdf$&quot;, &quot;.txt&quot;);<br/>
      System.out.println(&quot;PDF: &quot; + pdf + &quot;, TXT: &quot; + txt);<br/>
      ExtractText extractor = new ExtractText();<br/>
      extractor.startExtraction(new String[] { pdf, txt });<br/>
    }<br/>
  }<br/>
}<br/>
{code}
  </td>
