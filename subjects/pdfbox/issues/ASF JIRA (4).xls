<br/>
{code}<br/>
curl https://storage.googleapis.com/pids-share/high-rez-color.pdf -o test.pdf<br/>
java -jar $PDFBOXTOOLS/pdfbox-app-2.0.6.jar PDFSplit test.pdf<br/>
{code}<br/>
