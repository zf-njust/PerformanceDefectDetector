    </td>
                                            <td class="created"> 22/Mar/16 16:03 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:13 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.8.10,                     1.8.11,                     2.0.0,                     3.0.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">2</td>
