                <tr id="issuerow12910892" rel="12910892" data-issuekey="PDFBOX-3092" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3092" href="https://issues.apache.org/jira/browse/PDFBOX-3092">PDFBOX-3092</a>
</td>
                                            <td class="summary"><p>
                Format 4 TTF cmap table is parsed incorrectly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            John Hewson
    </td>
                                            <td class="creator">            John Hewson
    </td>
                                            <td class="created"> 06/Nov/15 00:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 25/Mar/17 18:09 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        3.0.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
