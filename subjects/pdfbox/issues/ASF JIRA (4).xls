    <a class="issue-link" data-issue-key="PDFBOX-3748" href="https://issues.apache.org/jira/browse/PDFBOX-3748">PDFBOX-3748</a>
</td>
                                            <td class="summary"><p>
                java.lang.UnsupportedOperationException: Kerning table version 0 format 2 not yet supported.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Thomas Penne
    </td>
                                            <td class="creator">            Thomas Penne
    </td>
