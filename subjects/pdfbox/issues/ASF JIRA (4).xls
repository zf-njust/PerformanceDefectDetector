    <a class="issue-link" data-issue-key="PDFBOX-3645" href="https://issues.apache.org/jira/browse/PDFBOX-3645">PDFBOX-3645</a>
</td>
                                            <td class="summary"><p>
                Probably not handling header read on bad PDFs
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            G. Ralph Kuntz
    </td>
                                            <td class="creator">            G. Ralph Kuntz
    </td>
                                            <td class="created"> 08/Jan/17 16:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Jan/17 17:12 </td>
                                            <td class="resolutiondate"> 17/Jan/17 17:12 </td>
                                            <td class="versions">                        2.0.4            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
