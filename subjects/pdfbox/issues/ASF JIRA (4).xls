                <tr id="issuerow12918082" rel="12918082" data-issuekey="PDFBOX-3152" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-3152" href="https://issues.apache.org/jira/browse/PDFBOX-3152">PDFBOX-3152</a>
</td>
                                            <td class="summary"><p>
                NullPointerException in PDType1Font.encode() with centered dot
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            John Hewson
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 03/Dec/15 18:24 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:07 </td>
                                            <td class="resolutiondate"> 11/Dec/15 20:17 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">    &nbsp;
</td>
