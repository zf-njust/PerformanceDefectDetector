    <a class="issue-link" data-issue-key="PDFBOX-3041" href="https://issues.apache.org/jira/browse/PDFBOX-3041">PDFBOX-3041</a>
</td>
                                            <td class="summary"><p>
                Wrong default type in Xref stream W0 element
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Andrea Vacondio
    </td>
                                            <td class="creator">            Andrea Vacondio
    </td>
                                            <td class="created"> 21/Oct/15 15:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Jan/16 12:01 </td>
                                            <td class="resolutiondate"> 21/Oct/15 18:39 </td>
                                            <td class="versions">                        1.8.10,                     1.8.11,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.11,                     2.0.0            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
