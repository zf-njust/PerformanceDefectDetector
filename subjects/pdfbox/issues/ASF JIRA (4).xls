                                            <td class="summary"><p>
                XMPSchemaBasic.getLabel() always returns null
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
