</td>
                                            <td class="summary"><p>
                Preflight : no check for &quot;Differences&quot; entry in &quot;Encoding&quot; dictionary
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Timur Kamalov
    </td>
                                            <td class="creator">            Timur Kamalov
    </td>
                                            <td class="created"> 19/Dec/14 09:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Dec/14 09:29 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Preflight            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
