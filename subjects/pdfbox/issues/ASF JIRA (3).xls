                <tr id="issuerow12765751" rel="12765751" data-issuekey="PDFBOX-2594" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2594" href="https://issues.apache.org/jira/browse/PDFBOX-2594">PDFBOX-2594</a>
</td>
                                            <td class="summary"><p>
                Set default params in JBIG2Filter
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Daniel Bonniot de Ruisselet
    </td>
                                            <td class="creator">            Daniel Bonniot de Ruisselet
    </td>
                                            <td class="created"> 08/Jan/15 12:29 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Mar/15 14:10 </td>
                                            <td class="resolutiondate"> 09/Jan/15 22:38 </td>
                                            <td class="versions">                        1.8.8,                     1.8.9,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.9,                     2.0.0            </td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        PDFBOX-2591                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      Currently JBIG2Filter does not set read params. This causes noise because jbig2-imageio logs this before using default params (e.g. see this [comment|https://issues.apache.org/jira/browse/PDFBOX-2112?focusedCommentId=14018039&amp;page=com.atlassian.jira.plugin.system.issuetabpanels:comment-tabpanel#comment-14018039]). This patch explicitly uses the default params, which would solve that:<br/>
{noformat}<br/>
Index: pdfbox/src/main/java/org/apache/pdfbox/filter/JBIG2Filter.java<br/>
===================================================================<br/>
--- pdfbox/src/main/java/org/apache/pdfbox/filter/JBIG2Filter.java      (revision 1650041)<br/>
+++ pdfbox/src/main/java/org/apache/pdfbox/filter/JBIG2Filter.java      (working copy)<br/>
@@ -85,7 +85,7 @@<br/>
             BufferedImage image;<br/>
             try<br/>
             {<br/>
-                image = reader.read(0);<br/>
+                image = reader.read(0, reader.getDefaultReadParam());<br/>
             }<br/>
             catch (Exception e)<br/>
             {<br/>
{noformat}<br/>

  </td>
