                <tr id="issuerow12752442" rel="12752442" data-issuekey="PDFBOX-2476" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2476" href="https://issues.apache.org/jira/browse/PDFBOX-2476">PDFBOX-2476</a>
</td>
                                            <td class="summary"><p>
                PDFBox doesn&#39;t display math characters and symbols
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Diego Casella
    </td>
                                            <td class="creator">            Diego Casella
    </td>
                                            <td class="created"> 03/Nov/14 15:30 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Nov/14 14:41 </td>
                                            <td class="resolutiondate"> 03/Nov/14 17:45 </td>
                                            <td class="versions">                        1.8.7            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
