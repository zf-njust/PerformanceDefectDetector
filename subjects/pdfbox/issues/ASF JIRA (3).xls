                <tr id="issuerow12852690" rel="12852690" data-issuekey="PDFBOX-2920" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2920" href="https://issues.apache.org/jira/browse/PDFBOX-2920">PDFBOX-2920</a>
</td>
                                            <td class="summary"><p>
                IndexOutOfBounds Exception when loading large PDF
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Brad Baker
    </td>
                                            <td class="creator">            Brad Baker
    </td>
                                            <td class="created"> 06/Aug/15 20:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Aug/16 16:16 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        1.8.8,                     1.8.9,                     1.8.10            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">6</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        PDFBOX-3441                        </td>
                                            <td class="environment">      Software
  </td>
                                            <td class="description">      I&#39;m getting exceptions loading large pdfs (~6-8 GB each). I&#39;ve tried using PDDocument.load() and PDDocument.loadNonSeq(). I can&#39;t attach a PDF due to the file size limit of 10 Mb. If there is another way to get it to someone, I can work that out. Here is my code:<br/>
<br/>
	<br/>
{code}<br/>
	public static void main(String[] args) {<br/>
		<br/>
		LOGGER.info(&quot;Test Large PDF Load &quot; + TEST_PDF);<br/>
		try {<br/>
			LOGGER.info(&quot;Create Steam&quot;);<br/>
			InputStream is = new FileInputStream(TEST_PDF);<br/>
			LOGGER.info(&quot;Start Load&quot;);<br/>
			PDDocument doc = PDDocument.load(is);<br/>
//			PDDocument doc = PDDocument.loadNonSeq(is, null);<br/>
			LOGGER.info(&quot;Finished Load&quot;);<br/>
			doc.close();<br/>
			is.close();<br/>
		} catch (IOException e) {<br/>
			e.printStackTrace();<br/>
		}<br/>
	}<br/>
{code}<br/>
This first error is using PDDocument.load()<br/>
