    <a class="issue-link" data-issue-key="PDFBOX-2675" href="https://issues.apache.org/jira/browse/PDFBOX-2675">PDFBOX-2675</a>
</td>
                                            <td class="summary"><p>
                PDOutlineNode.getParent uses /P item as fallback for /Parent
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
