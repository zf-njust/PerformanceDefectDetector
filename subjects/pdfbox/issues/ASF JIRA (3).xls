                                            <td class="summary"><p>
                java.lang.NegativeArraySizeException in org.apache.pdfbox.pdmodel.graphics.color.PDDeviceGray.createColorModel
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Aleksander Blomskøld
    </td>
                                            <td class="creator">            Aleksander Blomskøld
    </td>
                                            <td class="created"> 03/Aug/15 12:46 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Jan/16 12:01 </td>
                                            <td class="resolutiondate"> 04/Aug/15 20:22 </td>
                                            <td class="versions">                        1.8.10            </td>
                                            <td class="fixVersions">                        1.8.11            </td>
                                            <td class="components">    &nbsp;
</td>
