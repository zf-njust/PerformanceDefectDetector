    <a class="issue-link" data-issue-key="PDFBOX-2940" href="https://issues.apache.org/jira/browse/PDFBOX-2940">PDFBOX-2940</a>
</td>
                                            <td class="summary"><p>
                ClassCastException in FDF export
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maruan Sahyoun
    </td>
                                            <td class="reporter">            Laurent Richard
    </td>
                                            <td class="creator">            Laurent Richard
    </td>
