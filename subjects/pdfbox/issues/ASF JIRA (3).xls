                <tr id="issuerow12839074" rel="12839074" data-issuekey="PDFBOX-2834" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2834" href="https://issues.apache.org/jira/browse/PDFBOX-2834">PDFBOX-2834</a>
</td>
                                            <td class="summary"><p>
                Violation in PDOutputIntent.getDestOutputProfile() method
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Evgeniy Muravitskiy
    </td>
                                            <td class="creator">            Evgeniy Muravitskiy
    </td>
                                            <td class="created"> 19/Jun/15 08:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:06 </td>
                                            <td class="resolutiondate"> 23/Jun/15 17:10 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Windows 7, jdk 1.7.0_51
  </td>
                                            <td class="description">      Inside this method an Object (the result of dictionary.getItem(COSName.DEST_OUTPUT_PROFILE) method call) is casted to COSStream, but it can be also a COSObject containing COSStream which leads to class cast exception.<br/>
<br/>
{code}<br/>
public COSStream getDestOutputIntent()<br/>
{<br/>
     return (COSStream) dictionary.getItem(COSName.DEST_OUTPUT_PROFILE);<br/>
}<br/>
{code}<br/>
<br/>
Possible solutions :<br/>
1) Check class instance and handle them in proper way*<br/>
2) Usage of visitor pattern<br/>
<br/>
*{code}<br/>
public COSStream getDestOutputIntent()<br/>
{<br/>
        final COSBase item = dictionary.getItem(COSName.DEST_OUTPUT_PROFILE);<br/>
        return getDestOutputIntent(item);<br/>
}<br/>
<br/>
private COSStream getDestOutputIntent(COSBase object) {<br/>
        if (object instanceof COSStream) {<br/>
            return (COSStream) object;<br/>
        } else if (object instanceof COSObject) {<br/>
            return getDestOutputIntent(((COSObject) object).getObject());<br/>
        } else {<br/>
            return null;<br/>
        }<br/>
}<br/>
{code}
  </td>
