                <tr id="issuerow12717072" rel="12717072" data-issuekey="PDFBOX-2101" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2101" href="https://issues.apache.org/jira/browse/PDFBOX-2101">PDFBOX-2101</a>
</td>
                                            <td class="summary"><p>
                Surprising memory consumption when extracting images
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Tim Allison
    </td>
                                            <td class="creator">            Tim Allison
    </td>
                                            <td class="created"> 28/May/14 16:07 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 07/Sep/14 08:19 </td>
                                            <td class="resolutiondate"> 15/Jun/14 11:34 </td>
                                            <td class="versions">                        1.8.5            </td>
                                            <td class="fixVersions">                        1.8.6,                     2.0.0            </td>
                                            <td class="components">                        Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">6</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
