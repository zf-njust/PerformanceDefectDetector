                <tr id="issuerow12749061" rel="12749061" data-issuekey="PDFBOX-2437" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2437" href="https://issues.apache.org/jira/browse/PDFBOX-2437">PDFBOX-2437</a>
</td>
                                            <td class="summary"><p>
                PDFont isSymbolic() has unexpected return value
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            John Hewson
    </td>
                                            <td class="reporter">            John Hewson
    </td>
                                            <td class="creator">            John Hewson
    </td>
                                            <td class="created"> 18/Oct/14 19:48 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:08 </td>
                                            <td class="resolutiondate"> 11/Aug/15 00:35 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">    &nbsp;
</td>
