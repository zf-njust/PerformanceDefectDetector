    <a class="issue-link" data-issue-key="PDFBOX-2137" href="https://issues.apache.org/jira/browse/PDFBOX-2137">PDFBOX-2137</a>
</td>
                                            <td class="summary"><p>
                Rendering of Type3 string fails with NPE
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
