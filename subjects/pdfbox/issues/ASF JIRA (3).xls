</td>
                                            <td class="summary"><p>
                NullPointerException when reading a GIF file with a transparent color
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Shiva Sathiraju
    </td>
                                            <td class="creator">            Shiva Sathiraju
    </td>
                                            <td class="created"> 01/Feb/15 14:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Mar/15 14:10 </td>
                                            <td class="resolutiondate"> 05/Feb/15 22:18 </td>
                                            <td class="versions">                        1.8.8,                     1.8.9,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.9,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
