    <a class="issue-link" data-issue-key="PDFBOX-2618" href="https://issues.apache.org/jira/browse/PDFBOX-2618">PDFBOX-2618</a>
</td>
                                            <td class="summary"><p>
                Add an Example to create paragraphs with PDFBox
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 21/Jan/15 17:32 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 29/Apr/16 17:32 </td>
                                            <td class="resolutiondate"> &nbsp; </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Writing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">5</td>
                                            <td class="thumbnail"></td>
