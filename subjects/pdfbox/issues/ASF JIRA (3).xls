{code:title=Example code}<br/>
PDDocument doc = new PDDocument();<br/>
// load a font which is in PDFBox<br/>
PDTrueTypeFont font = PDTrueTypeFont.loadTTF(doc, getClass().getResourceAsStream(&quot;/org/apache/pdfbox/resources/ttf/LiberationSans-Regular.ttf&quot;));<br/>
font.getStringWidth(&quot;éé&quot;);<br/>
{code}<br/>

