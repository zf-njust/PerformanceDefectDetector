                                            <td class="resolutiondate"> 08/Feb/15 09:58 </td>
                                            <td class="versions">                        1.8.8,                     1.8.9,                     2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
