                                            <td class="summary"><p>
                Building on OpenJDK throws javax.imageio.IIOException
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
