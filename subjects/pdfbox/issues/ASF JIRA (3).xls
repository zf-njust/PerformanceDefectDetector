                                            <td class="resolutiondate"> 24/Dec/14 13:32 </td>
                                            <td class="versions">                        1.8.8,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.9,                     2.0.0            </td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
