    <a class="issue-link" data-issue-key="PDFBOX-2765" href="https://issues.apache.org/jira/browse/PDFBOX-2765">PDFBOX-2765</a>
</td>
                                            <td class="summary"><p>
                Add method to subset fonts for document pre-save
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">            John Hewson
    </td>
