    <a class="issue-link" data-issue-key="PDFBOX-2297" href="https://issues.apache.org/jira/browse/PDFBOX-2297">PDFBOX-2297</a>
</td>
                                            <td class="summary"><p>
                PDImageXObject: Add method getColorSpaces()
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
