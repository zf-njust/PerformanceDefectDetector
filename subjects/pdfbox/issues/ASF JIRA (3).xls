</td>
                                            <td class="summary"><p>
                Useless dependency in specific usage
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
