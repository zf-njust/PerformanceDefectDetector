</td>
                                            <td class="summary"><p>
                Infinite loop within RandomAccessBuffer 
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Andreas Lehmkühler
    </td>
                                            <td class="creator">            Andreas Lehmkühler
    </td>
                                            <td class="created"> 25/May/15 16:21 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Jul/15 06:35 </td>
                                            <td class="resolutiondate"> 25/May/15 16:28 </td>
                                            <td class="versions">                        1.8.9,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.10,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
