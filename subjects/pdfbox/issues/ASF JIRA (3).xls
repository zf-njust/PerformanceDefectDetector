    <a class="issue-link" data-issue-key="PDFBOX-2941" href="https://issues.apache.org/jira/browse/PDFBOX-2941">PDFBOX-2941</a>
</td>
                                            <td class="summary"><p>
                Improve PDFDebugger (2)
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
