                                            <td class="resolutiondate"> 26/Sep/14 06:35 </td>
                                            <td class="versions">                        1.8.6            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
