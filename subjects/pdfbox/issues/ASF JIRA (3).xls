    <a class="issue-link" data-issue-key="PDFBOX-2764" href="https://issues.apache.org/jira/browse/PDFBOX-2764">PDFBOX-2764</a>
</td>
                                            <td class="summary"><p>
                Allow setting extended graphics state in PDPageContentStream
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Jesse Long
    </td>
                                            <td class="creator">            Jesse Long
    </td>
                                            <td class="created"> 20/Apr/15 10:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:06 </td>
                                            <td class="resolutiondate"> 20/Apr/15 19:34 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
