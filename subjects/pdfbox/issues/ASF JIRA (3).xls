                <tr id="issuerow12841037" rel="12841037" data-issuekey="PDFBOX-2843" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2843" href="https://issues.apache.org/jira/browse/PDFBOX-2843">PDFBOX-2843</a>
</td>
                                            <td class="summary"><p>
                widthOfSpace() appears wrong in TextPosition
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Richard Wolfgram
    </td>
                                            <td class="creator">            Richard Wolfgram
    </td>
                                            <td class="created"> 27/Jun/15 01:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:08 </td>
                                            <td class="resolutiondate"> 29/Jun/15 04:02 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      JDK 8 on Windows 7
  </td>
                                            <td class="description">      When using the following override method of PDFTextStripper I am getting a large difference in values for TextPosition.getWidthOfSpace() between version 1.8.6 and pdfbox-2.0.0-20150611.100833-1423<br/>
<br/>
{code}<br/>
@Override<br/>
 protected void processTextPosition(TextPosition textPos)<br/>
 {<br/>
    float spaceWidth = textPos.getWidthOfSpace();<br/>
    float width = textPos.getWidth();<br/>
    System.out.println(textPos.getCharacter() + &quot; - Width of Space=&quot; + spaceWidth + &quot; - width=&quot; + width);<br/>
    builder.append(textPos.getCharacter());<br/>
 }<br/>
{code}<br/>
<br/>
In 1.8.6 average character width is around 5 and space width is around 2.5<br/>
<br/>
In 2.0 average character width is around 5 and space width is around 27
  </td>
