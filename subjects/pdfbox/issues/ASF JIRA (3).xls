                <tr id="issuerow12788098" rel="12788098" data-issuekey="PDFBOX-2745" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2745" href="https://issues.apache.org/jira/browse/PDFBOX-2745">PDFBOX-2745</a>
</td>
                                            <td class="summary"><p>
                PDPageXYZDestination zoom property can&#39;t be set lower than 100%
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Gilad Denneboom
    </td>
                                            <td class="creator">            Gilad Denneboom
    </td>
                                            <td class="created"> 03/Apr/15 20:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 23/Jul/15 06:35 </td>
                                            <td class="resolutiondate"> 03/Apr/15 22:38 </td>
                                            <td class="versions">                        1.8.9,                     1.8.10,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.10,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
