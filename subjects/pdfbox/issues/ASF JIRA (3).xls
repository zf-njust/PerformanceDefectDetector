    <a class="issue-link" data-issue-key="PDFBOX-2048" href="https://issues.apache.org/jira/browse/PDFBOX-2048">PDFBOX-2048</a>
</td>
                                            <td class="summary"><p>
                TextExtraction only working after uncompressing with pdftk
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 28/Apr/14 21:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:38 </td>
                                            <td class="resolutiondate"> 02/May/14 08:41 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        1.8.6,                     2.0.0            </td>
                                            <td class="components">                        Parsing,                     Rendering,                     Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
