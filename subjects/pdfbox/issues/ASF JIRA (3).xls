    <a class="issue-link" data-issue-key="PDFBOX-2876" href="https://issues.apache.org/jira/browse/PDFBOX-2876">PDFBOX-2876</a>
</td>
                                            <td class="summary"><p>
                Better support for embedding of simple TrueType fonts
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            John Hewson
    </td>
                                            <td class="reporter">            John Hewson
    </td>
                                            <td class="creator">            John Hewson
    </td>
                                            <td class="created"> 13/Jul/15 06:49 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:06 </td>
                                            <td class="resolutiondate"> 13/Jul/15 06:50 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
