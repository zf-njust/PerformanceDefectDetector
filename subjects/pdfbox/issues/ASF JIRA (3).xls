                <tr id="issuerow12713603" rel="12713603" data-issuekey="PDFBOX-2073" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2073" href="https://issues.apache.org/jira/browse/PDFBOX-2073">PDFBOX-2073</a>
</td>
                                            <td class="summary"><p>
                PDF files with unusual Japanese font can not be rewrite correctly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            May Yu
    </td>
                                            <td class="creator">            May Yu
    </td>
                                            <td class="created"> 12/May/14 11:34 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Jun/14 14:34 </td>
                                            <td class="resolutiondate"> 13/May/14 17:56 </td>
                                            <td class="versions">                        1.8.5,                     1.8.6,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.6,                     2.0.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      Windows 7 32bit
  </td>
                                            <td class="description">      While rotate attached pdf file, The Japanese characters cannot display in the output pdf file. <br/>
This problem can also occur when marge PDF files.<br/>
We suspect that this caused by the name of font type.<br/>
<br/>
Environment<br/>
-------------------------------------------------<br/>
OS    : Windows 7 (32bit)<br/>
jvm   : 1.6<br/>
pdfbox: 1.8.5<br/>
-------------------------------------------------<br/>
<br/>
<br/>
Code to reproduce the problem<br/>
-------------------------------------------------<br/>
    public static void main(String[] args) {<br/>
<br/>
        String filePath = &quot;D:\\test\\landscape.pdf&quot;;<br/>
        String newPDFFile = &quot;D:\\test\\new_landscape.pdf&quot;;<br/>
<br/>
        try {<br/>
            PDDocument rotatedDocument = PDDocument.load(filePath);<br/>
            PDDocument document = new PDDocument();<br/>
<br/>
            int pageNumber = document.getNumberOfPages();<br/>
            for (int i=0; i&lt;pageNumber; i++) {<br/>
                PDPage page = (PDPage)document.getDocumentCatalog().getAllPages().get(i);<br/>
                page.setRotation(-90);<br/>
                rotatedDocument.addPage(page);<br/>
            }<br/>
            rotatedDocument.save(newPDFFile);<br/>
<br/>
            document.close();<br/>
            rotatedDocument.close();<br/>
        } catch (Exception e) {<br/>
            e.printStackTrace();<br/>
        }<br/>
    }<br/>
-------------------------------------------------
