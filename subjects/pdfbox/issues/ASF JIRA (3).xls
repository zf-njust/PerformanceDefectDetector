    <a class="issue-link" data-issue-key="PDFBOX-2921" href="https://issues.apache.org/jira/browse/PDFBOX-2921">PDFBOX-2921</a>
</td>
                                            <td class="summary"><p>
                Validation fails if FontValidationProcess is not used
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Open
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
