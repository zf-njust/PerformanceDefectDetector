                <tr id="issuerow12742927" rel="12742927" data-issuekey="PDFBOX-2371" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2371" href="https://issues.apache.org/jira/browse/PDFBOX-2371">PDFBOX-2371</a>
</td>
                                            <td class="summary"><p>
                Overlay page off by one when using -useAllPages
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Laurent Yaish
    </td>
                                            <td class="creator">            Laurent Yaish
    </td>
                                            <td class="created"> 20/Sep/14 05:31 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 13/Dec/14 14:15 </td>
                                            <td class="resolutiondate"> 20/Sep/14 14:15 </td>
                                            <td class="versions">                        1.8.7,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.8            </td>
                                            <td class="components">                        Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">3</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      When using the new -useAllPages option added in 1.8.7, the usePageNum doesn&#39;t account for the fact that the specificOverlayPage is indexed by zero and the output ends up with overlay pages shifted<br/>
<br/>
e.g. The output page 1 has page 2 from the overlay.<br/>
<br/>
We need to subtract 1 from the pageNumber when getting the overlay page number.<br/>
<br/>
int usePageNum = (pageNumber - 1) % numberOfOverlayPages;<br/>
<br/>

  </td>
