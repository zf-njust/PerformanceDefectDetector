                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Sep/14 14:40 </td>
                                            <td class="resolutiondate"> 20/Jul/14 08:59 </td>
                                            <td class="versions">                        1.8.6,                     1.8.7,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.6,                     1.8.7,                     2.0.0            </td>
                                            <td class="components">                        Parsing            </td>
