                                            <td class="description">      {code:title=Bar.java|borderStyle=none}<br/>
InputStream zfExtensionIs = getClass().getResourceAsStream(&quot;/zf_extension.pdfbox.xmp&quot;);<br/>
DomXmpParser builder = new DomXmpParser();<br/>
         zfDefaultXmp = builder.parse(zfExtensionIs);<br/>
PdfaExtensionHelper.populateSchemaMapping(zfDefaultXmp);<br/>
<br/>
new XmpSerializer().serialize(zfDefaultXmp, new FileOutputStream(&quot;target/out.xmp.xml&quot;), true);<br/>
{code}<br/>
<br/>
<br/>
the incoming file <br/>
{code:xml|title=incoming.xml|borderStyle=none}<br/>
      &lt;rdf:Description xmlns:pdfaExtension=&quot;http://www.aiim.org/pdfa/ns/extension/&quot;<br/>
         xmlns:pdfaSchema=&quot;http://www.aiim.org/pdfa/ns/schema#&quot; xmlns:pdfaProperty=&quot;http://www.aiim.org/pdfa/ns/property#&quot; rdf:about=&quot;&quot;&gt;<br/>
{code}<br/>
<br/>
outgoing file <br/>
{code:xml|title=resulting.xml|borderStyle=none}<br/>
&lt;rdf:Description xmlns:pdfaExtension=&quot;http://www.aiim.org/pdfa/ns/extension/&quot; rdf:about=&quot;&quot;&gt;<br/>
{code}<br/>
<br/>
<br/>
why are the two namespaces gone?<br/>

