                <tr id="issuerow12857440" rel="12857440" data-issuekey="PDFBOX-2939" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2939" href="https://issues.apache.org/jira/browse/PDFBOX-2939">PDFBOX-2939</a>
</td>
                                            <td class="summary"><p>
                PDFRenderer.renderImageWithDPI exception with certain PDFs
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
