    <a class="issue-link" data-issue-key="PDFBOX-2908" href="https://issues.apache.org/jira/browse/PDFBOX-2908">PDFBOX-2908</a>
</td>
                                            <td class="summary"><p>
                PDFTextStripper.writeText is slow
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            V
    </td>
                                            <td class="creator">            V
    </td>
                                            <td class="created"> 29/Jul/15 16:06 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 05/Aug/15 00:35 </td>
                                            <td class="resolutiondate"> 29/Jul/15 17:59 </td>
                                            <td class="versions">                        1.8.9,                     1.8.10            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
