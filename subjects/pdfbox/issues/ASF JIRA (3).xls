    <a class="issue-link" data-issue-key="PDFBOX-2252" href="https://issues.apache.org/jira/browse/PDFBOX-2252">PDFBOX-2252</a>
</td>
                                            <td class="summary"><p>
                PDFTextStripper has problem with documents with mixed language directions
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maruan Sahyoun
    </td>
                                            <td class="reporter">            Amir
    </td>
                                            <td class="creator">            Amir
    </td>
                                            <td class="created"> 03/Aug/14 04:43 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 20/Mar/17 11:14 </td>
                                            <td class="resolutiondate"> 03/Jan/17 07:37 </td>
                                            <td class="versions">                        1.8.6,                     2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">9</td>
