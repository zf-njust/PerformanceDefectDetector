                <tr id="issuerow12711895" rel="12711895" data-issuekey="PDFBOX-2051" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2051" href="https://issues.apache.org/jira/browse/PDFBOX-2051">PDFBOX-2051</a>
</td>
                                            <td class="summary"><p>
                PDFPrinter does not use getPageable()
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
