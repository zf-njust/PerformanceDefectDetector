                                            <td class="summary"><p>
                PDFTextStripper has problem with semi-space characters
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Amir
    </td>
                                            <td class="creator">            Amir
    </td>
                                            <td class="created"> 05/Aug/14 22:39 </td>
                                            <td class="lastViewed"> &nbsp; </td>
