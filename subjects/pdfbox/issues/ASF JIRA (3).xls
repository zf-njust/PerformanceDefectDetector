                <tr id="issuerow12829682" rel="12829682" data-issuekey="PDFBOX-2801" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2801" href="https://issues.apache.org/jira/browse/PDFBOX-2801">PDFBOX-2801</a>
</td>
                                            <td class="summary"><p>
                SecurityHandler does not tolerate plain-text COSString
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Michele Balistreri
    </td>
                                            <td class="creator">            Michele Balistreri
    </td>
                                            <td class="created"> 13/May/15 20:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Dec/15 11:20 </td>
                                            <td class="resolutiondate"> 22/May/15 18:14 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">                        1.8.10,                     2.0.0            </td>
