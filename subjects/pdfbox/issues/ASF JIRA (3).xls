                <tr id="issuerow12718148" rel="12718148" data-issuekey="PDFBOX-2110" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2110" href="https://issues.apache.org/jira/browse/PDFBOX-2110">PDFBOX-2110</a>
</td>
                                            <td class="summary"><p>
                Font not found: CourierNew
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Juraj Lonc
    </td>
                                            <td class="creator">            Juraj Lonc
    </td>
                                            <td class="created"> 03/Jun/14 13:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Jun/14 14:34 </td>
                                            <td class="resolutiondate"> 07/Jun/14 16:06 </td>
                                            <td class="versions">                        1.8.5,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.6,                     2.0.0            </td>
                                            <td class="components">                        FontBox            </td>
