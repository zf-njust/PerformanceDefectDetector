                <tr id="issuerow12722974" rel="12722974" data-issuekey="PDFBOX-2156" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2156" href="https://issues.apache.org/jira/browse/PDFBOX-2156">PDFBOX-2156</a>
</td>
                                            <td class="summary"><p>
                different shading patterns at different resolutions when ctm is null
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 21/Jun/14 17:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Sep/14 14:40 </td>
                                            <td class="resolutiondate"> 22/Jun/14 16:27 </td>
                                            <td class="versions">                        1.8.5,                     1.8.6,                     1.8.7,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.7,                     2.0.0            </td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
