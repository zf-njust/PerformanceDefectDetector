                <tr id="issuerow12761253" rel="12761253" data-issuekey="PDFBOX-2561" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2561" href="https://issues.apache.org/jira/browse/PDFBOX-2561">PDFBOX-2561</a>
</td>
                                            <td class="summary"><p>
                Rendering of PDIndexed line incorrect
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Tilman Hausherr
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
