                <tr id="issuerow12708665" rel="12708665" data-issuekey="PDFBOX-2031" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2031" href="https://issues.apache.org/jira/browse/PDFBOX-2031">PDFBOX-2031</a>
</td>
                                            <td class="summary"><p>
                GrayScale images become inverted
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
