</td>
                                            <td class="summary"><p>
                Defective BufferedImage for flate encoded images
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Dominic Tubach
    </td>
                                            <td class="creator">            Dominic Tubach
    </td>
                                            <td class="created"> 25/Aug/14 15:40 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Aug/14 15:37 </td>
                                            <td class="resolutiondate"> 27/Aug/14 15:37 </td>
                                            <td class="versions">                        2.0.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
