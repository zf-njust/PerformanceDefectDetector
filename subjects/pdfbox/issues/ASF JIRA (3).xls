                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2657" href="https://issues.apache.org/jira/browse/PDFBOX-2657">PDFBOX-2657</a>
</td>
                                            <td class="summary"><p>
                Bad leading for AFM Fonts
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Antonio Vera
    </td>
                                            <td class="creator">            Antonio Vera
    </td>
                                            <td class="created"> 03/Feb/15 04:01 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 03/Feb/15 20:35 </td>
                                            <td class="resolutiondate"> 03/Feb/15 19:56 </td>
                                            <td class="versions">                        1.8.8            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
