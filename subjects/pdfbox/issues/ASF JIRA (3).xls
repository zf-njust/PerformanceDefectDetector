                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      I am trying to convert images (png, jpg) to pdf and the issue is that after conversion document pages are blank.<br/>
Used code:<br/>
{code:borderStyle=solid}<br/>
        PDDocument doc = new PDDocument();<br/>
        for (BufferedImage buff : list) {<br/>
            PDPage page = new PDPage(new PDRectangle(buff.getWidth(), buff.getHeight()));<br/>
            doc.addPage(page);<br/>
            PDXObjectImage ximage = new PDJpeg(doc, buff);<br/>
            PDPageContentStream content = new PDPageContentStream(doc, page);<br/>
            content.drawImage(ximage, 0, 0);<br/>
            content.close();<br/>
        }<br/>
        doc.save(outStream);<br/>
        doc.close();<br/>
{code}
  </td>
