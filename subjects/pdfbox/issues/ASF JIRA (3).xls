    <a class="issue-link" data-issue-key="PDFBOX-2471" href="https://issues.apache.org/jira/browse/PDFBOX-2471">PDFBOX-2471</a>
</td>
                                            <td class="summary"><p>
                AES encryption failing to write Acroform field names and values
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
