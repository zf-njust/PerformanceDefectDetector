    <a class="issue-link" data-issue-key="PDFBOX-2011" href="https://issues.apache.org/jira/browse/PDFBOX-2011">PDFBOX-2011</a>
</td>
                                            <td class="summary"><p>
                Please extend base class &quot;Encoding&quot; with 2 methods to access global name2char and char2name maps
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
