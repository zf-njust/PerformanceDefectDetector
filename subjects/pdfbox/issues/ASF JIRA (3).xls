    <a class="issue-link" data-issue-key="PDFBOX-2083" href="https://issues.apache.org/jira/browse/PDFBOX-2083">PDFBOX-2083</a>
</td>
                                            <td class="summary"><p>
                Some characters overlap other characters, font changed
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Webrtc Go
    </td>
                                            <td class="creator">            Webrtc Go
    </td>
                                            <td class="created"> 19/May/14 08:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/May/14 15:48 </td>
                                            <td class="resolutiondate"> 19/May/14 15:48 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
