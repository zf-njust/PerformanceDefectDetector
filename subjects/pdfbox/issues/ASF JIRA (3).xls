                <tr id="issuerow12744231" rel="12744231" data-issuekey="PDFBOX-2382" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-2382" href="https://issues.apache.org/jira/browse/PDFBOX-2382">PDFBOX-2382</a>
</td>
                                            <td class="summary"><p>
                Arabic compound words are displayed incorrectly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ahmet
    </td>
                                            <td class="creator">            Ahmet
    </td>
                                            <td class="created"> 26/Sep/14 07:43 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Sep/14 08:47 </td>
                                            <td class="resolutiondate"> 26/Sep/14 08:47 </td>
                                            <td class="versions">                        1.8.6            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
