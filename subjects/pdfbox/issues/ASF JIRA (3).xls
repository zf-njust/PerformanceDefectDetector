                                            <td class="summary"><p>
                horizontal line above shaded text when printing on HP1320
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
