                <tr id="issuerow12428344" rel="12428344" data-issuekey="PDFBOX-487" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-487" href="https://issues.apache.org/jira/browse/PDFBOX-487">PDFBOX-487</a>
</td>
                                            <td class="summary"><p>
                Font size not rendered with the needed precision
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Volker Bier
    </td>
                                            <td class="creator">            Volker Bier
    </td>
                                            <td class="created"> 19/Jun/09 10:25 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/09 09:52 </td>
                                            <td class="resolutiondate"> 20/Jun/09 13:32 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        0.8.0-incubator            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
