                <tr id="issuerow12391102" rel="12391102" data-issuekey="PDFBOX-68" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-68" href="https://issues.apache.org/jira/browse/PDFBOX-68">PDFBOX-68</a>
</td>
                                            <td class="summary"><p>
                Extracting Text in/between Bookmarks
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">    &nbsp;
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">            Adam Nichols
    </td>
                                            <td class="reporter">    <em>Anonymous</em>
</td>
