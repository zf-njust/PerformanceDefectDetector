                <tr id="issuerow12470449" rel="12470449" data-issuekey="PDFBOX-785" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-785" href="https://issues.apache.org/jira/browse/PDFBOX-785">PDFBOX-785</a>
</td>
                                            <td class="summary"><p>
                Spliting a PDF creates unnecessarily large files
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            mathieu radiguet
    </td>
                                            <td class="creator">            mathieu radiguet
    </td>
                                            <td class="created"> 29/Jul/10 15:10 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/May/16 10:25 </td>
                                            <td class="resolutiondate"> 22/Dec/14 10:35 </td>
                                            <td class="versions">                        1.8.8,                     2.0.0            </td>
                                            <td class="fixVersions">                        1.8.9,                     2.0.0            </td>
                                            <td class="components">                        Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">5</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
