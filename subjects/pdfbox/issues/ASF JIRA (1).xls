    <a class="issue-link" data-issue-key="PDFBOX-923" href="https://issues.apache.org/jira/browse/PDFBOX-923">PDFBOX-923</a>
</td>
                                            <td class="summary"><p>
                pdf gets messed up when updated with xfdf data
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maruan Sahyoun
    </td>
                                            <td class="reporter">            Madhav Vodnala
    </td>
                                            <td class="creator">            Madhav Vodnala
    </td>
                                            <td class="created"> 20/Dec/10 08:05 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:07 </td>
                                            <td class="resolutiondate"> 03/Feb/15 22:32 </td>
                                            <td class="versions">                        1.3.1            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        AcroForm            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
