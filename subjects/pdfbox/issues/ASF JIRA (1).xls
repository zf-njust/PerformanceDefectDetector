                <tr id="issuerow12422351" rel="12422351" data-issuekey="PDFBOX-454" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-454" href="https://issues.apache.org/jira/browse/PDFBOX-454">PDFBOX-454</a>
</td>
                                            <td class="summary"><p>
                IOException upon opening a PDF
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Daniel Wilson
    </td>
                                            <td class="creator">            Daniel Wilson
    </td>
                                            <td class="created"> 08/Apr/09 11:58 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/09 09:52 </td>
                                            <td class="resolutiondate"> 29/Apr/09 13:23 </td>
                                            <td class="versions">                        0.8.0-incubator            </td>
                                            <td class="fixVersions">                        0.8.0-incubator            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
