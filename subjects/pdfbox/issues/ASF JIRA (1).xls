                <tr id="issuerow12497465" rel="12497465" data-issuekey="PDFBOX-955" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-955" href="https://issues.apache.org/jira/browse/PDFBOX-955">PDFBOX-955</a>
</td>
                                            <td class="summary"><p>
                Can&#39;t extract b/w images from PDF
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Tilman Hausherr
    </td>
                                            <td class="creator">            Tilman Hausherr
    </td>
                                            <td class="created"> 02/Feb/11 13:57 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 18/Aug/13 16:35 </td>
                                            <td class="resolutiondate"> 18/Aug/13 16:35 </td>
                                            <td class="versions">                        1.4.0            </td>
                                            <td class="fixVersions">                        1.6.0            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
