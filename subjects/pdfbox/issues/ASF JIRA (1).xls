                <tr id="issuerow12460764" rel="12460764" data-issuekey="PDFBOX-675" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-675" href="https://issues.apache.org/jira/browse/PDFBOX-675">PDFBOX-675</a>
</td>
                                            <td class="summary"><p>
                Upgrade .Net build to use IKVM version 0.42 
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
