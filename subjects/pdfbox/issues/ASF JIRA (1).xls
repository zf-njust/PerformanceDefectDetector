    <a class="issue-link" data-issue-key="PDFBOX-198" href="https://issues.apache.org/jira/browse/PDFBOX-198">PDFBOX-198</a>
</td>
                                            <td class="summary"><p>
                Tiff image problems
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
