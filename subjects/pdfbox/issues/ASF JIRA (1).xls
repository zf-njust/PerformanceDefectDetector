                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Jul/10 07:26 </td>
                                            <td class="resolutiondate"> 08/Apr/10 23:39 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.2.0            </td>
