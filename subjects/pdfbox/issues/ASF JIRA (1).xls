String sFilename1 = &quot;D:\\main_doc_pdf.pdf&quot;;<br/>
String sFilename2 = &quot;D:\\compte-rendu.pdf&quot;;<br/>
mergeFiles(sFilename1, sFilename2);<br/>
<br/>
<br/>
/* failed ! */<br/>
String sFilename1 = &quot;D:\\compte-rendu.pdf&quot;;<br/>
String sFilename2 = &quot;D:\\main_doc_pdf.pdf&quot;;<br/>
