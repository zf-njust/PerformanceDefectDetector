</td>
                                            <td class="created"> 25/Oct/07 06:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:07 </td>
                                            <td class="resolutiondate"> 03/Feb/15 19:45 </td>
                                            <td class="versions">                        1.6.0,                     2.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
