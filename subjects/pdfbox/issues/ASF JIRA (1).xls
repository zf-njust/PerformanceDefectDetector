    <a class="issue-link" data-issue-key="PDFBOX-486" href="https://issues.apache.org/jira/browse/PDFBOX-486">PDFBOX-486</a>
</td>
                                            <td class="summary"><p>
                Position of each individual word
    </p>
</td>
                                            <td class="issuetype"> Wish</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
