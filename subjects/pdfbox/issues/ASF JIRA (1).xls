    <a class="issue-link" data-issue-key="PDFBOX-870" href="https://issues.apache.org/jira/browse/PDFBOX-870">PDFBOX-870</a>
</td>
                                            <td class="summary"><p>
                PDF-To-IMAGE output is not anti-aliased
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Nicolas Hoibian
    </td>
                                            <td class="creator">            Nicolas Hoibian
    </td>
                                            <td class="created"> 18/Oct/10 09:57 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:07 </td>
                                            <td class="resolutiondate"> 01/Sep/14 23:49 </td>
                                            <td class="versions">                        1.3.1            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
                                            <td class="components">                        Rendering            </td>
                                            <td class="duedate">    &nbsp;
</td>
