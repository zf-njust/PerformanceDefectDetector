<br/>
pdDocument = PDDocument.load(new ByteArrayInputStream(aContent));<br/>
List&lt;PDPage&gt; documentPageList = pdDocument.getDocumentCatalog().getAllPages();<br/>
for(int i=0; i&lt;documentPageList.size(); ++i) {<br/>
PDPage aPage = documentPageList.get(i);<br/>
for (int x=1; x &lt; 14; x++) {<br/>
BufferedImage tempImage = convertToImage(x, (2 * 72),aPage);<br/>
ImageIO.write(tempImage,&quot;jpeg&quot;, new File(&quot;c:\\tmp<br/>
page-&quot; + x + &quot;.jpeg&quot;));<br/>
}<br/>
} <br/>

