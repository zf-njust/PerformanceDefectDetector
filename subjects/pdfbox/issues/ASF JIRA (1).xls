                <tr id="issuerow12439068" rel="12439068" data-issuekey="PDFBOX-547" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-547" href="https://issues.apache.org/jira/browse/PDFBOX-547">PDFBOX-547</a>
</td>
                                            <td class="summary"><p>
                problem in extracting text using PDFBox
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Jignesh Sh
    </td>
                                            <td class="creator">            Jignesh Sh
    </td>
                                            <td class="created"> 26/Oct/09 13:00 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 16/Nov/09 12:07 </td>
                                            <td class="resolutiondate"> 26/Oct/09 18:49 </td>
                                            <td class="versions">                        0.7.0            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">345600</td>
                                            <td class="timeestimate">345600</td>
