                <tr id="issuerow12411710" rel="12411710" data-issuekey="PDFBOX-398" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-398" href="https://issues.apache.org/jira/browse/PDFBOX-398">PDFBOX-398</a>
</td>
                                            <td class="summary"><p>
                Russian extraction encoding failure
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Adrian Romano
    </td>
                                            <td class="creator">            Adrian Romano
    </td>
                                            <td class="created"> 05/Jan/09 19:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/09 10:01 </td>
                                            <td class="resolutiondate"> 07/Apr/09 15:12 </td>
                                            <td class="versions">                        0.7.3,                     0.8.0-incubator            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
