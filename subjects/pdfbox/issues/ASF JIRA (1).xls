</td>
                                            <td class="summary"><p>
                CID to Unicode mapping
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">    &nbsp;
</td>
