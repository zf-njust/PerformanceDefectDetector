                                            <td class="labels">    </td>
                                            <td class="customfield_12310220">            <span title="27/Nov/08 23:47"><time class="livestamp allow-future" datetime="2008-11-27T23:47:56+0000">27/Nov/08 11:47 PM</time></span>
    </td>
                                            <td class="customfield_12312322"></td>
                                            <td class="customfield_12312520"></td>
                                            <td class="customfield_12312323"></td>
                                            <td class="customfield_12312521">    8 years, 24 weeks, 6 days ago

