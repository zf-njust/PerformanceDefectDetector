    <a class="issue-link" data-issue-key="PDFBOX-359" href="https://issues.apache.org/jira/browse/PDFBOX-359">PDFBOX-359</a>
</td>
                                            <td class="summary"><p>
                ClassCastException issue when extracting graphics
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
