                <tr id="issuerow12496447" rel="12496447" data-issuekey="PDFBOX-945" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-945" href="https://issues.apache.org/jira/browse/PDFBOX-945">PDFBOX-945</a>
</td>
                                            <td class="summary"><p>
                PDFBOX may not depend on plattform encoding
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Martin Koegler
    </td>
