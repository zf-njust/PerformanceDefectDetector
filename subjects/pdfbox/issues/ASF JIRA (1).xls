                                            <td class="environment"></td>
                                            <td class="description">      An empty page does not need to have a Contents item.<br/>
PDDocument.importPage() fails with a NullPointerException when such an empty page is imported.<br/>
<br/>
<br/>
<br/>
### Eclipse Workspace Patch 1.0<br/>
#P pdfbox<br/>
Index: pdfbox/src/main/java/org/apache/pdfbox/pdmodel/PDDocument.java<br/>
===================================================================<br/>
--- pdfbox/src/main/java/org/apache/pdfbox/pdmodel/PDDocument.java	(revision 1026306)<br/>
+++ pdfbox/src/main/java/org/apache/pdfbox/pdmodel/PDDocument.java	(working copy)<br/>
@@ -322,16 +322,19 @@<br/>
         try<br/>
         {<br/>
             PDStream src = page.getContents();<br/>
-            PDStream dest = new PDStream( new COSStream( src.getStream(), document.getScratchFile() ) );<br/>
-            importedPage.setContents( dest );<br/>
-            os = dest.createOutputStream();<br/>
+            if (src != null)<br/>
+            {<br/>
+                PDStream dest = new PDStream( new COSStream( src.getStream(), document.getScratchFile() ) );<br/>
+                importedPage.setContents( dest );<br/>
+                os = dest.createOutputStream();<br/>
 <br/>
-            byte[] buf = new byte[10240];<br/>
-            int amountRead = 0;<br/>
-            is = src.createInputStream();<br/>
-            while((amountRead = is.read(buf,0,10240)) &gt; -1)<br/>
-            {<br/>
-                os.write(buf, 0, amountRead);<br/>
+                byte[] buf = new byte[10240];<br/>
+                int amountRead = 0;<br/>
+                is = src.createInputStream();<br/>
+                while((amountRead = is.read(buf,0,10240)) &gt; -1)<br/>
+                {<br/>
+                    os.write(buf, 0, amountRead);<br/>
+                }<br/>
             }<br/>
             addPage( importedPage );<br/>
         }<br/>

  </td>
