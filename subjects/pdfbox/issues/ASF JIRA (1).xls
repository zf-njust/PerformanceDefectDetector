</td>
                                            <td class="created"> 01/Jul/05 13:35 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Aug/10 20:10 </td>
                                            <td class="resolutiondate"> 12/Aug/10 20:10 </td>
