    <a class="issue-link" data-issue-key="PDFBOX-663" href="https://issues.apache.org/jira/browse/PDFBOX-663">PDFBOX-663</a>
</td>
                                            <td class="summary"><p>
                Ensuring non-null FontDescriptor for external TrueType fonts
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
