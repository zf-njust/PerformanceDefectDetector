                <tr id="issuerow12391291" rel="12391291" data-issuekey="PDFBOX-257" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-257" href="https://issues.apache.org/jira/browse/PDFBOX-257">PDFBOX-257</a>
</td>
                                            <td class="summary"><p>
                PDFMergerUtility may create non-unique AcroForm field names
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">    <em>Anonymous</em>
</td>
                                            <td class="creator"><em>Anonymous</em>
</td>
                                            <td class="created"> 16/Mar/07 15:46 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Oct/10 09:33 </td>
                                            <td class="resolutiondate"> 17/Oct/10 14:07 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.3.1            </td>
                                            <td class="components">                        AcroForm            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
