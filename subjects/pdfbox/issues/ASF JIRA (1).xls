    <a class="issue-link" data-issue-key="PDFBOX-532" href="https://issues.apache.org/jira/browse/PDFBOX-532">PDFBOX-532</a>
</td>
                                            <td class="summary"><p>
                getPageLabels method for PDocumentCatalog class.
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
