</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-7" href="https://issues.apache.org/jira/browse/PDFBOX-7">PDFBOX-7</a>
</td>
                                            <td class="summary"><p>
                extract information from tagged PDF
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">    &nbsp;
</td>
                                            <td class="resolution">    Fixed
</td>
