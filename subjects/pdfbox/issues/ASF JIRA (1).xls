    <a class="issue-link" data-issue-key="PDFBOX-964" href="https://issues.apache.org/jira/browse/PDFBOX-964">PDFBOX-964</a>
</td>
                                            <td class="summary"><p>
                Wrong charecters
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Bogdan Artyushenko
    </td>
