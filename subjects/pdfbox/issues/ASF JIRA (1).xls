    <a class="issue-link" data-issue-key="PDFBOX-809" href="https://issues.apache.org/jira/browse/PDFBOX-809">PDFBOX-809</a>
</td>
                                            <td class="summary"><p>
                Reusing PDFonts causing COSVisitorException.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Won&#39;t Fix
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            MH
    </td>
                                            <td class="creator">            MH
    </td>
                                            <td class="created"> 01/Sep/10 12:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Feb/14 23:12 </td>
                                            <td class="resolutiondate"> 08/Feb/14 18:52 </td>
                                            <td class="versions">                        1.2.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
