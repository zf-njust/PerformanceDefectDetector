    <a class="issue-link" data-issue-key="PDFBOX-1000" href="https://issues.apache.org/jira/browse/PDFBOX-1000">PDFBOX-1000</a>
</td>
                                            <td class="summary"><p>
                Conforming parser
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Adam Nichols
    </td>
                                            <td class="reporter">            Adam Nichols
    </td>
                                            <td class="creator">            Adam Nichols
    </td>
                                            <td class="created"> 21/Apr/11 06:31 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Oct/14 04:08 </td>
                                            <td class="resolutiondate"> 11/Oct/14 04:08 </td>
                                            <td class="versions">                        1.6.0            </td>
                                            <td class="fixVersions">                        1.7.0            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">4</td>
