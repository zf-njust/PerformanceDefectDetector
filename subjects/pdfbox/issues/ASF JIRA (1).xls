    <a class="issue-link" data-issue-key="PDFBOX-818" href="https://issues.apache.org/jira/browse/PDFBOX-818">PDFBOX-818</a>
</td>
                                            <td class="summary"><p>
                PDFParser fails if object/xref starts at same line as endobj of a stream object
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Timo Boehme
    </td>
                                            <td class="creator">            Timo Boehme
    </td>
                                            <td class="created"> 06/Sep/10 16:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 27/Feb/14 07:29 </td>
                                            <td class="resolutiondate"> 27/Feb/14 07:28 </td>
                                            <td class="versions">                        1.3.1            </td>
                                            <td class="fixVersions">                        1.6.0            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
