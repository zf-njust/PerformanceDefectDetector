for (int x=1; x &lt; 14; x++) {<br/>
BufferedImage tempImage = convertToImage(x, (2 * 72),aPage);<br/>
ImageIO.write(tempImage,&quot;jpeg&quot;, new File(&quot;c:\\tmp<br/>
page-&quot; + x + &quot;.jpeg&quot;));<br/>
}<br/>
