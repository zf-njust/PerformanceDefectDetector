                <tr id="issuerow12391233" rel="12391233" data-issuekey="PDFBOX-199" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-199" href="https://issues.apache.org/jira/browse/PDFBOX-199">PDFBOX-199</a>
</td>
                                            <td class="summary"><p>
                Tiff image problems
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">            Jukka Zitting
    </td>
                                            <td class="reporter">    <em>Anonymous</em>
</td>
                                            <td class="creator"><em>Anonymous</em>
</td>
                                            <td class="created"> 15/Sep/06 09:02 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/09 10:01 </td>
                                            <td class="resolutiondate"> 30/Dec/08 16:39 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">    &nbsp;
</td>
