    </td>
                                            <td class="created"> 03/Dec/08 22:59 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 04/Aug/14 19:16 </td>
                                            <td class="resolutiondate"> 04/Aug/14 19:16 </td>
                                            <td class="versions">                        0.8.0-incubator            </td>
                                            <td class="fixVersions">                        1.8.0            </td>
                                            <td class="components">                        Parsing            </td>
