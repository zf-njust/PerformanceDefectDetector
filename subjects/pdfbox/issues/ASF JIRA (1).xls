</td>
                                            <td class="summary"><p>
                PDFont.getStringWidth() returns incorrect values
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
