                                            <td class="summary"><p>
                Increase performance of ColorSpaceCMYK.toRGB, patch attached
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
