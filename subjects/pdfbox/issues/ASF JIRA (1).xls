    <a class="issue-link" data-issue-key="PDFBOX-739" href="https://issues.apache.org/jira/browse/PDFBOX-739">PDFBOX-739</a>
</td>
                                            <td class="summary"><p>
                Problem converting pdf page w/ fully embedded TTF font, Identity-H (CID)
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Armando Singer
    </td>
                                            <td class="creator">            Armando Singer
    </td>
                                            <td class="created"> 02/Jun/10 07:53 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Jul/10 07:27 </td>
                                            <td class="resolutiondate"> 10/Jun/10 19:52 </td>
                                            <td class="versions">                        1.2.0            </td>
                                            <td class="fixVersions">                        1.2.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
