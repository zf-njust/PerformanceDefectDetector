</td>
                                            <td class="summary"><p>
                invalid xref entry causes parser to fail
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Sean Bridges
    </td>
                                            <td class="creator">            Sean Bridges
    </td>
                                            <td class="created"> 14/May/09 18:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
