    </td>
                                            <td class="created"> 29/Oct/10 17:51 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 20/Dec/10 09:38 </td>
                                            <td class="resolutiondate"> 05/Nov/10 14:35 </td>
                                            <td class="versions">                        1.3.1,                     1.4.0            </td>
                                            <td class="fixVersions">                        1.4.0            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
