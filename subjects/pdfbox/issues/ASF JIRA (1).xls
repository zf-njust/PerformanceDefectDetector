                <tr id="issuerow12415094" rel="12415094" data-issuekey="PDFBOX-430" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-430" href="https://issues.apache.org/jira/browse/PDFBOX-430">PDFBOX-430</a>
</td>
                                            <td class="summary"><p>
                Incorrect diacritic placement in text extraction
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Brian Carrier
    </td>
                                            <td class="creator">            Brian Carrier
    </td>
                                            <td class="created"> 18/Feb/09 21:22 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/09 10:28 </td>
                                            <td class="resolutiondate"> 18/Feb/09 21:34 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        0.8.0-incubator            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
