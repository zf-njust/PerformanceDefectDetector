                <tr id="issuerow12443183" rel="12443183" data-issuekey="PDFBOX-583" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-583" href="https://issues.apache.org/jira/browse/PDFBOX-583">PDFBOX-583</a>
</td>
                                            <td class="summary"><p>
                TextPosition#getIndividualWidths returns negative values
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Villu Ruusmann
    </td>
                                            <td class="creator">            Villu Ruusmann
    </td>
                                            <td class="created"> 12/Dec/09 16:47 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Feb/10 18:28 </td>
                                            <td class="resolutiondate"> 18/Dec/09 18:53 </td>
                                            <td class="versions">                        1.0.0            </td>
                                            <td class="fixVersions">                        1.0.0            </td>
                                            <td class="components">                        Text extraction,                     Utilities            </td>
                                            <td class="duedate">    &nbsp;
</td>
