                <tr id="issuerow12391133" rel="12391133" data-issuekey="PDFBOX-99" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-99" href="https://issues.apache.org/jira/browse/PDFBOX-99">PDFBOX-99</a>
</td>
                                            <td class="summary"><p>
                Indexed color images have wrong colors after encryption
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Adam Nichols
    </td>
                                            <td class="reporter">    <em>Anonymous</em>
</td>
