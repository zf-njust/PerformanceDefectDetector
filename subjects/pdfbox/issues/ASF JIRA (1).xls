                <tr id="issuerow12439865" rel="12439865" data-issuekey="PDFBOX-554" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-554" href="https://issues.apache.org/jira/browse/PDFBOX-554">PDFBOX-554</a>
</td>
                                            <td class="summary"><p>
                Handle JPEG2000 images via JPXDecode filter
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Timo Boehme
    </td>
                                            <td class="creator">            Timo Boehme
    </td>
                                            <td class="created"> 04/Nov/09 15:52 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Oct/10 09:33 </td>
                                            <td class="resolutiondate"> 21/Sep/10 15:44 </td>
                                            <td class="versions">                        1.0.0            </td>
                                            <td class="fixVersions">                        1.3.1            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
