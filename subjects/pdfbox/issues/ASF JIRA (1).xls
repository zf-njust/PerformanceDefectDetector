+    public static final String SUB_TYPE_INK = &quot;Ink&quot;;<br/>
+    /**<br/>
+     * Constant for an Sound type of annotation.<br/>
+     */<br/>
+    public static final String SUB_TYPE_SOUND = &quot;Sound&quot;;<br/>
 <br/>
     /*<br/>
