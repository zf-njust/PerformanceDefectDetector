                <tr id="issuerow12458094" rel="12458094" data-issuekey="PDFBOX-648" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-648" href="https://issues.apache.org/jira/browse/PDFBOX-648">PDFBOX-648</a>
</td>
                                            <td class="summary"><p>
                PdfBox can&#39;t be buit from behind a firewall/proxy
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            David Horwitz
    </td>
                                            <td class="creator">            David Horwitz
    </td>
                                            <td class="created"> 04/Mar/10 09:42 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 17/Mar/16 19:08 </td>
                                            <td class="resolutiondate"> 06/Feb/14 11:30 </td>
                                            <td class="versions">                        1.0.0            </td>
                                            <td class="fixVersions">                        2.0.0            </td>
