                <tr id="issuerow12457857" rel="12457857" data-issuekey="PDFBOX-645" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-645" href="https://issues.apache.org/jira/browse/PDFBOX-645">PDFBOX-645</a>
</td>
                                            <td class="summary"><p>
                PDDocumentOutline should not have getParent()
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Johannes Koch
    </td>
                                            <td class="creator">            Johannes Koch
    </td>
                                            <td class="created"> 02/Mar/10 13:28 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 30/Mar/10 08:23 </td>
                                            <td class="resolutiondate"> 15/Mar/10 11:35 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.1.0            </td>
