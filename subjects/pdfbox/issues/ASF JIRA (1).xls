                <tr id="issuerow12455970" rel="12455970" data-issuekey="PDFBOX-615" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-615" href="https://issues.apache.org/jira/browse/PDFBOX-615">PDFBOX-615</a>
</td>
                                            <td class="summary"><p>
                shfill operator needs implementation
    </p>
</td>
                                            <td class="issuetype"> New Feature</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Daniel Wilson
    </td>
                                            <td class="creator">            Daniel Wilson
    </td>
                                            <td class="created"> 11/Feb/10 01:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/May/14 06:12 </td>
                                            <td class="resolutiondate"> 02/Feb/14 15:40 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.8.5,                     2.0.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">4</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                                        PDFBOX-1869,                                                PDFBOX-1870                        </td>
                                            <td class="issuelinks">                                        PDFBOX-1416,                                                PDFBOX-1442,                                                PDFBOX-1877,                                                PDFBOX-1094                        </td>
                                            <td class="environment"></td>
                                            <td class="description">      I have a PDF file (for which I do not yet have release permission) that uses the &quot;sh&quot; operator, equivalent to PostScript&#39;s shfill (per PDF spec 1.7 page 987).<br/>
<br/>
Adobe provides implementation guidance in a 78-page document at http://www.adobe.com/devnet/postscript/pdfs/TN5600.SmoothShading.pdf#17<br/>
<br/>
I will be trying to add this functionality this week, but if anyone has hints, suggestions, etc. they are most certainly welcome!
  </td>
