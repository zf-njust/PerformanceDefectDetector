</td>
                                            <td class="summary"><p>
                Exception in thread &quot;main&quot; java.lang.NoClassDefFoundError: org/bouncycastle/jce/provider/BouncyCastleProvider
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Not A Problem
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Vladimir
    </td>
                                            <td class="creator">            Vladimir
    </td>
