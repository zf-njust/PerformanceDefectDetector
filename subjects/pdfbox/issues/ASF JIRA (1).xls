pdDocument = PDDocument.load(new ByteArrayInputStream(aContent));<br/>
List&lt;PDPage&gt; documentPageList = pdDocument.getDocumentCatalog().getAllPages();<br/>
for(int i=0; i&lt;documentPageList.size(); ++i) {<br/>
