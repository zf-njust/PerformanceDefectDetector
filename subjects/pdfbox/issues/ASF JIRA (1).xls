    <a class="issue-link" data-issue-key="PDFBOX-969" href="https://issues.apache.org/jira/browse/PDFBOX-969">PDFBOX-969</a>
</td>
                                            <td class="summary"><p>
                IndexOutOfBound whle creating a Type1C font
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
