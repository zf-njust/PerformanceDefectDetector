    <a class="issue-link" data-issue-key="PDFBOX-1002" href="https://issues.apache.org/jira/browse/PDFBOX-1002">PDFBOX-1002</a>
</td>
                                            <td class="summary"><p>
                Form field not rendered after being processed by pdfbox-1.1.0, wrong position of same field in pdfbox-1.5.0
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Maruan Sahyoun
    </td>
