                <tr id="issuerow12409793" rel="12409793" data-issuekey="PDFBOX-393" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-393" href="https://issues.apache.org/jira/browse/PDFBOX-393">PDFBOX-393</a>
</td>
                                            <td class="summary"><p>
                Maven files in jempbox do not work in Eclipse.
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jukka Zitting
    </td>
                                            <td class="reporter">            Brian Carrier
    </td>
                                            <td class="creator">            Brian Carrier
    </td>
                                            <td class="created"> 03/Dec/08 19:33 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/09 09:52 </td>
                                            <td class="resolutiondate"> 06/Mar/09 18:47 </td>
                                            <td class="versions">                        0.8.0-incubator            </td>
                                            <td class="fixVersions">                        0.8.0-incubator            </td>
                                            <td class="components">                        JempBox            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
