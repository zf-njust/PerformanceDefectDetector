</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-849" href="https://issues.apache.org/jira/browse/PDFBOX-849">PDFBOX-849</a>
</td>
                                            <td class="summary"><p>
                saved pdf causes &quot;insufficient data for an image when opened with Adobe Acrobat Reader 9.2.0
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Invalid
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Grant Overby
    </td>
                                            <td class="creator">            Grant Overby
    </td>
                                            <td class="created"> 01/Oct/10 20:20 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Oct/10 22:26 </td>
                                            <td class="resolutiondate"> 01/Oct/10 22:16 </td>
                                            <td class="versions">                        1.2.1            </td>
                                            <td class="fixVersions">                        1.2.1            </td>
                                            <td class="components">                        Writing            </td>
                                            <td class="duedate">    &nbsp;
</td>
