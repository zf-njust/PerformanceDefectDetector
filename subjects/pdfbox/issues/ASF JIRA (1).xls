                <tr id="issuerow12391283" rel="12391283" data-issuekey="PDFBOX-249" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-249" href="https://issues.apache.org/jira/browse/PDFBOX-249">PDFBOX-249</a>
</td>
                                            <td class="summary"><p>
                Imbricated XObjects with the same name
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">    <em>Anonymous</em>
</td>
                                            <td class="creator"><em>Anonymous</em>
</td>
                                            <td class="created"> 20/Feb/07 10:39 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/09 09:52 </td>
                                            <td class="resolutiondate"> 17/Apr/09 08:47 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        0.8.0-incubator            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
