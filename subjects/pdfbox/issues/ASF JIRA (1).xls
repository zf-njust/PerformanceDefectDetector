                <tr id="issuerow12391268" rel="12391268" data-issuekey="PDFBOX-234" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-234" href="https://issues.apache.org/jira/browse/PDFBOX-234">PDFBOX-234</a>
</td>
                                            <td class="summary"><p>
                spaces lost
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">    <em>Anonymous</em>
</td>
                                            <td class="creator"><em>Anonymous</em>
</td>
                                            <td class="created"> 15/Jan/07 15:09 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 19/Jul/14 12:33 </td>
                                            <td class="resolutiondate"> 01/Apr/09 20:58 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        0.8.0-incubator            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
