                <tr id="issuerow12437202" rel="12437202" data-issuekey="PDFBOX-537" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-537" href="https://issues.apache.org/jira/browse/PDFBOX-537">PDFBOX-537</a>
</td>
                                            <td class="summary"><p>
                Endless loop in org.apache.pdfbox.pdfparser.BaseParser.parseCOSDictionary() on certain corrupt PDF streams
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Hacho
    </td>
                                            <td class="creator">            Hacho
    </td>
                                            <td class="created"> 03/Oct/09 20:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 22/Feb/10 18:28 </td>
                                            <td class="resolutiondate"> 27/Oct/09 18:37 </td>
                                            <td class="versions">                        0.8.0-incubator            </td>
                                            <td class="fixVersions">                        1.0.0            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate">3600</td>
                                            <td class="timeestimate">3600</td>
                                            <td class="timespent"></td>
                                            <td class="workratio">            0%
    </td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment">      The problem occurs on certain corrupt streams. I have attached the file &quot;corrupt-endless-loop-in-0.8.pdf&quot; which is 447 bytes long and exhibits this problem. Not sure, but I think this file was originally longer and was somehow cut.
  </td>
                                            <td class="description">      The endless loop seems to have been introduced with the changes from 01-Sep-2009 in svn revision 810122 with the addition of the loop to wait for a valid dictionary<br/>
<br/>
Index: PDFBox/src/main/java/org/apache/pdfbox/pdfparser/BaseParser.java<br/>
===================================================================<br/>
--- PDFBox/src/main/java/org/apache/pdfbox/pdfparser/BaseParser.java	(revision 793364)<br/>
+++ PDFBox/src/main/java/org/apache/pdfbox/pdfparser/BaseParser.java	(revision 810122)<br/>
@@ -183,7 +183,23 @@<br/>
             if( c == &#39;&gt;&#39;)<br/>
             {<br/>
                 done = true;<br/>
-            }<br/>
+            } <br/>
+            else <br/>
+                if(c != &#39;/&#39;) <br/>
+                {<br/>
+                    //an invalid dictionary, we are expecting<br/>
+                    //the key, read until we can recover<br/>
+                    logger().warning(&quot;Invalid dictionary, found:&quot; + (char)c + &quot; but expected:\&#39;&#39;&quot;);<br/>
+                    int read = pdfSource.read();<br/>
+                    while(read != -1 &amp;&amp; read != &#39;/&#39; &amp;&amp; read != &#39;&gt;&#39;)<br/>
+                    {<br/>
+                        read = pdfSource.read();<br/>
+                    }<br/>
+                    if(read != -1) <br/>
+                    {<br/>
+                        pdfSource.unread(read);<br/>
+                    }<br/>
+                }<br/>
             else<br/>
             {<br/>
                 COSName key = parseCOSName();<br/>
@@ -206,9 +222,12 @@<br/>
 <br/>
                 if( value == null )<br/>
                 {<br/>
-                    throw new IOException(&quot;Bad Dictionary Declaration &quot; + pdfSource );<br/>
+                    logger().warning(&quot;Bad Dictionary Declaration &quot; + pdfSource );<br/>
                 }<br/>
-                obj.setItem( key, value );<br/>
+                else<br/>
+                {<br/>
+                    obj.setItem( key, value );<br/>
+                }<br/>
             }<br/>
         }<br/>
         char ch = (char)pdfSource.read();<br/>

  </td>
