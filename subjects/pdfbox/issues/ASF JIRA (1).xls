                <tr id="issuerow12428212" rel="12428212" data-issuekey="PDFBOX-485" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-485" href="https://issues.apache.org/jira/browse/PDFBOX-485">PDFBOX-485</a>
</td>
                                            <td class="summary"><p>
                Fonts not printed on HP laserjet (1320 &amp; 8150) when having landscape orientation
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Volker Bier
    </td>
                                            <td class="creator">            Volker Bier
    </td>
                                            <td class="created"> 18/Jun/09 06:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/09 09:52 </td>
                                            <td class="resolutiondate"> 25/Jun/09 17:14 </td>
                                            <td class="versions">                        0.8.0-incubator            </td>
                                            <td class="fixVersions">                        0.8.0-incubator            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
