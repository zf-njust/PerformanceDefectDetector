                <tr id="issuerow12491575" rel="12491575" data-issuekey="PDFBOX-911" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-911" href="https://issues.apache.org/jira/browse/PDFBOX-911">PDFBOX-911</a>
</td>
                                            <td class="summary"><p>
                Method PDDocument.getNumberOfPages() returns wrong number of pages
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            nielsen
    </td>
                                            <td class="creator">            nielsen
    </td>
                                            <td class="created"> 29/Nov/10 20:13 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Dec/13 14:14 </td>
                                            <td class="resolutiondate"> 08/Dec/13 14:14 </td>
                                            <td class="versions">                        1.3.1            </td>
                                            <td class="fixVersions">                        1.8.1            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
                                            <td class="watches">2</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                                        PDFBOX-1000,                                                PDFBOX-796,                                                PDFBOX-912                        </td>
                                            <td class="environment">      Windows XP, Eclipse 3.5.2 Galileo
  </td>
                                            <td class="description">      Hello,<br/>
<br/>
I use PDFbox and are very pleased.<br/>
For one PDF file however getNumberOfPages() returns the wrong number of pages (1 instead of 2 pages).<br/>
<br/>
Test code:<br/>
        File xx = new File(&quot;c:\\temp\\test.pdf&quot;);<br/>
        PDDocument pdoc = PDDocument.load(xx);    <br/>
        int x = pdoc.getNumberOfPages();<br/>
<br/>
The PDF file could be provided.<br/>
<br/>
Thanks in advance.<br/>
<br/>
Regards
  </td>
                                            <td class="security"></td>
                                            <td class="progress">     
</td>
                                            <td class="aggregateprogress">     
</td>
                                            <td class="aggregatetimespent"></td>
