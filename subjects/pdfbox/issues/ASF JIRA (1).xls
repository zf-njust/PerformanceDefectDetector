at org.pdfbox.cos.COSNumber.get(COSNumber.java:106)<br/>
at org.pdfbox.pdfparser.PDFStreamParser.parseNextToken(PDFStreamParser.java:259)<br/>
at org.pdfbox.pdfparser.PDFStreamParser.parse(PDFStreamParser.java:115)<br/>
at org.pdfbox.cos.COSStream.getStreamTokens(COSStream.java:133)<br/>
