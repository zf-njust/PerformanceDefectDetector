                <tr id="issuerow12464619" rel="12464619" data-issuekey="PDFBOX-729" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-729" href="https://issues.apache.org/jira/browse/PDFBOX-729">PDFBOX-729</a>
</td>
                                            <td class="summary"><p>
                Disable text extraction whne using type3 fonts (was: Text extracted from a TeX-created PDF file is unintelligible, but not of the form a1a2a3...)
    </p>
</td>
