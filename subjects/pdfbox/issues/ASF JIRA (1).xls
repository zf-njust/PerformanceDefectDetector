                <tr id="issuerow12443542" rel="12443542" data-issuekey="PDFBOX-584" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-584" href="https://issues.apache.org/jira/browse/PDFBOX-584">PDFBOX-584</a>
</td>
                                            <td class="summary"><p>
                convertToImage seems to invert colors
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Scott Tyriver
    </td>
                                            <td class="creator">            Scott Tyriver
    </td>
                                            <td class="created"> 16/Dec/09 15:44 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 28/Jul/10 10:51 </td>
                                            <td class="resolutiondate"> 28/Mar/10 14:33 </td>
                                            <td class="versions">                        0.8.0-incubator            </td>
                                            <td class="fixVersions">                        1.2.0            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
