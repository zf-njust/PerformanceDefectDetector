</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-562" href="https://issues.apache.org/jira/browse/PDFBOX-562">PDFBOX-562</a>
</td>
                                            <td class="summary"><p>
                Some PDFs cannot be processed yet are valid PDFs
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Critical
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Matt Hicks
    </td>
                                            <td class="creator">            Matt Hicks
    </td>
                                            <td class="created"> 18/Nov/09 15:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 12/Feb/11 18:54 </td>
                                            <td class="resolutiondate"> 02/Dec/10 23:56 </td>
                                            <td class="versions">                        0.7.0,                     0.7.1,                     0.7.2,                     0.7.3,                     0.8.0-incubator,                     1.0.0            </td>
                                            <td class="fixVersions">                        1.3.1            </td>
                                            <td class="components">                        Parsing            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">1</td>
