    <a class="issue-link" data-issue-key="PDFBOX-495" href="https://issues.apache.org/jira/browse/PDFBOX-495">PDFBOX-495</a>
</td>
                                            <td class="summary"><p>
                PDFTextStripperByArea extracts text only from 1 region, despite several regions being defined
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Ismael Hasan
    </td>
                                            <td class="creator">            Ismael Hasan
    </td>
                                            <td class="created"> 23/Jul/09 10:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 09/Nov/15 16:45 </td>
                                            <td class="resolutiondate"> 09/Nov/15 16:45 </td>
                                            <td class="versions">                        0.8.0-incubator            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
