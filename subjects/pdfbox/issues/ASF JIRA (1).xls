                <tr id="issuerow12474831" rel="12474831" data-issuekey="PDFBOX-838" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-838" href="https://issues.apache.org/jira/browse/PDFBOX-838">PDFBOX-838</a>
</td>
                                            <td class="summary"><p>
                Problem with text extraction
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Cannot Reproduce
</td>
                                            <td class="assignee">            Jukka Zitting
    </td>
                                            <td class="reporter">            Dusan Radojevic
    </td>
                                            <td class="creator">            Dusan Radojevic
    </td>
                                            <td class="created"> 22/Sep/10 15:16 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Oct/10 09:42 </td>
                                            <td class="resolutiondate"> 14/Oct/10 09:30 </td>
                                            <td class="versions">                        1.2.1            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">1</td>
                                            <td class="thumbnail"></td>
