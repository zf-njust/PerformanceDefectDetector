PDXObjectImage image = (PDXObjectImage)images.get( <br/>
key ); <br/>
String name = getUniqueFileName( key, image.getSuffix<br/>
() ); <br/>
System.out.println( &quot;Writing image:&quot; + name ); <br/>
image.write2file( name ); <br/>
} <br/>
} <br/>
} <br/>
