    <a class="issue-link" data-issue-key="PDFBOX-412" href="https://issues.apache.org/jira/browse/PDFBOX-412">PDFBOX-412</a>
</td>
                                            <td class="summary"><p>
                Failure to render PDFs with embedded fonts
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
