                <tr id="issuerow12391257" rel="12391257" data-issuekey="PDFBOX-223" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-223" href="https://issues.apache.org/jira/browse/PDFBOX-223">PDFBOX-223</a>
</td>
                                            <td class="summary"><p>
                CurrentColor in PageDrawer Doesn&#39;t Restore Properly
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Minor
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
