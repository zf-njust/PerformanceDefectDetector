                <tr id="issuerow12413184" rel="12413184" data-issuekey="PDFBOX-410" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-410" href="https://issues.apache.org/jira/browse/PDFBOX-410">PDFBOX-410</a>
</td>
                                            <td class="summary"><p>
                Two small performance issue in COSString, these are not bugs
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Peter_Lenahan@ibi.com
    </td>
                                            <td class="creator">            Peter_Lenahan@ibi.com
    </td>
                                            <td class="created"> 24/Jan/09 19:55 </td>
                                            <td class="lastViewed"> 20/Jun/17 06:25 </td>
                                            <td class="updated"> 01/Jul/10 07:26 </td>
                                            <td class="resolutiondate"> 09/May/10 17:36 </td>
                                            <td class="versions">                        0.8.0-incubator            </td>
                                            <td class="fixVersions">                        1.2.0            </td>
                                            <td class="components">    &nbsp;
</td>
