                <tr id="issuerow12404583" rel="12404583" data-issuekey="PDFBOX-375" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-375" href="https://issues.apache.org/jira/browse/PDFBOX-375">PDFBOX-375</a>
</td>
                                            <td class="summary"><p>
                Rename org.pdfbox packages to org.apache.pdfbox
    </p>
</td>
                                            <td class="issuetype"> Task</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Blocker
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Jukka Zitting
    </td>
                                            <td class="reporter">            Jukka Zitting
    </td>
                                            <td class="creator">            Jukka Zitting
    </td>
                                            <td class="created"> 17/Sep/08 23:04 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 21/Oct/09 09:52 </td>
                                            <td class="resolutiondate"> 18/Sep/08 00:00 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        0.8.0-incubator            </td>
                                            <td class="components">    &nbsp;
</td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">0</td>
                                            <td class="watches">0</td>
                                            <td class="thumbnail"></td>
                                            <td class="timeoriginalestimate"></td>
                                            <td class="timeestimate"></td>
                                            <td class="timespent"></td>
                                            <td class="workratio">&nbsp;
</td>
                                            <td class="subtasks">                </td>
                                            <td class="issuelinks">                </td>
                                            <td class="environment"></td>
                                            <td class="description">      Java projects at Apache use the org.apache root for their package names. PDFBox should also adapt this naming convention.<br/>
<br/>
Note that this will break _all_ client applications that use the PDFBox APIs. Luckily the breakage can be fixed simply by modifying import statements.
  </td>
