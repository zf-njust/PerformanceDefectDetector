                <tr id="issuerow12460355" rel="12460355" data-issuekey="PDFBOX-670" class="issuerow">
                                            <td class="project">    PDFBox
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="PDFBOX-670" href="https://issues.apache.org/jira/browse/PDFBOX-670">PDFBOX-670</a>
</td>
                                            <td class="summary"><p>
                TrueType - Management of CMap format 2
    </p>
</td>
                                            <td class="issuetype"> Improvement</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Trivial
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Eric Leleu
    </td>
                                            <td class="creator">            Eric Leleu
    </td>
                                            <td class="created"> 26/Mar/10 14:11 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 01/Jul/10 07:26 </td>
                                            <td class="resolutiondate"> 14/Jun/10 17:23 </td>
                                            <td class="versions">                        1.0.0            </td>
                                            <td class="fixVersions">                        1.2.0            </td>
