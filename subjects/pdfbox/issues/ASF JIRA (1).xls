    </td>
                                            <td class="created"> 07/Mar/10 14:17 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 08/Oct/13 17:21 </td>
                                            <td class="resolutiondate"> 21/Jun/10 15:47 </td>
