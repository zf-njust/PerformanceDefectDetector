</td>
                                            <td class="summary"><p>
                infinite loop encountered in PushBackInputStream.read
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Duplicate
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Nicholas Blair
    </td>
                                            <td class="creator">            Nicholas Blair
    </td>
                                            <td class="created"> 26/Jan/10 14:55 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 11/Jul/10 14:46 </td>
                                            <td class="resolutiondate"> 21/Jun/10 15:24 </td>
                                            <td class="versions">                        0.8.0-incubator            </td>
                                            <td class="fixVersions">    &nbsp;
</td>
