</td>
                                            <td class="summary"><p>
                PDPage convertToImage partially generates image file and throws exception
    </p>
</td>
                                            <td class="issuetype"> Test</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Dan Sabin
    </td>
                                            <td class="creator">            Dan Sabin
    </td>
                                            <td class="created"> 19/Aug/10 13:18 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 02/May/13 02:29 </td>
                                            <td class="resolutiondate"> 18/Nov/12 17:37 </td>
                                            <td class="versions">                        1.2.1            </td>
                                            <td class="fixVersions">                        1.8.0            </td>
                                            <td class="components">                        PDModel            </td>
