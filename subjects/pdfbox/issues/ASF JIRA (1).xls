                                            <td class="description">      http://www.uss.com/corp/investors/sec_filings/3Q-2010-Earnings-Release.pdf<br/>
<br/>
In Foxit Reader opened correctly<br/>
<br/>
This code gets null:<br/>
<br/>
public static String getHtml(InputStream inputStream) {<br/>
        PDDocument pdDocument = null;<br/>
        String document = null;<br/>
        try {<br/>
            PDFParser parser = new PDFParser(inputStream);<br/>
            parser.parse();<br/>
<br/>
            pdDocument = parser.getPDDocument();<br/>
<br/>
            PDFText2HTML pdf2html = new PDFText2HTML(StringUtil.UTF_8());<br/>
            document = pdf2html.getText(pdDocument);<br/>
        } catch (IOException e) {<br/>
            e.printStackTrace();<br/>
        } finally {<br/>
            if (pdDocument != null) {<br/>
                try {<br/>
                    pdDocument.getDocument().close();<br/>
                } catch (IOException e) {<br/>
                    e.printStackTrace();<br/>
                }<br/>
            }<br/>
        }<br/>
<br/>
        return document;<br/>
    }<br/>
<br/>
<br/>
