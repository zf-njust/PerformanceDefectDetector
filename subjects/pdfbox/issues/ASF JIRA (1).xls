    <a class="issue-link" data-issue-key="PDFBOX-831" href="https://issues.apache.org/jira/browse/PDFBOX-831">PDFBOX-831</a>
</td>
                                            <td class="summary"><p>
                PDPage.convertToImage throwing an uncaught IOException internally
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">            Andreas Lehmkühler
    </td>
                                            <td class="reporter">            Kosta Krauth
    </td>
                                            <td class="creator">            Kosta Krauth
    </td>
                                            <td class="created"> 19/Sep/10 01:46 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Dec/12 15:53 </td>
                                            <td class="resolutiondate"> 26/Dec/12 15:53 </td>
                                            <td class="versions">                        1.2.1,                     1.3.1,                     1.5.0            </td>
                                            <td class="fixVersions">                        1.6.0            </td>
                                            <td class="components">                        PDModel            </td>
                                            <td class="duedate">    &nbsp;
</td>
                                            <td class="votes">2</td>
                                            <td class="watches">3</td>
