    <a class="issue-link" data-issue-key="PDFBOX-440" href="https://issues.apache.org/jira/browse/PDFBOX-440">PDFBOX-440</a>
</td>
                                            <td class="summary"><p>
                Improper text produced depending on font for sample_fonts_solidconverter.pdf
    </p>
</td>
                                            <td class="issuetype"> Bug</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
                                            <td class="reporter">            Justin LeFebvre
    </td>
                                            <td class="creator">            Justin LeFebvre
    </td>
                                            <td class="created"> 17/Mar/09 14:50 </td>
                                            <td class="lastViewed"> &nbsp; </td>
                                            <td class="updated"> 26/Oct/10 09:33 </td>
                                            <td class="resolutiondate"> 03/Oct/10 14:34 </td>
                                            <td class="versions">    &nbsp;
</td>
                                            <td class="fixVersions">                        1.3.1            </td>
                                            <td class="components">                        Text extraction            </td>
                                            <td class="duedate">    &nbsp;
</td>
