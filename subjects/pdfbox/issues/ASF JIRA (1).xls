PDFMergerUtility merger = new PDFMergerUtility();<br/>
merger.addSource(sFilename1);<br/>
merger.addSource(sFilename2);<br/>
<br/>
merger.setDestinationFileName(sFilename1 + &quot;_cr.pdf&quot;);<br/>
merger.mergeDocuments();<br/>
<br/>
}<br/>
