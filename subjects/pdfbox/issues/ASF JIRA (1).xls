    <a class="issue-link" data-issue-key="PDFBOX-394" href="https://issues.apache.org/jira/browse/PDFBOX-394">PDFBOX-394</a>
</td>
                                            <td class="summary"><p>
                TestFDF junit test failing in testFDFFreedomExpressions().
    </p>
</td>
                                            <td class="issuetype"> Test</td>
                                            <td class="status">
                Closed
    </td>
                                            <td class="priority">   Major
</td>
                                            <td class="resolution">    Fixed
